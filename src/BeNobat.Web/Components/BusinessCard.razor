<article class="business-card">
    <div class="business-cover @Accent"><span>@Icon</span><button aria-label="افزودن به علاقه‌مندی" type="button"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></button><small>@Category</small></div>
    <div class="business-card-body">
        <div class="business-name"><div><h3>@Name <span>✓</span></h3><p>⌖ @Location، @City</p></div><div class="score"><b>@Rating</b><span>★</span><small>@Reviews نظر</small></div></div>
        <div class="slot-row"><div><a class="reviews-link" href="/business/@Id/reviews">مشاهده نظرها</a><strong>و رزرو آنلاین</strong></div><a href="/book/@Id">رزرو نوبت</a></div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string Location { get; set; } = "";
    [Parameter] public string City { get; set; } = "تهران";
    [Parameter] public string Rating { get; set; } = "۴.۸";
    [Parameter] public string Reviews { get; set; } = "۰";
    [Parameter] public string Accent { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "✦";
}
