<article class="business-card">
    <div class="business-cover @Accent"><span>@Icon</span><button aria-label="افزودن به علاقه‌مندی" type="button">♡</button><small>@Category</small></div>
    <div class="business-card-body">
        <div class="business-name"><div><h3>@Name <span>✓</span></h3><p>⌖ @Location، @City</p></div><div class="score"><b>@Rating</b><span>★</span><small>@Reviews نظر</small></div></div>
        <div class="slot-row"><div><small>مشاهده جزئیات</small><strong>و رزرو آنلاین</strong></div><a href="/book/@Id">رزرو نوبت</a></div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string Location { get; set; } = "";
    [Parameter] public string City { get; set; } = "تهران";
    [Parameter] public string Rating { get; set; } = "۴.۸";
    [Parameter] public string Reviews { get; set; } = "۰";
    [Parameter] public string Accent { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "✦";
}
