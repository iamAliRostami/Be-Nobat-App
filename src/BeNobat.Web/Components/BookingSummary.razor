<aside class="booking-summary"><h3>خلاصه نوبت</h3><div class="summary-business"><i>✦</i><span><b>استودیو زیبایی آوان</b><small>شعبه ونک</small></span></div><dl><div><dt>خدمت</dt><dd>@Service</dd></div><div><dt>متخصص</dt><dd>اولین متخصص آزاد</dd></div>@if(Time is not null){<div><dt>زمان</dt><dd>@Time</dd></div>}<div><dt>مدت</dt><dd>۶۰ دقیقه</dd></div></dl><div class="summary-total"><span>مبلغ قابل پرداخت</span><strong>۴۸۰,۰۰۰ <small>تومان</small></strong></div><button @onclick="OnContinue">@(Time is null ? "انتخاب زمان" : "تأیید و ثبت نوبت") <span>←</span></button><p>با ادامه، قوانین رزرو و لغو را می‌پذیرید.</p></aside>

@code {
    [Parameter] public string Service { get; set; } = "";
    [Parameter] public string? Time { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
}

