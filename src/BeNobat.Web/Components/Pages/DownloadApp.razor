@code {
    private PlatformPricingSettings platformSettings = new();
    private AppRelease? latestRelease;

    [SupplyParameterFromQuery(Name = "bazaar")]
    public bool? RedirectToBazaar { get; set; }

    [SupplyParameterFromQuery(Name = "direct")]
    public bool? DirectDownload { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        platformSettings = await db.GetPlatformPricingAsync();

        latestRelease = await db.AppReleases.AsNoTracking()
            .Where(r => r.IsActive)
            .OrderByDescending(r => r.VersionCode)
            .FirstOrDefaultAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');

        if (path.EndsWith("/bazaar", StringComparison.OrdinalIgnoreCase) || RedirectToBazaar == true)
        {
            Nav.NavigateTo(GetBazaarUrl(), forceLoad: true);
            return;
        }

        if (path.EndsWith("/direct", StringComparison.OrdinalIgnoreCase) || DirectDownload == true)
        {
            Nav.NavigateTo(GetDirectDownloadUrl(), forceLoad: true);
            return;
        }
    }

    private string GetBazaarUrl()
    {
        if (!string.IsNullOrWhiteSpace(platformSettings.CafeBazaarUrl))
        {
            return platformSettings.CafeBazaarUrl.Trim();
        }

        var pkg = latestRelease?.BazaarPackageName;
        if (string.IsNullOrWhiteSpace(pkg))
        {
            pkg = "com.leon.be_nobat";
        }
        return $"https://cafebazaar.ir/app/{pkg}";
    }

    private string GetDirectDownloadUrl()
    {
        if (!string.IsNullOrWhiteSpace(platformSettings.DirectApkUrl))
        {
            return platformSettings.DirectApkUrl.Trim();
        }

        if (!string.IsNullOrWhiteSpace(latestRelease?.ExternalDownloadUrl))
        {
            return latestRelease.ExternalDownloadUrl.Trim();
        }

        return "/api/v1/app/download-latest";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "";
        var mb = bytes / (1024.0 * 1024.0);
        return $"{mb:F1} مگابایت";
    }

    private string T(string fa, string en, string ar) => UiLocale.Language switch
    {
        "en" => en,
        "ar" => ar,
        _ => fa
    };
}
