@page "/download"
@page "/app"
@page "/app/download"
@using BeNobat.Web.Components.Layout
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@using Microsoft.EntityFrameworkCore
@layout PublicLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject UiLocale UiLocale

<PageTitle>@T("دانلود اپلیکیشن اندروید به‌نوبت | لینک مستقیم و کافه بازار", "Download Be-Nobat Android App | Direct APK & Bazaar", "تحميل تطبيق به‌نوبت للأندرويد")</PageTitle>

<div class="download-page-shell" style="direction: @(UiLocale.Language == "en" ? "ltr" : "rtl");">
    <div class="download-hero">
        <span class="download-badge">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993s-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9994.4482.9994.9993s-.4483.9997-.9994.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5842 8.4116 13.8557 8.1 12 8.1s-3.5842.3116-5.1368.8497L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
            </svg>
            <span>@T("نسخه رسمی اندروید", "Official Android Release", "النسخة الرسمية للأندرويد")</span>
        </span>
        <h1>@T("دانلود اپلیکیشن موبایل به‌نوبت", "Download Be-Nobat Mobile App", "تحميل تطبيق به‌نوبت للهاتف")</h1>
        <p>@T("رزرو آنلاین نوبت، مدیریت خدمات، مشاهده تقویم کاری و دریافت اعلان‌های لحظه‌ای در سریع‌ترین زمان ممکن روی تلفن همراه شما.",
               "Online appointment booking, service management, work calendar, and instant notifications right on your phone.",
               "حجز المواعيد عبر الإنترنت وإدارة الخدمات والإشعارات الفورية على هاتفك المحمول.")</p>
    </div>

    <div class="download-container">
        <!-- کارت اصلی دانلود اپلیکیشن -->
        <div class="app-card-main">
            <div class="app-header-row">
                <div class="app-icon-wrapper">
                    <img src="/icons/icon-192.png" alt="BeNobat Icon" class="app-icon-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="app-icon-fallback" style="display:none;">
                        <span>ب</span>
                    </div>
                </div>
                <div class="app-info-col">
                    <div class="app-title-line">
                        <h2>@T("به‌نوبت", "Be-Nobat", "به‌نوبت")</h2>
                        <span class="free-pill">@T("رایگان", "Free", "مجاني")</span>
                    </div>
                    <p class="app-category">@T("سامانه رزرو نوبت و خدمات آنلاین", "Appointment & Services Booking Platform", "منصة حجز المواعيد والخدمات")</p>
                    <div class="app-meta-tags">
                        <span class="meta-tag">
                            <strong>@T("نسخه:", "Version:", "الإصدار:")</strong> @(latestRelease != null ? $"v{latestRelease.VersionName}" : "v1.2.0")
                        </span>
                        @if (latestRelease?.ApkFileSize > 0)
                        {
                            <span class="meta-tag">
                                <strong>@T("حجم:", "Size:", "الحجم:")</strong> @FormatFileSize(latestRelease.ApkFileSize.Value)
                            </span>
                        }
                        <span class="meta-tag">
                            <strong>@T("پیش‌نیاز:", "Requires:", "يتطلب:")</strong> @T("اندروید 7.0+", "Android 7.0+", "أندرويد 7.0+")
                        </span>
                    </div>
                </div>
            </div>

            <!-- دکمه‌های اصلی دانلود -->
            <div class="download-buttons-group">
                <!-- دکمه کافه بازار -->
                <a href="@GetBazaarUrl()" target="_blank" rel="noopener noreferrer" class="btn-download-bazaar">
                    <div class="btn-icon-area">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                        </svg>
                    </div>
                    <div class="btn-text-area">
                        <span class="btn-subtitle">@T("دانلود و به‌روزرسانی از", "Download & update from", "تحميل وتحديث من")</span>
                        <strong class="btn-title">@T("کافه بازار", "Cafe Bazaar", "كافيه بازار")</strong>
                    </div>
                </a>

                <!-- دکمه دانلود مستقیم فایل APK -->
                <a href="@GetDirectDownloadUrl()" download class="btn-download-direct">
                    <div class="btn-icon-area">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                        </svg>
                    </div>
                    <div class="btn-text-area">
                        <span class="btn-subtitle">@T("دانلود مستقیم فایل نصبی", "Direct APK download", "تحميل مباشر لملف APK")</span>
                        <strong class="btn-title">@T("دانلود فایل APK", "Download APK", "تحميل APK")</strong>
                    </div>
                </a>
            </div>

            <!-- تغییرات آخرین نسخه -->
            @if (latestRelease != null && !string.IsNullOrWhiteSpace(latestRelease.ReleaseNotes))
            {
                <div class="release-notes-box">
                    <div class="notes-header">
                        <span class="notes-icon">✨</span>
                        <h3>@T("تغییرات این نسخه:", "What's new in this version:", "ما الجديد في هذا الإصدار:")</h3>
                    </div>
                    <ul class="notes-list">
                        @foreach (var line in latestRelease.ReleaseNotes.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            var cleanLine = line.TrimStart('-', '*', '•', ' ').Trim();
                            if (!string.IsNullOrWhiteSpace(cleanLine))
                            {
                                <li>@cleanLine</li>
                            }
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- ستون اسکن QR و راهنمای نصب -->
        <div class="app-sidebar-col">
            <!-- کارت اسکن QR Code -->
            <div class="card-qr-box">
                <div class="qr-header">
                    <span class="qr-icon">📷</span>
                    <h3>@T("اسکن با دوربین گوشی", "Scan with Phone Camera", "امسح بكاميرا الهاتف")</h3>
                </div>
                <p>@T("دوربین گوشی خود را روبه‌روی بارکد زیر بگیرید تا مستقیماً وارد صفحه دانلود شوید:",
                       "Point your camera at this QR code to open the download page:",
                       "وجّه الكاميرا نحو الرمز الشريطي لفتح صفحة التحميل:")</p>
                <div class="qr-image-wrapper">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(Nav.BaseUri + "download")"
                         alt="QR Code" width="160" height="160" loading="lazy" />
                </div>
                <span class="qr-link-hint">@Nav.BaseUri.TrimEnd('/')/download</span>
            </div>

            <!-- راهنمای نصب فایل نصبی APK -->
            <div class="install-guide-card">
                <h3>@T("راهنمای نصب فایل مستقیم APK", "Direct APK Installation Guide", "دليل تثبيت ملف APK المباشر")</h3>
                <div class="guide-steps">
                    <div class="guide-step">
                        <span class="step-num">۱</span>
                        <div>
                            <strong>@T("دانلود فایل نصبی", "Download APK file", "تحميل ملف APK")</strong>
                            <p>@T("دکمه «دانلود فایل APK» را لمس کنید تا دانلود آغاز شود.",
                                   "Tap 'Download APK' to start the download.",
                                   "المس زر 'تحميل APK' لبدء التنزيل.")</p>
                        </div>
                    </div>
                    <div class="guide-step">
                        <span class="step-num">۲</span>
                        <div>
                            <strong>@T("تأیید نصب از منابع ناشناس", "Allow Unknown Sources", "السماح بالمصادر غير المعروفة")</strong>
                            <p>@T("در صورت نمایش پیام امنیتی، گزینه Settings یا Allow from this source را تأیید کنید.",
                                   "If prompted, tap Settings and allow installation from this source.",
                                   "إذا ظهرت رسالة أمان، اسمح بالتثبيت من هذا المصدر.")</p>
                        </div>
                    </div>
                    <div class="guide-step">
                        <span class="step-num">۳</span>
                        <div>
                            <strong>@T("نصب و ورود به برنامه", "Install & Enjoy", "التثبيت وتسجيل الدخول")</strong>
                            <p>@T("گزینه Install را بزنید و پس از پایان، برنامه به‌نوبت را باز کنید.",
                                   "Tap Install, and after completion, open the Be-Nobat app.",
                                   "المس تثبيت ثم افتح تطبيق به‌نوبت واستمتع بالخدمات.")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

