@page "/platform/settings"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@rendermode InteractiveServer
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>تنظیمات سامانه | به‌نوبت</PageTitle>

<div class="admin-page">
    <div class="page-title">
        <div>
            <h1>تنظیمات سامانه</h1>
            <p>مدیریت نشانی دفتر مرکزی، موقعیت روی نقشه، شماره تماس‌ها، حساب‌های بانکی و تعرفه‌ها</p>
        </div>
        <div class="page-actions">
            <button type="button" class="primary-button" disabled="@isSaving" @onclick="SaveSettings">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                <span>@(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")</span>
            </button>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="alert alert-success">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>تنظیمات با موفقیت ذخیره شد و در کل سیستم (وب و اندروید) اعمال گردید.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            <span>@errorMessage</span>
        </div>
    }

    <div class="settings-grid">
        <!-- ستون اول -->
        <div class="settings-col">
            <!-- بخش ۱: نشانی و موقعیت مکانی -->
            <section class="card">
                <div class="card-header">
                    <h2>
                        <span class="header-icon">📍</span>
                        <span>نشانی و موقعیت مکانی دفتر مرکزی</span>
                    </h2>
                </div>
                <p class="card-desc">
                    این نشانی در صفحه ارتباط با ما و فوتر اپلیکیشن نمایش داده می‌شود و کاربران می‌توانند مستقیماً به آن مسیریابی کنند.
                </p>

                <div class="form-group">
                    <label class="form-label">نشانی کامل دفتر مرکزی</label>
                    <textarea rows="3" class="form-control" @bind="settings.Address" placeholder="اصفهان، خیابان شریعتی، مجتمع تجاری اداری به‌نوبت، طبقه ۴، واحد ۴۰۲"></textarea>
                </div>

                <div class="form-group">
                    <LocationMapPicker @bind-Latitude="settings.Latitude" @bind-Longitude="settings.Longitude" Address="@settings.Address" Height="260px" />
                </div>

                <div class="preview-nav-box">
                    <span class="preview-nav-label">پیش‌نمایش مسیریابی کاربران:</span>
                    <LocationAddressActions Latitude="settings.Latitude" Longitude="settings.Longitude" Address="@settings.Address" Title="دفتر مرکزی به‌نوبت" />
                </div>
            </section>

            <!-- بخش ۲: اطلاعات مالی و حساب‌های بانکی -->
            <section class="card">
                <div class="card-header">
                    <h2>
                        <span class="header-icon">💳</span>
                        <span>اطلاعات بانکی و شماره حساب‌ها</span>
                    </h2>
                </div>
                <p class="card-desc">
                    شماره کارت و شبای رسمی سامانه جهت دریافت مبالغ ثبت کسب‌وکار و افزودن شعب اضافی.
                </p>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">نام بانک</label>
                        <input class="form-control" @bind="settings.BankName" placeholder="بانک ملت" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">نام صاحب حساب</label>
                        <input class="form-control" @bind="settings.AccountHolder" placeholder="سامانه نوبت‌دهی به‌نوبت" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">شماره کارت (۱۶ رقمی)</label>
                    <input class="form-control" dir="ltr" @bind="settings.CardNumber" placeholder="6037-9918-1234-5678" />
                </div>

                <div class="form-group">
                    <label class="form-label">شماره شبا (IBAN)</label>
                    <input class="form-control" dir="ltr" @bind="settings.Iban" placeholder="IR120170000000123456789012" />
                </div>

                <div class="form-group">
                    <label class="form-label">شماره حساب (اختیاری)</label>
                    <input class="form-control" dir="ltr" @bind="settings.AccountNumber" placeholder="123456789" />
                </div>

                <div class="form-group">
                    <label class="form-label">دستورالعمل واریز برای کاربر</label>
                    <textarea rows="2" class="form-control" @bind="settings.PaymentInstructions" placeholder="لطفاً پس از واریز مبلغ، تصویر فیش واریز را در این بخش بارگذاری نمایید."></textarea>
                </div>
            </section>
        </div>

        <!-- ستون دوم -->
        <div class="settings-col">
            <!-- بخش ۳: راه‌های ارتباطی و ساعات کاری -->
            <section class="card">
                <div class="card-header">
                    <h2>
                        <span class="header-icon">📞</span>
                        <span>راه‌های ارتباطی و ساعات کاری</span>
                    </h2>
                </div>
                <p class="card-desc">
                    شماره‌های پاسخگویی به مشتریان و ساعات اداری که در اپلیکیشن و وب‌سایت نمایش داده می‌شوند.
                </p>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">تلفن ثابت ۱</label>
                        <input class="form-control" dir="ltr" @bind="settings.Phone" placeholder="021-91002424" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">تلفن پشتیبانی ۲</label>
                        <input class="form-control" dir="ltr" @bind="settings.SupportPhone" placeholder="021-91002425" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">تلفن همراه و اضطراری</label>
                    <input class="form-control" dir="ltr" @bind="settings.Mobile" placeholder="09134588221" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">ایمیل پشتیبانی</label>
                        <input class="form-control" dir="ltr" @bind="settings.Email" placeholder="support@benobat.ir" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">ایمیل عمومی و سازمانی</label>
                        <input class="form-control" dir="ltr" @bind="settings.InfoEmail" placeholder="info@benobat.ir" />
                    </div>
                </div>

                <div class="section-subtitle">
                    <span>⏰</span>
                    <span>ساعات کاری و پاسخگویی</span>
                </div>

                <div class="form-group">
                    <label class="form-label">شنبه تا چهارشنبه</label>
                    <input class="form-control" @bind="settings.WorkingHoursWeekdays" placeholder="شنبه تا چهارشنبه: ۸:۳۰ الی ۱۸:۰۰" />
                </div>

                <div class="form-group">
                    <label class="form-label">پنج‌شنبه‌ها</label>
                    <input class="form-control" @bind="settings.WorkingHoursThursdays" placeholder="پنج‌شنبه‌ها: ۸:۳۰ الی ۱۳:۰۰" />
                </div>

                <div class="form-group">
                    <label class="form-label">روزهای تعطیل</label>
                    <input class="form-control" @bind="settings.WorkingHoursHolidays" placeholder="روزهای تعطیل: پشتیبانی آنلاین از طریق پیام و تیکت" />
                </div>
            </section>

            <!-- بخش ۴: تعرفه‌ها و شبکه‌های اجتماعی -->
            <section class="card">
                <div class="card-header">
                    <h2>
                        <span class="header-icon">⚙️</span>
                        <span>تعرفه‌ها و شبکه‌های اجتماعی</span>
                    </h2>
                </div>
                <p class="card-desc">
                    تنظیم مبالغ ارتقای کسب‌وکار و آیدی کانال‌های پشتیبانی در شبکه‌های اجتماعی.
                </p>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">تعرفه ثبت کسب‌وکار (تومان)</label>
                        <input type="number" step="10000" class="form-control" dir="ltr" @bind="settings.BaseBusinessPrice" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">تعرفه هر شعبه اضافی (تومان)</label>
                        <input type="number" step="10000" class="form-control" dir="ltr" @bind="settings.ExtraBranchPrice" />
                    </div>
                </div>

                <div class="section-subtitle">
                    <span>🌐</span>
                    <span>شبکه‌های اجتماعی و پیام‌رسان‌ها</span>
                </div>

                <div class="form-group">
                    <label class="form-label">آیدی تلگرام</label>
                    <input class="form-control" dir="ltr" @bind="settings.Telegram" placeholder="benobat_support" />
                </div>

                <div class="form-group">
                    <label class="form-label">صفحه اینستاگرام</label>
                    <input class="form-control" dir="ltr" @bind="settings.Instagram" placeholder="benobat.official" />
                </div>

                <div class="form-group">
                    <label class="form-label">کانال ایتا</label>
                    <input class="form-control" dir="ltr" @bind="settings.Eitaa" placeholder="benobat_support" />
                </div>
            </section>
        </div>
    </div>
</div>

<style>
.admin-page {
    padding: 1.5rem;
    max-width: 1280px;
    margin: 0 auto;
}
.page-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}
.page-actions .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.92rem;
    font-weight: 600;
}
.alert {
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.92rem;
    font-weight: 500;
}
.alert-success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
}
.alert-danger {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
}
.settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2rem;
}
@@media (max-width: 960px) {
    .settings-grid {
        grid-template-columns: 1fr;
    }
}
.settings-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}
.card {
    background: var(--surface, #fff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: box-shadow 0.2s ease;
}
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color, #eef2f6);
}
.card-header h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary, #1e293b);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.header-icon {
    font-size: 1.2rem;
}
.card-desc {
    font-size: 0.82rem;
    color: var(--text-secondary, #64748b);
    margin: 0 0 1.25rem;
    line-height: 1.55;
}
.form-group {
    margin-bottom: 1.1rem;
}
.form-group:last-child {
    margin-bottom: 0;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}
@@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
    }
}
.form-label {
    display: block;
    font-weight: 600;
    font-size: 0.88rem;
    margin-bottom: 0.45rem;
    color: var(--text-primary, #1e293b);
}
.form-control {
    width: 100%;
    padding: 0.7rem 0.95rem;
    border-radius: 10px;
    border: 1.5px solid var(--border-color, #cbd5e1);
    background: var(--surface, #fff);
    color: var(--text-primary, #1e293b);
    font-family: inherit;
    font-size: 0.92rem;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
}
.form-control:focus {
    outline: none;
    border-color: var(--primary, #00796b);
    box-shadow: 0 0 0 3px rgba(0, 121, 107, 0.12);
}
.form-control::placeholder {
    color: var(--text-muted, #94a3b8);
}
textarea.form-control {
    resize: vertical;
    min-height: 80px;
    line-height: 1.55;
}
.section-subtitle {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary, #1e293b);
    margin: 1.25rem 0 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border-color, #e2e8f0);
    display: flex;
    align-items: center;
    gap: 0.45rem;
}
.preview-nav-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--surface-variant, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 10px;
    margin-top: 0.75rem;
}
.preview-nav-label {
    font-size: 0.82rem;
    color: var(--text-secondary, #64748b);
    font-weight: 500;
}
.bottom-bar {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
}
.bottom-bar .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}
</style>

@code {
    private PlatformPricingSettings settings = new();
    private bool isSaving;
    private bool showSuccess;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        settings = await db.GetPlatformPricingAsync();
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        errorMessage = null;
        showSuccess = false;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var current = await db.GetPlatformPricingAsync();

            current.Address = settings.Address?.Trim() ?? "";
            current.Latitude = settings.Latitude;
            current.Longitude = settings.Longitude;

            current.Phone = settings.Phone?.Trim() ?? "";
            current.SupportPhone = settings.SupportPhone?.Trim() ?? "";
            current.Mobile = settings.Mobile?.Trim() ?? "";
            current.Email = settings.Email?.Trim() ?? "";
            current.InfoEmail = settings.InfoEmail?.Trim() ?? "";

            current.WorkingHoursWeekdays = settings.WorkingHoursWeekdays?.Trim() ?? "";
            current.WorkingHoursThursdays = settings.WorkingHoursThursdays?.Trim() ?? "";
            current.WorkingHoursHolidays = settings.WorkingHoursHolidays?.Trim() ?? "";

            current.BankName = settings.BankName?.Trim() ?? "";
            current.AccountHolder = settings.AccountHolder?.Trim() ?? "";
            current.CardNumber = settings.CardNumber?.Trim() ?? "";
            current.Iban = settings.Iban?.Trim() ?? "";
            current.AccountNumber = settings.AccountNumber?.Trim() ?? "";
            current.PaymentInstructions = settings.PaymentInstructions?.Trim() ?? "";

            current.BaseBusinessPrice = settings.BaseBusinessPrice;
            current.ExtraBranchPrice = settings.ExtraBranchPrice;

            current.Telegram = settings.Telegram?.Trim() ?? "";
            current.Instagram = settings.Instagram?.Trim() ?? "";
            current.Eitaa = settings.Eitaa?.Trim() ?? "";

            current.UpdatedAt = DateTimeOffset.UtcNow;
            await db.SaveChangesAsync();

            showSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در ذخیره تنظیمات: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
