@page "/admin/customers"
@page "/admin/team"
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject UserManager<AppUser> UserManager
@inject AppDbContext Db

<PageTitle>@Title | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>@Title</h1><p>@(IsTeam ? "اعضای تیم، وضعیت حساب و سطح دسترسی آن‌ها" : "اطلاعات و سوابق مراجعه‌کنندگان")</p></div><button @onclick="OpenAdd">+ @(IsTeam ? "افزودن عضو" : "افزودن مشتری")</button></div>
@if(Message is not null){<div class="success-notice">@Message</div>}
<article class="admin-panel"><div class="toolbar"><input placeholder="جست‌وجوی نام، ایمیل یا شماره تماس..." @bind="Query" @bind:event="oninput"/><span>@Filtered.Count() نتیجه</span></div>
@if(!Filtered.Any()){<p class="empty-state">موردی پیدا نشد.</p>}
<div class="people-list">@foreach(var person in Filtered){<article class="@(person.IsDisabled ? "disabled-row" : "")"><span class="customer-avatar purple">@Initials(person.User.DisplayName)</span><div><b>@DisplayName(person.User)</b><small>@(person.User.PhoneNumber ?? person.User.Email) · @(person.IsDisabled ? "غیرفعال" : "فعال")</small></div><em>@(IsTeam ? RoleLabel(person.Role) : $"{person.Visits} نوبت")</em><div class="inline-actions">@if(IsTeam){<button @onclick="() => Edit(person)">ویرایش</button>}<button @onclick="() => ToggleUser(person)">@(person.IsDisabled ? "فعال‌سازی" : "غیرفعال")</button></div></article>}</div></article>

@if(ShowForm){<div class="modal-backdrop" @onclick="Close"><EditForm Model="Form" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation><DataAnnotationsValidator/><div><h2>@(Editing is null ? (IsTeam?"عضو تیم جدید":"مشتری جدید") : "ویرایش دسترسی")</h2><button type="button" @onclick="Close">×</button></div>
<label>نام و نام خانوادگی<input required @bind="Form.Name" /></label><label>ایمیل<input type="email" required disabled="@(Editing is not null)" @bind="Form.Email" /></label><label>شماره تماس<input @bind="Form.Phone" /></label>@if(IsTeam){<label>نقش<select @bind="Form.Role"><option value="Staff">پرسنل</option><option value="Manager">مدیر</option><option value="Owner">مالک</option></select></label>}@if(Error is not null){<div class="auth-error">@Error</div>}<button class="primary-button">ذخیره</button></EditForm></div>}

@code {
 private bool IsTeam=>Navigation.Uri.TrimEnd('/').EndsWith("/team",StringComparison.OrdinalIgnoreCase); private string Title=>IsTeam?"اعضای تیم":"مشتریان"; private string Query="";private bool ShowForm;private string? Error,Message;private Person? Editing;private PersonInput Form=new();private List<Person> People=[];
 private IEnumerable<Person> Filtered=>People.Where(x=>IsTeam?x.Role is AppRoles.Owner or AppRoles.Manager or AppRoles.Staff:x.Role==AppRoles.Customer).Where(x=>$"{x.User.DisplayName} {x.User.Email} {x.User.PhoneNumber}".Contains(Query,StringComparison.OrdinalIgnoreCase));
 protected override async Task OnParametersSetAsync()=>await Load();
 private async Task Load(){var users=await UserManager.Users.OrderBy(x=>x.DisplayName).ToListAsync();var visits=await Db.Appointments.GroupBy(x=>x.CustomerId).Select(x=>new{x.Key,Count=x.Count()}).ToDictionaryAsync(x=>x.Key,x=>x.Count);People=[];foreach(var user in users){var roles=await UserManager.GetRolesAsync(user);var role=roles.FirstOrDefault(x=>x!=AppRoles.PlatformAdmin)??"";People.Add(new(user,role,visits.GetValueOrDefault(user.Id),user.LockoutEnd>DateTimeOffset.UtcNow));}}
 private void OpenAdd(){Editing=null;Form=new(){Role=IsTeam?AppRoles.Staff:AppRoles.Customer};Error=Message=null;ShowForm=true;}
 private void Edit(Person p){Editing=p;Form=new(){Name=p.User.DisplayName,Email=p.User.Email??"",Phone=p.User.PhoneNumber??"",Role=p.Role};Error=Message=null;ShowForm=true;}
 private async Task Save(){Error=null;if(Editing is null){var user=new AppUser{UserName=Form.Email.Trim(),Email=Form.Email.Trim(),EmailConfirmed=true,DisplayName=Form.Name.Trim(),PhoneNumber=Form.Phone.Trim()};var password=$"Bn!{Guid.NewGuid():N}"[..12];var result=await UserManager.CreateAsync(user,password);if(!result.Succeeded){Error=string.Join("، ",result.Errors.Select(x=>x.Description));return;}await UserManager.AddToRoleAsync(user,IsTeam?Form.Role:AppRoles.Customer);Message=$"حساب ساخته شد. رمز موقت: {password}";}else{var user=await UserManager.FindByIdAsync(Editing.User.Id.ToString());if(user is null)return;user.DisplayName=Form.Name.Trim();user.PhoneNumber=Form.Phone.Trim();await UserManager.UpdateAsync(user);var current=await UserManager.GetRolesAsync(user);await UserManager.RemoveFromRolesAsync(user,current.Where(x=>x is AppRoles.Owner or AppRoles.Manager or AppRoles.Staff));await UserManager.AddToRoleAsync(user,Form.Role);Message="تغییرات عضو تیم ذخیره شد.";}Close();await Load();}
 private async Task ToggleUser(Person p){var user=await UserManager.FindByIdAsync(p.User.Id.ToString());if(user is null)return;user.LockoutEnabled=true;user.LockoutEnd=p.IsDisabled?null:DateTimeOffset.MaxValue;await UserManager.UpdateAsync(user);await Load();}
 private void Close(){ShowForm=false;Editing=null;Error=null;}
 private static string DisplayName(AppUser u)=>string.IsNullOrWhiteSpace(u.DisplayName)?u.Email??"کاربر":u.DisplayName; private static string Initials(string? n)=>string.IsNullOrWhiteSpace(n)?"؟":n[..Math.Min(2,n.Length)];private static string RoleLabel(string r)=>r switch{AppRoles.Owner=>"مالک",AppRoles.Manager=>"مدیر",AppRoles.Staff=>"پرسنل",_=>r};
 private sealed record Person(AppUser User,string Role,int Visits,bool IsDisabled);private sealed class PersonInput{public string Name{get;set;}="";public string Email{get;set;}="";public string Phone{get;set;}="";public string Role{get;set;}=AppRoles.Staff;}
}
