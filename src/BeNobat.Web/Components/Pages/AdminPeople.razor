@* [fix] مسیرهای /admin/team و /admin/customers در سایدبار و داشبورد لینک شده بودند
   ولی این کامپوننت فقط روی /admin/people/{Mode} ثبت شده بود؛ بنابراین کلیک روی
   «اعضای تیم» و «مشتریان» به صفحه‌ی «پیدا نشد» می‌رسید و بین این دو حالت سوییچ
   نمی‌شد. حالا هر سه مسیر به همین کامپوننت می‌رسند. *@
@page "/admin/team"
@page "/admin/customers"
@page "/admin/people/{Mode}"
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject UserManager<AppUser> UserManager
@inject AppDbContext Db
@inject AdminAccessScope Access
@implements IDisposable

<PageTitle>@Title | به‌نوبت</PageTitle>

<div class="page-title">
    <div><h1>@Title</h1><p>@(IsTeam ? "اعضای تیم، وضعیت حساب و سطح دسترسی آن‌ها" : "اطلاعات، سوابق و امتیاز مراجعه‌کنندگان")</p></div>
    <button type="button" class="action-primary" @onclick="OpenAdd">+ @(IsTeam ? "افزودن عضو" : "افزودن مشتری")</button>
</div>

@* [fix] سوییچ بین دو فهرست حالا داخل خود صفحه هم هست و تب فعال مشخص است. *@
<div class="tabs">
    <NavLink href="/admin/team" Match="NavLinkMatch.All">اعضای تیم</NavLink>
    <NavLink href="/admin/customers" Match="NavLinkMatch.All">مشتریان</NavLink>
</div>

@if (Message is not null) { <div class="success-notice">@Message</div> }
@if (Error is not null && !ShowForm) { <div class="auth-error" role="alert">@Error</div> }

<article class="admin-panel">
    <div class="toolbar">
        <input aria-label="جست‌وجوی کاربران" placeholder="جست‌وجوی نام، ایمیل یا شماره تماس..." @bind="Query" @bind:event="oninput" />
        <select aria-label="وضعیت حساب" @bind="StatusFilter"><option value="all">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
        <span>@Filtered.Count() نتیجه</span>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ClearFilters">پاک کردن فیلترها</button> }
    </div>
    @if (HasEntityFilter) { <p class="filter-summary">@(IsTeam ? "اعضای تیم مرتبط با مورد انتخاب‌شده" : "مشتریان مرتبط با مورد انتخاب‌شده")</p> }
    @if (IsTeam && SelectedResource is { UserId: null } resourceWithoutUser)
    {
        <p class="empty-state">منبع «@resourceWithoutUser.Name» هنوز به حساب عضو تیم متصل نشده است. <a class="entity-link" href="@($"/admin/branches?branchId={resourceWithoutUser.BranchId}&resourceId={resourceWithoutUser.Id}")">مدیریت منبع در شعبه</a></p>
    }
    else if (!Filtered.Any()) { <p class="empty-state">موردی با این فیلترها پیدا نشد.</p> }

    <div class="people-list">
        @foreach (var person in Filtered)
        {
            <article class="@(person.IsDisabled ? "disabled-row" : "")">
                @if (UserAvatar.Has(person.User))
                {
                    <img class="customer-avatar" src="@UserAvatar.Url(person.User)" alt="" />
                }
                else
                {
                    <span class="customer-avatar purple">@UserAvatar.Initials(person.User.DisplayName)</span>
                }
                <div>
                    <b>@DisplayNameOf(person.User)</b>
                    <small class="person-contact"><span>✉ @person.User.Email</span><span>☎ @(string.IsNullOrWhiteSpace(person.User.PhoneNumber) ? "ثبت نشده" : person.User.PhoneNumber)</span><em class="status @(person.IsDisabled ? "cancelled" : "confirmed")">@(person.IsDisabled ? "غیرفعال" : "فعال")</em></small>
                </div>
                <em class="person-metrics">
                    @if (IsTeam)
                    {
                        @RoleLabel(person.Role)
                    }
                    else
                    {
                        @if (person.Visits > 0)
                        {
                            <a class="entity-link person-metric-link" href="@($"/admin/calendar?range=all&customerId={person.User.Id}")" title="مشاهده همه نوبت‌های مشتری" aria-label="@($"مشاهده {person.Visits} نوبت {DisplayNameOf(person.User)}")">@person.Visits نوبت</a>
                        }
                        else
                        {
                            <span>۰ نوبت</span>
                        }
                        @if (person.Rating is not null)
                        {
                            <span aria-hidden="true"> · </span><a class="entity-link person-metric-link" href="@($"/admin/reviews?tab=outgoing&customerId={person.User.Id}&evaluationStatus=reviewed")" title="مشاهده ارزیابی‌های مشتری" aria-label="@($"مشاهده ارزیابی‌های {DisplayNameOf(person.User)} با میانگین امتیاز {person.Rating.Value:0.0}")">★ @person.Rating.Value.ToString("0.0")</a>
                        }
                    }
                </em>
                <div class="inline-actions">
                    <button type="button" class="action-secondary" @onclick="() => Edit(person)">ویرایش</button>
                    <button type="button" class="@(person.IsDisabled ? "action-success" : "action-danger")" @onclick="() => ToggleUser(person)">@(person.IsDisabled ? "فعال‌سازی" : "غیرفعال")</button>
                </div>
            </article>
        }
    </div>
</article>

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="admin-person" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation>
            <DataAnnotationsValidator />
            <div>
                <h2>@(Editing is null ? (IsTeam ? "عضو تیم جدید" : "مشتری جدید") : "ویرایش کاربر")</h2>
                <button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button>
            </div>
            <label>نام و نام خانوادگی<input required @bind="Form.Name" /></label>
            <label>ایمیل<input type="email" required disabled="@(Editing is not null)" @bind="Form.Email" /></label>
            <label>شماره تماس<input inputmode="tel" maxlength="14" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" @bind="Form.Phone" /></label>
            @if (IsTeam && Editing is null)
            {
                <label>شعبه
                    <select required @bind="Form.BranchId">
                        <option value="">— انتخاب شعبه —</option>
                        @foreach (var branch in ManagedBranches) { <option value="@branch.Id">@branch.Business.Name · @branch.Name</option> }
                    </select>
                </label>
                <label>نقش در شعبه
                    <select @bind="Form.Role">
                        <option value="@AppRoles.Staff">پرسنل</option>
                        <option value="@AppRoles.Manager">مدیر</option>
                        <option value="@AppRoles.Owner">مالک</option>
                    </select>
                </label>
                @if (ManagedBranches.Count == 0) { <small>ابتدا یک شعبه تعریف کنید تا بتوانید عضو اضافه کنید.</small> }
            }
            else if (IsTeam)
            {
                <small>نقش و شعبه‌ی عضو را از صفحه‌ی «شعب و منابع ← اعضا» تغییر دهید.</small>
            }
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره</button>
        </EditForm>
    </div>
}

@code {
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? FilterQuery { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public Guid? FilterUserId { get; set; }
    [SupplyParameterFromQuery(Name = "customerId")] public Guid? FilterCustomerId { get; set; }
    [SupplyParameterFromQuery(Name = "resourceId")] public Guid? FilterResourceId { get; set; }
    [SupplyParameterFromQuery(Name = "branchId")] public Guid? FilterBranchId { get; set; }
    [SupplyParameterFromQuery(Name = "businessId")] public Guid? FilterBusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? FilterStatus { get; set; }

    private string Query = "";
    private string StatusFilter = "all";
    private bool ShowForm;
    private string? Error;
    private string? Message;
    private Person? Editing;
    private PersonInput Form = new();
    private List<Person> People = [];
    private List<Branch> ManagedBranches = [];
    private List<Resource> VisibleResources = [];
    private List<PersonScope> TeamScopes = [];
    private List<PersonScope> CustomerScopes = [];
    private bool IsPlatformAdmin;
    private bool Disposed;

    // [fix] قبلاً IsTeam از روی کل URL و با EndsWith("/team") حساب می‌شد؛ با
    // query string یا اسلش انتهایی اشتباه می‌شد. حالا فقط مسیر نسبی را می‌بینیم.
    private bool IsTeam;

    private string Title => IsTeam ? "اعضای تیم" : "مشتریان";

    private static readonly string[] TeamRoles = [AppRoles.Owner, AppRoles.Manager, AppRoles.Staff];

    private Resource? SelectedResource => VisibleResources.FirstOrDefault(r => r.Id == FilterResourceId);
    private bool HasEntityFilter => FilterUserId is not null || FilterCustomerId is not null || FilterResourceId is not null || FilterBranchId is not null || FilterBusinessId is not null;
    private bool HasFilters => HasEntityFilter || Query.Length > 0 || StatusFilter != "all";
    private IEnumerable<PersonScope> PersonScopes => IsTeam ? TeamScopes : CustomerScopes;
    private IEnumerable<Person> Filtered => People
        .Where(x => IsTeam ? TeamRoles.Any(x.Roles.Contains) : x.Roles.Contains(AppRoles.Customer))
        .Where(x => IsPlatformAdmin || PersonScopes.Any(s => s.UserId == x.User.Id))
        .Where(x => FilterUserId is null || x.User.Id == FilterUserId)
        .Where(x => FilterCustomerId is null || x.User.Id == FilterCustomerId)
        .Where(x => (FilterResourceId is null && FilterBranchId is null && FilterBusinessId is null) ||
            PersonScopes.Any(s => s.UserId == x.User.Id &&
                (FilterResourceId is null || s.ResourceId == FilterResourceId) &&
                (FilterBranchId is null || s.BranchId == FilterBranchId) &&
                (FilterBusinessId is null || s.BusinessId == FilterBusinessId)))
        .Where(x => StatusFilter == "all" || x.IsDisabled == (StatusFilter == "disabled"))
        .Where(x => $"{x.User.DisplayName} {x.User.Email} {x.User.PhoneNumber}"
            .Contains(Query, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        IsTeam = IsTeamLocation(Navigation.Uri);
        Navigation.LocationChanged += LocationChanged;
        await Load();
    }

    protected override void OnParametersSet()
    {
        ApplyLocationFilters(Navigation.Uri);
        var nextMode = IsTeamLocation(Navigation.Uri);
        if (nextMode != IsTeam) Close();
        IsTeam = nextMode;
    }

    // Both routes have identical parameters, so the router may reuse this component
    // without calling OnParametersSet. Navigation itself must switch the visible tab.
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var path = new Uri(args.Location).AbsolutePath.TrimEnd('/');
        if (!path.Equals("/admin/team", StringComparison.OrdinalIgnoreCase) &&
            !path.Equals("/admin/customers", StringComparison.OrdinalIgnoreCase) &&
            !path.StartsWith("/admin/people/", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(() =>
        {
            if (Disposed || args.Location != Navigation.Uri) return;
            var nextMode = IsTeamLocation(args.Location);
            if (nextMode != IsTeam) { Close(); Message = null; }
            IsTeam = nextMode;
            ApplyLocationFilters(args.Location);
            StateHasChanged();
        });
    }

    private void ApplyLocationFilters(string location)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(location).Query);
        FilterQuery = query.GetValueOrDefault("q").ToString();
        FilterStatus = query.GetValueOrDefault("status").ToString();
        FilterUserId = QueryId("userId");
        FilterCustomerId = QueryId("customerId");
        FilterResourceId = QueryId("resourceId");
        FilterBranchId = QueryId("branchId");
        FilterBusinessId = QueryId("businessId");
        Query = FilterQuery.Trim();
        StatusFilter = FilterStatus is "active" or "disabled" ? FilterStatus : "all";

        Guid? QueryId(string key) => Guid.TryParse(query.GetValueOrDefault(key).ToString(), out var id) ? id : null;
    }

    private bool IsTeamLocation(string location)
    {
        var path = new Uri(location).AbsolutePath.TrimEnd('/');
        return !path.EndsWith("/customers", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Disposed = true;
        Navigation.LocationChanged -= LocationChanged;
    }

    private void ClearFilters()
    {
        Query = "";
        StatusFilter = "all";
        FilterUserId = FilterCustomerId = FilterResourceId = FilterBranchId = FilterBusinessId = null;
        Navigation.NavigateTo(IsTeam ? "/admin/team" : "/admin/customers");
    }

    private async Task Load()
    {
        IsPlatformAdmin = await Access.IsPlatformAdminAsync();
        ManagedBranches = await (await Access.ManagedBranchesAsync()).Include(x => x.Business).OrderBy(x => x.Name).ToListAsync();
        var scopeBranches = await (await Access.BranchesAsync()).AsNoTracking().Include(x => x.Memberships).Include(x => x.Resources).ToListAsync();
        VisibleResources = scopeBranches.SelectMany(b => b.Resources).ToList();
        TeamScopes = scopeBranches.SelectMany(b => b.Memberships.Select(m => new PersonScope(m.UserId, b.Id, b.BusinessId, null)))
            .Concat(scopeBranches.SelectMany(b => b.Resources.Where(r => r.UserId is not null).Select(r => new PersonScope(r.UserId!.Value, b.Id, b.BusinessId, r.Id)))).ToList();
        var appointments = await Access.AppointmentsAsync();
        CustomerScopes = await appointments.Select(a => new PersonScope(a.CustomerId, a.BranchId, a.Branch.BusinessId, a.ResourceId)).Distinct().ToListAsync();
        var allowedUserIds = TeamScopes.Concat(CustomerScopes).Select(x => x.UserId).Distinct().ToList();
        var usersQuery = UserManager.Users.AsQueryable();
        if (!IsPlatformAdmin) usersQuery = usersQuery.Where(x => allowedUserIds.Contains(x.Id));
        var users = await usersQuery.OrderBy(x => x.DisplayName).ToListAsync();

        var visits = await appointments
            .GroupBy(x => x.CustomerId)
            .Select(x => new { x.Key, Count = x.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);

        // [feature] میانگین امتیازی که مجموعه به هر سرویس‌گیرنده داده است.
        var customerReviews = await Access.CustomerReviewsAsync();
        var ratings = await customerReviews
            .GroupBy(x => x.CustomerId)
            .Select(x => new { x.Key, Average = x.Average(r => (double)r.Rating) })
            .ToDictionaryAsync(x => x.Key, x => x.Average);

        People = [];
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            People.Add(new Person(
                user,
                roles,
                visits.GetValueOrDefault(user.Id),
                user.LockoutEnd > DateTimeOffset.UtcNow,
                ratings.TryGetValue(user.Id, out var average) ? average : null));
        }
    }

    private void OpenAdd()
    {
        Editing = null;
        Form = new PersonInput
        {
            Role = IsTeam ? AppRoles.Staff : AppRoles.Customer,
            BranchId = ManagedBranches.FirstOrDefault(b => b.Id == FilterBranchId)?.Id,
        };
        Error = Message = null;
        ShowForm = true;
    }

    private void Edit(Person person)
    {
        Editing = person;
        Form = new PersonInput
        {
            Name = person.User.DisplayName,
            Email = person.User.Email ?? "",
            Phone = person.User.PhoneNumber ?? "",
            Role = TeamRoles.Contains(person.Role) ? person.Role : AppRoles.Staff,
        };

        Error = Message = null;
        ShowForm = true;
    }

    private async Task Save()
    {
        Error = null;
        if (!UserInputValidation.TryNormalizeIranianMobile(Form.Phone, out var phone))
        {
            Error = "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
            return;
        }

        if (Editing is null)
        {
            var email = Form.Email.Trim();

            if (IsTeam)
            {
                if (Form.BranchId is not Guid selectedBranch || ManagedBranches.All(b => b.Id != selectedBranch))
                {
                    Error = "یک شعبه‌ی معتبر انتخاب کنید.";
                    return;
                }
                if (!await Access.CanAssignRoleAsync(Form.Role, selectedBranch))
                {
                    Error = Form.Role == AppRoles.Owner ? "نقش «مالک» را فقط مالک کسب‌وکار یا مدیر سامانه می‌تواند بدهد." : "اجازه‌ی واگذاری این نقش را ندارید.";
                    return;
                }
            }

            // [fix] پیش از ساخت حساب، تکراری بودن ایمیل را با پیام فارسی اعلام می‌کنیم.
            if (await UserManager.FindByEmailAsync(email) is not null)
            {
                Error = "کاربری با این ایمیل از قبل وجود دارد.";
                return;
            }

            var user = new AppUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true,
                DisplayName = Form.Name.Trim(),
                PhoneNumber = phone,
            };

            var password = $"Bn1!{Guid.NewGuid():N}"[..12];
            var result = await UserManager.CreateAsync(user, password);
            if (!result.Succeeded)
            {
                Error = string.Join("، ", result.Errors.Select(x => x.Description).Distinct(StringComparer.Ordinal));
                return;
            }

            if (IsTeam)
            {
                Db.BranchMemberships.Add(new BranchMembership { BranchId = Form.BranchId!.Value, UserId = user.Id, Role = Form.Role });
                await Db.SaveChangesAsync();
                await TeamRoleSync.SyncAsync(UserManager, Db, user);
            }
            else
            {
                await UserManager.AddToRoleAsync(user, AppRoles.Customer);
            }
            Message = $"حساب ساخته شد. رمز موقت: «{password}» — فقط همین یک‌بار نمایش داده می‌شود؛ آن را امن به کاربر بدهید.";
        }
        else
        {
            var user = await UserManager.FindByIdAsync(Editing.User.Id.ToString());
            if (user is null) return;
            if (await IsProtectedAsync(user)) { Error = "اجازه‌ی ویرایش این کاربر را ندارید."; return; }

            user.DisplayName = Form.Name.Trim();
            user.PhoneNumber = phone;

            var updateResult = await UserManager.UpdateAsync(user);
            if (!updateResult.Succeeded)
            {
                Error = string.Join("، ", updateResult.Errors.Select(x => x.Description).Distinct(StringComparer.Ordinal));
                return;
            }

            if (IsTeam)
            {
                Message = "اطلاعات عضو تیم ذخیره شد.";
            }
            else
            {
                Message = "اطلاعات مشتری ذخیره شد.";
            }
        }

        Close();
        await Load();
    }

    private async Task ToggleUser(Person person)
    {
        var user = await UserManager.FindByIdAsync(person.User.Id.ToString());
        if (user is null) return;
        if (user.Id == await Access.UserIdAsync()) { Message = null; Error = "حساب خودتان را نمی‌توانید غیرفعال کنید."; return; }
        if (await IsProtectedAsync(user)) { Message = null; Error = "اجازه‌ی تغییر وضعیت این کاربر را ندارید."; return; }
        Error = null;

        user.LockoutEnabled = true;
        user.LockoutEnd = person.IsDisabled ? null : DateTimeOffset.MaxValue;
        await UserManager.UpdateAsync(user);
        await Load();
    }

    /// <summary>مدیر سامانه و مالکانی که کاربر جاری مالکشان نیست، توسط مدیران شعبه قابل دستکاری نیستند.</summary>
    private async Task<bool> IsProtectedAsync(AppUser target)
    {
        if (await Access.IsPlatformAdminAsync()) return false;
        if (await UserManager.IsInRoleAsync(target, AppRoles.PlatformAdmin)) return true;
        var branchIds = ManagedBranches.Select(b => b.Id).ToList();
        return await Access.TargetOutranksMeAsync(target.Id, branchIds);
    }

    private void Close()
    {
        ShowForm = false;
        Editing = null;
        Error = null;
    }

    private static string DisplayNameOf(AppUser user) =>
        string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? "کاربر" : user.DisplayName;

    private static string RoleLabel(string role) => role switch
    {
        AppRoles.Owner => "مالک",
        AppRoles.Manager => "مدیر",
        AppRoles.Staff => "پرسنل",
        AppRoles.Customer => "مشتری",
        _ => role,
    };

    private sealed record Person(AppUser User, IList<string> Roles, int Visits, bool IsDisabled, double? Rating)
    {
        public string Role => TeamRoles.FirstOrDefault(Roles.Contains) ?? (Roles.Contains(AppRoles.Customer) ? AppRoles.Customer : "");
    }
    private sealed record PersonScope(Guid UserId, Guid BranchId, Guid BusinessId, Guid? ResourceId);

    private sealed class PersonInput
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Role { get; set; } = AppRoles.Staff;
        public Guid? BranchId { get; set; }
    }
}
