@page "/platform/access"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>دسترسی‌های سامانه | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>کاربران و دسترسی‌ها</h1><p>نقش سراسری، اطلاعات تماس و وضعیت حساب کاربران را مدیریت کنید.</p></div></div>
@if (Message is not null) { <div class="success-notice">@Message</div> }
@if (Error is not null) { <div class="auth-error">@Error</div> }
<article class="admin-panel">
    <div class="toolbar filter-toolbar">
        <input aria-label="جست‌وجوی کاربران" placeholder="جست‌وجوی نام، ایمیل، موبایل یا نقش..." @bind="Query" @bind:event="oninput" />
        <select aria-label="فیلتر وضعیت حساب" @bind="StatusFilter"><option value="">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
        <select aria-label="فیلتر نقش کاربر" @bind="RoleFilter"><option value="">همه نقش‌ها</option>@foreach (var role in AppRoles.All) { <option value="@role">@RoleLabel(role)</option> }</select>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ResetFilters">پاک‌کردن فیلترها</button> }
        <span>@Filtered.Count() کاربر</span>
    </div>
    @if (!Filtered.Any()) { <p class="empty-state">کاربری با این مشخصات پیدا نشد.</p> }
    <div class="access-list">
        @foreach (var item in Filtered)
        {
            <article @key="item.User.Id" class="@(item.Disabled ? "disabled-row" : "")">
                <span class="customer-avatar purple">@UserAvatar.Initials(item.User.DisplayName)</span>
                <div class="access-user-details"><b>@DisplayName(item.User)</b><small>✉ @item.User.Email</small><small>☎ @(string.IsNullOrWhiteSpace(item.User.PhoneNumber) ? "شماره موبایل ثبت نشده" : item.User.PhoneNumber)</small></div>
                <label>دسترسی<select @bind="item.SelectedRole">@foreach (var role in AppRoles.All) { <option value="@role">@RoleLabel(role)</option> }</select></label>
                <div class="access-actions"><button type="button" class="action-primary" @onclick="() => SaveRole(item)" disabled="@item.Saving">ذخیره نقش</button><button type="button" class="@(item.Disabled ? "action-success" : "action-danger")" @onclick="() => ToggleAccess(item)">@(item.Disabled ? "فعال‌سازی" : "غیرفعال‌سازی")</button><button type="button" class="action-warning" @onclick="() => ResetPassword(item)" disabled="@item.Saving">ریست رمز</button></div>
                <em class="status @(item.Disabled ? "cancelled" : "confirmed")">@(item.Disabled ? "غیرفعال" : "فعال")</em>
            </article>
        }
    </div>
</article>

@code {
    private List<UserAccess> Items = [];
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public Guid? UserIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleParam { get; set; }
    private string Query = "";
    private Guid? SelectedUserId;
    private string StatusFilter = "";
    private string RoleFilter = "";
    private string? Message;
    private string? Error;
    private bool HasFilters => !string.IsNullOrWhiteSpace(Query) || SelectedUserId is not null || StatusFilter != "" || RoleFilter != "";
    private IEnumerable<UserAccess> Filtered => Items.Where(x =>
        (SelectedUserId is null || x.User.Id == SelectedUserId) &&
        (StatusFilter != "active" || !x.Disabled) &&
        (StatusFilter != "disabled" || x.Disabled) &&
        (RoleFilter == "" || x.Role == RoleFilter) &&
        $"{x.User.DisplayName} {x.User.Email} {x.User.PhoneNumber} {x.Role} {RoleLabel(x.Role)}".Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();
    protected override void OnParametersSet()
    {
        Query = QueryParam?.Trim() ?? "";
        SelectedUserId = UserIdParam;
        StatusFilter = StatusParam is "active" or "disabled" ? StatusParam : "";
        RoleFilter = AppRoles.All.Contains(RoleParam ?? "") ? RoleParam! : "";
    }
    private void ResetFilters()
    {
        Query = StatusFilter = RoleFilter = "";
        SelectedUserId = null;
        Navigation.NavigateTo("/platform/access");
    }
    private async Task Load()
    {
        Items = [];
        foreach (var user in await UserManager.Users.OrderBy(x => x.DisplayName).ToListAsync())
        {
            var roles = await UserManager.GetRolesAsync(user);
            var role = AppRoles.All.FirstOrDefault(roles.Contains) ?? AppRoles.Customer;
            Items.Add(new UserAccess(user, role, user.LockoutEnd > DateTimeOffset.UtcNow));
        }
    }

    private async Task<bool> IsSelfAsync(UserAccess item)
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return UserContext.IdOf(principal) == item.User.Id;
    }

    private async Task SaveRole(UserAccess item)
    {
        if (!AppRoles.All.Contains(item.SelectedRole)) return;
        if (await IsSelfAsync(item) && item.SelectedRole != AppRoles.PlatformAdmin)
        {
            Message = null; Error = "نقش مدیر کل را برای حساب خودتان نمی‌توانید کم کنید؛ از مدیر دیگری بخواهید.";
            return;
        }
        item.Saving = true;
        Message = Error = null;
        var user = await UserManager.FindByIdAsync(item.User.Id.ToString());
        if (user is null) { Error = "کاربر پیدا نشد."; item.Saving = false; return; }
        var current = await UserManager.GetRolesAsync(user);
        var remove = current.Where(AppRoles.All.Contains).Where(x => x != item.SelectedRole).ToArray();
        var addResult = await UserManager.IsInRoleAsync(user, item.SelectedRole) ? IdentityResult.Success : await UserManager.AddToRoleAsync(user, item.SelectedRole);
        var removeResult = addResult.Succeeded && remove.Length > 0 ? await UserManager.RemoveFromRolesAsync(user, remove) : IdentityResult.Success;
        if (!removeResult.Succeeded || !addResult.Succeeded)
            Error = string.Join("، ", removeResult.Errors.Concat(addResult.Errors).Select(x => x.Description));
        else
        {
            await UserManager.UpdateSecurityStampAsync(user);
            Message = $"دسترسی {DisplayName(user)} روی «{RoleLabel(item.SelectedRole)}» ذخیره شد.";
        }
        await Load();
    }

    private async Task ToggleAccess(UserAccess item)
    {
        if (await IsSelfAsync(item)) { Message = null; Error = "حساب خودتان را نمی‌توانید غیرفعال کنید."; return; }
        var user = await UserManager.FindByIdAsync(item.User.Id.ToString());
        if (user is null) return;
        user.LockoutEnabled = true;
        user.LockoutEnd = item.Disabled ? null : DateTimeOffset.MaxValue;
        var result = await UserManager.UpdateAsync(user);
        Message = result.Succeeded ? "وضعیت دسترسی کاربر تغییر کرد." : null;
        Error = result.Succeeded ? null : string.Join("، ", result.Errors.Select(x => x.Description));
        await Load();
    }

    private async Task ResetPassword(UserAccess item)
    {
        item.Saving = true;
        Message = Error = null;
        var user = await UserManager.FindByIdAsync(item.User.Id.ToString());
        if (user is null) { Error = "کاربر پیدا نشد."; item.Saving = false; return; }
        var temporary = NewTemporaryPassword();
        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, temporary);
        if (result.Succeeded)
        {
            await UserManager.UpdateSecurityStampAsync(user);
            Message = $"رمز موقت {DisplayName(user)}: «{temporary}» — فقط همین یک‌بار نمایش داده می‌شود؛ آن را امن به کاربر بدهید و بخواهید پس از ورود تغییرش دهد.";
        }
        else
            Error = string.Join("، ", result.Errors.Select(x => x.Description));
        await Load();
    }

    private static string DisplayName(AppUser user) => string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? "کاربر" : user.DisplayName;
    private static string NewTemporaryPassword()
    {
        const string letters = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var chars = new char[12];
        for (var i = 0; i < chars.Length; i++) chars[i] = letters[System.Security.Cryptography.RandomNumberGenerator.GetInt32(letters.Length)];
        return "Bn" + new string(chars) + "@7";
    }
    private static string RoleLabel(string role) => role switch { AppRoles.PlatformAdmin => "مدیر کل سامانه", AppRoles.Owner => "مدیر کسب‌وکار", AppRoles.Manager => "مدیر شعبه", AppRoles.Staff => "کارمند", _ => "مشتری" };
    private sealed class UserAccess(AppUser user, string role, bool disabled)
    {
        public AppUser User { get; } = user;
        public string Role { get; } = role;
        public string SelectedRole { get; set; } = role;
        public bool Disabled { get; } = disabled;
        public bool Saving { get; set; }
    }
}
