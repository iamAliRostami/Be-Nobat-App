@page "/platform/access"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@inject UserManager<AppUser> UserManager

<PageTitle>دسترسی‌های سامانه | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>کاربران و دسترسی‌ها</h1><p>نقش سراسری کاربران را مشاهده و تغییر دهید.</p></div></div>
@if(Message is not null){<div class="success-notice">@Message</div>}
<article class="admin-panel"><div class="toolbar"><input placeholder="جست‌وجوی کاربر..." @bind="Query" @bind:event="oninput"/><span>@Filtered.Count() کاربر</span></div><div class="access-list">@foreach(var item in Filtered){<article><div><b>@(item.User.DisplayName??item.User.Email)</b><small>@item.User.Email</small></div><select value="@item.Role" @onchange="e=>ChangeRole(item,e.Value?.ToString())">@foreach(var role in AppRoles.All){<option value="@role">@RoleLabel(role)</option>}</select><em class="status @(item.Disabled?"cancelled":"confirmed")">@(item.Disabled?"غیرفعال":"فعال")</em></article>}</div></article>
@code{private List<UserAccess> Items=[];private string Query="";private string? Message;private IEnumerable<UserAccess> Filtered=>Items.Where(x=>$"{x.User.DisplayName} {x.User.Email}".Contains(Query,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){Items=[];foreach(var user in await UserManager.Users.OrderBy(x=>x.DisplayName).ToListAsync()){var roles=await UserManager.GetRolesAsync(user);Items.Add(new(user,roles.FirstOrDefault()??AppRoles.Customer,user.LockoutEnd>DateTimeOffset.UtcNow));}}private async Task ChangeRole(UserAccess item,string? role){if(role is null||!AppRoles.All.Contains(role))return;var user=await UserManager.FindByIdAsync(item.User.Id.ToString());if(user is null)return;var current=await UserManager.GetRolesAsync(user);if(current.Count>0)await UserManager.RemoveFromRolesAsync(user,current);await UserManager.AddToRoleAsync(user,role);Message="سطح دسترسی ذخیره شد.";await Load();}private static string RoleLabel(string x)=>x switch{AppRoles.PlatformAdmin=>"مدیر کل سامانه",AppRoles.Owner=>"مالک کسب‌وکار",AppRoles.Manager=>"مدیر شعبه",AppRoles.Staff=>"پرسنل",_=>"مشتری"};private sealed record UserAccess(AppUser User,string Role,bool Disabled);}
