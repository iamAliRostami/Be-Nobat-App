@page "/platform/access"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject AdminAccessScope Access
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>دسترسی‌های سامانه | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>کاربران و دسترسی‌ها</h1><p>نقش سراسری، اطلاعات تماس و وضعیت حساب کاربران را مدیریت کنید.</p></div></div>
@if (Message is not null) { <div class="success-notice">@Message</div> }
@if (Error is not null) { <div class="auth-error">@Error</div> }
<article class="admin-panel">
    <div class="toolbar filter-toolbar">
        <input aria-label="جست‌وجوی کاربران" placeholder="جست‌وجوی نام، ایمیل، موبایل یا نقش..." @bind="Query" @bind:event="oninput" />
        <select aria-label="فیلتر وضعیت حساب" @bind="StatusFilter"><option value="">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
        <select aria-label="فیلتر نقش کاربر" @bind="RoleFilter"><option value="">همه نقش‌ها</option>@foreach (var role in AppRoles.All) { <option value="@role">@RoleLabel(role)</option> }</select>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ResetFilters">پاک‌کردن فیلترها</button> }
        <span>@Filtered.Count() کاربر</span>
    </div>
    @if (!Filtered.Any()) { <p class="empty-state">کاربری با این مشخصات پیدا نشد.</p> }
    <div class="access-list">
        @foreach (var item in Filtered)
        {
            <article @key="item.User.Id" class="@(item.Disabled ? "disabled-row" : "")">
                <span class="customer-avatar purple" data-i18n-skip>@UserAvatar.Initials(item.User.DisplayName)</span>
                <div class="access-user-details"><b data-i18n-skip>@DisplayName(item.User)</b><small>✉ @item.User.Email</small><small>☎ @(string.IsNullOrWhiteSpace(item.User.PhoneNumber) ? "شماره موبایل ثبت نشده" : item.User.PhoneNumber)</small><small>@($"نقش‌ها: {string.Join("، ", item.Roles.Select(RoleLabel))}")</small></div>
                <label>دسترسی سراسری<select @bind="item.SelectedRole"><option value="@AppRoles.Customer">@RoleLabel(AppRoles.Customer)</option><option value="@AppRoles.PlatformAdmin">@RoleLabel(AppRoles.PlatformAdmin)</option></select></label>
                <div class="access-actions"><button type="button" class="action-primary" @onclick="() => SaveRole(item)" disabled="@Saving">ذخیره نقش</button><button type="button" class="@(item.Disabled ? "action-success" : "action-danger")" @onclick="() => ToggleAccess(item)" disabled="@Saving">@(item.Disabled ? "فعال‌سازی" : "غیرفعال‌سازی")</button><button type="button" class="action-warning" @onclick="() => ResetPassword(item)" disabled="@Saving">ریست رمز</button></div>
                <em class="status @(item.Disabled ? "cancelled" : "confirmed")">@(item.Disabled ? "غیرفعال" : "فعال")</em>
            </article>
        }
    </div>
</article>

@code {
    private List<UserAccess> Items = [];
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public Guid? UserIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleParam { get; set; }
    private string Query = "";
    private Guid? SelectedUserId;
    private string StatusFilter = "";
    private string RoleFilter = "";
    private string? Message;
    private string? Error;
    private bool Saving;
    private bool HasFilters => !string.IsNullOrWhiteSpace(Query) || SelectedUserId is not null || StatusFilter != "" || RoleFilter != "";
    private IEnumerable<UserAccess> Filtered => Items.Where(x =>
        (SelectedUserId is null || x.User.Id == SelectedUserId) &&
        (StatusFilter != "active" || !x.Disabled) &&
        (StatusFilter != "disabled" || x.Disabled) &&
        (RoleFilter == "" || x.Roles.Contains(RoleFilter)) &&
        $"{x.User.DisplayName} {x.User.Email} {x.User.PhoneNumber} {string.Join(" ", x.Roles)} {string.Join(" ", x.Roles.Select(RoleLabel))}".Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();
    protected override void OnParametersSet()
    {
        Query = QueryParam?.Trim() ?? "";
        SelectedUserId = UserIdParam;
        StatusFilter = StatusParam is "active" or "disabled" ? StatusParam : "";
        RoleFilter = AppRoles.All.Contains(RoleParam ?? "") ? RoleParam! : "";
    }
    private void ResetFilters()
    {
        Query = StatusFilter = RoleFilter = "";
        SelectedUserId = null;
        Navigation.NavigateTo("/platform/access");
    }
    private async Task<bool> EnsureAccess()
    {
        if (await Access.IsPlatformAdminAsync()) return true;
        Items = [];
        Message = null;
        Error = "دسترسی مدیریت سامانه ندارید؛ دوباره وارد حساب شوید.";
        return false;
    }

    private async Task Load()
    {
        if (!await EnsureAccess()) return;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var items = new List<UserAccess>();
        foreach (var user in await users.Users.AsNoTracking().OrderBy(x => x.DisplayName).ToListAsync())
        {
            var roles = await users.GetRolesAsync(user);
            var knownRoles = AppRoles.All.Where(roles.Contains).ToArray();
            items.Add(new UserAccess(user, knownRoles.Length == 0 ? [AppRoles.Customer] : knownRoles));
        }
        Items = items;
    }

    private async Task<bool> IsSelfAsync(UserAccess item)
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return UserContext.IdOf(principal) == item.User.Id;
    }

    private bool CheckResult(IdentityResult result)
    {
        if (result.Succeeded) return true;
        Error = string.Join("، ", result.Errors.Select(x => x.Description));
        return false;
    }

    private static bool HasOtherActivePlatformAdmin(IEnumerable<AppUser> administrators, Guid targetId, DateTimeOffset now) =>
        administrators.Any(user => user.Id != targetId && (!user.LockoutEnabled || user.LockoutEnd is null || user.LockoutEnd <= now));

    private async Task SaveRole(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (item.SelectedRole is not (AppRoles.PlatformAdmin or AppRoles.Customer))
        {
            Error = "نقش مالک، مدیر یا کارمند را از عضویت‌های شعبه مدیریت کنید.";
            return;
        }
        if (await IsSelfAsync(item) && item.SelectedRole != AppRoles.PlatformAdmin)
        {
            Error = "نقش مدیر کل را برای حساب خودتان نمی‌توانید کم کنید؛ از مدیر دیگری بخواهید.";
            return;
        }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            // The last-administrator check and role changes share a serializable
            // transaction so two administrators cannot concurrently remove each other.
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            var isAdmin = await users.IsInRoleAsync(user, AppRoles.PlatformAdmin);
            if (isAdmin && item.SelectedRole != AppRoles.PlatformAdmin
                && !HasOtherActivePlatformAdmin(await users.GetUsersInRoleAsync(AppRoles.PlatformAdmin), user.Id, DateTimeOffset.UtcNow))
            {
                Error = "آخرین مدیر فعال سامانه را نمی‌توانید حذف کنید.";
                return;
            }

            var changed = false;
            if (!await users.IsInRoleAsync(user, item.SelectedRole))
            {
                if (!CheckResult(await users.AddToRoleAsync(user, item.SelectedRole))) return;
                changed = true;
            }
            if (item.SelectedRole != AppRoles.PlatformAdmin && isAdmin)
            {
                if (!CheckResult(await users.RemoveFromRoleAsync(user, AppRoles.PlatformAdmin))) return;
                changed = true;
            }
            // Identity team roles follow memberships. A global Customer grant must
            // never erase the user's Owner/Manager/Staff role while memberships exist.
            try { await TeamRoleSync.SyncAsync(users, db, user); }
            catch (InvalidOperationException ex) { Error = ex.Message; return; }
            if (changed && !CheckResult(await users.UpdateSecurityStampAsync(user))) return;
            await transaction.CommitAsync();
            Message = $"دسترسی سراسری {DisplayName(user)} روی «{RoleLabel(item.SelectedRole)}» ذخیره شد؛ نقش‌های شعبه از عضویت‌ها تعیین می‌شوند.";
            await Load();
        }
        catch (DbUpdateConcurrencyException) { Error = "اطلاعات کاربر هم‌زمان تغییر کرد؛ فهرست را تازه کنید و دوباره تلاش کنید."; }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "40001" })
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == "40001")
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        finally { Saving = false; }
    }

    private async Task ToggleAccess(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (await IsSelfAsync(item)) { Error = "حساب خودتان را نمی‌توانید غیرفعال کنید."; return; }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            if (!item.Disabled && await users.IsInRoleAsync(user, AppRoles.PlatformAdmin)
                && !HasOtherActivePlatformAdmin(await users.GetUsersInRoleAsync(AppRoles.PlatformAdmin), user.Id, DateTimeOffset.UtcNow))
            {
                Error = "آخرین مدیر فعال سامانه را نمی‌توانید غیرفعال کنید.";
                return;
            }
            if (!CheckResult(await users.SetLockoutEnabledAsync(user, true))) return;
            if (!CheckResult(await users.SetLockoutEndDateAsync(user, item.Disabled ? null : DateTimeOffset.MaxValue))) return;
            // Rotating on both disable and reactivation prevents an old authenticated
            // circuit from becoming valid again when an account is re-enabled.
            if (!CheckResult(await users.UpdateSecurityStampAsync(user))) return;
            await transaction.CommitAsync();
            Message = "وضعیت دسترسی کاربر تغییر کرد.";
            await Load();
        }
        catch (DbUpdateConcurrencyException) { Error = "اطلاعات کاربر هم‌زمان تغییر کرد؛ دوباره تلاش کنید."; }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "40001" })
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == "40001")
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        finally { Saving = false; }
    }

    private async Task ResetPassword(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (await IsSelfAsync(item)) { Error = "رمز حساب خودتان را از بخش پروفایل تغییر دهید."; return; }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            var temporary = NewTemporaryPassword();
            var token = await users.GeneratePasswordResetTokenAsync(user);
            // Identity's password reset also rotates the security stamp.
            if (!CheckResult(await users.ResetPasswordAsync(user, token, temporary))) return;
            Message = $"رمز موقت {DisplayName(user)}: «{temporary}» — فقط همین یک‌بار نمایش داده می‌شود؛ آن را امن به کاربر بدهید و بخواهید پس از ورود تغییرش دهد.";
            await Load();
        }
        finally { Saving = false; }
    }

    private static string DisplayName(AppUser user) => string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? "کاربر" : user.DisplayName;
    private static string NewTemporaryPassword()
    {
        const string letters = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var chars = new char[12];
        for (var i = 0; i < chars.Length; i++) chars[i] = letters[System.Security.Cryptography.RandomNumberGenerator.GetInt32(letters.Length)];
        return "Bn" + new string(chars) + "@7";
    }
    private static string RoleLabel(string role) => role switch { AppRoles.PlatformAdmin => "مدیر کل سامانه", AppRoles.Owner => "مدیر کسب‌وکار", AppRoles.Manager => "مدیر شعبه", AppRoles.Staff => "کارمند", _ => "مشتری" };
    private sealed class UserAccess(AppUser user, string[] roles)
    {
        public AppUser User { get; } = user;
        public string[] Roles { get; } = roles;
        public string SelectedRole { get; set; } = roles.Contains(AppRoles.PlatformAdmin) ? AppRoles.PlatformAdmin : AppRoles.Customer;
        public bool Disabled { get; } = user.LockoutEnabled && user.LockoutEnd > DateTimeOffset.UtcNow;
    }
}
