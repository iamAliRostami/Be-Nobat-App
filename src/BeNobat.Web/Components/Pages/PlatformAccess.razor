@page "/platform/access"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@using BeNobat.Web.Security
@inject IServiceScopeFactory ScopeFactory
@inject AdminAccessScope Access
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>دسترسی‌های سامانه | به‌نوبت</PageTitle>
<div class="page-title">
    <div>
        <h1>کاربران و دسترسی‌ها</h1>
        <p>نقش سراسری، اطلاعات تماس، وضعیت حساب کاربران و درخواست‌های بازیابی رمز عبور را مدیریت کنید.</p>
    </div>
</div>

<div class="auth-tabs" style="max-width:440px; margin-bottom:1.5rem;">
    <a href="javascript:void(0)" class="@(ActiveTab == "users" ? "active" : "")" @onclick='() => SetTab("users")'>
        کاربران سامانه (@Items.Count)
    </a>
    <a href="javascript:void(0)" class="@(ActiveTab == "resets" ? "active" : "")" @onclick='() => SetTab("resets")'>
        درخواست‌های ریست رمز
        @if (PendingResetsCount > 0)
        {
            <b class="sidebar-badge-count" style="margin-right:6px; background:#d32f2f; color:#fff; border-radius:10px; padding:2px 7px; font-size:11px;">
                @PendingResetsCount
            </b>
        }
    </a>
</div>

@if (Message is not null) { <div class="success-notice">@Message</div> }
@if (Error is not null) { <div class="auth-error">@Error</div> }

@if (ActiveTab == "users")
{
    <article class="admin-panel">
        <div class="toolbar filter-toolbar">
            <input aria-label="جست‌وجوی کاربران" placeholder="جست‌وجوی نام، ایمیل، موبایل یا نقش..." @bind="Query" @bind:event="oninput" />
            <select aria-label="فیلتر وضعیت حساب" @bind="StatusFilter"><option value="">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
            <select aria-label="فیلتر نقش کاربر" @bind="RoleFilter"><option value="">همه نقش‌ها</option>@foreach (var role in AppRoles.All) { <option value="@role">@RoleLabel(role)</option> }</select>
            @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ResetFilters">پاک‌کردن فیلترها</button> }
            <span>@Filtered.Count() کاربر</span>
        </div>
        @if (!Filtered.Any()) { <p class="empty-state">کاربری با این مشخصات پیدا نشد.</p> }
        <div class="access-list">
            @foreach (var item in Filtered)
            {
                var hasPendingReset = UserIdsWithPendingResets.Contains(item.User.Id);
                <article @key="item.User.Id" class="@(item.Disabled ? "disabled-row" : "")">
                    <span class="customer-avatar purple" data-i18n-skip>@UserAvatar.Initials(item.User.DisplayName)</span>
                    <div class="access-user-details">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <b data-i18n-skip>@DisplayName(item.User)</b>
                            @if (hasPendingReset)
                            {
                                <span style="background:#fff3cd; color:#856404; border:1px solid #ffeeba; border-radius:6px; padding:1px 6px; font-size:11px; font-weight:600;">درخواست ریست رمز دارد</span>
                            }
                        </div>
                        <small>✉ @item.User.Email</small>
                        <small>☎ @(string.IsNullOrWhiteSpace(item.User.PhoneNumber) ? "شماره موبایل ثبت نشده" : item.User.PhoneNumber)</small>
                        <small>@($"نقش‌ها: {string.Join("، ", item.Roles.Select(RoleLabel))}")</small>
                    </div>
                    <label>دسترسی سراسری
                        <select @bind="item.SelectedRole">
                            <option value="@AppRoles.Customer">@RoleLabel(AppRoles.Customer)</option>
                            <option value="@AppRoles.PlatformAdmin">@RoleLabel(AppRoles.PlatformAdmin)</option>
                        </select>
                    </label>
                    <div class="access-actions">
                        <button type="button" class="action-primary" @onclick="() => SaveRole(item)" disabled="@Saving">ذخیره نقش</button>
                        <button type="button" class="@(item.Disabled ? "action-success" : "action-danger")" @onclick="() => ToggleAccess(item)" disabled="@Saving">@(item.Disabled ? "فعال‌سازی" : "غیرفعال‌سازی")</button>
                        <button type="button" class="action-warning" @onclick="() => ResetPassword(item)" disabled="@Saving">ریست رمز</button>
                    </div>
                    <em class="status @(item.Disabled ? "cancelled" : "confirmed")">@(item.Disabled ? "غیرفعال" : "فعال")</em>
                </article>
            }
        </div>
    </article>
}
else
{
    <article class="admin-panel">
        <div class="toolbar filter-toolbar">
            <input aria-label="جست‌وجو در درخواست‌ها" placeholder="جست‌وجوی شناسه، ایمیل یا شماره موبایل..." @bind="ResetQuery" @bind:event="oninput" />
            <select aria-label="فیلتر وضعیت درخواست" @bind="ResetStatusFilter">
                <option value="">همه وضعیت‌ها</option>
                <option value="pending">در انتظار بررسی</option>
                <option value="resolved">انجام شده</option>
                <option value="rejected">رد شده</option>
            </select>
            @if (!string.IsNullOrWhiteSpace(ResetQuery) || !string.IsNullOrWhiteSpace(ResetStatusFilter))
            {
                <button type="button" class="action-secondary" @onclick="() => { ResetQuery = ResetStatusFilter = string.Empty; }">پاک‌کردن فیلتر</button>
            }
            <span>@FilteredResets.Count() درخواست</span>
        </div>

        @if (!FilteredResets.Any())
        {
            <p class="empty-state">هیچ درخواستی با این مشخصات یافت نشد.</p>
        }
        else
        {
            <div class="access-list">
                @foreach (var req in FilteredResets)
                {
                    <article @key="req.Id">
                        <span class="customer-avatar @(req.Status == PasswordResetRequestStatus.Pending ? "rose" : "blue")">
                            @(req.User != null ? UserAvatar.Initials(req.User.DisplayName) : "؟")
                        </span>
                        <div class="access-user-details">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <b data-i18n-skip>@(req.User != null ? DisplayName(req.User) : "کاربر ناشناس یا مهمان")</b>
                                <span style="font-size:11px; color:#555; background:#eef2f5; padding:2px 8px; border-radius:6px;" dir="ltr">@req.Identifier</span>
                            </div>
                            <small>☎ اطلاعات تماس: @req.ContactInfo</small>
                            <small>⏱ زمان ثبت: @FormatDateTime(req.CreatedAt)</small>
                            @if (req.ResolvedAt.HasValue)
                            {
                                <small>✓ زمان بررسی: @FormatDateTime(req.ResolvedAt.Value) @(!string.IsNullOrEmpty(req.AdminNote) ? $"— {req.AdminNote}" : "")</small>
                            }
                        </div>

                        <div class="access-actions" style="margin-right:auto;">
                            @if (req.Status == PasswordResetRequestStatus.Pending)
                            {
                                <button type="button" class="action-primary" @onclick="() => ResolveRequest(req)" disabled="@Saving">
                                    تأیید و صدور رمز موقت
                                </button>
                                <button type="button" class="action-danger" @onclick="() => RejectRequest(req)" disabled="@Saving">
                                    رد درخواست
                                </button>
                            }
                        </div>

                        <em class="status @(req.Status switch { PasswordResetRequestStatus.Pending => "pending", PasswordResetRequestStatus.Resolved => "confirmed", _ => "cancelled" })">
                            @(req.Status switch
                            {
                                PasswordResetRequestStatus.Pending => "در انتظار بررسی",
                                PasswordResetRequestStatus.Resolved => "انجام شده",
                                PasswordResetRequestStatus.Rejected => "رد شده",
                                _ => "نامشخص"
                            })
                        </em>
                    </article>
                }
            </div>
        }
    </article>
}

@code {
    private string ActiveTab = "users";
    private List<UserAccess> Items = [];
    private List<PasswordResetRequest> ResetRequests = [];
    private HashSet<Guid> UserIdsWithPendingResets = [];

    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "userId")] public Guid? UserIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleParam { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private string Query = "";
    private Guid? SelectedUserId;
    private string StatusFilter = "";
    private string RoleFilter = "";

    private string ResetQuery = "";
    private string ResetStatusFilter = "pending";

    private string? Message;
    private string? Error;
    private bool Saving;

    private int PendingResetsCount => ResetRequests.Count(r => r.Status == PasswordResetRequestStatus.Pending);

    private bool HasFilters => !string.IsNullOrWhiteSpace(Query) || SelectedUserId is not null || StatusFilter != "" || RoleFilter != "";

    private IEnumerable<UserAccess> Filtered => Items.Where(x =>
        (SelectedUserId is null || x.User.Id == SelectedUserId) &&
        (StatusFilter != "active" || !x.Disabled) &&
        (StatusFilter != "disabled" || x.Disabled) &&
        (RoleFilter == "" || x.Roles.Contains(RoleFilter)) &&
        $"{x.User.DisplayName} {x.User.Email} {x.User.PhoneNumber} {string.Join(" ", x.Roles)} {string.Join(" ", x.Roles.Select(RoleLabel))}".Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PasswordResetRequest> FilteredResets => ResetRequests.Where(r =>
        (string.IsNullOrWhiteSpace(ResetStatusFilter) ||
         (ResetStatusFilter == "pending" && r.Status == PasswordResetRequestStatus.Pending) ||
         (ResetStatusFilter == "resolved" && r.Status == PasswordResetRequestStatus.Resolved) ||
         (ResetStatusFilter == "rejected" && r.Status == PasswordResetRequestStatus.Rejected)) &&
        (string.IsNullOrWhiteSpace(ResetQuery) ||
         (r.Identifier != null && r.Identifier.Contains(ResetQuery.Trim(), StringComparison.OrdinalIgnoreCase)) ||
         (r.ContactInfo != null && r.ContactInfo.Contains(ResetQuery.Trim(), StringComparison.OrdinalIgnoreCase)) ||
         (r.User != null && (
             (r.User.DisplayName != null && r.User.DisplayName.Contains(ResetQuery.Trim(), StringComparison.OrdinalIgnoreCase)) ||
             (r.User.Email != null && r.User.Email.Contains(ResetQuery.Trim(), StringComparison.OrdinalIgnoreCase)) ||
             (r.User.PhoneNumber != null && r.User.PhoneNumber.Contains(ResetQuery.Trim(), StringComparison.OrdinalIgnoreCase))
         ))));

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnParametersSet()
    {
        Query = QueryParam?.Trim() ?? "";
        SelectedUserId = UserIdParam;
        StatusFilter = StatusParam is "active" or "disabled" ? StatusParam : "";
        RoleFilter = AppRoles.All.Contains(RoleParam ?? "") ? RoleParam! : "";
        if (TabParam is "resets" or "users")
        {
            ActiveTab = TabParam;
        }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
        Message = Error = null;
    }

    private void ResetFilters()
    {
        Query = StatusFilter = RoleFilter = "";
        SelectedUserId = null;
        Navigation.NavigateTo("/platform/access");
    }

    private async Task<bool> EnsureAccess()
    {
        if (await Access.IsPlatformAdminAsync()) return true;
        Items = [];
        ResetRequests = [];
        Message = null;
        Error = "دسترسی مدیریت سامانه ندارید؛ دوباره وارد حساب شوید.";
        return false;
    }

    private async Task Load()
    {
        if (!await EnsureAccess()) return;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var items = new List<UserAccess>();
        foreach (var user in await users.Users.AsNoTracking().OrderBy(x => x.DisplayName).ToListAsync())
        {
            var roles = await users.GetRolesAsync(user);
            var knownRoles = AppRoles.All.Where(roles.Contains).ToArray();
            items.Add(new UserAccess(user, knownRoles.Length == 0 ? [AppRoles.Customer] : knownRoles));
        }
        Items = items;

        ResetRequests = await db.PasswordResetRequests
            .Include(r => r.User)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();

        UserIdsWithPendingResets = ResetRequests
            .Where(r => r.Status == PasswordResetRequestStatus.Pending && r.UserId.HasValue)
            .Select(r => r.UserId!.Value)
            .ToHashSet();
    }

    private async Task<bool> IsSelfAsync(UserAccess item)
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        return UserContext.IdOf(principal) == item.User.Id;
    }

    private bool CheckResult(IdentityResult result)
    {
        if (result.Succeeded) return true;
        Error = string.Join("، ", result.Errors.Select(x => x.Description));
        return false;
    }

    private static bool HasOtherActivePlatformAdmin(IEnumerable<AppUser> administrators, Guid targetId, DateTimeOffset now) =>
        administrators.Any(user => user.Id != targetId && (!user.LockoutEnabled || user.LockoutEnd is null || user.LockoutEnd <= now));

    private async Task SaveRole(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (item.SelectedRole is not (AppRoles.PlatformAdmin or AppRoles.Customer))
        {
            Error = "نقش مالک، مدیر یا کارمند را از عضویت‌های شعبه مدیریت کنید.";
            return;
        }
        if (await IsSelfAsync(item) && item.SelectedRole != AppRoles.PlatformAdmin)
        {
            Error = "نقش مدیر کل را برای حساب خودتان نمی‌توانید کم کنید؛ از مدیر دیگری بخواهید.";
            return;
        }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            var isAdmin = await users.IsInRoleAsync(user, AppRoles.PlatformAdmin);
            if (isAdmin && item.SelectedRole != AppRoles.PlatformAdmin
                && !HasOtherActivePlatformAdmin(await users.GetUsersInRoleAsync(AppRoles.PlatformAdmin), user.Id, DateTimeOffset.UtcNow))
            {
                Error = "آخرین مدیر فعال سامانه را نمی‌توانید حذف کنید.";
                return;
            }

            var changed = false;
            if (!await users.IsInRoleAsync(user, item.SelectedRole))
            {
                if (!CheckResult(await users.AddToRoleAsync(user, item.SelectedRole))) return;
                changed = true;
            }
            if (item.SelectedRole != AppRoles.PlatformAdmin && isAdmin)
            {
                if (!CheckResult(await users.RemoveFromRoleAsync(user, AppRoles.PlatformAdmin))) return;
                changed = true;
            }

            try { await TeamRoleSync.SyncAsync(users, db, user); }
            catch (InvalidOperationException ex) { Error = ex.Message; return; }
            if (changed && !CheckResult(await users.UpdateSecurityStampAsync(user))) return;
            await transaction.CommitAsync();
            Message = $"دسترسی سراسری {DisplayName(user)} روی «{RoleLabel(item.SelectedRole)}» ذخیره شد؛ نقش‌های شعبه از عضویت‌ها تعیین می‌شوند.";
            await Load();
        }
        catch (DbUpdateConcurrencyException) { Error = "اطلاعات کاربر هم‌زمان تغییر کرد؛ فهرست را تازه کنید و دوباره تلاش کنید."; }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "40001" })
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == "40001")
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        finally { Saving = false; }
    }

    private async Task ToggleAccess(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (await IsSelfAsync(item)) { Error = "حساب خودتان را نمی‌توانید غیرفعال کنید."; return; }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            if (!item.Disabled && await users.IsInRoleAsync(user, AppRoles.PlatformAdmin)
                && !HasOtherActivePlatformAdmin(await users.GetUsersInRoleAsync(AppRoles.PlatformAdmin), user.Id, DateTimeOffset.UtcNow))
            {
                Error = "آخرین مدیر فعال سامانه را نمی‌توانید غیرفعال کنید.";
                return;
            }
            if (!CheckResult(await users.SetLockoutEnabledAsync(user, true))) return;
            if (!CheckResult(await users.SetLockoutEndDateAsync(user, item.Disabled ? null : DateTimeOffset.MaxValue))) return;

            if (!CheckResult(await users.UpdateSecurityStampAsync(user))) return;
            await transaction.CommitAsync();
            Message = "وضعیت دسترسی کاربر تغییر کرد.";
            await Load();
        }
        catch (DbUpdateConcurrencyException) { Error = "اطلاعات کاربر هم‌زمان تغییر کرد؛ دوباره تلاش کنید."; }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "40001" })
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == "40001")
        { Error = "دسترسی‌ها هم‌زمان تغییر کردند؛ دوباره تلاش کنید."; }
        finally { Saving = false; }
    }

    private async Task ResetPassword(UserAccess item)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        if (await IsSelfAsync(item)) { Error = "رمز حساب خودتان را از بخش پروفایل تغییر دهید."; return; }
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var user = await users.FindByIdAsync(item.User.Id.ToString());
            if (user is null) { Error = "کاربر پیدا نشد."; return; }
            var temporary = NewTemporaryPassword();
            var token = await users.GeneratePasswordResetTokenAsync(user);

            if (!CheckResult(await users.ResetPasswordAsync(user, token, temporary))) return;

            // Mark any pending reset requests for this user as resolved
            var pendingRequests = await db.PasswordResetRequests
                .Where(r => r.Status == PasswordResetRequestStatus.Pending &&
                            (r.UserId == user.Id || r.Identifier == user.PhoneNumber || r.Identifier == user.Email || r.Identifier == user.UserName))
                .ToListAsync();

            foreach (var pr in pendingRequests)
            {
                pr.Status = PasswordResetRequestStatus.Resolved;
                pr.ResolvedAt = DateTimeOffset.UtcNow;
                pr.AdminNote = "ریست رمز موقت توسط مدیر سامانه انجام شد.";
            }
            await db.SaveChangesAsync();

            Message = $"رمز موقت {DisplayName(user)}: «{temporary}» — فقط همین یک‌بار نمایش داده می‌شود؛ آن را امن به کاربر بدهید و بخواهید پس از ورود تغییرش دهد.";
            await Load();
        }
        finally { Saving = false; }
    }

    private async Task ResolveRequest(PasswordResetRequest req)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            AppUser? user = null;
            if (req.UserId.HasValue)
            {
                user = await users.FindByIdAsync(req.UserId.Value.ToString());
            }

            if (user is null && !string.IsNullOrWhiteSpace(req.Identifier))
            {
                var identifier = req.Identifier.Trim();
                if (UserInputValidation.TryNormalizeIranianMobile(identifier, out var phone))
                {
                    user = await users.Users.FirstOrDefaultAsync(u => u.PhoneNumber == phone || u.UserName == phone);
                }
                else if (new EmailAddressAttribute().IsValid(identifier))
                {
                    user = await users.FindByEmailAsync(identifier)
                        ?? await users.Users.FirstOrDefaultAsync(u => u.UserName == identifier);
                }
                else
                {
                    user = await users.FindByNameAsync(identifier);
                }
            }

            if (user is null)
            {
                Error = "کاربر متناظر با این درخواست پیدا نشد. می‌توانید درخواست را رد کنید.";
                return;
            }

            var temporary = NewTemporaryPassword();
            var token = await users.GeneratePasswordResetTokenAsync(user);
            if (!CheckResult(await users.ResetPasswordAsync(user, token, temporary))) return;

            var entity = await db.PasswordResetRequests.FindAsync(req.Id);
            if (entity != null)
            {
                entity.Status = PasswordResetRequestStatus.Resolved;
                entity.ResolvedAt = DateTimeOffset.UtcNow;
                entity.AdminNote = "رمز موقت توسط مدیر سامانه صادر شد.";
                entity.UserId = user.Id;
                await db.SaveChangesAsync();
            }

            Message = $"رمز عبور موقت برای {DisplayName(user)} با موفقیت صادر شد: «{temporary}» — لطفاً آن را به کاربر اطلاع دهید.";
            await Load();
        }
        finally { Saving = false; }
    }

    private async Task RejectRequest(PasswordResetRequest req)
    {
        if (Saving || !await EnsureAccess()) return;
        Message = Error = null;
        Saving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var entity = await db.PasswordResetRequests.FindAsync(req.Id);
            if (entity != null)
            {
                entity.Status = PasswordResetRequestStatus.Rejected;
                entity.ResolvedAt = DateTimeOffset.UtcNow;
                entity.AdminNote = "درخواست توسط مدیر سامانه رد شد.";
                await db.SaveChangesAsync();
            }

            Message = "درخواست بازیابی رمز عبور رد شد.";
            await Load();
        }
        finally { Saving = false; }
    }

    private static string DisplayName(AppUser user) => string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? "کاربر" : user.DisplayName;

    private static string NewTemporaryPassword()
    {
        const string letters = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var chars = new char[12];
        for (var i = 0; i < chars.Length; i++) chars[i] = letters[System.Security.Cryptography.RandomNumberGenerator.GetInt32(letters.Length)];
        return "Bn" + new string(chars) + "@7";
    }

    private static string RoleLabel(string role) => role switch
    {
        AppRoles.PlatformAdmin => "مدیر کل سامانه",
        AppRoles.Owner => "مدیر کسب‌وکار",
        AppRoles.Manager => "مدیر شعبه",
        AppRoles.Staff => "کارمند",
        _ => "مشتری"
    };

    private static string FormatDateTime(DateTimeOffset dto)
    {
        var local = dto.ToOffset(TimeSpan.FromHours(3.5));
        var (y, m, d) = LocalizedDate.GetParts(DateOnly.FromDateTime(local.DateTime), "fa");
        return $"{y:D4}/{m:D2}/{d:D2} {local.Hour:D2}:{local.Minute:D2}";
    }

    private sealed class UserAccess(AppUser user, string[] roles)
    {
        public AppUser User { get; } = user;
        public string[] Roles { get; } = roles;
        public string SelectedRole { get; set; } = roles.Contains(AppRoles.PlatformAdmin) ? AppRoles.PlatformAdmin : AppRoles.Customer;
        public bool Disabled { get; } = user.LockoutEnabled && user.LockoutEnd > DateTimeOffset.UtcNow;
    }
}
