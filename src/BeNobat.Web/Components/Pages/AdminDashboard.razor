@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageAppointments)]
@using System.Globalization
@inject AppDbContext Db

<PageTitle>داشبورد مدیریت | به‌نوبت</PageTitle>

<div class="admin-welcome">
    <div><span>@Today.ToString("dddd، d MMMM yyyy", PersianCulture)</span><h1>صبح بخیر! 👋</h1><p>امروز <b>@TodayAppointments.Count نوبت</b> در پیش دارید.</p></div>
    <a class="primary-button" href="/admin/calendar">مشاهده تقویم ←</a>
</div>

<div class="stat-cards">
    <article><i class="purple">▦</i><div><small>نوبت‌های امروز</small><strong>@TodayAppointments.Count</strong></div></article>
    <article><i class="green">✓</i><div><small>تکمیل‌شده امروز</small><strong>@TodayAppointments.Count(a => a.Status == AppointmentStatus.Completed)</strong></div></article>
    <article><i class="orange">◷</i><div><small>در انتظار تأیید</small><strong>@TodayAppointments.Count(a => a.Status == AppointmentStatus.Pending)</strong></div></article>
    <article><i class="blue">♧</i><div><small>کل نوبت‌ها</small><strong>@TotalAppointments</strong></div></article>
</div>

<div class="dashboard-grid">
    <section class="admin-panel today-list">
        <div class="panel-head"><div><h2>نوبت‌های امروز</h2><p>@Today.ToString("dddd، d MMMM", PersianCulture)</p></div><a href="/admin/calendar">مشاهده تقویم ←</a></div>

        @if (TodayAppointments.Count == 0)
        {
            <p class="empty-state">امروز نوبتی ثبت نشده است.</p>
        }

        @foreach (var appointment in TodayAppointments)
        {
            <div class="schedule-row">
                <time>@appointment.StartsAt.ToString("HH:mm")<small>@appointment.Service.DurationMinutes دقیقه</small></time>
                <i class="line @(appointment.Status == AppointmentStatus.Completed ? "done" : "")"></i>
                <span class="customer-avatar rose">@CustomerInitials(appointment)</span>
                <div><b>@CustomerName(appointment)</b><small>@appointment.Service.Name · @appointment.Branch.Name</small></div>
                <em class="status @StatusCssClass(appointment.Status)">@StatusLabel(appointment.Status)</em>
                @if (appointment.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                {
                    <div class="row-actions">
                        @if (appointment.Status == AppointmentStatus.Pending)
                        {
                            <button type="button" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Confirmed)">تأیید</button>
                        }
                        <button type="button" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Completed)">تکمیل شد</button>
                        <button type="button" class="outline" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Cancelled)">لغو</button>
                    </div>
                }
            </div>
        }
    </section>
    <aside class="admin-side">
        <section class="quick-panel">
            <h3>دسترسی سریع</h3>
            <div>
                <a href="/admin/calendar"><i>▦</i><span>تقویم کاری</span></a>
                <AuthorizeView Policy="@Policies.ManageBusiness"><Authorized>
                    <a href="/businesses"><i>◇</i><span>مدیریت خدمات</span></a>
                    <a href="/admin/branches"><i>⌖</i><span>شعب و منابع</span></a>
                    <a href="/admin/team"><i>◎</i><span>اعضای تیم</span></a>
                </Authorized></AuthorizeView>
            </div>
        </section>
    </aside>
</div>

@code {
    private static readonly CultureInfo PersianCulture = new("fa-IR");
    private DateTimeOffset Today;
    private List<Appointment> TodayAppointments = [];
    private int TotalAppointments;

    protected override async Task OnInitializedAsync()
    {
        Today = DateTimeOffset.Now;
        var dayStart = new DateTimeOffset(Today.Date, Today.Offset);
        var dayEnd = dayStart.AddDays(1);

        TodayAppointments = await Db.Appointments
            .Include(a => a.Service)
            .Include(a => a.Branch)
            .Include(a => a.Customer)
            .Where(a => a.StartsAt >= dayStart && a.StartsAt < dayEnd)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();

        TotalAppointments = await Db.Appointments.CountAsync();
    }

    private async Task UpdateStatus(Guid appointmentId, AppointmentStatus status)
    {
        var appointment = await Db.Appointments.FirstOrDefaultAsync(a => a.Id == appointmentId);
        if (appointment is null) return;

        appointment.Status = status;
        appointment.UpdatedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        await OnInitializedAsync();
    }

    private static string CustomerName(Appointment appointment) =>
        string.IsNullOrWhiteSpace(appointment.Customer.DisplayName) ? appointment.Customer.Email ?? "مشتری" : appointment.Customer.DisplayName;

    private static string CustomerInitials(Appointment appointment)
    {
        var name = CustomerName(appointment);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };
}
