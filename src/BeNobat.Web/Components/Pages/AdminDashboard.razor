@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageAppointments)]
@using System.Globalization
@inject AppDbContext Db
@inject AdminAccessScope Access

<PageTitle>داشبورد مدیریت | به‌نوبت</PageTitle>

<div class="admin-welcome">
    <div><span>@Today.ToString("dddd، d MMMM yyyy", PersianCulture)</span><h1>صبح بخیر! 👋</h1>
        <AuthorizeView Roles="@AppRoles.PlatformAdmin"><Authorized><p>نمای مدیریتی کل سامانه و وضعیت همه نوبت‌ها</p></Authorized></AuthorizeView>
        <AuthorizeView Roles="@($"{AppRoles.Owner},{AppRoles.Manager}")"><Authorized><p>امروز <b>@TodayAppointments.Count نوبت</b> در شعب تحت مدیریت دارید.</p></Authorized></AuthorizeView>
        <AuthorizeView Roles="@AppRoles.Staff"><Authorized><p>امروز <b>@TodayAppointments.Count نوبت</b> برای پیگیری دارید.</p></Authorized></AuthorizeView>
    </div>
    <a class="primary-button" href="/admin/calendar">مشاهده تقویم ←</a>
</div>

<div class="stat-cards">
    <article class="filter-card @(DashboardFilter == "all" ? "active" : "")" @onclick='() => DashboardFilter = "all"'><i class="purple">▦</i><div><small>نوبت‌های امروز</small><strong>@TodayAppointments.Count</strong></div></article>
    <article class="filter-card @(DashboardFilter == "completed" ? "active" : "")" @onclick='() => DashboardFilter = "completed"'><i class="green">✓</i><div><small>تکمیل‌شده امروز</small><strong>@TodayAppointments.Count(a => a.Status == AppointmentStatus.Completed)</strong></div></article>
    <article class="filter-card @(DashboardFilter == "pending" ? "active" : "")" @onclick='() => DashboardFilter = "pending"'><i class="orange">◷</i><div><small>در انتظار تأیید</small><strong>@TodayAppointments.Count(a => a.Status == AppointmentStatus.Pending)</strong></div></article>
    <article class="filter-card"><a class="stat-card-link" href="/admin/calendar"><i class="blue">♧</i><div><small>کل نوبت‌ها</small><strong>@TotalAppointments</strong></div></a></article>
</div>

<div class="dashboard-grid">
    <section class="admin-panel today-list">
        <div class="panel-head"><div><h2>@DashboardFilterTitle</h2><p>@Today.ToString("dddd، d MMMM", PersianCulture)</p></div><a href="/admin/calendar">مشاهده تقویم ←</a></div>

        @if (!DisplayedAppointments.Any())
        {
            <p class="empty-state">امروز نوبتی ثبت نشده است.</p>
        }

        @foreach (var appointment in DisplayedAppointments)
        {
            <div class="schedule-row">
                <time>@appointment.StartsAt.ToString("HH:mm")<small>@((appointment.EndsAt - appointment.StartsAt).TotalMinutes.ToString("0")) دقیقه</small></time>
                <i class="line @(appointment.Status == AppointmentStatus.Completed ? "done" : "")"></i>
                <span class="customer-avatar rose">@CustomerInitials(appointment)</span>
                <div class="schedule-summary">
                    <b><a class="entity-link entity-link-prominent" href="@EntityUrl("/admin/customers", CustomerName(appointment))" title="نمایش این مشتری در فهرست مشتریان">@CustomerName(appointment)</a></b>
                    <small class="schedule-entity-links">
                        <span class="entity-link-list">
                            @if (appointment.Services.Count == 0)
                            {
                                <a class="entity-link" href="@EntityUrl("/businesses", appointment.Service.Name)" title="نمایش این خدمت در مدیریت خدمات">@appointment.Service.Name</a>
                            }
                            else
                            {
                                @foreach (var appointmentService in appointment.Services)
                                {
                                    <a class="entity-link" href="@EntityUrl("/businesses", appointmentService.Service.Name)" title="نمایش این خدمت در مدیریت خدمات">@appointmentService.Service.Name</a>
                                }
                            }
                        </span>
                        <span aria-hidden="true">·</span>
                        @if (appointment.Resource is not null)
                        {
                            <a class="entity-link" href="@EntityUrl("/admin/team", ResourceFilterValue(appointment.Resource))" title="نمایش این عضو در فهرست اعضای تیم">@appointment.Resource.Name</a>
                        }
                        else
                        {
                            <span>بدون کارمند</span>
                        }
                        <span aria-hidden="true">·</span>
                        <a class="entity-link" href="@EntityUrl("/admin/branches", appointment.Branch.Name)" title="نمایش این شعبه در مدیریت شعب">@appointment.Branch.Name</a>
                    </small>
                </div>
                <em class="status @StatusCssClass(appointment.Status)">@StatusLabel(appointment.Status)</em>
                @if (appointment.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                {
                    <div class="row-actions">
                        @if (appointment.Status == AppointmentStatus.Pending)
                        {
                            <button type="button" class="action-primary" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Confirmed)">تأیید</button>
                        }
                        <button type="button" class="action-success" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Completed)">تکمیل شد</button>
                        <button type="button" class="action-danger" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Cancelled)">لغو</button>
                    </div>
                }
            </div>
        }
    </section>
    <aside class="admin-side">
        <section class="quick-panel">
            <h3>دسترسی سریع</h3>
            <div>
                <a href="/admin/calendar"><i>▦</i><span>تقویم کاری</span></a>
                <AuthorizeView Policy="@Policies.ManageBusiness"><Authorized>
                    <a href="/businesses"><i>◇</i><span>مدیریت خدمات</span></a>
                    <a href="/admin/branches"><i>⌖</i><span>شعب و منابع</span></a>
                    <a href="/admin/team"><i>◎</i><span>اعضای تیم</span></a>
                </Authorized></AuthorizeView>
                <AuthorizeView Roles="@AppRoles.PlatformAdmin"><Authorized>
                    <a href="/platform"><i>▤</i><span>کسب‌وکارها</span></a>
                    <a href="/platform/access"><i>♙</i><span>کاربران و دسترسی‌ها</span></a>
                </Authorized></AuthorizeView>
            </div>
        </section>
    </aside>
</div>

@code {
    private static readonly CultureInfo PersianCulture = new("fa-IR");
    private DateTimeOffset Today;
    private List<Appointment> TodayAppointments = [];
    private int TotalAppointments;
    private string DashboardFilter = "all";
    private HashSet<Guid> AllowedAppointmentIds = [];
    private IEnumerable<Appointment> DisplayedAppointments => DashboardFilter switch
    {
        "completed" => TodayAppointments.Where(x => x.Status == AppointmentStatus.Completed),
        "pending" => TodayAppointments.Where(x => x.Status == AppointmentStatus.Pending),
        _ => TodayAppointments,
    };
    private string DashboardFilterTitle => DashboardFilter switch
    {
        "completed" => "نوبت‌های تکمیل‌شده امروز",
        "pending" => "نوبت‌های در انتظار تأیید",
        _ => "نوبت‌های امروز",
    };

    protected override async Task OnInitializedAsync()
    {
        var tz = TimeZoneInfo.GetSystemTimeZones().FirstOrDefault(x => x.Id == "Asia/Tehran" || x.Id == "Iran Standard Time") ?? TimeZoneInfo.Local;
        Today = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
        var (dayStart, dayEnd) = BookingPolicy.UtcDayWindow(DateOnly.FromDateTime(Today.DateTime), tz);

        var appointments = await Access.AppointmentsAsync();

        TodayAppointments = await appointments
            .Include(a => a.Service)
            .Include(a => a.Services).ThenInclude(x => x.Service)
            .Include(a => a.Resource).ThenInclude(r => r!.User)
            .Include(a => a.Branch)
            .Include(a => a.Customer)
            .Where(a => a.StartsAt >= dayStart && a.StartsAt < dayEnd)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();

        TotalAppointments = await appointments.CountAsync();
        AllowedAppointmentIds = (await appointments.Select(a => a.Id).ToListAsync()).ToHashSet();
    }

    private async Task UpdateStatus(Guid appointmentId, AppointmentStatus status)
    {
        if (!AllowedAppointmentIds.Contains(appointmentId)) return;
        var appointment = await Db.Appointments.FirstOrDefaultAsync(a => a.Id == appointmentId);
        if (appointment is null) return;

        appointment.Status = status;
        appointment.UpdatedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        await OnInitializedAsync();
    }

    private static string CustomerName(Appointment appointment) =>
        string.IsNullOrWhiteSpace(appointment.Customer.DisplayName) ? appointment.Customer.Email ?? "مشتری" : appointment.Customer.DisplayName;

    private static string EntityUrl(string path, string value) => $"{path}?q={Uri.EscapeDataString(value)}";

    private static string ResourceFilterValue(Resource resource) =>
        string.IsNullOrWhiteSpace(resource.User?.DisplayName) ? resource.Name : resource.User.DisplayName;

    private static string CustomerInitials(Appointment appointment)
    {
        var name = CustomerName(appointment);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };
}
