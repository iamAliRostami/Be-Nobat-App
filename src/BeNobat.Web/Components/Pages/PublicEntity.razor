    private async Task AddGalleryPhoto()
    {
        if (SelectedGalleryBytes == null) return;
        try
        {
            IsUploadingMedia = true;
            MediaError = MediaMessage = null;
            await using var db = await DbFactory.CreateDbContextAsync();
            var newId = Guid.NewGuid();
            var caption = string.IsNullOrWhiteSpace(NewGalleryCaption) ? null : NewGalleryCaption.Trim();
            var ct = SelectedGalleryContentType ?? "image/jpeg";

            if (BusinessId is Guid bId)
            {
                var count = await db.BusinessGalleryItems.CountAsync(x => x.BusinessId == bId);
                db.BusinessGalleryItems.Add(new BusinessGalleryItem
                {
                    Id = newId, BusinessId = bId, Caption = caption, ImageData = SelectedGalleryBytes, ContentType = ct, SortOrder = count, CreatedAt = DateTimeOffset.UtcNow, UpdatedAt = DateTimeOffset.UtcNow
                });
                await db.SaveChangesAsync();
                Gallery.Add(new GalleryItemView(newId, caption, $"/media/business/gallery/{newId}"));
            }
            else if (BranchId is Guid brId)
            {
                var count = await db.BranchGalleryItems.CountAsync(x => x.BranchId == brId);
                db.BranchGalleryItems.Add(new BranchGalleryItem
                {
                    Id = newId, BranchId = brId, Caption = caption, ImageData = SelectedGalleryBytes, ContentType = ct, SortOrder = count, CreatedAt = DateTimeOffset.UtcNow, UpdatedAt = DateTimeOffset.UtcNow
                });
                await db.SaveChangesAsync();
                Gallery.Add(new GalleryItemView(newId, caption, $"/media/branch/gallery/{newId}"));
            }
            else if (ProviderId is Guid pId)
            {
                var count = await db.ResourceGalleryItems.CountAsync(x => x.ResourceId == pId);
                db.ResourceGalleryItems.Add(new ResourceGalleryItem
                {
                    Id = newId, ResourceId = pId, Caption = caption, ImageData = SelectedGalleryBytes, ContentType = ct, SortOrder = count, CreatedAt = DateTimeOffset.UtcNow, UpdatedAt = DateTimeOffset.UtcNow
                });
                await db.SaveChangesAsync();
                Gallery.Add(new GalleryItemView(newId, caption, $"/media/resource/gallery/{newId}"));
            }
            SelectedGalleryBytes = null;
            NewGalleryCaption = "";
            MediaMessage = "تصویر با موفقیت به گالری اضافه شد.";
        }
        catch (Exception ex)
        {
            MediaError = "خطا در ثبت تصویر: " + ex.Message;
        }
        finally
        {
            IsUploadingMedia = false;
            StateHasChanged();
        }
    }

    private async Task DeleteGalleryPhoto(Guid id)
    {
        try
        {
            IsUploadingMedia = true;
            MediaError = MediaMessage = null;
            await using var db = await DbFactory.CreateDbContextAsync();
            if (BusinessId is not null)
            {
                var item = await db.BusinessGalleryItems.FirstOrDefaultAsync(x => x.Id == id);
                if (item != null) { db.BusinessGalleryItems.Remove(item); await db.SaveChangesAsync(); }
            }
            else if (BranchId is not null)
            {
                var item = await db.BranchGalleryItems.FirstOrDefaultAsync(x => x.Id == id);
                if (item != null) { db.BranchGalleryItems.Remove(item); await db.SaveChangesAsync(); }
            }
            else if (ProviderId is not null)
            {
                var item = await db.ResourceGalleryItems.FirstOrDefaultAsync(x => x.Id == id);
                if (item != null) { db.ResourceGalleryItems.Remove(item); await db.SaveChangesAsync(); }
            }
            Gallery.RemoveAll(x => x.Id == id);
            MediaMessage = "تصویر از گالری حذف شد.";
        }
        catch (Exception ex)
        {
            MediaError = "خطا در حذف تصویر: " + ex.Message;
        }
        finally
        {
            IsUploadingMedia = false;
            StateHasChanged();
        }
    }
