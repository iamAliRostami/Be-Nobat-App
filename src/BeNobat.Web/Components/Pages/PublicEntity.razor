    private async Task UploadAvatar(InputFileChangeEventArgs e)
    {
        try
        {
            IsUploadingMedia = true;
            MediaError = MediaMessage = null;
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024)
            {
                MediaError = "حجم فایل نباید بیش از ۵ مگابایت باشد.";
                return;
            }
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var contentType = file.ContentType.ToLowerInvariant();

            await using var db = await DbFactory.CreateDbContextAsync();
            if (BusinessId is Guid bId)
            {
                var b = await db.Businesses.FirstOrDefaultAsync(x => x.Id == bId);
                if (b != null) { b.AvatarData = bytes; b.AvatarContentType = contentType; await db.SaveChangesAsync(); }
                AvatarUrl = $"/media/business/{bId}/avatar?t={DateTime.UtcNow.Ticks}";
            }
            else if (BranchId is Guid brId)
            {
                var br = await db.Branches.FirstOrDefaultAsync(x => x.Id == brId);
                if (br != null) { br.AvatarData = bytes; br.AvatarContentType = contentType; await db.SaveChangesAsync(); }
                AvatarUrl = $"/media/branch/{brId}/avatar?t={DateTime.UtcNow.Ticks}";
            }
            else if (ProviderId is Guid pId)
            {
                var p = await db.Resources.FirstOrDefaultAsync(x => x.Id == pId);
                if (p != null) { p.AvatarData = bytes; p.AvatarContentType = contentType; await db.SaveChangesAsync(); }
                AvatarUrl = $"/media/resource/{pId}/avatar?t={DateTime.UtcNow.Ticks}";
            }
            MediaMessage = "آواتار با موفقیت به‌روزرسانی شد.";
        }
        catch (Exception ex)
        {
            MediaError = "خطا در بارگذاری تصویر: " + ex.Message;
        }
        finally
        {
            IsUploadingMedia = false;
            StateHasChanged();
        }
    }

