@page "/business/{BusinessId:guid}"
@page "/branch/{BranchId:guid}"
@page "/provider/{ProviderId:guid}"
@page "/service/{ServiceId:guid}"
@layout Layout.PublicLayout
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@(Title.Length == 0 ? "جزئیات | به‌نوبت" : $"{Title} | به‌نوبت")</PageTitle>

<section class="directory-page" aria-busy="@(IsLoading ? "true" : "false")">
    @if (IsLoading)
    {
        <p class="empty-state" role="status">در حال دریافت اطلاعات…</p>
    }
    else if (NotFound)
    {
        <div class="directory-panel directory-state"><h1>صفحه پیدا نشد</h1><p>صفحه موردنظر پیدا نشد یا دیگر فعال نیست.</p><a class="primary-button" href="/">بازگشت به صفحه اصلی</a></div>
    }
    else
    {
        <a class="back-link" href="/#businesses">→ بازگشت به فهرست کسب‌وکارها</a>
        <header class="directory-hero">
            <div class="directory-mark" aria-hidden="true">@Icon</div>
            <div class="directory-heading"><span class="directory-kicker">@KindLabel</span><h1 data-i18n-skip>@Title</h1>@if (BusinessId is not null) { <p><span>@SubtitleCategory</span> · <span data-i18n-skip>@Subtitle</span></p> } else if (ProviderId is not null) { <p><span>ارائه‌دهنده در</span> <span data-i18n-skip>@Subtitle</span></p> } else { <p data-i18n-skip>@Subtitle</p> }
                @if (Metadata.Count > 0) { <div class="directory-meta">@foreach (var value in Metadata) { <span>@value</span> }</div> }
                @if (!string.IsNullOrWhiteSpace(Description)) { <p class="directory-description" data-i18n-skip>@Description</p> }
            </div>
            @if (BusinessIdForBooking is Guid businessId)
            {
                <a class="primary-button action-primary" href="@BookingHref(businessId)">رزرو نوبت</a>
            }
        </header>

        @if (ParentLinks.Count > 0)
        {
            <nav class="directory-breadcrumbs" aria-label="مسیر مرتبط">
                <a href="/">صفحه اصلی</a>
                @foreach (var link in ParentLinks) { <span class="directory-crumb"><span aria-hidden="true">/</span><a href="@link.Url" title="@link.Description" data-i18n-skip>@link.Label</a></span> }
                <span class="directory-crumb"><span aria-hidden="true">/</span><span aria-current="page" data-i18n-skip>@Title</span></span>
            </nav>
        }

        <dl class="directory-stats">
            @if (Services.Count > 0) { <div><dt>خدمات قابل رزرو</dt><dd>@LocalizedDate.FormatNumber(Services.Count, UiLocale.Language)</dd></div> }
            @if (Providers.Count > 0) { <div><dt>ارائه‌دهندگان</dt><dd>@LocalizedDate.FormatNumber(Providers.Count, UiLocale.Language)</dd></div> }
            @if (Branches.Count > 0) { <div><dt>شعب فعال</dt><dd>@LocalizedDate.FormatNumber(Branches.Count, UiLocale.Language)</dd></div> }
            <div><dt>نظرات منتشرشده</dt><dd>@LocalizedDate.FormatNumber(PublishedReviewCount, UiLocale.Language)</dd></div>
        </dl>

        <div class="directory-grid">
            <div class="directory-content">
                @if (Services.Count > 0)
                {
                    <section class="directory-panel" aria-labelledby="directory-services"><div class="panel-head"><div><h2 id="directory-services">خدمات</h2><p>@LocalizedDate.FormatNumber(Services.Count, UiLocale.Language) خدمت قابل رزرو</p></div></div><div class="directory-links">@foreach (var item in Services) { <a href="@item.Url"><span class="directory-item-icon" aria-hidden="true">✦</span><span class="directory-item-copy"><b data-i18n-skip>@item.Label</b><small>@item.Description</small></span><span class="directory-item-arrow" aria-hidden="true">←</span></a> }</div></section>
                }
                @if (Providers.Count > 0)
                {
                    <section class="directory-panel" aria-labelledby="directory-providers"><div class="panel-head"><div><h2 id="directory-providers">ارائه‌دهندگان</h2><p>@LocalizedDate.FormatNumber(Providers.Count, UiLocale.Language) متخصص و عضو تیم</p></div></div><div class="directory-links">@foreach (var item in Providers) { <a href="@item.Url"><span class="directory-item-icon" aria-hidden="true">◎</span><span class="directory-item-copy"><b data-i18n-skip>@item.Label</b><small data-i18n-skip>@item.Description</small></span><span class="directory-item-arrow" aria-hidden="true">←</span></a> }</div></section>
                }
                @if (Branches.Count > 0)
                {
                    <section class="directory-panel" aria-labelledby="directory-branches"><div class="panel-head"><div><h2 id="directory-branches">شعب</h2><p>@LocalizedDate.FormatNumber(Branches.Count, UiLocale.Language) شعبه فعال</p></div></div><div class="directory-links">@foreach (var item in Branches) { <a href="@item.Url"><span class="directory-item-icon" aria-hidden="true">⌖</span><span class="directory-item-copy"><b data-i18n-skip>@item.Label</b><small data-i18n-skip>@item.Description</small></span><span class="directory-item-arrow" aria-hidden="true">←</span></a> }</div></section>
                }
                @if (Services.Count == 0 && Providers.Count == 0 && Branches.Count == 0)
                {
                    <section class="directory-panel"><p class="empty-state">هنوز خدمت قابل رزروی برای این بخش تعریف نشده است.</p></section>
                }
            </div>
            <aside class="directory-panel directory-reviews" aria-labelledby="directory-reviews-title">
                <div class="review-summary">
                    <div><strong>@(PublishedReviewCount == 0 ? "—" : LocalizedDate.FormatNumber(Average, UiLocale.Language, "0.0"))</strong><span class="stars" aria-hidden="true">@SummaryStars</span></div>
                    <p>@(PublishedReviewCount == 0 ? "هنوز نظری منتشر نشده است" : $"میانگین امتیاز از ۵، بر پایه {LocalizedDate.FormatNumber(PublishedReviewCount, UiLocale.Language)} نظر منتشرشده")</p>
                </div>
                <h2 id="directory-reviews-title">امتیازها و نظرات</h2>
                @if (PublishedReviewCount > Reviews.Count) { <p class="directory-review-limit">@LocalizedDate.FormatNumber(Reviews.Count, UiLocale.Language) نظر اخیر</p> }
                @if (Reviews.Count == 0) { <p class="empty-state">هنوز نظری برای این مورد منتشر نشده است.</p> }
                @foreach (var review in Reviews)
                {
                    <article><header><b data-i18n-skip>@review.Author</b><span class="stars" aria-label="@($"{LocalizedDate.FormatNumber(review.Rating, UiLocale.Language)} از ۵ ستاره")">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span></header><small>@LocalizedDate.Format(DateOnly.FromDateTime(review.CreatedAt.UtcDateTime), UiLocale.Language)</small><p data-i18n-skip>@review.Comment</p>@if (!string.IsNullOrWhiteSpace(review.Reply)) { <blockquote>پاسخ مجموعه: <span data-i18n-skip>@review.Reply</span></blockquote> }</article>
                }
            </aside>
        </div>
    }
</section>

@code {
    [Parameter] public Guid? BusinessId { get; set; }
    [Parameter] public Guid? BranchId { get; set; }
    [Parameter] public Guid? ProviderId { get; set; }
    [Parameter] public Guid? ServiceId { get; set; }

    private bool IsLoading = true, NotFound;
    private string Title = "", Subtitle = "", SubtitleCategory = "", Description = "", KindLabel = "", Icon = "✦";
    private Guid? BusinessIdForBooking;
    private string CurrentPath = "/";
    private string BookingQuery = "";
    private List<LinkItem> ParentLinks = [], Services = [], Providers = [], Branches = [];
    private List<string> Metadata = [];
    private List<ReviewView> Reviews = [];
    private int PublishedReviewCount;
    private double Average;
    private string SummaryStars => new string('★', RoundedRating) + new string('☆', 5 - RoundedRating);
    private int RoundedRating => PublishedReviewCount == 0 ? 0 : Math.Clamp((int)Math.Round(Average, MidpointRounding.AwayFromZero), 0, 5);

    // دکمه‌ی رزرو، شعبه/خدمت/ارائه‌دهنده‌ی همین صفحه را از پیش انتخاب می‌کند.
    private string BookingHref(Guid businessId) =>
        $"/book/{businessId}?returnUrl={Uri.EscapeDataString(CurrentPath)}{BookingQuery}";

    public override Task SetParametersAsync(ParameterView parameters)
    {
        // Each of the four routes supplies only its own ID; discard IDs from a prior route.
        BusinessId = BranchId = ProviderId = ServiceId = null;
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true; NotFound = false; ParentLinks = []; Services = []; Providers = []; Branches = []; Reviews = []; Metadata = [];
        Title = Subtitle = SubtitleCategory = Description = KindLabel = BookingQuery = "";
        BusinessIdForBooking = null; CurrentPath = "/"; PublishedReviewCount = 0; Average = 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (BusinessId is Guid businessId) await LoadBusiness(db, businessId);
        else if (BranchId is Guid branchId) await LoadBranch(db, branchId);
        else if (ProviderId is Guid providerId) await LoadProvider(db, providerId);
        else if (ServiceId is Guid serviceId) await LoadService(db, serviceId);
        else NotFound = true;
        IsLoading = false;
    }

    private async Task LoadBusiness(AppDbContext db, Guid id)
    {
        var item = await db.Businesses.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
        if (item is null) { NotFound = true; return; }
        Title = item.Name; SubtitleCategory = item.Category; Subtitle = item.City; Description = item.Description; KindLabel = "کسب‌وکار"; Icon = "ب"; BusinessIdForBooking = id; CurrentPath = $"/business/{id}";
        Branches = (await db.Branches.AsNoTracking().Where(x => x.BusinessId == id).OrderBy(x => x.Name).ToListAsync()).Select(x => new LinkItem(x.Name, x.Address, $"/branch/{x.Id}")).ToList();
        // فقط خدماتی که حداقل به یک شعبه متصل‌اند قابل رزروند.
        var services = await db.BranchServices.AsNoTracking().Include(x => x.Service)
            .Where(x => x.Service.BusinessId == id && x.Branch.DeletedAt == null)
            .Select(x => x.Service).Distinct().OrderBy(x => x.Name).ToListAsync();
        Services = services.Select(x => new LinkItem(x.Name, ServiceMetadata(x.DurationMinutes, x.Price), $"/service/{x.Id}")).ToList();
        Providers = (await db.Resources.AsNoTracking().Include(x => x.Branch).Where(x => x.Branch.BusinessId == id && x.Kind == "staff").OrderBy(x => x.Name).ToListAsync()).Select(x => new LinkItem(x.Name, x.Branch.Name, $"/provider/{x.Id}")).ToList();
        Reviews = await LoadReviews(db, q => q.Where(x => x.BusinessId == id));
    }

    private async Task LoadBranch(AppDbContext db, Guid id)
    {
        var item = await db.Branches.AsNoTracking().Include(x => x.Business).FirstOrDefaultAsync(x => x.Id == id);
        if (item is null) { NotFound = true; return; }
        var hours = $"ساعت کاری {LocalizedDate.FormatNumber(item.OpenHour, UiLocale.Language)}:۰۰ تا {LocalizedDate.FormatNumber(item.CloseHour, UiLocale.Language)}:۰۰";
        Title = item.Name; Subtitle = string.IsNullOrWhiteSpace(item.Address) ? item.Business.Name : item.Address; Metadata = [hours]; KindLabel = "شعبه"; Icon = "⌖"; BusinessIdForBooking = item.BusinessId; CurrentPath = $"/branch/{id}";
        BookingQuery = $"&branch={id}";
        ParentLinks.Add(new(item.Business.Name, "مشاهده کسب‌وکار", $"/business/{item.BusinessId}"));
        Services = (await db.BranchServices.AsNoTracking().Include(x => x.Service).Where(x => x.BranchId == id).OrderBy(x => x.Service.Name).ToListAsync()).Select(x => new LinkItem(x.Service.Name, ServiceMetadata(x.Service.DurationMinutes, x.Price ?? x.Service.Price), $"/service/{x.ServiceId}")).ToList();
        Providers = (await db.Resources.AsNoTracking().Where(x => x.BranchId == id && x.Kind == "staff").OrderBy(x => x.Name).ToListAsync()).Select(x => new LinkItem(x.Name, item.Name, $"/provider/{x.Id}")).ToList();
        Reviews = await LoadReviews(db, q => q.Where(x => x.BranchId == id));
    }

    private async Task LoadProvider(AppDbContext db, Guid id)
    {
        var item = await db.Resources.AsNoTracking().Include(x => x.Branch).ThenInclude(x => x.Business).FirstOrDefaultAsync(x => x.Id == id && x.Kind == "staff");
        if (item is null) { NotFound = true; return; }
        Title = item.Name; Subtitle = $"{item.Branch.Name} · {item.Branch.Business.Name}"; KindLabel = "ارائه‌دهنده"; Icon = "◎"; BusinessIdForBooking = item.Branch.BusinessId; CurrentPath = $"/provider/{id}";
        BookingQuery = $"&branch={item.BranchId}&provider={id}";
        ParentLinks = [new(item.Branch.Business.Name, "کسب‌وکار", $"/business/{item.Branch.BusinessId}"), new(item.Branch.Name, "شعبه", $"/branch/{item.BranchId}")];
        var branchServices = await db.BranchServices.AsNoTracking().Include(x => x.Service).Where(x => x.BranchId == item.BranchId && x.Service.ServiceResources.Any(r => r.ResourceId == id)).OrderBy(x => x.Service.Name).ToListAsync();
        Services = branchServices.Select(x => new LinkItem(x.Service.Name, ServiceMetadata(x.Service.DurationMinutes, x.Price ?? x.Service.Price), $"/service/{x.ServiceId}")).ToList();
        Reviews = await LoadReviews(db, q => q.Where(x => x.Appointment != null && x.Appointment.ResourceId == id));
    }

    private async Task LoadService(AppDbContext db, Guid id)
    {
        var item = await db.Services.AsNoTracking().Include(x => x.Business).FirstOrDefaultAsync(x => x.Id == id);
        if (item is null) { NotFound = true; return; }
        Title = item.Name; Subtitle = item.Business.Name; Description = item.Description; Metadata = [ServiceMetadata(item.DurationMinutes, item.Price)]; KindLabel = "خدمت"; Icon = "✦"; BusinessIdForBooking = item.BusinessId; CurrentPath = $"/service/{id}";
        BookingQuery = $"&service={id}";
        ParentLinks.Add(new(item.Business.Name, "کسب‌وکار", $"/business/{item.BusinessId}"));
        Branches = (await db.BranchServices.AsNoTracking().Include(x => x.Branch).Where(x => x.ServiceId == id).OrderBy(x => x.Branch.Name).ToListAsync()).Select(x => new LinkItem(x.Branch.Name, x.Branch.Address, $"/branch/{x.BranchId}")).ToList();
        Providers = (await db.ServiceResources.AsNoTracking().Include(x => x.Resource).ThenInclude(x => x.Branch).Where(x => x.ServiceId == id && x.Resource.Kind == "staff").OrderBy(x => x.Resource.Name).ToListAsync()).Select(x => new LinkItem(x.Resource.Name, x.Resource.Branch.Name, $"/provider/{x.ResourceId}")).ToList();
        Reviews = await LoadReviews(db, q => q.Where(x => x.Appointment != null && (x.Appointment.ServiceId == id || x.Appointment.Services.Any(s => s.ServiceId == id))));
    }

    // فقط نام نویسنده خوانده می‌شود؛ Include(Customer) قبلاً کل ردیف کاربر شامل بایت‌های عکس را می‌آورد.
    private async Task<List<ReviewView>> LoadReviews(AppDbContext db, Func<IQueryable<Review>, IQueryable<Review>> scope)
    {
        var query = scope(db.Reviews.AsNoTracking().Where(x => x.Status == ReviewStatus.Published));
        var summary = await query.GroupBy(x => 1).Select(x => new { Count = x.Count(), Average = x.Average(r => r.Rating) }).SingleOrDefaultAsync();
        PublishedReviewCount = summary?.Count ?? 0;
        Average = summary?.Average ?? 0;
        return await query
            .OrderByDescending(x => x.CreatedAt)
            .Take(20)
            .Select(x => new ReviewView(x.Customer.DisplayName, x.Rating, x.CreatedAt, x.Comment, x.ManagerReply))
            .ToListAsync();
    }

    private string ServiceMetadata(int duration, decimal price) =>
        $"{LocalizedDate.FormatNumber(duration, UiLocale.Language)} دقیقه · {LocalizedDate.FormatNumber(price, UiLocale.Language, "N0")} تومان";

    private sealed record LinkItem(string Label, string Description, string Url);
    private sealed record ReviewView(string Author, int Rating, DateTimeOffset CreatedAt, string Comment, string? Reply);
}
