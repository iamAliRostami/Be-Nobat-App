@page "/favorites"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>علاقه‌مندی‌ها | به‌نوبت</PageTitle>
<div class="account-page">
    <AccountMenu UserId="@UserId" DisplayName="@DisplayName" Email="@Email"
                 AvatarContentType="@AvatarContentType" ConcurrencyStamp="@ConcurrencyStamp" />
    <main class="account-content favorites-page">
        <div class="page-title"><div><h1>کسب‌وکارهای مورد علاقه</h1><p>انتخاب‌های شما برای رزروهای بعدی</p></div></div>
        @if (!Loaded)
        {
            <p class="empty-state">در حال دریافت علاقه‌مندی‌ها…</p>
        }
        else if (Items.Count == 0)
        {
            <p class="empty-state">هنوز کسب‌وکاری را به علاقه‌مندی‌ها اضافه نکرده‌اید. از صفحه‌ی اصلی روی دکمه‌ی قلب بزنید. <a class="entity-link" href="/#businesses">دیدن کسب‌وکارها ←</a></p>
        }
        else
        {
            <div class="business-grid">
                @foreach (var business in Items)
                {
                    <BusinessCard @key="business.Id" Id="@business.Id" Name="@business.Name" Category="@business.Category" City="@business.City"
                                  Location="@(business.Branches.FirstOrDefault()?.Address ?? business.City)"
                                  Rating="@Rating(business)" ReviewCount="@business.Reviews.Count"
                                  ReturnUrl="/favorites" UserId="@UserId" IsFavorite="true"
                                  OnToggled="@(isFavorite => OnToggled(business.Id, isFavorite))" />
                }
            </div>
        }
    </main>
</div>

@code {
    private List<Business> Items = [];
    private Guid? UserId;
    private string DisplayName = "";
    private string Email = "";
    private string? AvatarContentType;
    private string? ConcurrencyStamp;
    private bool Loaded;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        UserId = UserContext.IdOf(user);
        if (UserId is not Guid userId) { Loaded = true; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var profile = await db.Users.AsNoTracking().Where(x => x.Id == userId)
            .Select(x => new { x.DisplayName, x.Email, x.AvatarContentType, x.ConcurrencyStamp }).FirstOrDefaultAsync();
        DisplayName = string.IsNullOrWhiteSpace(profile?.DisplayName) ? (user.Identity?.Name ?? "کاربر") : profile!.DisplayName;
        Email = profile?.Email ?? "";
        AvatarContentType = profile?.AvatarContentType;
        ConcurrencyStamp = profile?.ConcurrencyStamp;
        var favorites = await FavoritesQuery(db, userId).ToListAsync();
        Items = favorites.Select(x => x.Business).ToList();
        Loaded = true;
    }

    // Load the favorite's navigation graph before projecting to businesses.
    // EF cannot apply collection Includes after selecting a navigation entity.
    private static IQueryable<FavoriteBusiness> FavoritesQuery(AppDbContext db, Guid userId) =>
        db.FavoriteBusinesses.AsNoTracking()
            .Where(x => x.UserId == userId && x.Business.DeletedAt == null)
            .Include(x => x.Business).ThenInclude(x => x.Branches)
            .Include(x => x.Business).ThenInclude(x => x.Reviews.Where(r => r.Status == ReviewStatus.Published))
            .OrderByDescending(x => x.CreatedAt);

    // کارتی که از علاقه‌مندی‌ها برداشته شد، بلافاصله از همین صفحه حذف می‌شود.
    private void OnToggled(Guid businessId, bool isFavorite)
    {
        if (!isFavorite) Items.RemoveAll(x => x.Id == businessId);
    }

    private string Rating(Business business) => business.Reviews.Count == 0
        ? "—"
        : LocalizedDate.FormatNumber(Math.Round(business.Reviews.Average(x => x.Rating), 1), UiLocale.Language, "0.0");
}
