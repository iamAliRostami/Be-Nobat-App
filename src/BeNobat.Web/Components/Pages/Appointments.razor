@page "/appointments"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ViewOwnAppointments)]
@using System.Globalization
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<Appointments> Logger

<PageTitle>نوبت‌های من | به‌نوبت</PageTitle>

<div class="account-page">
    <aside class="account-menu">
        <div class="account-user">
            @if (UserAvatar.Has(CurrentUser))
            {
                <img class="customer-avatar" src="@UserAvatar.Url(CurrentUser!)" alt="" />
            }
            else
            {
                <span>@Initials</span>
            }
            <div><b>@DisplayName</b><small>@Email</small></div>
        </div>
        <nav>
            <NavLink href="/appointments" Match="NavLinkMatch.All">▦ نوبت‌های من</NavLink>
            <NavLink href="/account/profile" Match="NavLinkMatch.All">◈ اطلاعات حساب</NavLink>
        </nav>
        <form method="post" action="/account/logout"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="logout">خروج از حساب</button></form>
    </aside>
    <main class="account-content">
        <div class="page-title"><div><h1>نوبت‌های من</h1><p>نوبت‌های پیش رو و سوابق مراجعه</p></div><a class="primary-button" href="/">+ رزرو نوبت جدید</a></div>
        @if (ReviewMessage is not null) { <div class="success-notice">@ReviewMessage</div> }
        @if (ActionError is not null) { <div class="auth-error">@ActionError</div> }
        <div class="tabs">
            <button type="button" class="@(ActiveTab == "upcoming" ? "active" : "")" @onclick='() => ActiveTab = "upcoming"'>پیش رو <b>@Upcoming.Count</b></button>
            <button type="button" class="@(ActiveTab == "past" ? "active" : "")" @onclick='() => ActiveTab = "past"'>گذشته</button>
            <button type="button" class="@(ActiveTab == "cancelled" ? "active" : "")" @onclick='() => ActiveTab = "cancelled"'>لغو شده</button>
        </div>

        @{
            var visible = ActiveTab switch
            {
                "past" => Past,
                "cancelled" => Cancelled,
                _ => Upcoming,
            };
        }

        @if (visible.Count == 0)
        {
            <p class="empty-state">موردی برای نمایش وجود ندارد.</p>
        }

        @foreach (var appointment in visible)
        {
            <article class="appointment-card">
                <div class="appointment-date"><b>@appointment.StartsAt.Day</b><span>@PersianMonthName(appointment.StartsAt)</span><small>@appointment.StartsAt.ToString("dddd", PersianCulture)</small></div>
                <div class="appointment-info">
                    <span class="@StatusCssClass(appointment.Status)">● @StatusLabel(appointment.Status)</span>
                    <h3>@ServiceLabel(appointment)</h3>
                    <p>@appointment.Branch.Business.Name · @appointment.Branch.Name · @(appointment.Resource?.Name ?? "بدون کارمند")</p>
                    <div><span>◷ ساعت @appointment.StartsAt.ToString("HH:mm") تا @appointment.EndsAt.ToString("HH:mm")</span><span>⌖ @appointment.Branch.Address</span></div>
                </div>
                <div class="appointment-actions">
                    @if (BookingPolicy.CanCustomerCancel(appointment, DateTimeOffset.UtcNow))
                    {
                        <button type="button" class="outline" @onclick="() => CancelAsync(appointment.Id)">لغو نوبت</button>
                    }
                    @* [feature] ثبت نظر مستقیماً از همین فهرست؛ قبلاً فقط از صفحه‌ی
                       «اطلاعات حساب» و با انتخاب از یک لیست کشویی ممکن بود. *@
                    @if (CanReview(appointment) && !ReviewedAppointmentIds.Contains(appointment.Id))
                    {
                        <button type="button" @onclick="() => OpenReview(appointment)">ثبت نظر</button>
                    }
                    else if (CanReview(appointment))
                    {
                        <span class="review-done">نظر ثبت شد</span>
                    }
                </div>
            </article>
        }
    </main>
</div>

@if (Reviewing is not null)
{
    <div class="modal-backdrop" @onclick="CloseReview">
        @* This is an interactive-only action and has no validation pipeline. Keeping it in an
           EditForm allowed the browser to fall back to a native POST while the server circuit
           was reconnecting, producing the "POST request does not specify which form" page.
           An explicit Blazor click keeps the action in the circuit and also lets us prevent
           duplicate submissions while the database write is in progress. *@
        <div class="form-modal" role="dialog" aria-modal="true" aria-labelledby="review-dialog-title" @onclick:stopPropagation>
            <div><h2 id="review-dialog-title">نظر درباره‌ی @Reviewing.Service.Name</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="CloseReview">×</button></div>
            <label>امتیاز
                <select disabled="@IsSubmittingReview" @bind="ReviewForm.Rating">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <option value="@i">@i ستاره</option>
                    }
                </select>
            </label>
            <label>نظر شما<textarea disabled="@IsSubmittingReview" @bind="ReviewForm.Comment"></textarea></label>
            @if (ReviewError is not null) { <div class="auth-error">@ReviewError</div> }
            <button type="button" class="primary-button" disabled="@IsSubmittingReview" @onclick="SubmitReview">
                @(IsSubmittingReview ? "در حال ارسال…" : "ارسال برای بررسی")
            </button>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid userId;
    private string DisplayName = "";
    private string Email = "";
    private string Initials = "؟";
    private string ActiveTab = "upcoming";

    private AppUser? CurrentUser;
    private HashSet<Guid> ReviewedAppointmentIds = [];
    private Appointment? Reviewing;
    private ReviewInput ReviewForm = new();
    private string? ReviewError;
    private string? ReviewMessage;
    private string? ActionError;
    private bool IsSubmittingReview;

    private List<Appointment> Upcoming = [];
    private List<Appointment> Past = [];
    private List<Appointment> Cancelled = [];

    private static readonly CultureInfo PersianCulture = new("fa-IR");
    private static readonly string[] PersianMonths =
    [
        "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
        "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask!;
        var idText = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idText is null || !Guid.TryParse(idText, out userId)) return;

        DisplayName = authState.User.FindFirst("DisplayName")?.Value
            ?? authState.User.Identity?.Name
            ?? "کاربر";
        Email = authState.User.FindFirst(ClaimTypes.Email)?.Value ?? authState.User.Identity?.Name ?? "";
        var parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        Initials = parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : DisplayName[..Math.Min(2, DisplayName.Length)];

        await using var db = await DbFactory.CreateDbContextAsync();
        CurrentUser = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var appointments = await db.Appointments
            .AsNoTracking()
            .Include(a => a.Service)
            .Include(a => a.Services).ThenInclude(x => x.Service)
            .Include(a => a.Resource)
            .Include(a => a.Branch).ThenInclude(b => b.Business)
            .Where(a => a.CustomerId == userId)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();

        ReviewedAppointmentIds = (await db.Reviews
            .AsNoTracking()
            .Where(r => r.CustomerId == userId && r.AppointmentId != null)
            .Select(r => r.AppointmentId!.Value)
            .ToListAsync()).ToHashSet();

        var now = DateTimeOffset.Now;
        Cancelled = appointments.Where(a => a.Status == AppointmentStatus.Cancelled).ToList();
        Upcoming = appointments.Where(a => a.Status != AppointmentStatus.Cancelled && a.EndsAt >= now).ToList();
        Past = appointments.Where(a => a.Status != AppointmentStatus.Cancelled && a.EndsAt < now)
            .OrderByDescending(a => a.StartsAt).ToList();
    }

    private static string ServiceLabel(Appointment appointment) => appointment.Services.Count == 0
        ? appointment.Service.Name
        : string.Join("، ", appointment.Services.Select(x => x.Service.Name));

    private async Task CancelAsync(Guid appointmentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var appointment = await db.Appointments.FirstOrDefaultAsync(a => a.Id == appointmentId && a.CustomerId == userId);
        if (appointment is null) return;
        if (!BookingPolicy.CanCustomerCancel(appointment, DateTimeOffset.UtcNow))
        {
            ActionError = "لغو اینترنتی فقط تا دو ساعت پیش از شروع نوبت امکان‌پذیر است؛ برای موارد فوری با شعبه تماس بگیرید.";
            return;
        }

        appointment.Status = AppointmentStatus.Cancelled;
        appointment.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        ActionError = null;
        await LoadAsync();
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };

    private void OpenReview(Appointment appointment)
    {
        Reviewing = appointment;
        ReviewForm = new ReviewInput();
        IsSubmittingReview = false;
        ReviewError = null;
        ReviewMessage = null;
    }

    private void CloseReview()
    {
        Reviewing = null;
        ReviewError = null;
    }

    private async Task SubmitReview()
    {
        if (Reviewing is null || IsSubmittingReview) return;

        IsSubmittingReview = true;
        ReviewError = null;

        var appointmentId = Reviewing.Id;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var appointment = await db.Appointments
                .Include(a => a.Branch)
                .FirstOrDefaultAsync(a => a.Id == appointmentId
                    && a.CustomerId == userId
                    && (a.Status == AppointmentStatus.Completed || (a.Status == AppointmentStatus.Confirmed && a.EndsAt < DateTimeOffset.Now)));
            if (appointment is null)
            {
                ReviewError = "فقط مراجعه‌کننده‌ی این نوبت می‌تواند پس از تکمیل خدمت امتیاز ثبت کند.";
                return;
            }

            if (await db.Reviews.AnyAsync(r => r.AppointmentId == appointmentId))
            {
                ReviewError = "برای این نوبت قبلاً نظر ثبت شده است.";
                return;
            }

            db.Reviews.Add(new Review
            {
                AppointmentId = appointmentId,
                BusinessId = appointment.Branch.BusinessId,
                BranchId = appointment.BranchId,
                CustomerId = userId,
                Rating = Math.Clamp(ReviewForm.Rating, 1, 5),
                Comment = ReviewForm.Comment.Trim(),
            });

            await db.SaveChangesAsync();
            Reviewing = null;
            await LoadAsync();
            ReviewMessage = "امتیاز و نظر شما برای این خدمت ثبت شد و پس از بررسی نمایش داده می‌شود.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to submit review for appointment {AppointmentId}", appointmentId);
            ReviewError = "ثبت نظر انجام نشد. لطفاً اتصال خود را بررسی کرده و دوباره تلاش کنید.";
        }
        finally
        {
            IsSubmittingReview = false;
        }
    }

    private sealed class ReviewInput
    {
        public int Rating { get; set; } = 5;
        public string Comment { get; set; } = "";
    }

    private static bool CanReview(Appointment appointment) => appointment.Status == AppointmentStatus.Completed
        || (appointment.Status == AppointmentStatus.Confirmed && appointment.EndsAt < DateTimeOffset.Now);

    private static string PersianMonthName(DateTimeOffset date)
    {
        var calendar = new PersianCalendar();
        return PersianMonths[calendar.GetMonth(date.LocalDateTime) - 1];
    }
}
