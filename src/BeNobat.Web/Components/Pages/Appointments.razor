@page "/appointments"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ViewOwnAppointments)]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject ILogger<Appointments> Logger

<PageTitle>نوبت‌های من | به‌نوبت</PageTitle>

<div class="account-page">
    <AccountMenu UserId="@userId" DisplayName="@DisplayName" Email="@Email"
                 AvatarContentType="@AvatarContentType" ConcurrencyStamp="@ConcurrencyStamp" />
    <main class="account-content">
        <div class="page-title"><div><h1>نوبت‌های من</h1><p>نوبت‌های پیش رو و سوابق مراجعه</p></div><a class="primary-button" href="/">+ رزرو نوبت جدید</a></div>
        @if (ReviewMessage is not null) { <div class="success-notice" role="status">@ReviewMessage</div> }
        @if (ActionError is not null) { <div class="auth-error" role="alert">@ActionError</div> }
        <div class="tabs">
            <button type="button" class="@(ActiveTab == "upcoming" ? "active" : "")" @onclick='() => ActiveTab = "upcoming"'>پیش رو <b>@Upcoming.Count</b></button>
            <button type="button" class="@(ActiveTab == "past" ? "active" : "")" @onclick='() => ActiveTab = "past"'>گذشته <b>@Past.Count</b></button>
            <button type="button" class="@(ActiveTab == "cancelled" ? "active" : "")" @onclick='() => ActiveTab = "cancelled"'>لغو شده <b>@Cancelled.Count</b></button>
        </div>

        @{
            var visible = ActiveTab switch
            {
                "past" => Past,
                "cancelled" => Cancelled,
                _ => Upcoming,
            };
        }

        @if (!Loaded)
        {
            <p class="empty-state">در حال دریافت نوبت‌ها…</p>
        }
        else if (visible.Count == 0)
        {
            <p class="empty-state">@(ActiveTab == "upcoming" ? "نوبت پیش‌رویی ندارید. " : "موردی برای نمایش وجود ندارد. ")<a class="entity-link" href="/#businesses">رزرو نوبت جدید ←</a></p>
        }

        @foreach (var appointment in visible)
        {
            var zone = appointment.Branch.TimeZoneId;
            var localDate = BranchClock.LocalDate(appointment.StartsAt, zone);
            var dateParts = LocalizedDate.DayAndMonth(localDate, Language);
            <article class="appointment-card" @key="appointment.Id">
                <div class="appointment-date"><b>@dateParts.Day</b><span>@dateParts.Month</span><small>@LocalizedDate.Weekday(localDate, Language)</small></div>
                <div class="appointment-info">
                    <span class="@StatusCssClass(appointment.Status)">● @StatusLabel(appointment.Status)</span>
                    <h3 class="appointment-service-links">
                        @if (appointment.Services.Count == 0)
                        {
                            <a class="entity-link" href="/service/@appointment.ServiceId">@appointment.Service.Name</a>
                        }
                        else
                        {
                            @foreach (var item in appointment.Services)
                            {
                                <a class="entity-link" href="/service/@item.ServiceId">@item.Service.Name</a>
                            }
                        }
                    </h3>
                    <p class="appointment-entity-links">
                        <a class="entity-link" href="/business/@appointment.Branch.BusinessId">@appointment.Branch.Business.Name</a>
                        <span aria-hidden="true">·</span>
                        <a class="entity-link" href="/branch/@appointment.BranchId">@appointment.Branch.Name</a>
                        @if (appointment.Resource is not null)
                        {
                            <span aria-hidden="true">·</span><a class="entity-link" href="/provider/@appointment.ResourceId">@appointment.Resource.Name</a>
                        }
                    </p>
                    <div><span>◷ ساعت @BranchClock.FormatTime(appointment.StartsAt, zone, Language) تا @BranchClock.FormatTime(appointment.EndsAt, zone, Language)</span><span>⌖ <a class="entity-link" href="/branch/@appointment.BranchId">@(string.IsNullOrWhiteSpace(appointment.Branch.Address) ? appointment.Branch.Name : appointment.Branch.Address)</a></span><span>💳 @LocalizedDate.FormatNumber(appointment.FinalPrice, Language, "N0") تومان</span><span>کد پیگیری: <bdi>@appointment.TrackingCode</bdi></span></div>
                    @if (appointment.Status == AppointmentStatus.Pending)
                    {
                        <small class="appointment-hint">منتظر تأیید مجموعه است؛ پس از تأیید وضعیت اینجا تغییر می‌کند.</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(appointment.CustomerNote))
                    {
                        <small class="appointment-hint">توضیح شما: @appointment.CustomerNote</small>
                    }
                </div>
                <div class="appointment-actions">
                    @if (BookingPolicy.CanCustomerCancel(appointment, DateTimeOffset.UtcNow))
                    {
                        <button type="button" class="action-danger" @onclick="() => AskCancel(appointment)">لغو نوبت</button>
                    }
                    else if (BookingPolicy.IsActiveFuture(appointment, DateTimeOffset.UtcNow) && appointment.StartsAt > DateTimeOffset.UtcNow)
                    {
                        <small class="appointment-hint">لغو اینترنتی بسته شده؛ با شعبه تماس بگیرید.</small>
                    }
                    @if (BookingPolicy.CanCustomerReview(appointment, DateTimeOffset.UtcNow) && !ReviewedAppointmentIds.Contains(appointment.Id))
                    {
                        <button type="button" class="action-secondary" @onclick="() => OpenReview(appointment)">ثبت نظر</button>
                    }
                    else if (BookingPolicy.CanCustomerReview(appointment, DateTimeOffset.UtcNow))
                    {
                        <span class="review-done">نظر ثبت شد</span>
                    }
                    @if (appointment.EndsAt < DateTimeOffset.UtcNow || appointment.Status == AppointmentStatus.Cancelled)
                    {
                        <a class="outline-link" href="@RebookUrl(appointment)">رزرو مجدد</a>
                    }
                </div>
            </article>
        }
    </main>
</div>

@if (Cancelling is not null)
{
    <div class="modal-backdrop" @onclick="CloseCancel">
        <div class="form-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div><h2>لغو نوبت</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="CloseCancel">×</button></div>
            <p>نوبت «@ServiceLabel(Cancelling)» در @BranchClock.FormatDateTime(Cancelling.StartsAt, Cancelling.Branch.TimeZoneId, Language) لغو شود؟ این کار قابل بازگشت نیست.</p>
            <button type="button" class="action-danger" disabled="@IsCancelling" @onclick="ConfirmCancel">@(IsCancelling ? "در حال لغو…" : "بله، لغو شود")</button>
            <button type="button" class="outline-link" disabled="@IsCancelling" @onclick="CloseCancel">انصراف</button>
        </div>
    </div>
}

@if (Reviewing is not null)
{
    <div class="modal-backdrop" @onclick="CloseReview">
        @* یک کلیک صریح Blazor به‌جای EditForm: فرم می‌توانست هنگام قطع موقت مدار به POST بومی مرورگر برگردد
           و صفحه‌ی «POST request does not specify which form» بدهد؛ همچنین ارسال تکراری را مهار می‌کند. *@
        <div class="form-modal" role="dialog" aria-modal="true" aria-labelledby="review-dialog-title" @onclick:stopPropagation>
            <div><h2 id="review-dialog-title">نظر درباره‌ی @ServiceLabel(Reviewing)</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="CloseReview">×</button></div>
            <div class="star-picker" role="radiogroup" aria-label="امتیاز">
                @for (var i = 1; i <= 5; i++)
                {
                    var value = i;
                    <button type="button" role="radio" aria-checked="@(ReviewForm.Rating == value ? "true" : "false")" aria-label="@value ستاره" class="@(value <= ReviewForm.Rating ? "on" : "")" disabled="@IsSubmittingReview" @onclick="() => ReviewForm.Rating = value">★</button>
                }
            </div>
            <label>نظر شما (اختیاری)<textarea maxlength="1000" disabled="@IsSubmittingReview" @bind="ReviewForm.Comment" @bind:event="oninput"></textarea></label>
            @if (ReviewError is not null) { <div class="auth-error" role="alert">@ReviewError</div> }
            <button type="button" class="primary-button" disabled="@IsSubmittingReview" @onclick="SubmitReview">
                @(IsSubmittingReview ? "در حال ارسال…" : "ارسال برای بررسی")
            </button>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid userId;
    private string DisplayName = "";
    private string Email = "";
    private string? AvatarContentType;
    private string? ConcurrencyStamp;
    private string ActiveTab = "upcoming";
    private string Language = "fa";
    private bool Loaded;

    private HashSet<Guid> ReviewedAppointmentIds = [];
    private Appointment? Reviewing;
    private Appointment? Cancelling;
    private ReviewInput ReviewForm = new();
    private string? ReviewError;
    private string? ReviewMessage;
    private string? ActionError;
    private bool IsSubmittingReview;
    private bool IsCancelling;

    private List<Appointment> Upcoming = [];
    private List<Appointment> Past = [];
    private List<Appointment> Cancelled = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask;
        if (UserContext.IdOf(authState.User) is not Guid id) return;
        userId = id;

        await using var db = await DbFactory.CreateDbContextAsync();
        // فقط ستون‌های سبک؛ بایت‌های عکس پروفایل خوانده نمی‌شود.
        var row = await db.Users.AsNoTracking().Where(u => u.Id == userId)
            .Select(u => new { u.DisplayName, u.Email, u.AvatarContentType, u.ConcurrencyStamp }).FirstOrDefaultAsync();
        DisplayName = string.IsNullOrWhiteSpace(row?.DisplayName) ? (authState.User.Identity?.Name ?? "کاربر") : row!.DisplayName;
        Email = row?.Email ?? "";
        AvatarContentType = row?.AvatarContentType;
        ConcurrencyStamp = row?.ConcurrencyStamp;

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { Language = await JS.InvokeAsync<string>("beNobat.preferences.getLanguage"); }
        catch (JSDisconnectedException) { return; }
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var appointments = await db.Appointments
            .AsNoTracking()
            .Include(a => a.Service)
            .Include(a => a.Services).ThenInclude(x => x.Service)
            .Include(a => a.Resource)
            .Include(a => a.Branch).ThenInclude(b => b.Business)
            .Where(a => a.CustomerId == userId)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();

        ReviewedAppointmentIds = (await db.Reviews
            .AsNoTracking()
            .IgnoreQueryFilters()
            .Where(r => r.CustomerId == userId && r.AppointmentId != null)
            .Select(r => r.AppointmentId!.Value)
            .ToListAsync()).ToHashSet();

        var now = DateTimeOffset.UtcNow;
        Cancelled = appointments.Where(a => a.Status == AppointmentStatus.Cancelled).OrderByDescending(a => a.StartsAt).ToList();
        Upcoming = appointments.Where(a => a.Status != AppointmentStatus.Cancelled && a.EndsAt >= now).ToList();
        Past = appointments.Where(a => a.Status != AppointmentStatus.Cancelled && a.EndsAt < now)
            .OrderByDescending(a => a.StartsAt).ToList();
        Loaded = true;
    }

    private static string ServiceLabel(Appointment appointment) => appointment.Services.Count == 0
        ? appointment.Service.Name
        : string.Join("، ", appointment.Services.Select(x => x.Service.Name));

    private static string RebookUrl(Appointment appointment)
    {
        var services = appointment.Services.Count == 0
            ? appointment.ServiceId.ToString()
            : string.Join(',', appointment.Services.Select(x => x.ServiceId));
        return $"/book/{appointment.Branch.BusinessId}?branch={appointment.BranchId}&services={services}&returnUrl=%2Fappointments";
    }

    private void AskCancel(Appointment appointment) { Cancelling = appointment; ActionError = null; ReviewMessage = null; }
    private void CloseCancel() { if (!IsCancelling) Cancelling = null; }

    private async Task ConfirmCancel()
    {
        if (Cancelling is null || IsCancelling) return;
        IsCancelling = true;
        var appointmentId = Cancelling.Id;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var appointment = await db.Appointments.FirstOrDefaultAsync(a => a.Id == appointmentId && a.CustomerId == userId);
            if (appointment is null) { Cancelling = null; return; }
            if (!BookingPolicy.CanCustomerCancel(appointment, DateTimeOffset.UtcNow))
            {
                ActionError = "لغو اینترنتی فقط تا دو ساعت پیش از شروع نوبت امکان‌پذیر است؛ برای موارد فوری با شعبه تماس بگیرید.";
                Cancelling = null;
                await LoadAsync();
                return;
            }

            appointment.Status = AppointmentStatus.Cancelled;
            appointment.UpdatedAt = DateTimeOffset.UtcNow;
            await db.SaveChangesAsync();
            ActionError = null;
            ReviewMessage = "نوبت لغو شد.";
            Cancelling = null;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to cancel appointment {AppointmentId}", appointmentId);
            ActionError = "لغو نوبت انجام نشد؛ دوباره تلاش کنید.";
            Cancelling = null;
        }
        finally
        {
            IsCancelling = false;
        }
    }

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار تأیید",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };

    private void OpenReview(Appointment appointment)
    {
        Reviewing = appointment;
        ReviewForm = new ReviewInput();
        IsSubmittingReview = false;
        ReviewError = null;
        ReviewMessage = null;
    }

    private void CloseReview()
    {
        if (IsSubmittingReview) return;
        Reviewing = null;
        ReviewError = null;
    }

    private async Task SubmitReview()
    {
        if (Reviewing is null || IsSubmittingReview) return;

        IsSubmittingReview = true;
        ReviewError = null;

        var appointmentId = Reviewing.Id;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var appointment = await db.Appointments
                .Include(a => a.Branch)
                .FirstOrDefaultAsync(a => a.Id == appointmentId && a.CustomerId == userId);

            // مقایسه‌ی زمان بیرون از SQL انجام می‌شود (timestamptz فقط UTC می‌پذیرد).
            if (appointment is null || !BookingPolicy.CanCustomerReview(appointment, DateTimeOffset.UtcNow))
            {
                ReviewError = "فقط مراجعه‌کننده‌ی این نوبت می‌تواند پس از تکمیل خدمت امتیاز ثبت کند.";
                return;
            }

            if (await db.Reviews.IgnoreQueryFilters().AnyAsync(r => r.AppointmentId == appointmentId))
            {
                ReviewError = "برای این نوبت قبلاً نظر ثبت شده است.";
                return;
            }

            db.Reviews.Add(new Review
            {
                AppointmentId = appointmentId,
                BusinessId = appointment.Branch.BusinessId,
                BranchId = appointment.BranchId,
                CustomerId = userId,
                Rating = Math.Clamp(ReviewForm.Rating, 1, 5),
                Comment = ReviewForm.Comment.Trim(),
            });

            await db.SaveChangesAsync();
            Reviewing = null;
            await LoadAsync();
            ReviewMessage = "امتیاز و نظر شما ثبت شد و پس از بررسی مجموعه نمایش داده می‌شود.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to submit review for appointment {AppointmentId}", appointmentId);
            ReviewError = "ثبت نظر انجام نشد. لطفاً اتصال خود را بررسی کرده و دوباره تلاش کنید.";
        }
        finally
        {
            IsSubmittingReview = false;
        }
    }

    private sealed class ReviewInput
    {
        public int Rating { get; set; } = 5;
        public string Comment { get; set; } = "";
    }
}
