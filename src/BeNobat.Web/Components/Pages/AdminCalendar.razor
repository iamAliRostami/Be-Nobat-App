@page "/admin/calendar"
@attribute [Authorize(Policy = Policies.ManageAppointments)]
@rendermode InteractiveServer
<PageTitle>تقویم نوبت‌ها | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>تقویم نوبت‌ها</h1><p>برنامه روزانه تیم و منابع</p></div><button @onclick="() => ShowForm = true">+ ثبت نوبت جدید</button></div><section class="admin-panel calendar-panel"><div class="calendar-toolbar"><div><button @onclick="() => DayOffset = 0">امروز</button><button @onclick="() => DayOffset--">→</button><button @onclick="() => DayOffset++">←</button><h2>@(19 + DayOffset) شهریور ۱۴۰۵</h2></div><div>@foreach(var view in new[]{"روز","هفته","ماه"}){<button class="@(View == view ? "active" : "")" @onclick="() => View = view">@view</button>}</div></div><div class="calendar-grid"><div class="staff-head"></div><div class="staff-head"><span class="customer-avatar rose">ا‌م</span><b>الناز محمدی</b></div><div class="staff-head"><span class="customer-avatar blue">م‌ر</span><b>مریم رضایی</b></div>@foreach(var hour in Hours){<time>@hour</time><div class="calendar-cell">@foreach(var item in Entries.Where(x => x.Time == hour && x.Staff == 1)){<article class="event @item.Color"><b>@item.Customer</b><small>@item.Service</small></article>}</div><div class="calendar-cell">@foreach(var item in Entries.Where(x => x.Time == hour && x.Staff == 2)){<article class="event @item.Color"><b>@item.Customer</b><small>@item.Service</small></article>}</div>}</div></section>
@if(ShowForm){<div class="modal-backdrop" @onclick="() => ShowForm = false"><section class="form-modal" @onclick:stopPropagation><div><h2>ثبت نوبت جدید</h2><button @onclick="() => ShowForm = false">×</button></div><label>نام مشتری<input @bind="Customer" /></label><label>خدمت<select @bind="Service"><option>کوتاهی مو</option><option>رنگ و لایت</option><option>اصلاح و ابرو</option></select></label><label>متخصص<select @bind="Staff"><option value="1">الناز محمدی</option><option value="2">مریم رضایی</option></select></label><label>ساعت<select @bind="Time">@foreach(var hour in Hours){<option>@hour</option>}</select></label><button class="primary-button" disabled="@(string.IsNullOrWhiteSpace(Customer))" @onclick="AddAppointment">ثبت نوبت</button></section></div>}

@code { private int DayOffset; private string View="روز"; private bool ShowForm; private string Customer=""; private string Service="کوتاهی مو"; private int Staff=1; private string Time="۰۹:۰۰"; private readonly string[] Hours=["۰۹:۰۰","۱۰:۰۰","۱۱:۰۰","۱۲:۰۰","۱۳:۰۰","۱۴:۰۰","۱۵:۰۰","۱۶:۰۰","۱۷:۰۰"]; private readonly List<CalendarEntry> Entries=[new("۱۰:۰۰",1,"نیلوفر کریمی","کوتاهی مو","rose"),new("۱۳:۰۰",1,"مریم احمدی","رنگ و لایت","green"),new("۱۱:۰۰",2,"سارا مرادی","اصلاح و ابرو","blue"),new("۱۶:۰۰",2,"زهرا حسینی","کوتاهی مو","purple")]; private void AddAppointment(){Entries.Add(new(Time,Staff,Customer.Trim(),Service,"purple"));Customer="";ShowForm=false;} private sealed record CalendarEntry(string Time,int Staff,string Customer,string Service,string Color); }
