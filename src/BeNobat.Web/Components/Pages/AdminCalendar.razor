@page "/admin/calendar"
<PageTitle>تقویم نوبت‌ها | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>تقویم نوبت‌ها</h1><p>برنامه روزانه تیم و منابع</p></div><button>+ ثبت نوبت جدید</button></div><section class="admin-panel calendar-panel"><div class="calendar-toolbar"><div><button>امروز</button><button>→</button><button>←</button><h2>۱۹ شهریور ۱۴۰۵</h2></div><div><button class="active">روز</button><button>هفته</button><button>ماه</button></div></div><div class="calendar-grid"><div class="staff-head"></div><div class="staff-head"><span class="customer-avatar rose">ا‌م</span><b>الناز محمدی</b></div><div class="staff-head"><span class="customer-avatar blue">م‌ر</span><b>مریم رضایی</b></div>@foreach(var hour in new[]{"۰۹:۰۰","۱۰:۰۰","۱۱:۰۰","۱۲:۰۰","۱۳:۰۰","۱۴:۰۰","۱۵:۰۰","۱۶:۰۰","۱۷:۰۰"}){<time>@hour</time><div class="calendar-cell">@if(hour=="۱۰:۰۰"){<article class="event rose"><b>نیلوفر کریمی</b><small>کوتاهی مو</small></article>}@if(hour=="۱۳:۰۰"){<article class="event green"><b>مریم احمدی</b><small>رنگ و لایت</small></article>}</div><div class="calendar-cell">@if(hour=="۱۱:۰۰"){<article class="event blue"><b>سارا مرادی</b><small>اصلاح و ابرو</small></article>}@if(hour=="۱۶:۰۰"){<article class="event purple"><b>زهرا حسینی</b><small>کوتاهی مو</small></article>}</div>}</div></section>

