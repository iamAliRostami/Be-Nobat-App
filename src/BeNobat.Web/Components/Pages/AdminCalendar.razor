@page "/admin/calendar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageAppointments)]
@using System.Globalization
@inject AppDbContext Db
@inject AdminAccessScope Access

<PageTitle>تقویم نوبت‌ها | به‌نوبت</PageTitle>

<div class="page-title"><div><h1>تقویم نوبت‌ها</h1><p>برنامه روزانه نوبت‌ها</p></div></div>

<section class="admin-panel calendar-panel">
    <div class="calendar-toolbar">
        <div>
            <button type="button" @onclick="() => ChangeDay(0)">امروز</button>
            <button type="button" aria-label="روز قبل" title="روز قبل" @onclick="() => ChangeDay(-1)">→</button>
            <button type="button" aria-label="روز بعد" title="روز بعد" @onclick="() => ChangeDay(1)">←</button>
            <h2>@SelectedDate.ToString("dddd، d MMMM yyyy", PersianCulture)</h2>
        </div>
    </div>

    @if (DayAppointments.Count == 0)
    {
        <p class="empty-state">برای این روز نوبتی ثبت نشده است.</p>
    }
    else
    {
        <div class="agenda-list">
            @foreach (var appointment in DayAppointments)
            {
                <article class="event-row @StatusCssClass(appointment.Status)">
                    <time>@appointment.StartsAt.ToString("HH:mm") - @appointment.EndsAt.ToString("HH:mm")</time>
                    <div>
                        <b><a class="entity-link" href="@EntityUrl("/admin/customers", CustomerName(appointment))">@CustomerName(appointment)</a></b>
                        <small><a class="entity-link" href="@EntityUrl("/businesses", ServiceLabel(appointment))">@ServiceLabel(appointment)</a> · @if (appointment.Resource is not null) { <a class="entity-link" href="@EntityUrl("/admin/team", appointment.Resource.Name)">@appointment.Resource.Name</a> } else { <text>بدون کارمند</text> } · <a class="entity-link" href="@EntityUrl("/platform", appointment.Branch.Business.Name)">@appointment.Branch.Business.Name</a> · <a class="entity-link" href="@EntityUrl("/admin/branches", appointment.Branch.Name)">@appointment.Branch.Name</a></small>
                    </div>
                    <em class="status @StatusCssClass(appointment.Status)">@StatusLabel(appointment.Status)</em>
                </article>
            }
        </div>
    }
</section>

@code {
    private static readonly CultureInfo PersianCulture = new("fa-IR");
    private static readonly TimeZoneInfo BusinessTimeZone =
        TimeZoneInfo.GetSystemTimeZones().FirstOrDefault(x => x.Id == "Asia/Tehran" || x.Id == "Iran Standard Time") ?? TimeZoneInfo.Local;
    private DateTimeOffset SelectedDate = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, BusinessTimeZone);
    private List<Appointment> DayAppointments = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ChangeDay(int offsetDays)
    {
        SelectedDate = offsetDays == 0
            ? TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, BusinessTimeZone)
            : SelectedDate.AddDays(offsetDays);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (dayStart, dayEnd) = BookingPolicy.UtcDayWindow(
            DateOnly.FromDateTime(SelectedDate.DateTime), BusinessTimeZone);

        var appointments = await Access.AppointmentsAsync();
        DayAppointments = await appointments
            .Include(a => a.Service)
            .Include(a => a.Services).ThenInclude(x => x.Service)
            .Include(a => a.Resource)
            .Include(a => a.Branch).ThenInclude(b => b.Business)
            .Include(a => a.Customer)
            .Where(a => a.StartsAt >= dayStart && a.StartsAt < dayEnd)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();
    }

    private static string ServiceLabel(Appointment appointment) => appointment.Services.Count == 0
        ? appointment.Service.Name
        : string.Join("، ", appointment.Services.Select(x => x.Service.Name));

    private static string CustomerName(Appointment appointment) =>
        string.IsNullOrWhiteSpace(appointment.Customer.DisplayName) ? appointment.Customer.Email ?? "مشتری" : appointment.Customer.DisplayName;

    private static string EntityUrl(string path, string value) => $"{path}?q={Uri.EscapeDataString(value)}";

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };
}
