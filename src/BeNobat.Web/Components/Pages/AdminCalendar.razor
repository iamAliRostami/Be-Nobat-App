@page "/admin/calendar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageAppointments)]
@inject AdminAccessScope Access

<PageTitle>تقویم نوبت‌ها | به‌نوبت</PageTitle>

<div class="page-title"><div><h1>تقویم نوبت‌ها</h1><p>برنامه روزانه نوبت‌ها</p></div></div>

<section class="admin-panel calendar-panel">
    <div class="calendar-toolbar">
        <div>
            <button type="button" @onclick="() => ChangeDay(0)">امروز</button>
            <button type="button" aria-label="روز قبل" title="روز قبل" @onclick="() => ChangeDay(-1)">→</button>
            <button type="button" aria-label="روز بعد" title="روز بعد" @onclick="() => ChangeDay(1)">←</button>
            <h2>@LocalizedDate.Weekday(SelectedDate, "fa")، @LocalizedDate.Format(SelectedDate, "fa")</h2>
        </div>
    </div>
    @if (Error is not null) { <div class="auth-error" role="alert">@Error</div> }

    @if (DayAppointments.Count == 0)
    {
        <p class="empty-state">برای این روز نوبتی ثبت نشده است.</p>
    }
    else
    {
        <div class="agenda-list">
            @foreach (var appointment in DayAppointments)
            {
                <article class="event-row @StatusCssClass(appointment.Status)" @key="appointment.Id">
                    <time>@BranchClock.FormatTime(appointment.StartsAt, appointment.Branch.TimeZoneId, "fa") - @BranchClock.FormatTime(appointment.EndsAt, appointment.Branch.TimeZoneId, "fa")</time>
                    <div>
                        <b>@(string.IsNullOrWhiteSpace(appointment.Customer.DisplayName) ? appointment.Customer.Email : appointment.Customer.DisplayName)</b>
                        <small>@ServiceLabel(appointment) · @(appointment.Resource?.Name ?? "بدون کارمند") · @appointment.Branch.Business.Name · @appointment.Branch.Name</small>
                        <small>کد پیگیری: <bdi>@appointment.TrackingCode</bdi>@(string.IsNullOrWhiteSpace(appointment.Customer.PhoneNumber) ? "" : $" · ☎ {appointment.Customer.PhoneNumber}")</small>
                        @if (!string.IsNullOrWhiteSpace(appointment.CustomerNote)) { <small>توضیح مشتری: @appointment.CustomerNote</small> }
                    </div>
                    <em class="status @StatusCssClass(appointment.Status)">@StatusLabel(appointment.Status)</em>
                    @if (appointment.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                    {
                        <div class="row-actions">
                            @if (appointment.Status == AppointmentStatus.Pending) { <button type="button" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Confirmed)">تأیید</button> }
                            @if (appointment.StartsAt <= DateTimeOffset.UtcNow)
                            {
                                <button type="button" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Completed)">تکمیل شد</button>
                                <button type="button" class="outline" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.NoShow)">عدم حضور</button>
                            }
                            else { <button type="button" class="outline" @onclick="() => UpdateStatus(appointment.Id, AppointmentStatus.Cancelled)">لغو</button> }
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private DateOnly SelectedDate;
    private string? Zone;
    private string? Error;
    private List<Appointment> DayAppointments = [];

    protected override async Task OnInitializedAsync()
    {
        Zone = await Access.DisplayZoneAsync();
        SelectedDate = BranchClock.Today(Zone);
        await LoadAsync();
    }

    private async Task ChangeDay(int offsetDays)
    {
        SelectedDate = offsetDays == 0 ? BranchClock.Today(Zone) : SelectedDate.AddDays(offsetDays);
        Error = null;
        await LoadAsync();
    }

    private async Task UpdateStatus(Guid id, AppointmentStatus status)
    {
        Error = await Access.ChangeStatusAsync(id, status);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (dayStart, dayEnd) = BranchClock.DayWindow(SelectedDate, Zone);

        var appointments = await Access.AppointmentsAsync();
        DayAppointments = await appointments
            .AsNoTracking()
            .Include(a => a.Service)
            .Include(a => a.Services).ThenInclude(x => x.Service)
            .Include(a => a.Resource)
            .Include(a => a.Branch).ThenInclude(b => b.Business)
            .Include(a => a.Customer)
            .Where(a => a.StartsAt >= dayStart && a.StartsAt < dayEnd)
            .OrderBy(a => a.StartsAt)
            .ToListAsync();
    }

    private static string ServiceLabel(Appointment appointment) => appointment.Services.Count == 0
        ? appointment.Service.Name
        : string.Join("، ", appointment.Services.Select(x => x.Service.Name));

    private static string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "در انتظار",
        AppointmentStatus.Confirmed => "تأیید شده",
        AppointmentStatus.Completed => "تکمیل شد",
        AppointmentStatus.Cancelled => "لغو شده",
        AppointmentStatus.NoShow => "عدم حضور",
        _ => status.ToString(),
    };

    private static string StatusCssClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => "confirmed",
        AppointmentStatus.Completed => "done",
        AppointmentStatus.Cancelled => "cancelled",
        _ => "pending",
    };
}
