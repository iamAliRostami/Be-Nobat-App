@page "/platform"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@using System.Text
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject AdminAccessScope Access
@inject NavigationManager Navigation

<PageTitle>مدیریت کل سامانه | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>مدیریت کسب‌وکارها</h1><p>نمای کلی تمام مستأجرها، شعب و وضعیت انتشار در سامانه.</p></div><button type="button" @onclick="NewBusiness">+ کسب‌وکار جدید</button></div>

@if (Message is not null) { <div class="success-notice" role="status">@Message</div> }
@if (Error is not null && !ShowForm) { <div class="auth-error" role="alert">@Error</div> }

<div class="stat-cards">
    <a class="stat-card-link" href="/platform"><article><i class="purple">▤</i><div><small>کسب‌وکارها</small><strong>@Items.Count</strong></div></article></a>
    <a class="stat-card-link" href="/admin/branches"><article><i class="blue">⌖</i><div><small>شعب</small><strong>@Items.Sum(x => x.Branches.Count)</strong></div></article></a>
    <a class="stat-card-link" href="/businesses?status=active"><article><i class="green">◇</i><div><small>خدمات فعال</small><strong>@Items.Where(x => x.DeletedAt is null).Sum(x => x.Services.Count(y => y.DeletedAt is null))</strong></div></article></a>
    <a class="stat-card-link" href="/platform?status=inactive"><article><i class="orange">⊘</i><div><small>غیرفعال</small><strong>@Items.Count(x => x.DeletedAt is not null)</strong></div></article></a>
</div>

<article class="admin-panel">
    <div class="toolbar filter-toolbar">
        <input aria-label="جست‌وجوی کسب‌وکار" placeholder="جست‌وجوی نام، دسته‌بندی یا شهر..." @bind="Query" @bind:event="oninput" />
        <select aria-label="فیلتر دسته‌بندی کسب‌وکار" @bind="SelectedCategory"><option value="">همه دسته‌بندی‌ها</option>@foreach (var category in FilterCategories) { <option value="@category">@category</option> }</select>
        <select aria-label="فیلتر شهر" @bind="SelectedCity"><option value="">همه شهرها</option>@foreach (var city in Cities) { <option value="@city">@city</option> }</select>
        <select aria-label="فیلتر وضعیت کسب‌وکار" @bind="StatusFilter"><option value="">همه وضعیت‌ها</option><option value="active">فعال</option><option value="inactive">تعلیق‌شده</option></select>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ResetFilters">پاک‌کردن فیلترها</button> }
        <span>@Filtered.Count() کسب‌وکار</span>
    </div>
    @if (!Filtered.Any()) { <p class="empty-state">کسب‌وکاری پیدا نشد.</p> }
    <div class="service-table platform-table">
        <div class="table-head"><span>کسب‌وکار</span><span>شهر</span><span>شعب</span><span>وضعیت</span><span></span></div>
        @foreach (var item in Filtered)
        {
            <div @key="item.Id">
                <span><i class="purple">▤</i><b><a class="entity-link" href="@($"/platform?businessId={item.Id}")" data-i18n-skip>@item.Name</a><small><a class="entity-link" href="@($"/platform?category={Uri.EscapeDataString(item.Category)}")">@item.Category</a> · /@item.Slug · @(item.RequiresApproval ? "نیازمند تأیید نوبت" : "تأیید خودکار")</small></b></span>
                <span><a class="entity-link" href="@($"/platform?city={Uri.EscapeDataString(item.City)}")">@item.City</a></span>
                <span><a class="entity-link" href="@($"/admin/branches?businessId={item.Id}")">@item.Branches.Count@(item.Branches.Count == 0 ? " (بدون شعبه؛ در سایت نمایش داده نمی‌شود)" : "")</a></span>
                <span><em class="status @(item.DeletedAt is null ? "confirmed" : "cancelled")">@(item.DeletedAt is null ? "فعال" : "تعلیق")</em></span>
                <span class="inline-actions"><button type="button" class="action-secondary" @onclick="() => Edit(item)">ویرایش</button><button type="button" class="@(item.DeletedAt is null ? "action-danger" : "action-success")" @onclick="() => Toggle(item)">@(item.DeletedAt is null ? "تعلیق" : "فعال‌سازی")</button></span>
            </div>
        }
    </div>
</article>

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="platform-business" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation>
            <div><h2>@(EditingId is null ? "کسب‌وکار جدید" : "ویرایش کسب‌وکار")</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <label>نام<input required @bind="Form.Name" /></label>
            <label>شناسه URL (اختیاری؛ خالی بماند خودکار ساخته می‌شود)<input dir="ltr" @bind="Form.Slug" /></label>
            <div class="form-columns">
                <label>دسته‌بندی
                    <select @bind="Form.Category">
                        @foreach (var category in CategoryNames) { <option value="@category">@category</option> }
                    </select>
                </label>
                <label>شهر<input @bind="Form.City" /></label>
            </div>
            <label>توضیحات<textarea @bind="Form.Description"></textarea></label>
            <label class="check-label"><input type="checkbox" @bind="Form.RequiresApproval" /><span>نوبت‌های جدید باید توسط مجموعه تأیید شوند</span></label>
            @if (EditingId is null)
            {
                <label>نام شعبه‌ی اول<input @bind="Form.FirstBranchName" /></label>
                <label>ایمیل مالک (اختیاری؛ باید قبلاً ثبت‌نام کرده باشد)<input type="email" dir="ltr" @bind="Form.OwnerEmail" /></label>
            }
            @if (Error is not null) { <div class="auth-error" role="alert">@Error</div> }
            <button class="primary-button" disabled="@Saving">ذخیره</button>
        </EditForm>
    </div>
}

@code {
    private List<Business> Items = [];
    private List<string> CategoryNames = [];
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "businessId")] public Guid? BusinessIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryParam { get; set; }
    [SupplyParameterFromQuery(Name = "city")] public string? CityParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    private string Query = "";
    private Guid? SelectedBusinessId;
    private string SelectedCategory = "";
    private string SelectedCity = "";
    private string StatusFilter = "";
    private bool ShowForm;
    private bool Saving;
    private Guid? EditingId;
    private BusinessInput Form = new();
    private string? Error;
    private string? Message;

    private IEnumerable<string> FilterCategories => CategoryNames.Concat(Items.Select(x => x.Category)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();
    private IEnumerable<string> Cities => Items.Select(x => x.City).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();
    private bool HasFilters => !string.IsNullOrWhiteSpace(Query) || SelectedBusinessId is not null || SelectedCategory != "" || SelectedCity != "" || StatusFilter != "";
    private IEnumerable<Business> Filtered => Items.Where(x =>
        (SelectedBusinessId is null || x.Id == SelectedBusinessId) &&
        (SelectedCategory == "" || x.Category == SelectedCategory) &&
        (SelectedCity == "" || x.City == SelectedCity) &&
        (StatusFilter != "active" || x.DeletedAt is null) &&
        (StatusFilter != "inactive" || x.DeletedAt is not null) &&
        $"{x.Name} {x.Category} {x.City} {x.Slug}".Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();
    protected override void OnParametersSet()
    {
        Query = QueryParam?.Trim() ?? "";
        SelectedBusinessId = BusinessIdParam;
        SelectedCategory = CategoryParam ?? "";
        SelectedCity = CityParam ?? "";
        StatusFilter = StatusParam is "active" or "inactive" ? StatusParam : "";
    }
    private void ResetFilters()
    {
        Query = SelectedCategory = SelectedCity = StatusFilter = "";
        SelectedBusinessId = null;
        Navigation.NavigateTo("/platform");
    }

    private async Task<bool> EnsureAccess()
    {
        if (await Access.IsPlatformAdminAsync()) return true;
        Items = [];
        CategoryNames = [];
        ShowForm = false;
        Message = null;
        Error = "دسترسی مدیریت سامانه ندارید؛ دوباره وارد حساب شوید.";
        return false;
    }

    private async Task Load()
    {
        if (!await EnsureAccess()) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        Items = await db.Businesses.IgnoreQueryFilters().AsNoTracking()
            .Include(x => x.Branches.Where(branch => branch.DeletedAt == null))
            .Include(x => x.Services.Where(service => service.DeletedAt == null))
            .OrderBy(x => x.Name).ToListAsync();
        CategoryNames = await db.CategoryDefinitions.AsNoTracking()
            .Where(x => x.Kind == CategoryKind.Business && x.IsActive)
            .OrderBy(x => x.SortOrder).ThenBy(x => x.Name).Select(x => x.Name).ToListAsync();
    }

    private void EnsureCategory(string current)
    {
        if (!string.IsNullOrWhiteSpace(current) && !CategoryNames.Contains(current)) CategoryNames.Add(current);
    }

    private async Task NewBusiness()
    {
        if (Saving || !await EnsureAccess()) return;
        await Load();
        EditingId = null;
        Error = Message = null;
        Form = new() { Category = CategoryNames.FirstOrDefault() ?? "" };
        ShowForm = true;
    }

    private async Task Edit(Business x)
    {
        if (Saving || !await EnsureAccess()) return;
        EditingId = x.Id;
        Error = Message = null;
        EnsureCategory(x.Category);
        Form = new()
        {
            Name = x.Name, Slug = x.Slug, Category = x.Category, City = x.City,
            Description = x.Description, RequiresApproval = x.RequiresApproval,
        };
        ShowForm = true;
    }

    private static string MakeSlug(string name)
    {
        var builder = new StringBuilder();
        foreach (var ch in name.Trim().ToLowerInvariant())
        {
            if (ch is >= 'a' and <= 'z' or >= '0' and <= '9') builder.Append(ch);
            else if (builder.Length > 0 && builder[^1] != '-' && (char.IsWhiteSpace(ch) || ch is '-' or '_')) builder.Append('-');
        }

        var slug = builder.ToString().Trim('-');
        if (slug.Length > 100) slug = slug[..100].TrimEnd('-');
        return slug.Length >= 2 ? slug : "biz-" + Guid.NewGuid().ToString("N")[..6];
    }

    private static string? ValidateInput(BusinessInput form, out string slug)
    {
        form.Name = (form.Name ?? "").Trim();
        form.Category = (form.Category ?? "").Trim();
        form.City = (form.City ?? "").Trim();
        form.Description = (form.Description ?? "").Trim();
        form.FirstBranchName = (form.FirstBranchName ?? "").Trim();
        form.OwnerEmail = (form.OwnerEmail ?? "").Trim();
        slug = string.IsNullOrWhiteSpace(form.Slug) ? MakeSlug(form.Name) : form.Slug.Trim().ToLowerInvariant();
        if (form.Name.Length is 0 or > 200) return "نام کسب‌وکار باید بین ۱ تا ۲۰۰ نویسه باشد.";
        if (slug.Length > 100 || !System.Text.RegularExpressions.Regex.IsMatch(slug, "^[a-z0-9]+(-[a-z0-9]+)*$"))
            return "شناسه URL باید حداکثر ۱۰۰ نویسه و فقط شامل حروف انگلیسی، عدد و خط تیره باشد.";
        if (form.Category.Length is 0 or > 200) return "یک دسته‌بندی معتبر انتخاب کنید.";
        if (form.City.Length > 100 || form.Description.Length > 5000 || form.FirstBranchName.Length > 200 || form.OwnerEmail.Length > 256)
            return "شهر، توضیحات، نام شعبه یا ایمیل بیش از حد طولانی است.";
        return null;
    }

    private static IQueryable<Business> SlugConflicts(AppDbContext db, string slug, Guid? editingId) =>
        db.Businesses.IgnoreQueryFilters().Where(x => x.Slug.ToLower() == slug && x.Id != editingId);

    private async Task Save()
    {
        if (Saving || !await EnsureAccess()) return;
        Error = ValidateInput(Form, out var slug);
        if (Error is not null) return;
        Saving = true;
        try
        {
            await using var identityScope = ScopeFactory.CreateAsyncScope();
            var db = identityScope.ServiceProvider.GetRequiredService<AppDbContext>();
            var users = identityScope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            await using var transaction = await db.Database.BeginTransactionAsync();
            var business = EditingId is Guid id
                ? await db.Businesses.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.Id == id)
                : new Business { Name = Form.Name };
            if (business is null) { Error = "کسب‌وکار پیدا نشد؛ فهرست را تازه کنید."; return; }
            if (!await db.CategoryDefinitions.AnyAsync(x => x.Kind == CategoryKind.Business && x.IsActive && x.Name == Form.Category)
                && (EditingId is null || business.Category != Form.Category))
            {
                Error = "دسته‌بندی انتخاب‌شده فعال نیست؛ ابتدا یک دسته‌بندی فعال بسازید.";
                return;
            }
            var baseSlug = slug;
            while (await SlugConflicts(db, slug, EditingId).AnyAsync())
            {
                if (!string.IsNullOrWhiteSpace(Form.Slug))
                {
                    Error = "این شناسه URL قبلاً استفاده شده است.";
                    return;
                }
                slug = baseSlug[..Math.Min(baseSlug.Length, 87)].TrimEnd('-') + "-" + Guid.NewGuid().ToString("N")[..12];
            }

            AppUser? owner = null;
            if (EditingId is null && !string.IsNullOrWhiteSpace(Form.OwnerEmail))
            {
                owner = await users.FindByEmailAsync(Form.OwnerEmail);
                if (owner is null) { Error = "کاربری با این ایمیل پیدا نشد؛ ابتدا باید ثبت‌نام کند یا از «اعضای تیم» ساخته شود."; return; }
                if (await users.IsLockedOutAsync(owner)) { Error = "حساب مالک غیرفعال است."; return; }
            }

            business.Name = Form.Name;
            business.Slug = slug;
            business.Category = Form.Category;
            business.City = Form.City;
            business.Description = Form.Description;
            business.RequiresApproval = Form.RequiresApproval;
            business.UpdatedAt = DateTimeOffset.UtcNow;

            if (EditingId is null)
            {
                db.Businesses.Add(business);
                var branch = new Branch
                {
                    Business = business,
                    Name = string.IsNullOrWhiteSpace(Form.FirstBranchName) ? "شعبه مرکزی" : Form.FirstBranchName,
                };
                db.Branches.Add(branch);
                if (owner is not null) db.BranchMemberships.Add(new BranchMembership { Branch = branch, UserId = owner.Id, Role = AppRoles.Owner });
            }

            await db.SaveChangesAsync();
            if (owner is not null)
            {
                try { await TeamRoleSync.SyncAsync(users, db, owner); }
                catch (InvalidOperationException ex) { Error = ex.Message; return; }
            }
            await transaction.CommitAsync();
            Message = EditingId is null ? "کسب‌وکار و شعبه‌ی اول ساخته شد. خدمات و کارکنان را از بخش «شعب و منابع» و «خدمات» تکمیل کنید." : "تغییرات ذخیره شد.";
            Close();
            await Load();
        }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "23505" })
        {
            Error = "این شناسه URL هم‌زمان توسط کاربر دیگری ثبت شد؛ شناسه دیگری انتخاب کنید.";
        }
        finally { Saving = false; }
    }

    private async Task Toggle(Business x)
    {
        if (Saving || !await EnsureAccess()) return;
        Saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var item = await db.Businesses.IgnoreQueryFilters().FirstOrDefaultAsync(y => y.Id == x.Id);
            if (item is null) { Error = "کسب‌وکار پیدا نشد؛ فهرست را تازه کنید."; return; }
            // Suspension belongs to the parent. Preserve independently archived children
            // so reactivation cannot restore previously removed branches or services.
            item.DeletedAt = x.DeletedAt is null ? DateTimeOffset.UtcNow : null;
            item.UpdatedAt = DateTimeOffset.UtcNow;
            await db.SaveChangesAsync();
            Message = x.DeletedAt is null ? "کسب‌وکار تعلیق شد." : "کسب‌وکار فعال شد.";
            Error = null;
            await Load();
        }
        finally { Saving = false; }
    }

    private void Close() { ShowForm = false; Error = null; }

    private sealed class BusinessInput
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Category { get; set; } = "عمومی";
        public string City { get; set; } = "تهران";
        public string Description { get; set; } = "";
        public bool RequiresApproval { get; set; } = true;
        public string FirstBranchName { get; set; } = "شعبه مرکزی";
        public string OwnerEmail { get; set; } = "";
    }
}
