@page "/platform"
@attribute [Authorize(Policy = Policies.ManagePlatform)]
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>مدیریت کل سامانه | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>مدیریت کسب‌وکارها</h1><p>نمای کلی تمام مستأجرها، شعب و وضعیت انتشار در سامانه.</p></div><button @onclick="NewBusiness">+ کسب‌وکار جدید</button></div>
<div class="stat-cards"><article><i class="purple">▤</i><div><small>کسب‌وکارها</small><strong>@Items.Count</strong></div></article><article><i class="blue">⌖</i><div><small>شعب</small><strong>@Items.Sum(x=>x.Branches.Count)</strong></div></article><article><i class="green">◇</i><div><small>خدمات فعال</small><strong>@Items.Sum(x=>x.Services.Count)</strong></div></article><article><i class="orange">⊘</i><div><small>غیرفعال</small><strong>@Items.Count(x=>x.DeletedAt is not null)</strong></div></article></div>
<article class="admin-panel"><div class="toolbar"><input placeholder="جست‌وجوی نام، دسته‌بندی یا شهر..." @bind="Query" @bind:event="oninput"/><span>@Filtered.Count() کسب‌وکار</span></div><div class="service-table platform-table"><div class="table-head"><span>کسب‌وکار</span><span>شهر</span><span>شعب</span><span>وضعیت</span><span></span></div>@foreach(var item in Filtered){<div><span><i class="purple">▤</i><b>@item.Name<small>@item.Category · /@item.Slug</small></b></span><span>@item.City</span><span>@item.Branches.Count</span><span><em class="status @(item.DeletedAt is null?"confirmed":"cancelled")">@(item.DeletedAt is null?"فعال":"تعلیق")</em></span><span class="inline-actions"><button @onclick="()=>Edit(item)">ویرایش</button><button @onclick="()=>Toggle(item)">@(item.DeletedAt is null?"تعلیق":"فعال")</button></span></div>}</div></article>
@if(ShowForm){<div class="modal-backdrop" @onclick="Close"><EditForm Model="Form" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation><div><h2>@(EditingId is null?"کسب‌وکار جدید":"ویرایش کسب‌وکار")</h2><button type="button" @onclick="Close">×</button></div><label>نام<input required @bind="Form.Name"/></label><label>شناسه URL<input required dir="ltr" @bind="Form.Slug"/></label><div class="form-columns"><label>دسته‌بندی<input @bind="Form.Category"/></label><label>شهر<input @bind="Form.City"/></label></div><label>توضیحات<textarea @bind="Form.Description"></textarea></label>@if(Error is not null){<div class="auth-error">@Error</div>}<button class="primary-button">ذخیره</button></EditForm></div>}
@code{private List<Business> Items=[];private string Query="";private bool ShowForm;private Guid? EditingId;private BusinessInput Form=new();private string? Error;private IEnumerable<Business> Filtered=>Items.Where(x=>$"{x.Name} {x.Category} {x.City}".Contains(Query,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync()=>await Load();private async Task Load()=>Items=await Db.Businesses.IgnoreQueryFilters().Include(x=>x.Branches).Include(x=>x.Services).OrderBy(x=>x.Name).ToListAsync();private void NewBusiness(){EditingId=null;Form=new();ShowForm=true;}private void Edit(Business x){EditingId=x.Id;Form=new(){Name=x.Name,Slug=x.Slug,Category=x.Category,City=x.City,Description=x.Description};ShowForm=true;}private async Task Save(){Form.Slug=Form.Slug.Trim().ToLowerInvariant();if(string.IsNullOrWhiteSpace(Form.Name)||string.IsNullOrWhiteSpace(Form.Slug)||await Db.Businesses.IgnoreQueryFilters().AnyAsync(x=>x.Slug==Form.Slug&&x.Id!=EditingId)){Error="نام و شناسه یکتا الزامی است.";return;}var x=EditingId is null?new Business{Name=Form.Name}:await Db.Businesses.IgnoreQueryFilters().FirstAsync(x=>x.Id==EditingId);x.Name=Form.Name.Trim();x.Slug=Form.Slug;x.Category=Form.Category.Trim();x.City=Form.City.Trim();x.Description=Form.Description.Trim();if(EditingId is null)Db.Businesses.Add(x);await Db.SaveChangesAsync();Close();await Load();}private async Task Toggle(Business x){var item=await Db.Businesses.IgnoreQueryFilters().FirstAsync(y=>y.Id==x.Id);item.DeletedAt=item.DeletedAt is null?DateTimeOffset.UtcNow:null;await Db.SaveChangesAsync();await Load();}private void Close(){ShowForm=false;Error=null;}private sealed class BusinessInput{public string Name{get;set;}="";public string Slug{get;set;}="";public string Category{get;set;}="عمومی";public string City{get;set;}="تهران";public string Description{get;set;}="";}}
