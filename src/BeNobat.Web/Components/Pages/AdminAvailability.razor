@page "/admin/availability"
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AdminAccessScope Access
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>زمان‌های خالی | به‌نوبت</PageTitle>

<div class="page-title">
    <div><h1>زمان‌های خالی</h1><p>ساعات قابل رزرو شعبه یا هر کارمند را مشخص کنید.</p></div>
    <button type="button" class="action-primary" @onclick="OpenForm">+ بازه جدید</button>
</div>

<article class="admin-panel">
    <div class="toolbar filter-toolbar availability-filters">
        <label>کسب‌وکار<select aria-label="فیلتر کسب‌وکار" @bind="BusinessFilter" @bind:after="BusinessFilterChanged">
            <option value="">همه کسب‌وکارها</option>
            @foreach (var business in Businesses) { <option value="@business.Id" data-i18n-skip>@business.Name</option> }
        </select></label>
        <label>شعبه<select aria-label="فیلتر شعبه" @bind="BranchFilter" @bind:after="BranchFilterChanged"><option value="">همه شعب</option>@foreach (var branch in FilterBranches) { <option value="@branch.Id" data-i18n-skip>@branch.Name</option> }</select></label>
        <label>ارائه‌دهنده<select aria-label="فیلتر ارائه‌دهنده" @bind="ResourceFilter" @bind:after="UpdateFilters"><option value="">همه ارائه‌دهندگان</option>@foreach (var resource in FilterResources) { <option value="@resource.Id" data-i18n-skip>@resource.Name</option> }</select></label>
    </div>
    <div class="availability-summary">
        <div class="availability-tabs">
            <button type="button" class="@(ActiveTab == "active" ? "active" : "")" @onclick='() => ChangeTab("active")'>جاری و آینده</button>
            <button type="button" class="@(ActiveTab == "past" ? "active" : "")" @onclick='() => ChangeTab("past")'>گذشته</button>
        </div>
        <span>@LocalizedDate.FormatNumber(VisibleRules.Count(), Language) بازه</span>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ClearFilters">پاک کردن فیلترها</button> }
    </div>
    @if (PageMessage is not null) { <div class="success-notice" role="status">@PageMessage</div> }
    @if (!VisibleRules.Any()) { <p class="empty-state">در این بخش بازه‌ای وجود ندارد.</p> }
    <div class="availability-list">
        @foreach (var rule in VisibleRules)
        {
            <article class="availability-row" @key="rule.Id">
                <div class="availability-details">
                    <div class="availability-main">
                        <b>@DayLabel(rule.DayOfWeek)</b>
                        <strong>@DateLabel(rule)</strong>
                        <span class="availability-time"><bdi>@LocalTime(rule.StartsAt) تا @LocalTime(rule.EndsAt)</bdi></span>
                    </div>
                    <small class="availability-scope entity-meta">
                        <a class="entity-link" href="@EntityUrl(IsPlatformAdmin ? "/platform" : "/businesses", "businessId", rule.BusinessId)" data-i18n-skip>@rule.Business.Name</a>
                        @if (rule.Branch is not null) { <a class="entity-link" href="@EntityUrl("/admin/branches", "branchId", rule.Branch.Id)" data-i18n-skip>@rule.Branch.Name</a> } else { <span>کل مجموعه</span> }
                        @if (rule.Resource is not null) { <a class="entity-link" href="@ResourceUrl(rule.Resource)" data-i18n-skip>@rule.Resource.Name</a> } else { <span>همه منابع</span> }
                    </small>
                </div>
                <div class="availability-state"><em class="status @(rule.IsAvailable ? "confirmed" : "cancelled")">@(rule.IsAvailable ? "قابل رزرو" : "مسدود")</em>@if (BookedRuleIds.Contains(rule.Id)) { <em class="status pending">رزرو شده</em> } else { <em class="status done">بدون رزرو</em> }</div>
                @if (!IsPast(rule)) { <div class="availability-actions"><button type="button" class="action-secondary" @onclick="() => Edit(rule)">ویرایش</button><button type="button" class="action-danger" @onclick="() => Remove(rule)">حذف</button></div> }
            </article>
        }
    </div>
</article>

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="availability-rule" OnValidSubmit="Save" class="form-modal availability-form-modal" @onclick:stopPropagation>
            <div><h2>@(EditingId is null ? "بازه جدید" : "ویرایش بازه")</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <div class="availability-fields"><label>کسب‌وکار<select @bind="Form.BusinessId" @bind:after="BusinessChanged">@foreach(var business in Businesses){<option value="@business.Id" data-i18n-skip>@business.Name</option>}</select></label><label>شعبه<select @bind="Form.BranchId" @bind:after="BranchChanged">@if (IsPlatformAdmin) { <option value="">کل مجموعه</option> }@foreach(var branch in AvailableBranches){<option value="@branch.Id" data-i18n-skip>@branch.Name</option>}</select></label><label>ارائه‌دهنده<select @bind="Form.ResourceId" @bind:after="ResourceChanged"><option value="">همه کارکنان شعبه</option>@foreach(var resource in AvailableResources){<option value="@resource.Id" data-i18n-skip>@resource.Name</option>}</select></label></div>
            @if (Form.BranchId is not null)
            {
                <fieldset class="availability-services"><legend>@(Form.ResourceId is null ? "خدمات قابل ارائه توسط همه کارکنان" : "خدمات قابل ارائه توسط این کارمند")</legend>
                    @if (!AvailableServices.Any()) { <small>ابتدا یک خدمت فعال برای این شعبه تعریف کنید.</small> }
                    @foreach (var service in AvailableServices) { <label class="check-label"><input type="checkbox" checked="@SelectedServiceIds.Contains(service.Id)" @onchange="() => ToggleService(service.Id)" /><span data-i18n-skip>@service.Name</span></label> }
                    <small>@(Form.ResourceId is null ? "خدمات انتخاب‌شده به همه کارکنان شعبه تخصیص داده می‌شوند." : "کارمند فقط برای خدمات انتخاب‌شده در مرحله رزرو نمایش داده می‌شود.")</small>
                </fieldset>
            }
            <label class="localized-date-field"><span class="localized-date-heading"><span>تاریخ</span><small>@LocalizedDate.Weekday(Form.EffectiveDate, Language)</small></span><div class="localized-date-inputs"><select aria-label="سال" @bind="LocalYear" @bind:after="LocalizedDateChanged">@foreach(var year in LocalYears){<option value="@year">@LocalizedDate.FormatNumber(year, Language)</option>}</select><select aria-label="ماه" @bind="LocalMonth" @bind:after="LocalizedDateChanged">@foreach(var month in LocalMonths){<option value="@month">@LocalizedDate.MonthName(month, Language)</option>}</select><select aria-label="روز" @bind="LocalDay" @bind:after="LocalizedDateChanged">@foreach(var day in LocalDays){<option value="@day">@LocalizedDate.FormatNumber(day, Language)</option>}</select></div></label>
            <div class="time-range"><label>از<select @bind="StartMinutes" @bind:after="StartTimeChanged">@foreach(var minutes in TimeOptions(Form.StartsAt)){<option value="@minutes">@FormatTimeOption(minutes)</option>}</select></label><label>تا<select @bind="EndMinutes">@foreach(var minutes in TimeOptions(Form.EndsAt, true)){<option value="@minutes">@FormatTimeOption(minutes)</option>}</select></label></div>
            <label class="check-label"><input type="checkbox" @bind="Form.IsAvailable" /><span>قابل رزرو باشد</span></label>
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره</button>
        </EditForm>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "businessId")] public string? BusinessQuery { get; set; }
    [SupplyParameterFromQuery(Name = "branchId")] public string? BranchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "resourceId")] public string? ResourceQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    private List<Business> Businesses = [];
    private List<Branch> Branches = [];
    private List<AvailabilityRule> Rules = [];
    private List<Resource> Resources = [];
    private List<Service> Services = [];
    private List<BranchService> BranchServices = [];
    private HashSet<Guid> SelectedServiceIds = [];
    private HashSet<Guid> BookedRuleIds = [];
    private string BusinessFilter = "";
    private string BranchFilter = "";
    private string ResourceFilter = "";
    private string ActiveTab = "active";
    private bool ShowForm;
    private Guid? EditingId;
    private RuleInput Form = new();
    private string? Error;
    private bool IsPlatformAdmin;
    private string Language = "fa";
    private DateOnly Today => BranchClock.Today(Branches.FirstOrDefault()?.TimeZoneId);
    private string? PageMessage;
    private int LocalYear;
    private int LocalMonth;
    private int LocalDay;
    private DateTimeOffset CurrentLocalNow => TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, FormTimeZone);
    private DateOnly FormToday => DateOnly.FromDateTime(CurrentLocalNow.DateTime);
    private TimeZoneInfo FormTimeZone => BranchClock.Zone(
        Branches.FirstOrDefault(x => x.Id == Form.BranchId)?.TimeZoneId ??
        Branches.FirstOrDefault(x => x.BusinessId == Form.BusinessId)?.TimeZoneId);
    private IEnumerable<int> LocalYears => Enumerable.Range(LocalizedDate.GetParts(FormToday, Language).Year, 11);
    private IEnumerable<int> LocalMonths => Enumerable.Range(IsCurrentLocalYear ? TodayParts.Month : 1, 12 - (IsCurrentLocalYear ? TodayParts.Month : 1) + 1);
    private IEnumerable<int> LocalDays => Enumerable.Range(IsCurrentLocalMonth ? TodayParts.Day : 1, LocalDaysInMonth - (IsCurrentLocalMonth ? TodayParts.Day : 1) + 1);
    private int LocalDaysInMonth => LocalizedDate.DaysInMonth(LocalYear, LocalMonth, Language);
    private (int Year, int Month, int Day) TodayParts => LocalizedDate.GetParts(FormToday, Language);
    private bool IsCurrentLocalYear => LocalYear == TodayParts.Year;
    private bool IsCurrentLocalMonth => IsCurrentLocalYear && LocalMonth == TodayParts.Month;
    private int StartMinutes { get => Form.StartsAt.Hour * 60 + Form.StartsAt.Minute; set => Form.StartsAt = new TimeOnly(value / 60, value % 60); }
    private int EndMinutes { get => Form.EndsAt >= new TimeOnly(23, 59) ? 1440 : Form.EndsAt.Hour * 60 + Form.EndsAt.Minute; set => Form.EndsAt = value >= 1440 ? AvailabilityResolver.EndOfDay : new TimeOnly(value / 60, value % 60); }
    private IEnumerable<AvailabilityRule> VisibleRules => (ActiveTab == "past" ? Rules.Where(IsPast) : Rules.Where(x => !IsPast(x)))
        .OrderBy(RuleSortDate)
        .ThenBy(x => x.StartsAt)
        .ThenBy(x => x.EndsAt)
        .ThenBy(x => x.Business.Name);
    private IEnumerable<Branch> AvailableBranches => Branches.Where(x => x.BusinessId == Form.BusinessId);
    private IEnumerable<Resource> AvailableResources => Resources.Where(x => Form.BranchId != null && x.BranchId == Form.BranchId && x.Kind == "staff");
    private IEnumerable<Service> AvailableServices => Services.Where(x => BranchServices.Any(bs => bs.BranchId == Form.BranchId && bs.ServiceId == x.Id));
    private IEnumerable<Branch> FilterBranches => Branches.Where(x => !Guid.TryParse(BusinessFilter, out var businessId) || x.BusinessId == businessId);
    private IEnumerable<Resource> FilterResources => Resources.Where(x => FilterBranches.Any(b => b.Id == x.BranchId) && (!Guid.TryParse(BranchFilter, out var branchId) || x.BranchId == branchId));
    private bool HasFilters => BusinessFilter.Length > 0 || BranchFilter.Length > 0 || ResourceFilter.Length > 0;

    protected override async Task OnInitializedAsync() => await LoadOptions();

    private async Task LoadOptions()
    {
        IsPlatformAdmin = await Access.IsPlatformAdminAsync();
        var branchQuery = await Access.ManagedBranchesAsync();
        Branches = await branchQuery.AsNoTracking().Include(x => x.Business).OrderBy(x => x.Name).ToListAsync();
        var businessIds = Branches.Select(x => x.BusinessId).Distinct().ToList();
        Businesses = await Db.Businesses.Where(x => businessIds.Contains(x.Id)).OrderBy(x => x.Name).ToListAsync();
        var branchIds = Branches.Select(x => x.Id).ToList();
        Resources = await Db.Resources.Where(x => branchIds.Contains(x.BranchId)).OrderBy(x => x.Name).ToListAsync();
        Services = await Db.Services.Where(x => businessIds.Contains(x.BusinessId)).OrderBy(x => x.Name).ToListAsync();
        BranchServices = await Db.BranchServices.Where(x => branchIds.Contains(x.BranchId)).ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        BusinessFilter = Guid.TryParse(BusinessQuery, out var businessId) ? businessId.ToString() : "";
        BranchFilter = Guid.TryParse(BranchQuery, out var branchId) ? branchId.ToString() : "";
        ResourceFilter = Guid.TryParse(ResourceQuery, out var resourceId) ? resourceId.ToString() : "";
        ActiveTab = TabQuery == "past" ? "past" : "active";
        await LoadRules();
    }

    private void BusinessFilterChanged() { BranchFilter = ""; ResourceFilter = ""; UpdateFilters(); }
    private void BranchFilterChanged() { ResourceFilter = ""; UpdateFilters(); }
    private void ChangeTab(string tab) { ActiveTab = tab; UpdateFilters(); }
    private void ClearFilters() { BusinessFilter = ""; BranchFilter = ""; ResourceFilter = ""; UpdateFilters(); }
    private void UpdateFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["businessId"] = BusinessFilter.Length == 0 ? null : BusinessFilter,
        ["branchId"] = BranchFilter.Length == 0 ? null : BranchFilter,
        ["resourceId"] = ResourceFilter.Length == 0 ? null : ResourceFilter,
        ["tab"] = ActiveTab == "past" ? "past" : null,
    }));

    private async Task LoadRules()
    {
        // Circuit options are refreshed before applying URL filters or saving.
        await LoadOptions();
        var branchIds = Branches.Select(x => x.Id).ToList();
        var businessIds = Businesses.Select(x => x.Id).ToList();
        var query = Db.AvailabilityRules.Include(x => x.Business).Include(x => x.Branch).Include(x => x.Resource)
            .Where(x => businessIds.Contains(x.BusinessId) && (x.BranchId == null || branchIds.Contains(x.BranchId.Value)));
        if (Guid.TryParse(BusinessFilter, out var businessId)) query = query.Where(x => x.BusinessId == businessId);
        if (Guid.TryParse(BranchFilter, out var branchId)) query = query.Where(x => x.BranchId == branchId);
        if (Guid.TryParse(ResourceFilter, out var resourceId)) query = query.Where(x => x.ResourceId == resourceId);
        Rules = await query.OrderBy(x => x.EffectiveDate).ThenBy(x => x.Business.Name).ThenBy(x => x.DayOfWeek).ThenBy(x => x.StartsAt).ToListAsync();
        await LoadBookedRules();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Language = await JS.InvokeAsync<string>("beNobat.preferences.getLanguage");
        SetLocalizedDateParts();
        StateHasChanged();
    }

    private async Task OpenForm()
    {
        EditingId = null;
        var business = Businesses.FirstOrDefault(x => x.Id.ToString() == BusinessFilter) ?? Businesses.FirstOrDefault();
        var businessId = business?.Id ?? Guid.Empty;
        Form = new RuleInput { BusinessId = businessId, BranchId = IsPlatformAdmin ? null : Branches.FirstOrDefault(x => x.BusinessId == businessId)?.Id };
        if (Guid.TryParse(BranchFilter, out var branchId) && AvailableBranches.Any(x => x.Id == branchId)) Form.BranchId = branchId;
        if (Guid.TryParse(ResourceFilter, out var resourceId) && AvailableResources.Any(x => x.Id == resourceId)) Form.ResourceId = resourceId;
        Form.EffectiveDate = FormToday;
        Form.DayOfWeek = FormToday.DayOfWeek;
        await LoadSelectedServicesAsync(Form.ResourceId);
        SetLocalizedDateParts();
        EnsureFutureTimes();
        ShowForm = true;
    }

    private async Task Edit(AvailabilityRule rule)
    {
        EditingId = rule.Id;
        if (IsPast(rule)) return;
        Form = new RuleInput { BusinessId = rule.BusinessId, BranchId = rule.BranchId, ResourceId = rule.ResourceId, EffectiveDate = rule.EffectiveDate ?? Today, DayOfWeek = rule.DayOfWeek, StartsAt = rule.StartsAt, EndsAt = rule.EndsAt, IsAvailable = rule.IsAvailable };
        await LoadSelectedServicesAsync(rule.ResourceId);
        SetLocalizedDateParts();
        EnsureFutureTimes();
        ShowForm = true;
    }

    private async Task BusinessChanged() { Form.BranchId = IsPlatformAdmin ? null : AvailableBranches.FirstOrDefault()?.Id; Form.ResourceId = null; await LoadSelectedServicesAsync(null); }
    private async Task BranchChanged() { Form.ResourceId = null; await LoadSelectedServicesAsync(null); }
    private async Task ResourceChanged() => await LoadSelectedServicesAsync(Form.ResourceId);
    private async Task LoadSelectedServicesAsync(Guid? resourceId)
    {
        if (resourceId is Guid id)
        {
            SelectedServiceIds = (await Db.ServiceResources.Where(x => x.ResourceId == id).Select(x => x.ServiceId).ToListAsync()).ToHashSet();
            return;
        }

        var staffIds = AvailableResources.Select(x => x.Id).ToList();
        if (staffIds.Count == 0) { SelectedServiceIds = []; return; }
        var assignments = await Db.ServiceResources.Where(x => staffIds.Contains(x.ResourceId)).ToListAsync();
        SelectedServiceIds = AvailableServices.Where(service => staffIds.All(staffId =>
            assignments.Any(x => x.ResourceId == staffId && x.ServiceId == service.Id))).Select(x => x.Id).ToHashSet();
    }
    private void ToggleService(Guid id) { if (!SelectedServiceIds.Add(id)) SelectedServiceIds.Remove(id); }
    private void SetLocalizedDateParts() => (LocalYear, LocalMonth, LocalDay) = LocalizedDate.GetParts(Form.EffectiveDate, Language);
    private Task LocalizedDateChanged()
    {
        if (!LocalMonths.Contains(LocalMonth)) LocalMonth = LocalMonths.First();
        if (!LocalDays.Contains(LocalDay)) LocalDay = LocalDays.First();
        LocalDay = Math.Min(LocalDay, LocalDaysInMonth);
        Form.EffectiveDate = LocalizedDate.FromParts(LocalYear, LocalMonth, LocalDay, Language);
        if (Form.EffectiveDate < FormToday) Form.EffectiveDate = FormToday;
        SetLocalizedDateParts();
        Form.DayOfWeek = Form.EffectiveDate.DayOfWeek;
        EnsureFutureTimes();
        return Task.CompletedTask;
    }
    private IEnumerable<int> TimeOptions(TimeOnly selected, bool isEnd = false)
    {
        var selectedMinutes = isEnd && selected >= new TimeOnly(23, 59) ? 1440 : selected.Hour * 60 + selected.Minute;
        var minimum = Form.EffectiveDate == FormToday ? NextQuarterHour() : 0;
        var options = Enumerable.Range(0, 96).Select(x => x * 15).ToList();
        if (isEnd) options.Add(1440);
        return options.Where(x => x >= minimum).Append(selectedMinutes).Where(x => x >= minimum).Distinct().Order();
    }
    private int NextQuarterHour() => (int)Math.Ceiling(CurrentLocalNow.TimeOfDay.TotalMinutes / 15) * 15;
    private void EnsureFutureTimes()
    {
        if (Form.EffectiveDate != FormToday) return;
        var minimum = NextQuarterHour();
        if (minimum >= 1440)
        {
            Form.EffectiveDate = FormToday.AddDays(1);
            Form.DayOfWeek = Form.EffectiveDate.DayOfWeek;
            Form.StartsAt = new TimeOnly(9, 0);
            Form.EndsAt = new TimeOnly(18, 0);
            SetLocalizedDateParts();
            return;
        }
        if (StartMinutes < minimum) StartMinutes = minimum;
        if (EndMinutes <= StartMinutes) EndMinutes = Math.Min(1440, StartMinutes + 15);
    }
    private Task StartTimeChanged()
    {
        if (EndMinutes <= StartMinutes) EndMinutes = Math.Min(1440, StartMinutes + 15);
        return Task.CompletedTask;
    }
    private string FormatTimeOption(int minutes) => LocalizedDate.LocalizeDigits(minutes >= 1440 ? "24:00" : $"{minutes / 60:00}:{minutes % 60:00}", Language);

    private async Task Save()
    {
        Error = null;
        await LoadOptions();
        if (!await Access.CanManageAvailabilityAsync(Form.BusinessId, Form.BranchId, Form.ResourceId)) { Error = "اجازه‌ی مدیریت این برنامه کاری را ندارید."; return; }
        if (EditingId is Guid editingId)
        {
            var original = await Db.AvailabilityRules.AsNoTracking().FirstOrDefaultAsync(r => r.Id == editingId);
            if (original is null || !await Access.CanManageAvailabilityAsync(original.BusinessId, original.BranchId, original.ResourceId))
            { Error = "اجازه‌ی ویرایش این برنامه کاری را ندارید."; return; }
        }
        if (Form.BusinessId == Guid.Empty || Form.EndsAt <= Form.StartsAt || (!IsPlatformAdmin && Form.BranchId is null)) { Error = "بازه زمانی و شعبه انتخاب‌شده معتبر نیست."; return; }
        if (Form.EffectiveDate < FormToday || (Form.EffectiveDate == FormToday && Form.StartsAt < TimeOnly.FromDateTime(CurrentLocalNow.DateTime))) { Error = "امکان تعریف یا ویرایش زمان خالی برای تاریخ گذشته وجود ندارد."; return; }
        if (Form.ResourceId is Guid resourceId && !AvailableResources.Any(x => x.Id == resourceId)) { Error = "کارمند باید متعلق به شعبه انتخاب‌شده باشد."; return; }
        if (Form.IsAvailable && Form.BranchId is not null && (SelectedServiceIds.Count == 0 || SelectedServiceIds.Any(id => AvailableServices.All(x => x.Id != id)))) { Error = "حداقل یک خدمت فعال همین شعبه را برای ارائه‌دهنده انتخاب کنید."; return; }
        if (Form.BranchId is not null && !AvailableResources.Any()) { Error = "برای این شعبه هنوز هیچ کارمندی تعریف نشده است."; return; }
        if (Form.BranchId is Guid branchId && !await Access.CanManageBranchAsync(branchId)) { Error = "به این شعبه دسترسی ندارید."; return; }
        var duplicateOrOverlap = await Db.AvailabilityRules.AnyAsync(x =>
            x.Id != EditingId && x.BusinessId == Form.BusinessId && x.BranchId == Form.BranchId &&
            x.ResourceId == Form.ResourceId && x.EffectiveDate == Form.EffectiveDate && x.DayOfWeek == Form.EffectiveDate.DayOfWeek &&
            x.IsAvailable == Form.IsAvailable && x.StartsAt < Form.EndsAt && Form.StartsAt < x.EndsAt);
        if (duplicateOrOverlap) { Error = "برای این دامنه، کارمند و روز یک بازه هم‌پوشان از همین نوع قبلاً تعریف شده است."; return; }
        var rule = EditingId is null ? new AvailabilityRule() : await Db.AvailabilityRules.FirstOrDefaultAsync(x => x.Id == EditingId);
        if (rule is null) { Error = "برنامه کاری پیدا نشد."; return; }
        if (EditingId is not null) await Db.Entry(rule).ReloadAsync();
        rule.BusinessId = Form.BusinessId; rule.BranchId = Form.BranchId; rule.ResourceId = Form.ResourceId; rule.EffectiveDate = Form.EffectiveDate; rule.DayOfWeek = Form.EffectiveDate.DayOfWeek;
        rule.StartsAt = Form.StartsAt; rule.EndsAt = Form.EndsAt; rule.IsAvailable = Form.IsAvailable;
        if (EditingId is null) Db.AvailabilityRules.Add(rule);
        rule.UpdatedAt = DateTimeOffset.UtcNow;
        if (Form.IsAvailable && Form.ResourceId is Guid providerId)
        {
            var existing = await Db.ServiceResources.IgnoreQueryFilters().Where(x => x.ResourceId == providerId).ToListAsync();
            Db.ServiceResources.RemoveRange(existing.Where(x => !SelectedServiceIds.Contains(x.ServiceId)));
            foreach (var link in existing.Where(x => SelectedServiceIds.Contains(x.ServiceId))) { link.DeletedAt = null; link.UpdatedAt = DateTimeOffset.UtcNow; }
            var existingIds = existing.Select(x => x.ServiceId).ToHashSet();
            Db.ServiceResources.AddRange(SelectedServiceIds.Where(id => !existingIds.Contains(id))
                .Select(id => new ServiceResource { ResourceId = providerId, ServiceId = id }));
        }
        else if (Form.IsAvailable && Form.BranchId is not null)
        {
            // A branch-wide availability interval applies to all staff, so the selected
            // qualifications must also be created for every staff resource in that branch.
            var staffIds = AvailableResources.Select(x => x.Id).ToList();
            var existing = await Db.ServiceResources.IgnoreQueryFilters().Where(x => staffIds.Contains(x.ResourceId) && SelectedServiceIds.Contains(x.ServiceId)).ToListAsync();
            foreach (var link in existing) { link.DeletedAt = null; link.UpdatedAt = DateTimeOffset.UtcNow; }
            var existingPairs = existing.Select(x => (x.ResourceId, x.ServiceId)).ToHashSet();
            Db.ServiceResources.AddRange(staffIds.SelectMany(resourceId => SelectedServiceIds
                .Where(serviceId => !existingPairs.Contains((resourceId, serviceId)))
                .Select(serviceId => new ServiceResource { ResourceId = resourceId, ServiceId = serviceId })));
        }
        await Db.SaveChangesAsync(); Close(); await LoadRules();
    }

    private async Task Remove(AvailabilityRule rule)
    {
        var current = await Db.AvailabilityRules.FirstOrDefaultAsync(r => r.Id == rule.Id);
        if (current is null) return;
        await Db.Entry(current).ReloadAsync();
        if (!await Access.CanManageAvailabilityAsync(current.BusinessId, current.BranchId, current.ResourceId))
        { Error = "اجازه‌ی حذف این برنامه کاری را ندارید."; return; }
        if (IsPast(current)) return;
        PageMessage = BookedRuleIds.Contains(current.Id) ? "این بازه نوبت فعال دارد؛ نوبت‌های موجود حفظ می‌شوند ولی زمان جدیدی از آن رزرو نخواهد شد." : null;
        current.DeletedAt = DateTimeOffset.UtcNow;
        current.UpdatedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        await LoadRules();
    }
    private async Task LoadBookedRules()
    {
        BookedRuleIds = [];
        if (Rules.Count == 0) return;
        var businessIds = Rules.Select(x => x.BusinessId).Distinct().ToList();
        var appointmentQuery = await Access.AppointmentsAsync();
        var appointments = await appointmentQuery.Include(x => x.Branch)
            .Where(x => x.Status != AppointmentStatus.Cancelled && x.EndsAt >= DateTimeOffset.UtcNow && businessIds.Contains(x.Branch.BusinessId)).ToListAsync();
        foreach (var rule in Rules)
        {
            var booked = appointments.Any(a => (rule.BranchId == null || a.BranchId == rule.BranchId) &&
                (rule.ResourceId == null || a.ResourceId == rule.ResourceId) &&
                (rule.EffectiveDate == null ? BranchClock.LocalDate(a.StartsAt, a.Branch.TimeZoneId).DayOfWeek == rule.DayOfWeek : BranchClock.LocalDate(a.StartsAt, a.Branch.TimeZoneId) == rule.EffectiveDate) &&
                BranchClock.LocalTime(a.StartsAt, a.Branch.TimeZoneId) < rule.EndsAt && rule.StartsAt < (BranchClock.LocalDate(a.EndsAt, a.Branch.TimeZoneId) > BranchClock.LocalDate(a.StartsAt, a.Branch.TimeZoneId) ? TimeOnly.MaxValue : BranchClock.LocalTime(a.EndsAt, a.Branch.TimeZoneId)));
            if (booked) BookedRuleIds.Add(rule.Id);
        }
    }
    private void Close() { ShowForm = false; Error = null; }
    private bool IsPast(AvailabilityRule rule) => rule.EffectiveDate is DateOnly date && date < Today;
    private DateOnly RuleSortDate(AvailabilityRule rule) => rule.EffectiveDate ?? NextOccurrence(rule.DayOfWeek);
    private string DateLabel(AvailabilityRule rule)
    {
        var date = rule.EffectiveDate ?? NextOccurrence(rule.DayOfWeek);
        var prefix = rule.EffectiveDate is null ? (Language switch { "en" => "Weekly · next", "ar" => "أسبوعي · التالي", _ => "هفتگی · نوبت بعد" }) : "";
        return string.IsNullOrEmpty(prefix) ? LocalizedDate.Format(date, Language) : $"{prefix}: {LocalizedDate.Format(date, Language)}";
    }
    private DateOnly NextOccurrence(DayOfWeek day)
    {
        var offset = ((int)day - (int)Today.DayOfWeek + 7) % 7;
        return Today.AddDays(offset);
    }
    private string LocalTime(TimeOnly time) => LocalizedDate.LocalizeDigits(time >= new TimeOnly(23, 59) ? "24:00" : time.ToString("HH:mm"), Language);
    private static string EntityUrl(string path, string parameter, Guid id) => $"{path}?{parameter}={id}";
    private static string ResourceUrl(Resource resource) => resource.Kind == "staff"
        ? EntityUrl("/admin/team", "resourceId", resource.Id)
        : $"/admin/branches?branchId={resource.BranchId}&resourceId={resource.Id}";
    private static string DayLabel(DayOfWeek day) => day switch { DayOfWeek.Saturday => "شنبه", DayOfWeek.Sunday => "یکشنبه", DayOfWeek.Monday => "دوشنبه", DayOfWeek.Tuesday => "سه‌شنبه", DayOfWeek.Wednesday => "چهارشنبه", DayOfWeek.Thursday => "پنجشنبه", _ => "جمعه" };
    private sealed class RuleInput { public Guid BusinessId { get; set; } public Guid? BranchId { get; set; } public Guid? ResourceId { get; set; } public DateOnly EffectiveDate { get; set; } = BranchClock.Today(null); public DayOfWeek DayOfWeek { get; set; } = BranchClock.Today(null).DayOfWeek; public TimeOnly StartsAt { get; set; } = new(9, 0); public TimeOnly EndsAt { get; set; } = new(18, 0); public bool IsAvailable { get; set; } = true; }
}
