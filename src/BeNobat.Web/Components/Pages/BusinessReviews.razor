@page "/business/{BusinessId:guid}/reviews"
@layout Layout.PublicLayout
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>نظرات مشتریان | به‌نوبت</PageTitle>
<section class="profile-page">
    @if (!Loaded)
    {
        <p class="empty-state">در حال دریافت نظرها…</p>
    }
    else if (BusinessName is null)
    {
        <p class="empty-state">کسب‌وکار موردنظر پیدا نشد.</p>
    }
    else
    {
        <a class="back-link" href="/business/@BusinessId">→ بازگشت به <span data-i18n-skip>@BusinessName</span></a>
        <div class="page-title">
            <div>
                <h1>نظرهای <span data-i18n-skip>@BusinessName</span></h1>
                <p>@(Reviews.Count == 0 ? "هنوز نظری منتشر نشده است" : $"{Reviews.Count} نظر منتشرشده · میانگین {Average:0.0} از ۵")</p>
            </div>
            <a class="primary-button" href="/appointments">ثبت نظر برای نوبت‌های من</a>
        </div>
        <div class="review-list">
            @foreach (var review in Reviews)
            {
                <article @key="review.Id">
                    <header>
                        <div><b data-i18n-skip>@review.Author</b><small data-i18n-skip>@review.Date@(review.BranchName is null ? "" : $" · {review.BranchName}")</small></div>
                        <span class="stars" aria-label="@review.Rating از ۵">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(review.Comment)) { <p data-i18n-skip>@review.Comment</p> }
                    @if (!string.IsNullOrWhiteSpace(review.Reply)) { <blockquote>پاسخ مجموعه: <span data-i18n-skip>@review.Reply</span></blockquote> }
                </article>
            }
        </div>
        @if (Reviews.Count == 0) { <p class="empty-state">پس از اولین مراجعه می‌توانید اولین نظر را ثبت کنید.</p> }
    }
</section>

@code {
    [Parameter] public Guid BusinessId { get; set; }

    private bool Loaded;
    private string? BusinessName;
    private List<ReviewView> Reviews = [];
    private double Average => Reviews.Count == 0 ? 0 : Reviews.Average(x => x.Rating);

    protected override async Task OnParametersSetAsync()
    {
        Loaded = false;
        await using var db = await DbFactory.CreateDbContextAsync();
        BusinessName = await db.Businesses.AsNoTracking().Where(x => x.Id == BusinessId).Select(x => x.Name).FirstOrDefaultAsync();
        if (BusinessName is not null)
        {
            // فقط ستون‌های لازم؛ بایت‌های عکس پروفایل خوانده نمی‌شود.
            var rows = await db.Reviews.AsNoTracking()
                .Where(x => x.BusinessId == BusinessId && x.Status == ReviewStatus.Published)
                .OrderByDescending(x => x.CreatedAt)
                .Select(x => new
                {
                    x.Id, x.Rating, x.Comment, x.ManagerReply, x.CreatedAt,
                    Author = x.Customer.DisplayName,
                    BranchName = x.Branch != null ? x.Branch.Name : null,
                    Zone = x.Branch != null ? x.Branch.TimeZoneId : null,
                })
                .ToListAsync();
            Reviews = rows.Select(x => new ReviewView(
                x.Id,
                x.Rating,
                x.Comment,
                x.ManagerReply,
                string.IsNullOrWhiteSpace(x.Author) ? "کاربر" : x.Author,
                x.BranchName,
                BranchClock.FormatDate(x.CreatedAt, x.Zone, UiLocale.Language))).ToList();
        }
        Loaded = true;
    }

    private sealed record ReviewView(Guid Id, int Rating, string? Comment, string? Reply, string Author, string? BranchName, string Date);
}
