@page "/business/{BusinessId:guid}/reviews"
@layout Layout.PublicLayout
@inject AppDbContext Db

<PageTitle>نظرات مشتریان | به‌نوبت</PageTitle>
<section class="profile-page">
    @if (Business is null)
    {
        <p class="empty-state">کسب‌وکار موردنظر پیدا نشد.</p>
    }
    else
    {
        <a class="back-link" href="/">→ بازگشت</a>
        <div class="page-title"><div><h1>نظرهای @Business.Name</h1><p>@Reviews.Count نظر منتشرشده · میانگین @Average.ToString("0.0") از ۵</p></div><a class="primary-button" href="/account/profile">ثبت نظر</a></div>
        <div class="review-list">
            @foreach (var review in Reviews)
            {
                <article><header><div><b>@review.Customer.DisplayName</b><small>@review.CreatedAt.ToString("yyyy/MM/dd") @if(review.Branch is not null){<text>· @review.Branch.Name</text>}</small></div><span class="stars">@(new string('★', review.Rating))@(new string('☆', 5-review.Rating))</span></header><p>@review.Comment</p>@if(!string.IsNullOrWhiteSpace(review.ManagerReply)){<blockquote>پاسخ مجموعه: @review.ManagerReply</blockquote>}</article>
            }
        </div>
        @if(Reviews.Count==0){<p class="empty-state">هنوز نظری منتشر نشده است.</p>}
    }
</section>

@code {
    [Parameter] public Guid BusinessId { get; set; }
    private Business? Business; private List<Review> Reviews=[];
    private double Average=>Reviews.Count==0?0:Reviews.Average(x=>x.Rating);
    protected override async Task OnParametersSetAsync(){Business=await Db.Businesses.FirstOrDefaultAsync(x=>x.Id==BusinessId);Reviews=await Db.Reviews.Include(x=>x.Customer).Include(x=>x.Branch).Where(x=>x.BusinessId==BusinessId&&x.Status==ReviewStatus.Published).OrderByDescending(x=>x.CreatedAt).ToListAsync();}
}
