@if (IsRenewModalOpen && CurrentBusiness is not null && PlatformPricing is not null)
{
    <div class="modal-backdrop" @onclick="CloseRenewModal">
        <div class="form-modal" style="max-width:560px;" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2>تمدید یا ارتقای اشتراک</h2>
                    <p class="modal-subtitle">کسب‌وکار: @CurrentBusiness.Name</p>
                </div>
                <button type="button" class="close-button" aria-label="بستن" title="بستن" @onclick="CloseRenewModal">×</button>
            </div>
            <div class="modal-body">
                @if (RenewError is not null) { <div class="auth-error" style="margin-bottom:10px;">@RenewError</div> }
                
                <div style="font-weight:700; font-size:14px; margin-bottom:10px; color:var(--on-surface);">انتخاب پلن تمدید / ارتقا:</div>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:10px; margin-bottom:16px;">
                    <!-- ۱ ماهه -->
                    <div class="renew-plan-card @(RenewPlanType == "Monthly" ? "active" : "")" @onclick='() => SetRenewPlan("Monthly")'>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <b>۱ ماهه</b>
                            <span class="badge-discount badge-monthly">عادی</span>
                        </div>
                        <div class="renew-plan-subtitle">۱ ماه اشتراک مدیریت</div>
                        <div class="renew-plan-price">
                            @LocalizedDate.FormatNumber(CalculateRenewCost("Monthly"), UiLocale.Language) تومان
                        </div>
                    </div>

                    <!-- ۳ ماهه -->
                    <div class="renew-plan-card @(RenewPlanType == "Quarterly" ? "active" : "")" @onclick='() => SetRenewPlan("Quarterly")'>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <b>۳ ماهه</b>
                            @if (PlatformPricing.DiscountPercent3Months > 0)
                            {
                                <span class="badge-discount badge-quarterly">@PlatformPricing.DiscountPercent3Months٪ تخفیف</span>
                            }
                        </div>
                        <div class="renew-plan-subtitle">۳ ماه اشتراک کسب‌وکار</div>
                        <div class="renew-plan-price">
                            @LocalizedDate.FormatNumber(CalculateRenewCost("Quarterly"), UiLocale.Language) تومان
                        </div>
                    </div>

                    <!-- ۶ ماهه -->
                    <div class="renew-plan-card @(RenewPlanType == "SemiAnnual" ? "active" : "")" @onclick='() => SetRenewPlan("SemiAnnual")'>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <b>۶ ماهه</b>
                            @if (PlatformPricing.DiscountPercent6Months > 0)
                            {
                                <span class="badge-discount badge-semiannual">@PlatformPricing.DiscountPercent6Months٪ تخفیف</span>
                            }
                        </div>
                        <div class="renew-plan-subtitle">۶ ماه اشتراک اقتصادی</div>
                        <div class="renew-plan-price">
                            @LocalizedDate.FormatNumber(CalculateRenewCost("SemiAnnual"), UiLocale.Language) تومان
                        </div>
                    </div>

                    <!-- ۱ ساله -->
                    <div class="renew-plan-card @(RenewPlanType == "Annual" ? "active" : "")" @onclick='() => SetRenewPlan("Annual")'>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <b>۱ ساله</b>
                            @if (PlatformPricing.DiscountPercent12Months > 0)
                            {
                                <span class="badge-discount badge-annual">@PlatformPricing.DiscountPercent12Months٪ تخفیف</span>
                            }
                        </div>
                        <div class="renew-plan-subtitle">۱۲ ماه حداکثر صرفه‌جویی</div>
                        <div class="renew-plan-price">
                            @LocalizedDate.FormatNumber(CalculateRenewCost("Annual"), UiLocale.Language) تومان
                        </div>
                    </div>
                </div>

                <div class="renew-calc-box">
                    <div class="renew-calc-row">
                        <span>تعداد شعب فعال کسب‌وکار:</span>
                        <b>@ActiveBranchesCount شعبه</b>
                    </div>
                    <div class="renew-calc-row">
                        <span>تعرفه پایه ماهانه:</span>
                        <span>@LocalizedDate.FormatNumber(PlatformPricing.BaseBusinessPrice, UiLocale.Language) تومان</span>
                    </div>
                    @if (ActiveBranchesCount > 1)
                    {
                        <div class="renew-calc-row">
                            <span>تعرفه شعب مازاد (@(ActiveBranchesCount - 1) شعبه):</span>
                            <span>@LocalizedDate.FormatNumber((ActiveBranchesCount - 1) * PlatformPricing.ExtraBranchPrice, UiLocale.Language) تومان / ماه</span>
                        </div>
                    }
                    <div class="renew-calc-row renew-calc-total">
                        <span>مبلغ کل قابل پرداخت:</span>
                        <span>@LocalizedDate.FormatNumber(CalculateRenewCost(RenewPlanType), UiLocale.Language) تومان</span>
                    </div>
                </div>

                <!-- اطلاعات واریز -->
                <div class="renew-bank-box">
                    <div class="renew-bank-row"><span>شماره کارت:</span> <b dir="ltr">@PlatformPricing.CardNumber</b> @(!string.IsNullOrWhiteSpace(PlatformPricing.AccountHolder) ? $"({PlatformPricing.AccountHolder})" : "")</div>
                    @if (!string.IsNullOrWhiteSpace(PlatformPricing.Iban))
                    {
                        <div class="renew-bank-row"><span>شماره شبا:</span> <b dir="ltr">@PlatformPricing.Iban</b></div>
                    }
                </div>

                <div style="display:flex; flex-direction:column; gap:10px;">
                    <label style="font-size:13px;">کد پیگیری یا شماره ارجاع فیش
                        <input type="text" maxlength="50" placeholder="مثلاً: ۱۲۳۴۵۶۷۸" @bind="RenewTrackingCode" disabled="@IsSubmittingRenew" />
                    </label>
                    <label style="font-size:13px;">تصویر فیش واریزی
                        <InputFile OnChange="OnRenewReceiptSelected" accept="image/png,image/jpeg,image/webp" disabled="@IsSubmittingRenew" />
                    </label>
                    @if (RenewReceiptFileName is not null)
                    {
                        <div style="font-size:12px; color:#15803d;">فایل انتخاب‌شده: @RenewReceiptFileName</div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="action-secondary" @onclick="CloseRenewModal">انصراف</button>
                <button type="button" class="primary-button action-primary" disabled="@(IsSubmittingRenew || RenewReceiptBytes == null)" @onclick="SubmitRenewRequest">
                    @(IsSubmittingRenew ? "در حال ارسال..." : "ثبت درخواست و ارسال فیش")
                </button>
            </div>
        </div>
    </div>
}

