@page "/admin/business"
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AdminAccessScope Access
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>مشخصات کسب‌وکار | به‌نوبت</PageTitle>

<div class="page-title">
    <div>
        <h1>مشخصات کسب‌وکار</h1>
        <p>مشخصات اصلی، لوگو، معرفی و نحوه تأیید نوبت‌های کسب‌وکار خود را ویرایش کنید.</p>
    </div>
    @if (CurrentBusiness is not null)
    {
        var publicTarget = !string.IsNullOrWhiteSpace(CurrentBusiness.Slug) ? CurrentBusiness.Slug : CurrentBusiness.Id.ToString();
        <a href="/b/@publicTarget" target="_blank" class="action-secondary" style="display:inline-flex; align-items:center; gap:6px;">
            <span>مشاهده صفحه عمومی</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
    }
</div>

@if (Message is not null) { <div class="success-notice" role="status" style="margin-bottom:16px;">@Message</div> }
@if (Error is not null) { <div class="auth-error" role="alert" style="margin-bottom:16px;">@Error</div> }

@if (Loading)
{
    <p class="empty-state">در حال بارگذاری اطلاعات کسب‌وکار...</p>
}
else if (ManagedBusinesses.Count == 0)
{
    <p class="empty-state">شما هنوز کسب‌وکاری تحت مدیریت ندارید یا دسترسی لازم داده نشده است.</p>
}
else
{
    @if (ManagedBusinesses.Count > 1)
    {
        <div class="toolbar" style="margin-bottom: 20px; background:var(--surface); padding:12px 16px; border-radius:10px; border:1px solid var(--outline-soft); display:flex; align-items:center; gap:12px;">
            <label style="display:flex; align-items:center; gap:8px; font-weight:600; font-size:13px;">
                <span>انتخاب کسب‌وکار:</span>
                <select @bind="SelectedBusinessId" @bind:after="OnBusinessChanged" style="min-width:200px;">
                    @foreach (var b in ManagedBusinesses)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </label>
        </div>
    }

    @if (CurrentBusiness is not null)
    {
        var daysLeft = CurrentBusiness.DaysUntilPlanExpiration;
        var isExpired = CurrentBusiness.IsPlanExpired;
        var isWarning = !isExpired && daysLeft.HasValue && daysLeft.Value <= 7;

        <div class="admin-panel plan-banner" style="margin-bottom:20px; max-width:850px; background:@(isExpired ? "#fef2f2" : isWarning ? "#fffbeb" : "#f0fdf4"); border:1px solid @(isExpired ? "#fecaca" : isWarning ? "#fde68a" : "#bbf7d0"); border-radius:12px; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="font-size:28px;">
                        @(isExpired ? "🚫" : isWarning ? "⚠️" : "✨")
                    </div>
                    <div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <h3 style="margin:0; font-size:16px; font-weight:700; color:@(isExpired ? "#991b1b" : isWarning ? "#92400e" : "#166534");">
                                وضعیت اشتراک: @FormatPlanTitle(CurrentBusiness.PlanType)
                            </h3>
                            <span class="status @(isExpired ? "cancelled" : isWarning ? "pending" : "confirmed")" style="font-size:11px; padding:2px 8px; border-radius:999px;">
                                @(isExpired ? "منقضی شده" : isWarning ? $"رو به پایان ({daysLeft} روز باقی‌مانده)" : $"فعال ({daysLeft} روز باقی‌مانده)")
                            </span>
                        </div>
                        <div style="font-size:12px; color:#64748b; margin-top:4px; display:flex; gap:14px; flex-wrap:wrap;">
                            @if (CurrentBusiness.PlanStartedAt.HasValue)
                            {
                                <span>شروع: <b>@LocalizedDate.Format(DateOnly.FromDateTime(CurrentBusiness.PlanStartedAt.Value.DateTime), UiLocale.Language)</b></span>
                            }
                            @if (CurrentBusiness.PlanExpiresAt.HasValue)
                            {
                                <span>پایان: <b>@LocalizedDate.Format(DateOnly.FromDateTime(CurrentBusiness.PlanExpiresAt.Value.DateTime), UiLocale.Language)</b></span>
                            }
                            <span>تعداد شعب: <b>@ActiveBranchesCount شعبه فعال</b></span>
                        </div>
                    </div>
                </div>
                <button type="button" class="primary-button action-primary" style="font-size:13px; padding:8px 18px;" @onclick="OpenRenewModal">
                    تمدید یا ارتقای پلن
                </button>
            </div>
        </div>
    }

    <EditForm Model="Form" FormName="business-edit" OnValidSubmit="SaveBusiness" class="admin-panel admin-business-form" style="max-width:850px;">
        <!-- بخش ۱: تصاویر و هویت بصری -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg> هویت بصری و تصاویر
            </legend>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px;">
                <!-- لوگو / آواتار -->
                <div style="border:1px solid var(--outline-soft); border-radius:12px; padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px;">
                    <span style="font-size:13px; font-weight:600;">لوگو / نشان کسب‌وکار</span>
                    <div style="width:84px; height:84px; border-radius:50%; overflow:hidden; border:2px solid var(--outline-soft); background:var(--surface-variant); display:grid; place-items:center;">
                        @if (!string.IsNullOrEmpty(AvatarUrl))
                        {
                            <img src="@AvatarUrl" alt="لوگو" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#8a9794" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                        }
                    </div>
                    <label class="action-secondary" style="cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-size:12px;">
                        <span>تغییر لوگو</span>
                        <InputFile OnChange="UploadAvatar" accept="image/png,image/jpeg,image/webp" style="display:none;" />
                    </label>
                    <small style="color:var(--text-muted); font-size:11px;">فرمت‌های مجاز: JPG, PNG, WEBP (حداکثر ۵ مگابایت)</small>
                </div>

                <!-- بنر / کاور هدر -->
                <div style="border:1px solid var(--outline-soft); border-radius:12px; padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px;">
                    <span style="font-size:13px; font-weight:600;">تصویر پس‌زمینه (کاور)</span>
                    <div style="width:100%; height:84px; border-radius:8px; overflow:hidden; border:1px solid var(--outline-soft); background:var(--surface-variant); display:grid; place-items:center;">
                        @if (!string.IsNullOrEmpty(HeaderUrl))
                        {
                            <img src="@HeaderUrl" alt="کاور" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <span style="font-size:12px; color:#8a9794;">بدون تصویر کاور</span>
                        }
                    </div>
                    <label class="action-secondary" style="cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-size:12px;">
                        <span>تغییر کاور</span>
                        <InputFile OnChange="UploadHeader" accept="image/png,image/jpeg,image/webp" style="display:none;" />
                    </label>
                    <small style="color:var(--text-muted); font-size:11px;">فرمت‌های مجاز: JPG, PNG, WEBP (حداکثر ۵ مگابایت)</small>
                </div>
            </div>
        </fieldset>

        <hr style="border:none; border-top:1px solid var(--outline-soft); margin:20px 0;" />

        <!-- بخش ۲: مشخصات اصلی کسب‌وکار -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg> مشخصات عمومی
            </legend>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>نام کسب‌وکار <strong class="req" style="color:red;">*</strong></span>
                    <input type="text" required placeholder="مثال: کلینیک دندانپزشکی مهر" @bind="Form.Name" />
                </label>

                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>شناسه اینترنتی (Slug) <strong class="req" style="color:red;">*</strong></span>
                    <div class="input-prefix-wrapper">
                        <span class="input-prefix">benobat.ir/b/</span>
                        <input type="text" dir="ltr" required placeholder="mehr-clinic" @bind="Form.Slug" />
                    </div>
                </label>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:14px;">
                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>دسته‌بندی / صنف <strong class="req" style="color:red;">*</strong></span>
                    <select @bind="Form.Category">
                        @foreach (var cat in CategoryOptions)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </label>

                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>شهر</span>
                    <input type="text" placeholder="مثال: تهران" @bind="Form.City" />
                </label>
            </div>

            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; margin-top:14px;">
                <span>معرفی و درباره کسب‌وکار</span>
                <textarea rows="4" placeholder="توضیحاتی در مورد سوابق، تجهیزات و خدمات ویژه کسب‌وکار..." @bind="Form.Description"></textarea>
            </label>
        </fieldset>

        <hr style="border:none; border-top:1px solid var(--outline-soft); margin:20px 0;" />

        <!-- بخش ۳: قوانین رزرو و تأیید نوبت‌ها -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> تنظیمات نوبت‌دهی و تأیید
            </legend>

            <div style="background:var(--surface-variant, #f8faf9); padding:16px; border-radius:12px; border:1px solid var(--outline-soft); display:grid; gap:14px;">
                <label class="check-card" style="margin:0;">
                    <input type="checkbox" @bind="Form.RequiresApproval" />
                    <div>
                        <b>نیازمند تأیید دستی نوبت‌ها توسط شعبه</b>
                        <small>
                            در صورت فعال بودن، نوبت‌های ثبت‌شده توسط مشتریان تا زمان تأیید مدیریت با وضعیت «در انتظار تأیید» باقی می‌مانند و پیامک نهایی پس از بررسی ارسال می‌شود.
                            در غیر این صورت، نوبت‌ها بلافاصله پس از ثبت به‌صورت خودکار تأیید می‌گردند.
                        </small>
                    </div>
                </label>

                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>حداقل مهلت مجاز لغو نوبت توسط مشتری:</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <input type="number" min="0" max="129600" style="max-width:140px;" @bind="Form.CancellationNoticeMinutes" />
                        <span style="color:var(--text-muted); font-size:12px;">دقیقه قبل از زمان نوبت (پیش‌فرض: ۱۲۰ دقیقه = ۲ ساعت)</span>
                    </div>
                </label>
            </div>
        </fieldset>

        <hr style="border:none; border-top:1px solid var(--outline-soft); margin:20px 0;" />

        <!-- بخش ۴: شعبه مرکزی و نشانی -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> شعبه مرکزی و نشانی
            </legend>

            <div style="display:grid; grid-template-columns:1fr; gap:16px;">
                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>نام شعبه مرکزی</span>
                    <input type="text" placeholder="مثال: شعبه مرکزی" @bind="Form.FirstBranchName" />
                </label>

                <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                    <span>نشانی شعبه مرکزی</span>
                    <textarea rows="2" placeholder="خیابان، پلاک، طبقه یا واحد..." @bind="Form.FirstBranchAddress"></textarea>
                </label>
            </div>
        </fieldset>

        <hr style="border:none; border-top:1px solid var(--outline-soft); margin:20px 0;" />

        <!-- بخش ۵: تنظیمات بیعانه نوبت -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg> تنظیمات بیعانه نوبت (اختیاری)
            </legend>

            <div style="background:var(--surface-variant, #f8faf9); padding:16px; border-radius:12px; border:1px solid var(--outline-soft); display:grid; gap:14px;">
                <p style="margin:0; font-size:12px; color:var(--text-muted);">
                    در صورت تعیین درصد بیعانه، کاربر برای ثبت نوبت موظف به پرداخت بیعانه و الصاق تصویر فیش واریز خواهد بود.
                </p>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>درصد بیعانه (۰ تا ۱۰۰)</span>
                        <input type="number" min="0" max="100" placeholder="مثلاً: ۲۰" @bind="Form.DepositPercentage" />
                    </label>

                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>نام صاحب حساب</span>
                        <input type="text" placeholder="نام و نام خانوادگی صاحب کارت" @bind="Form.DepositAccountHolder" />
                    </label>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>شماره کارت (۱۶ رقمی)</span>
                        <input type="text" dir="ltr" maxlength="19" placeholder="۶۰۳۷-xxxx-xxxx-xxxx" @bind="Form.DepositCardNumber" />
                    </label>

                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>شماره شبا (با IR)</span>
                        <input type="text" dir="ltr" maxlength="26" placeholder="IRxxxxxxxxxxxxxxxxxxxxxxxx" @bind="Form.DepositIban" />
                    </label>
                </div>
            </div>
        </fieldset>

        <hr style="border:none; border-top:1px solid var(--outline-soft); margin:20px 0;" />

        <!-- بخش ۶: شبکه‌های اجتماعی و راه‌های ارتباطی -->
        <fieldset class="form-section" style="border:none; padding:0; margin-bottom:24px;">
            <legend style="font-size:15px; font-weight:700; color:var(--primary); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; color:var(--primary);"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> شبکه‌های اجتماعی و راه‌های ارتباطی (اختیاری)
            </legend>

            <div style="background:var(--surface-variant, #f8faf9); padding:16px; border-radius:12px; border:1px solid var(--outline-soft); display:grid; gap:14px;">
                <p style="margin:0; font-size:12px; color:var(--text-muted);">
                    آدرس‌ها و شناسه‌های شبکه‌های اجتماعی کسب‌وکار را وارد کنید تا در صفحه عمومی نمایش داده شوند. می‌توانید آیدی (با یا بدون @@) یا لینک کامل را درج نمایید.
                </p>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>اینستاگرام</span>
                        <input type="text" dir="ltr" placeholder="mehr_clinic یا لینک کامل..." @bind="Form.Instagram" />
                    </label>

                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>تلگرام</span>
                        <input type="text" dir="ltr" placeholder="mehr_clinic یا لینک کامل..." @bind="Form.Telegram" />
                    </label>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>واتساپ</span>
                        <input type="text" dir="ltr" placeholder="۰۹۱۲... یا لینک wa.me..." @bind="Form.WhatsApp" />
                    </label>

                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>ایتا</span>
                        <input type="text" dir="ltr" placeholder="mehr_clinic..." @bind="Form.Eitaa" />
                    </label>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>بله</span>
                        <input type="text" dir="ltr" placeholder="mehr_clinic..." @bind="Form.Bale" />
                    </label>

                    <label style="display:flex; flex-direction:column; gap:6px; font-size:13px;">
                        <span>روبیکا</span>
                        <input type="text" dir="ltr" placeholder="mehr_clinic..." @bind="Form.Rubika" />
                    </label>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
