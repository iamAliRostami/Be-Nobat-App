    private async Task SaveBusiness()
    {
        if (CurrentBusiness is null || Saving) return;
        Error = Message = null;

        var name = (Form.Name ?? "").Trim();
        var slug = (Form.Slug ?? "").Trim().ToLowerInvariant();
        var category = (Form.Category ?? "").Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            Error = "نام کسب‌وکار الزامی است.";
            return;
        }

        if (string.IsNullOrWhiteSpace(slug) || !System.Text.RegularExpressions.Regex.IsMatch(slug, "^[a-z0-9]+(-[a-z0-9]+)*$"))
        {
            Error = "شناسه URL باید فقط شامل حروف انگلیسی کوچک، اعداد و خط تیره (-) باشد.";
            return;
        }

        Saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var isSlugTaken = await db.Businesses.AnyAsync(x => x.Slug.ToLower() == slug && x.Id != CurrentBusiness.Id);
            if (isSlugTaken)
            {
                Error = "این شناسه اینترنتی (Slug) قبلاً توسط کسب‌وکار دیگری ثبت شده است.";
                return;
            }

            var b = await db.Businesses.FirstOrDefaultAsync(x => x.Id == CurrentBusiness.Id);
            if (b is null)
            {
                Error = "کسب‌وکار پیدا نشد.";
                return;
            }

            b.Name = name;
            b.Slug = slug;
            b.Category = category;
            b.City = (Form.City ?? "").Trim();
            b.Description = (Form.Description ?? "").Trim();
            b.RequiresApproval = Form.RequiresApproval;
            b.CancellationNoticeMinutes = Form.CancellationNoticeMinutes ?? 120;
            b.DepositPercentage = Form.DepositPercentage;
            b.DepositCardNumber = string.IsNullOrWhiteSpace(Form.DepositCardNumber) ? null : Form.DepositCardNumber.Trim();
            b.DepositIban = string.IsNullOrWhiteSpace(Form.DepositIban) ? null : Form.DepositIban.Trim();
            b.DepositAccountHolder = string.IsNullOrWhiteSpace(Form.DepositAccountHolder) ? null : Form.DepositAccountHolder.Trim();
            b.Telegram = string.IsNullOrWhiteSpace(Form.Telegram) ? null : Form.Telegram.Trim();
            b.Instagram = string.IsNullOrWhiteSpace(Form.Instagram) ? null : Form.Instagram.Trim();
            b.WhatsApp = string.IsNullOrWhiteSpace(Form.WhatsApp) ? null : Form.WhatsApp.Trim();
            b.Eitaa = string.IsNullOrWhiteSpace(Form.Eitaa) ? null : Form.Eitaa.Trim();
            b.Bale = string.IsNullOrWhiteSpace(Form.Bale) ? null : Form.Bale.Trim();
            b.Rubika = string.IsNullOrWhiteSpace(Form.Rubika) ? null : Form.Rubika.Trim();
            b.LinkedIn = string.IsNullOrWhiteSpace(Form.LinkedIn) ? null : Form.LinkedIn.Trim();
            b.Twitter = string.IsNullOrWhiteSpace(Form.Twitter) ? null : Form.Twitter.Trim();
            b.Aparat = string.IsNullOrWhiteSpace(Form.Aparat) ? null : Form.Aparat.Trim();
            b.Website = string.IsNullOrWhiteSpace(Form.Website) ? null : Form.Website.Trim();

            var firstBranch = await db.Branches
                .Where(x => x.BusinessId == b.Id && x.DeletedAt == null)
                .OrderBy(x => x.CreatedAt).ThenBy(x => x.Id).FirstOrDefaultAsync();
            if (firstBranch is not null)
            {
                if (!string.IsNullOrWhiteSpace(Form.FirstBranchName))
                    firstBranch.Name = Form.FirstBranchName.Trim();
                firstBranch.Address = (Form.FirstBranchAddress ?? "").Trim();
                firstBranch.UpdatedAt = DateTimeOffset.UtcNow;
            }

            b.UpdatedAt = DateTimeOffset.UtcNow;

            await db.SaveChangesAsync();
            CurrentBusiness = b;
            Message = "مشخصات کسب‌وکار با موفقیت ذخیره شد.";

            // Reload list to update titles if name changed
            ManagedBusinesses = await Access.ManagedBusinessesAsync();
        }
        catch (Exception ex)
        {
            Error = "خطا در ذخیره مشخصات: " + ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

