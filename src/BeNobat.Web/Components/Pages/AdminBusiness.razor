@code {
    [SupplyParameterFromQuery(Name = "businessId")] public Guid? QueryBusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "renew")] public bool AutoRenew { get; set; }

    private bool Loading = true;
    private bool Saving = false;
    private string? Error;
    private string? Message;
    private List<Business> ManagedBusinesses = [];
    private Guid SelectedBusinessId;
    private Business? CurrentBusiness;
    private BusinessFormModel Form = new();
    private List<string> CategoryOptions = [];
    private string? AvatarUrl;
    private string? HeaderUrl;

    private int ActiveBranchesCount;
    private bool IsRenewModalOpen;
    private PlatformPricingSettings? PlatformPricing;
    private string RenewPlanType = "Quarterly";
    private byte[]? RenewReceiptBytes;
    private string? RenewReceiptContentType;
    private string? RenewReceiptFileName;
    private string? RenewTrackingCode;
    private bool IsSubmittingRenew;
    private string? RenewError;

    private static string FormatPlanTitle(string? planType) => planType switch
    {
        "Trial7Days" => "تست رایگان (۷ روز)",
        "Quarterly" => "۳ ماهه",
        "SemiAnnual" => "۶ ماهه",
        "Annual" => "۱ ساله",
        _ => "تعرفه پایه"
    };

    private void SetRenewPlan(string plan)
    {
        RenewPlanType = plan;
    }

    private decimal CalculateRenewCost(string planType)
    {
        if (PlatformPricing is null) return 0;
        var extraCount = Math.Max(0, ActiveBranchesCount - 1);
        var monthly = PlatformPricing.BaseBusinessPrice + (extraCount * PlatformPricing.ExtraBranchPrice);
        return planType switch
        {
            "Quarterly" => (monthly * 3) * (100 - PlatformPricing.DiscountPercent3Months) / 100m,
            "SemiAnnual" => (monthly * 6) * (100 - PlatformPricing.DiscountPercent6Months) / 100m,
            "Annual" => (monthly * 12) * (100 - PlatformPricing.DiscountPercent12Months) / 100m,
            _ => monthly
        };
    }

    private async Task OpenRenewModal()
    {
        if (CurrentBusiness is null) return;
        RenewError = null;
        RenewReceiptBytes = null;
        RenewReceiptFileName = null;
        RenewTrackingCode = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        PlatformPricing = await db.GetPlatformPricingAsync();
        ActiveBranchesCount = await db.Branches.CountAsync(b => b.BusinessId == CurrentBusiness.Id && b.DeletedAt == null);
        IsRenewModalOpen = true;
    }

    private void CloseRenewModal()
    {
        IsRenewModalOpen = false;
        RenewError = null;
        if (AutoRenew)
        {
            AutoRenew = false;
            Navigation.NavigateTo("/admin/business", replace: true);
        }
    }

    private async Task OnRenewReceiptSelected(InputFileChangeEventArgs e)
    {
        RenewReceiptBytes = null;
        RenewReceiptContentType = null;
        RenewReceiptFileName = null;
        RenewError = null;

        var file = e.File;
        if (file is null) return;
        if (file.Size > 4 * 1024 * 1024)
        {
            RenewError = "حجم فایل نباید بیشتر از ۴ مگابایت باشد.";
            return;
        }

        using var stream = file.OpenReadStream(4 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        RenewReceiptBytes = ms.ToArray();
        RenewReceiptContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        RenewReceiptFileName = file.Name;
    }

    private async Task SubmitRenewRequest()
    {
        if (CurrentBusiness is null || PlatformPricing is null || RenewReceiptBytes == null || IsSubmittingRenew) return;
        IsSubmittingRenew = true;
        RenewError = null;
        try
        {
            var myUserId = await Access.UserIdAsync();
            var durationMonths = RenewPlanType switch
            {
                "Quarterly" => 3,
                "SemiAnnual" => 6,
                "Annual" => 12,
                _ => 1
            };
            var discount = RenewPlanType switch
            {
                "Quarterly" => PlatformPricing.DiscountPercent3Months,
                "SemiAnnual" => PlatformPricing.DiscountPercent6Months,
                "Annual" => PlatformPricing.DiscountPercent12Months,
                _ => 0
            };
            var totalFee = CalculateRenewCost(RenewPlanType);

            await using var db = await DbFactory.CreateDbContextAsync();
            var req = new BusinessRequest
            {
                UserId = myUserId,
                ApprovedBusinessId = CurrentBusiness.Id,
                BusinessName = CurrentBusiness.Name,
                Category = CurrentBusiness.Category,
                City = CurrentBusiness.City,
                Description = $"درخواست تمدید/ارتقای پلن به {FormatPlanTitle(RenewPlanType)}",
                ContactPhone = "",
                FirstBranchName = Form.FirstBranchName,
                FirstBranchAddress = Form.FirstBranchAddress,
                PlanType = RenewPlanType,
                PlanDurationMonths = durationMonths,
                DiscountPercent = discount,
                BasePrice = PlatformPricing.BaseBusinessPrice,
                ExtraBranchPrice = PlatformPricing.ExtraBranchPrice,
                TotalBranchesCount = ActiveBranchesCount,
                TotalFee = totalFee,
                ReceiptImageData = RenewReceiptBytes,
                ReceiptImageContentType = RenewReceiptContentType ?? "image/jpeg",
                ReceiptTrackingCode = RenewTrackingCode?.Trim(),
                ReceiptUploadedAt = DateTimeOffset.UtcNow,
                Status = BusinessRequestStatus.Pending,
                CreatedAt = DateTimeOffset.UtcNow,
                UpdatedAt = DateTimeOffset.UtcNow,
            };

            db.BusinessRequests.Add(req);
            await db.SaveChangesAsync();

            IsRenewModalOpen = false;
            Message = "درخواست تمدید پلن با موفقیت ثبت شد و پس از بررسی مدیریت سامانه فعال خواهد شد.";
        }
        catch (Exception ex)
        {
            RenewError = "خطا در ثبت درخواست تمدید: " + ex.Message;
        }
        finally
        {
            IsSubmittingRenew = false;
        }
    }

    public sealed class BusinessFormModel
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Category { get; set; } = "";
        public string City { get; set; } = "";
        public string Description { get; set; } = "";
        public bool RequiresApproval { get; set; } = true;
        public int? CancellationNoticeMinutes { get; set; } = 120;
        public string FirstBranchName { get; set; } = "شعبه مرکزی";
        public string FirstBranchAddress { get; set; } = "";
        public int? DepositPercentage { get; set; }
        public string? DepositCardNumber { get; set; }
        public string? DepositIban { get; set; }
        public string? DepositAccountHolder { get; set; }
        public string? Telegram { get; set; }
        public string? Instagram { get; set; }
        public string? WhatsApp { get; set; }
        public string? Eitaa { get; set; }
        public string? Bale { get; set; }
        public string? Rubika { get; set; }
        public string? LinkedIn { get; set; }
        public string? Twitter { get; set; }
        public string? Aparat { get; set; }
        public string? Website { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBusinesses();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (QueryBusinessId.HasValue && QueryBusinessId.Value != Guid.Empty && QueryBusinessId.Value != SelectedBusinessId)
        {
            SelectedBusinessId = QueryBusinessId.Value;
            await SelectBusiness(SelectedBusinessId);
        }
        if (AutoRenew && CurrentBusiness is not null && !IsRenewModalOpen)
        {
            await OpenRenewModal();
        }
    }

    private async Task LoadBusinesses()
    {
        Loading = true;
        Error = Message = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            CategoryOptions = await db.CategoryDefinitions.AsNoTracking()
                .Where(x => x.Kind == CategoryKind.Business && x.IsActive)
                .OrderBy(x => x.SortOrder).ThenBy(x => x.Name)
                .Select(x => x.Name).ToListAsync();

            if (CategoryOptions.Count == 0)
            {
                CategoryOptions = ["پزشکی و سلامت", "زیبایی و سلامت", "آموزش", "خدمات فنی", "ورزش", "مشاوره", "عمومی"];
            }

            ManagedBusinesses = await Access.ManagedBusinessesAsync();
            if (ManagedBusinesses.Count > 0)
            {
                var targetId = QueryBusinessId.HasValue && ManagedBusinesses.Any(b => b.Id == QueryBusinessId.Value)
                    ? QueryBusinessId.Value
                    : ManagedBusinesses[0].Id;
                SelectedBusinessId = targetId;
                await SelectBusiness(targetId);
                if (AutoRenew && !IsRenewModalOpen)
                {
                    await OpenRenewModal();
                }
            }
        }
        catch (Exception ex)
        {
            Error = "خطا در بارگذاری کسب‌وکارها: " + ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task OnBusinessChanged()
    {
        await SelectBusiness(SelectedBusinessId);
    }

    private async Task SelectBusiness(Guid id)
    {
        Error = Message = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        CurrentBusiness = await db.Businesses.FirstOrDefaultAsync(b => b.Id == id);
        if (CurrentBusiness is null)
        {
            Error = "کسب‌وکار مورد نظر یافت نشد.";
            return;
        }

        ActiveBranchesCount = await db.Branches.CountAsync(b => b.BusinessId == id && b.DeletedAt == null);

        if (!CategoryOptions.Contains(CurrentBusiness.Category) && !string.IsNullOrWhiteSpace(CurrentBusiness.Category))
        {
            CategoryOptions.Insert(0, CurrentBusiness.Category);
        }

        var firstBranch = await db.Branches
            .Where(x => x.BusinessId == id && x.DeletedAt == null)
            .OrderBy(x => x.CreatedAt).ThenBy(x => x.Id).FirstOrDefaultAsync();

        Form = new BusinessFormModel
        {
            Name = CurrentBusiness.Name,
            Slug = CurrentBusiness.Slug,
            Category = CurrentBusiness.Category,
            City = CurrentBusiness.City,
            Description = CurrentBusiness.Description,
            RequiresApproval = CurrentBusiness.RequiresApproval,
            CancellationNoticeMinutes = CurrentBusiness.CancellationNoticeMinutes,
            FirstBranchName = firstBranch?.Name ?? "شعبه مرکزی",
            FirstBranchAddress = firstBranch?.Address ?? "",
            DepositPercentage = CurrentBusiness.DepositPercentage,
            DepositCardNumber = CurrentBusiness.DepositCardNumber,
            DepositIban = CurrentBusiness.DepositIban,
            DepositAccountHolder = CurrentBusiness.DepositAccountHolder,
            Telegram = CurrentBusiness.Telegram,
            Instagram = CurrentBusiness.Instagram,
            WhatsApp = CurrentBusiness.WhatsApp,
            Eitaa = CurrentBusiness.Eitaa,
            Bale = CurrentBusiness.Bale,
            Rubika = CurrentBusiness.Rubika,
            LinkedIn = CurrentBusiness.LinkedIn,
            Twitter = CurrentBusiness.Twitter,
            Aparat = CurrentBusiness.Aparat,
            Website = CurrentBusiness.Website,
        };

        AvatarUrl = CurrentBusiness.AvatarData != null ? $"/media/business/{CurrentBusiness.Id}/avatar?t={DateTime.UtcNow.Ticks}" : null;
        HeaderUrl = CurrentBusiness.HeaderData != null ? $"/media/business/{CurrentBusiness.Id}/header?t={DateTime.UtcNow.Ticks}" : null;
    }

    private async Task UploadAvatar(InputFileChangeEventArgs e)
    {
        if (CurrentBusiness is null) return;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024)
            {
                Error = "حجم فایل نباید بیش از ۵ مگابایت باشد.";
                return;
            }
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            await using var db = await DbFactory.CreateDbContextAsync();
            var b = await db.Businesses.FirstOrDefaultAsync(x => x.Id == CurrentBusiness.Id);
            if (b != null)
            {
                b.AvatarData = ms.ToArray();
                b.AvatarContentType = file.ContentType.ToLowerInvariant();
                b.UpdatedAt = DateTimeOffset.UtcNow;
                await db.SaveChangesAsync();
                AvatarUrl = $"/media/business/{b.Id}/avatar?t={DateTime.UtcNow.Ticks}";
                Message = "لوگوی کسب‌وکار با موفقیت به‌روزرسانی شد.";
            }
        }
        catch (Exception ex)
        {
            Error = "خطا در بارگذاری تصویر: " + ex.Message;
        }
    }

