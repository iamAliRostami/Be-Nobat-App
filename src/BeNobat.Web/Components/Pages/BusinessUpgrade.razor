@page "/account/business-upgrade"
@page "/business-upgrade"
@layout Layout.PublicLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<BusinessUpgrade> Logger

<PageTitle>درخواست کسب‌وکار و ارتقا | به‌نوبت</PageTitle>

<div class="account-page">
    <AccountMenu UserId="@User?.Id" DisplayName="@User?.DisplayName" Email="@User?.Email"
                 AvatarContentType="@User?.AvatarContentType" ConcurrencyStamp="@User?.ConcurrencyStamp" />
    <div class="account-content profile-account-content">
        <section class="profile-page" aria-labelledby="upgrade-heading">
            <div class="page-title">
                <div>
                    <h1 id="upgrade-heading">ارتقا به مدیر کسب‌وکار</h1>
                    <p>با ثبت اطلاعات کسب‌وکار و شعب، می‌توانید خدمات، تقویم و نوبت‌های خود را به صورت هوشمند مدیریت کنید.</p>
                </div>
                <div>
                    <a href="/account/profile" class="action-secondary" style="font-size:0.85rem; padding:0.4rem 0.8rem; text-decoration:none;">بازگشت به حساب کاربری</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="success-notice" role="status" style="margin-bottom:1rem;">@SuccessMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="auth-error" role="alert" style="margin-bottom:1rem;">@ErrorMessage</div>
            }

            @if (IsLoading)
            {
                <div style="padding:2rem; text-align:center; color:#64748b;">در حال دریافت اطلاعات...</div>
            }
            else if (IsAlreadyManager)
            {
                <article class="admin-panel profile-form profile-card">
                    <header class="profile-card-head">
                        <h2>مدیر فعال سامانه</h2>
                    </header>
                    <div style="display:flex; align-items:center; gap:0.75rem; margin:1rem 0; flex-wrap:wrap;">
                        <span class="status confirmed" style="font-size:0.85rem; font-weight:700; padding:0.35rem 0.85rem; border-radius:999px; background:#e6f4ea; color:#137333;">مدیر فعال</span>
                        <span style="color:#475569; font-size:0.92rem;">حساب کاربری شما دارای دسترسی مدیریت کسب‌وکار است و می‌توانید نوبت‌ها، خدمات و شعب خود را مدیریت نمایید.</span>
                    </div>
                    <div class="profile-card-actions">
                        <a class="primary-button action-primary" href="/admin" style="display:inline-block; text-align:center; text-decoration:none;">ورود به پنل مدیریت</a>
                    </div>
                </article>
            }
            else if (LatestRequest is not null && LatestRequest.Status == BusinessRequestStatus.Pending)
            {
                var isTrial = LatestRequest.PlanType == "Trial7Days";
                @* مرحله در انتظار پرداخت و تأیید مدیر *@
                <div style="display:grid; gap:1.25rem;">
                    @* بنر وضعیت درخواست *@
                    <div style="background:@(isTrial || LatestRequest.ReceiptImageData != null ? "#ecfdf5" : "#fffbeb"); border:1px solid @(isTrial || LatestRequest.ReceiptImageData != null ? "#a7f3d0" : "#fde68a"); border-radius:12px; padding:1.2rem; color:@(isTrial || LatestRequest.ReceiptImageData != null ? "#065f46" : "#92400e");">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.5rem;">
                            <div style="display:flex; align-items:center; gap:0.6rem; font-weight:700; font-size:1rem;">
                                <span>@(isTrial ? "✨" : LatestRequest.ReceiptImageData != null ? "⏳" : "💳")</span>
                                <span>@(isTrial ? "درخواست تست رایگان در انتظار بررسی مدیریت سامانه است" : LatestRequest.ReceiptImageData != null ? "درخواست شما در انتظار بررسی مدیریت سامانه است" : "در انتظار پرداخت تعرفه و ارسال فیش واریزی")</span>
                            </div>
                            <span style="font-size:0.78rem; font-weight:600; padding:0.25rem 0.65rem; border-radius:999px; background:@(isTrial || LatestRequest.ReceiptImageData != null ? "#d1fae5" : "#fef3c7"); color:@(isTrial || LatestRequest.ReceiptImageData != null ? "#047857" : "#b45309");">
                                @(isTrial ? "پلن تست رایگان" : LatestRequest.ReceiptImageData != null ? "فیش ارسال شد — در صف بررسی" : "در انتظار پرداخت")
                            </span>
                        </div>
                        <p style="margin:0.25rem 0 0; font-size:0.88rem; line-height:1.6;">
                            @(isTrial
                                ? $"درخواست کسب‌وکار «{LatestRequest.BusinessName}» با پلن تست رایگان ۷ روزه ثبت شده است و نیازی به واریز وجه ندارد. پس از تأیید مدیریت سامانه دسترسی فعال خواهد شد."
                                : LatestRequest.ReceiptImageData != null
                                    ? $"فیش واریزی شما برای درخواست کسب‌وکار «{LatestRequest.BusinessName}» با موفقیت دریافت شد. پس از بررسی و تأیید توسط مدیریت سامانه، دسترسی مدیریت فعال خواهد شد."
                                    : $"اطلاعات کسب‌وکار «{LatestRequest.BusinessName}» ثبت شده است. لطفاً مبلغ کل تعرفه را طبق تعداد شعب به اطلاعات حساب واریز کرده و تصویر فیش واریزی را در فرم زیر ارسال نمایید.")
                        </p>
                    </div>

                    @* مشخصات کسب‌وکار و محاسبه تعرفه *@
                    <article class="admin-panel profile-form profile-card">
                        <header class="profile-card-head">
                            <h2>مشخصات کسب‌وکار و تعرفه محاسبه‌شده</h2>
                        </header>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; font-size:0.88rem; margin:0.5rem 0;">
                            <div><span class="detail-label">نام کسب‌وکار:</span> <b>@LatestRequest.BusinessName</b></div>
                            <div><span class="detail-label">دسته‌بندی:</span> @LatestRequest.Category</div>
                            <div><span class="detail-label">پلن انتخابی:</span> <b style="color:var(--primary);">@FormatPlanTitle(LatestRequest.PlanType, LatestRequest.DiscountPercent)</b></div>
                            <div><span class="detail-label">شهر:</span> @LatestRequest.City</div>
                            <div><span class="detail-label">شماره تماس:</span> <span dir="ltr">@LatestRequest.ContactPhone</span></div>
                            <div><span class="detail-label">شعبه اول:</span> @LatestRequest.FirstBranchName (@LatestRequest.FirstBranchAddress)</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(LatestRequest.Description))
                        {
                            <div class="detail-desc-box">
                                <span style="font-weight:600;" class="detail-label">توضیحات:</span> @LatestRequest.Description
                            </div>
                        }

                        @* لیست سایر شعب *@
                        @if (LatestRequest.GetAdditionalBranches().Count > 0)
                        {
                            <div style="margin-top:1rem; border-top:1px dashed var(--outline-soft, #e2e8f0); padding-top:0.75rem;">
                                <div style="font-weight:600; font-size:0.85rem; color:var(--on-surface-variant, #475569); margin-bottom:0.5rem;">
                                    سایر شعب ثبت‌شده (@LatestRequest.GetAdditionalBranches().Count شعبه):
                                </div>
                                <ul style="margin:0; padding-right:1.25rem; font-size:0.85rem; color:var(--on-surface, #334155);">
                                    @foreach (var br in LatestRequest.GetAdditionalBranches())
                                    {
                                        <li style="margin-bottom:0.25rem;">
                                            <b>@br.Name</b> @(!string.IsNullOrWhiteSpace(br.Address) ? $"({br.Address})" : "")
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @* کادر رقم قابل پرداخت براساس تعداد شعب و پلن *@
                        <div class="plan-calc-box" style="margin-top:1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
                            <div>
                                <div class="plan-calc-title">تعداد کل شعب: <b>@LatestRequest.TotalBranchesCount شعبه</b> (۱ شعبه اصلی + @(LatestRequest.TotalBranchesCount - 1) شعبه دیگر)</div>
                                <div class="plan-calc-desc">
                                    پلن: @FormatPlanTitle(LatestRequest.PlanType, LatestRequest.DiscountPercent)
                                    @if (!isTrial)
                                    {
                                        <span> • تعرفه ماهانه پایه: @LocalizedDate.FormatNumber(LatestRequest.BasePrice, UiLocale.Language) تومان</span>
                                    }
                                </div>
                            </div>
                            <div style="text-align:left;">
                                <div class="plan-calc-total-label">مبلغ کل:</div>
                                <div class="plan-calc-total-val">
                                    @(isTrial || LatestRequest.TotalFee == 0 ? "رایگان" : $"{LocalizedDate.FormatNumber(LatestRequest.TotalFee, UiLocale.Language)} تومان")
                                </div>
                            </div>
                        </div>
                    </article>

                    @if (!isTrial)
                    {
                        @* اطلاعات واریز و بانکی *@
                        <article class="admin-panel profile-form profile-card">
                            <header class="profile-card-head">
                                <h2>اطلاعات حساب بانکی جهت واریز</h2>
                            </header>
                            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:1rem; margin:0.75rem 0; font-size:0.88rem;">
                                @if (!string.IsNullOrWhiteSpace(Pricing.CardNumber))
                                {
                                    <div class="bank-info-item">
                                        <div class="bank-info-label">شماره کارت:</div>
                                        <div class="bank-info-val" style="font-family:monospace;" dir="ltr">@Pricing.CardNumber</div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Pricing.Iban))
                                {
                                    <div class="bank-info-item">
                                        <div class="bank-info-label">شماره شبا:</div>
                                        <div class="bank-info-val" style="font-family:monospace;" dir="ltr">@Pricing.Iban</div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Pricing.AccountHolder))
                                {
                                    <div class="bank-info-item">
                                        <div class="bank-info-label">به نام:</div>
                                        <div class="bank-info-val">@Pricing.AccountHolder</div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Pricing.PaymentInstructions))
                            {
                                <div class="bank-instructions">
                                    💡 <b>راهنما:</b> @Pricing.PaymentInstructions
                                </div>
                            }
                        </article>

                        @* فرم ارسال یا تغییر فیش واریزی *@
                        <article class="admin-panel profile-form profile-card">
                            <header class="profile-card-head">
                                <h2>ارسال تصویر فیش واریزی</h2>
                            </header>

                            @if (LatestRequest.ReceiptImageData != null && LatestRequest.ReceiptImageData.Length > 0)
                            {
                                <div class="receipt-preview-box">
                                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.75rem;">
                                        <span style="color:var(--primary, #059669); font-weight:700; font-size:0.9rem;">✓ فیش واریزی با موفقیت بارگذاری شده است</span>
                                        @if (LatestRequest.ReceiptUploadedAt.HasValue)
                                        {
                                            <span style="color:var(--on-surface-variant, #64748b); font-size:0.8rem;">تاریخ ارسال: @LocalizedDate.Format(DateOnly.FromDateTime(LatestRequest.ReceiptUploadedAt.Value.DateTime), UiLocale.Language)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(LatestRequest.ReceiptTrackingCode))
                                    {
                                        <div style="font-size:0.85rem; color:var(--on-surface, #334155); margin-bottom:0.75rem;">
                                            کد پیگیری / ارجاع: <b dir="ltr" style="font-family:monospace;">@LatestRequest.ReceiptTrackingCode</b>
                                        </div>
                                    }
                                    <div>
                                        <img src="data:@(LatestRequest.ReceiptImageContentType ?? "image/jpeg");base64,@Convert.ToBase64String(LatestRequest.ReceiptImageData)"
                                             alt="تصویر فیش واریزی"
                                             style="max-width:320px; width:100%; max-height:240px; object-fit:contain; border-radius:8px; border:1px solid var(--outline-soft, #cbd5e1); background:var(--surface, #ffffff);" />
                                    </div>
                                </div>
                            }

                            <p style="font-size:0.84rem; color:var(--on-surface-variant, #64748b); margin-bottom:0.75rem;">
                                @(LatestRequest.ReceiptImageData != null ? "در صورت تمایل به تغییر یا اصلاح فیش واریزی، فایل جدید را در زیر انتخاب و ذخیره کنید:" : "تصویر فیش انتقال وجه یا اسکرین‌شات رسید همراه با کد رهگیری را ثبت نمایید:")
                            </p>

                            <div class="profile-fields">
                                <label>
                                    <span>کد رهگیری یا شماره ارجاع فیش</span>
                                    <input maxlength="50" placeholder="مثلاً: ۱۲۳۴۵۶۷۸ یا شماره پیگیری تراکنش" @bind="ReceiptTrackingCode" disabled="@IsUploadingReceipt" />
                                </label>
                                <label>
                                    <span>انتخاب تصویر فیش واریزی <strong class="req">*</strong></span>
                                    <InputFile OnChange="OnReceiptFileSelected" accept="image/png,image/jpeg,image/webp" disabled="@IsUploadingReceipt" />
                                </label>
                                @if (!string.IsNullOrWhiteSpace(ReceiptFileName))
                                {
                                    <div style="font-size:0.8rem; color:#059669;">فایل انتخاب شده: @ReceiptFileName (@((ReceiptFileBytes?.Length ?? 0) / 1024) کیلوبایت)</div>
                                }
                            </div>

                            <div class="profile-card-actions" style="margin-top:1rem;">
                                <button type="button" class="primary-button action-primary" disabled="@(IsUploadingReceipt || ReceiptFileBytes == null)" @onclick="SubmitReceipt">
                                    @(IsUploadingReceipt ? "در حال ارسال فیش..." : (LatestRequest.ReceiptImageData != null ? "بروزرسانی تصویر فیش" : "ثبت فیش واریزی"))
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            else if (LatestRequest is not null && LatestRequest.Status == BusinessRequestStatus.Rejected && !IsEditingResubmit)
            {
                <article class="admin-panel profile-form profile-card">
                    <div style="background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:10px; padding:1.25rem; margin-bottom:1.25rem;">
                        <div style="display:flex; align-items:center; gap:0.5rem; font-weight:700; font-size:1rem; margin-bottom:0.5rem;">
                            <span>❌</span>
                            <span>درخواست قبلی شما رد شد</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(LatestRequest.ReviewNote))
                        {
                            <p style="margin:0.25rem 0 0; font-size:0.88rem; line-height:1.6; color:#b91c1c;">
                                <b>توضیح مدیریت:</b> @LatestRequest.ReviewNote
                            </p>
                        }
                    </div>
                    <div class="profile-card-actions">
                        <button type="button" class="primary-button action-primary" @onclick="StartResubmit">ویرایش و ارسال مجدد درخواست</button>
                    </div>
                </article>
            }
            else
            {
                @* فرم درخواست ارتقا و ثبت کسب‌وکار با امکان افزودن چند شعبه *@
                <article class="admin-panel profile-form profile-card">
                    <header class="profile-card-head">
                        <h2>فرم ثبت کسب‌وکار و شعب</h2>
                    </header>
                    <p style="font-size:0.875rem; color:#64748b; margin-bottom:1.25rem; line-height:1.7;">
                        اطلاعات کسب‌وکار و شعبه‌های خود را وارد کنید. پس از ثبت، رقم تعرفه بر اساس تعداد شعب محاسبه شده و به مرحله پرداخت و ارسال فیش منتقل خواهید شد.
                    </p>

                    <EditForm Model="BusinessForm" OnValidSubmit="HandleSubmitRequest">
                        <div class="profile-fields">
                            <label>
                                <span>نام کسب‌وکار <strong class="req">*</strong></span>
                                <input required maxlength="100" placeholder="مثال: سالن زیبایی پروانه" @bind="BusinessForm.BusinessName" disabled="@IsSubmitting" />
                            </label>

                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                                <label>
                                    <span>دسته‌بندی <strong class="req">*</strong></span>
                                    <select @bind="BusinessForm.Category" disabled="@IsSubmitting" required>
                                        <option value="">— انتخاب دسته‌بندی —</option>
                                        @foreach (var cat in Categories)
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>شهر <strong class="req">*</strong></span>
                                    <input required maxlength="50" placeholder="مثال: تهران" @bind="BusinessForm.City" disabled="@IsSubmitting" />
                                </label>
                            </div>

                            <label>
                                <span>شماره تماس کسب‌وکار <strong class="req">*</strong></span>
                                <input type="tel" required maxlength="14" dir="ltr" placeholder="مثلاً ۰۲۱۱۲۳۴۵۶۷۸ یا ۰۹۱۲..." @bind="BusinessForm.Phone" disabled="@IsSubmitting" />
                            </label>

                            <label>
                                <span>توضیحات کسب‌وکار</span>
                                <textarea rows="2" maxlength="1000" placeholder="توضیح مختصری درباره خدمات و زمینه فعالیت..." @bind="BusinessForm.Description" disabled="@IsSubmitting"></textarea>
                            </label>

                            @* اطلاعات شعبه اول *@
                            <div class="branch-box">
                                <div class="branch-box-title">
                                    <span>📍</span>
                                    <span>شعبه اول (شعبه اصلی)</span>
                                </div>
                                <div style="display:grid; gap:0.75rem;">
                                    <label>
                                        <span>نام اولین شعبه <strong class="req">*</strong></span>
                                        <input required maxlength="100" placeholder="مثال: شعبه مرکزی" @bind="BusinessForm.FirstBranchName" disabled="@IsSubmitting" />
                                    </label>
                                    <label>
                                        <span>نشانی اولین شعبه <strong class="req">*</strong></span>
                                        <input required maxlength="250" placeholder="مثال: خیابان ولیعصر، پلاک ۱۰" @bind="BusinessForm.FirstBranchAddress" disabled="@IsSubmitting" />
                                    </label>
                                </div>
                            </div>

                            @* بخش افزودن شعب اضافه *@
                            <div style="margin-top:0.5rem;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                                    <div class="section-subtitle" style="margin-bottom:0;">شعب دیگر کسب‌وکار</div>
                                    <button type="button" class="action-secondary" style="font-size:0.8rem; padding:0.35rem 0.75rem;" disabled="@IsSubmitting" @onclick="AddExtraBranch">
                                        ➕ افزودن شعبه دیگر
                                    </button>
                                </div>

                                @if (ExtraBranches.Count > 0)
                                {
                                    <div style="display:grid; gap:0.75rem;">
                                        @for (var i = 0; i < ExtraBranches.Count; i++)
                                        {
                                            var idx = i;
                                            var branch = ExtraBranches[idx];
                                            <div class="extra-branch-box">
                                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                                                    <span class="extra-branch-title">شعبه @(idx + 2)</span>
                                                    <button type="button" class="action-danger" style="font-size:0.75rem; padding:0.2rem 0.5rem;" disabled="@IsSubmitting" @onclick="() => RemoveExtraBranch(idx)">
                                                        حذف
                                                    </button>
                                                </div>
                                                <div style="display:grid; gap:0.5rem;">
                                                    <label>
                                                        <span>نام شعبه <strong class="req">*</strong></span>
                                                        <input required maxlength="100" placeholder="مثال: شعبه سعادت‌آباد" @bind="branch.Name" disabled="@IsSubmitting" />
                                                    </label>
                                                    <label>
                                                        <span>نشانی شعبه <strong class="req">*</strong></span>
                                                        <input required maxlength="250" placeholder="مثال: میدان کاج، خیابان سرو غربی، پلاک ۲" @bind="branch.Address" disabled="@IsSubmitting" />
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="section-note">
                                        در صورت داشتن بیش از یک شعبه، دکمه «افزودن شعبه دیگر» را بزنید.
                                    </div>
                                }
                            </div>

                            @* بخش انتخاب پلن و دوره اشتراک *@
                            <div style="margin-top:1.25rem;">
                                <div class="section-subtitle">
                                    انتخاب دوره اشتراک کسب‌وکار <strong class="req">*</strong>
                                </div>
                                <div class="plan-grid">
                                    <!-- پلن ۱ هفته تست رایگان -->
                                    <div class="plan-card @(SelectedPlanType == "Trial7Days" ? "active" : "")" @onclick='() => SelectPlan("Trial7Days")'>
                                        <div style="display:flex; justify-content:space-between; align-items:center;">
                                            <span class="plan-card-title">۱ هفته تست</span>
                                            <span class="plan-tag tag-trial">رایگان</span>
                                        </div>
                                        <div class="plan-card-sub">۷ روز تست کامل امکانات</div>
                                        <div class="plan-card-price" style="color:var(--primary, #0284c7);">۰ <small style="font-size:0.72rem;">تومان</small></div>
                                    </div>

                                    <!-- پلن ۱ ماهه -->
                                    <div class="plan-card @(SelectedPlanType == "Monthly" ? "active" : "")" @onclick='() => SelectPlan("Monthly")'>
                                        <div style="display:flex; justify-content:space-between; align-items:center;">
                                            <span class="plan-card-title">۱ ماهه</span>
                                            <span class="plan-tag tag-monthly">عادی</span>
                                        </div>
                                        <div class="plan-card-sub">۱ ماه اشتراک مدیریت</div>
                                        <div class="plan-card-price">
                                            @LocalizedDate.FormatNumber(CalculatePlanCost("Monthly"), UiLocale.Language) <small style="font-size:0.72rem;">تومان</small>
                                        </div>
                                    </div>

                                    <!-- پلن ۳ ماهه -->
                                    <div class="plan-card @(SelectedPlanType == "Quarterly" ? "active" : "")" @onclick='() => SelectPlan("Quarterly")'>
                                        <div style="display:flex; justify-content:space-between; align-items:center;">
                                            <span class="plan-card-title">۳ ماهه</span>
                                            @if (Pricing.DiscountPercent3Months > 0)
                                            {
                                                <span class="plan-tag tag-discount-3">@Pricing.DiscountPercent3Months٪ تخفیف</span>
                                            }
                                        </div>
                                        <div class="plan-card-sub">۳ ماه اشتراک مدیریت</div>
                                        <div class="plan-card-price">
                                            @LocalizedDate.FormatNumber(CalculatePlanCost("Quarterly"), UiLocale.Language) <small style="font-size:0.72rem;">تومان</small>
                                        </div>
                                    </div>

                                    <!-- پلن ۶ ماهه -->
                                    <div class="plan-card @(SelectedPlanType == "SemiAnnual" ? "active" : "")" @onclick='() => SelectPlan("SemiAnnual")'>
                                        <div style="display:flex; justify-content:space-between; align-items:center;">
                                            <span class="plan-card-title">۶ ماهه</span>
                                            @if (Pricing.DiscountPercent6Months > 0)
                                            {
                                                <span class="plan-tag tag-discount-6">@Pricing.DiscountPercent6Months٪ تخفیف</span>
                                            }
                                        </div>
                                        <div class="plan-card-sub">۶ ماه اشتراک اقتصادی</div>
                                        <div class="plan-card-price">
                                            @LocalizedDate.FormatNumber(CalculatePlanCost("SemiAnnual"), UiLocale.Language) <small style="font-size:0.72rem;">تومان</small>
                                        </div>
                                    </div>

                                    <!-- پلن ۱ ساله -->
                                    <div class="plan-card @(SelectedPlanType == "Annual" ? "active" : "")" @onclick='() => SelectPlan("Annual")'>
                                        <div style="display:flex; justify-content:space-between; align-items:center;">
                                            <span class="plan-card-title">۱ ساله</span>
                                            @if (Pricing.DiscountPercent12Months > 0)
                                            {
                                                <span class="plan-tag tag-discount-12">@Pricing.DiscountPercent12Months٪ تخفیف</span>
                                            }
                                        </div>
                                        <div class="plan-card-sub">۱۲ ماه حداکثر صرفه‌جویی</div>
                                        <div class="plan-card-price">
                                            @LocalizedDate.FormatNumber(CalculatePlanCost("Annual"), UiLocale.Language) <small style="font-size:0.72rem;">تومان</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* کارت آنلاین محاسبه رقم تعرفه *@
                            <div class="plan-calc-box">
                                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:0.75rem;">
                                    <div>
                                        <div class="plan-calc-title">
                                            محاسبه هزینه پلن (@FormatPlanTitle(SelectedPlanType, GetDiscountForPlan(SelectedPlanType)))
                                        </div>
                                        <div class="plan-calc-desc">
                                            @if (SelectedPlanType == "Trial7Days")
                                            {
                                                <span>پلن آزمایشی رایگان برای ۱ هفته، بدون نیاز به پرداخت</span>
                                            }
                                            else
                                            {
                                                <span>تعرفه ماهانه پایه: @LocalizedDate.FormatNumber(Pricing.BaseBusinessPrice, UiLocale.Language) تومان</span>
                                                @if (ExtraBranches.Count > 0)
                                                {
                                                    <span> + @ExtraBranches.Count شعبه اضافه (هر شعبه ماهانه @LocalizedDate.FormatNumber(Pricing.ExtraBranchPrice, UiLocale.Language) تومان)</span>
                                                }
                                                @if (GetDiscountForPlan(SelectedPlanType) > 0)
                                                {
                                                    <span> • <b>@GetDiscountForPlan(SelectedPlanType)٪ تخفیف اعمال شد</b></span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div style="text-align:left;">
                                        <div class="plan-calc-total-label">مبلغ کل:</div>
                                        <div class="plan-calc-total-val">
                                            @(SelectedPlanType == "Trial7Days" ? "رایگان" : $"{LocalizedDate.FormatNumber(LiveTotalFee, UiLocale.Language)} تومان")
                                        </div>
                                    </div>
                                </div>
                                <div class="plan-calc-footer">
                                    تعداد کل شعب: <b>@(1 + ExtraBranches.Count) شعبه</b> • @(SelectedPlanType == "Trial7Days" ? "پلن تستی نیازی به پرداخت یا فیش ندارد و با تأیید مدیر فعال خواهد شد." : "پس از ثبت، به مرحله بارگذاری فیش واریزی منتقل خواهید شد.")
                                </div>
                            </div>
                        </div>

                        <div class="profile-card-actions" style="margin-top:1.25rem;">
                            <button type="submit" disabled="@IsSubmitting" class="primary-button action-primary">
                                @(IsSubmitting ? "در حال ثبت درخواست..." : (SelectedPlanType == "Trial7Days" ? "ثبت درخواست با پلن رایگان (بدون هزینه)" : "ثبت درخواست و انتقال به مرحله پرداخت"))
                            </button>
                            @if (IsEditingResubmit)
                            {
                                <button type="button" class="action-secondary" disabled="@IsSubmitting" @onclick="CancelResubmit">انصراف</button>
                            }
                        </div>
                    </EditForm>
                </article>
            }
        </section>
    </div>
</div>

