@code {
    private List<AppRelease> releases = [];
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? statusMessage;
    private string? errorMessage;

    private Guid? editingId;
    private string inputVersionName = string.Empty;
    private int inputVersionCode = 1;
    private string inputReleaseNotes = string.Empty;
    private bool inputIsForceUpdate = false;
    private bool inputIsActive = true;
    private string inputBazaarPkg = "com.leon.be_nobat";
    private string? inputExternalUrl;

    private string? selectedFileName;
    private long selectedFileSize;
    private byte[]? selectedFileBytes;

    private AppRelease? latestActive => releases.FirstOrDefault(r => r.IsActive);

    protected override async Task OnInitializedAsync()
    {
        await LoadReleases();
    }

    private async Task LoadReleases()
    {
        isLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            releases = await db.AppReleases.AsNoTracking()
                .OrderByDescending(r => r.VersionCode)
                .ToListAsync();

            if (!editingId.HasValue && releases.Count > 0)
            {
                inputVersionCode = releases.Max(r => r.VersionCode) + 1;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load releases");
            errorMessage = "خطا در دریافت لیست نسخه‌ها.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AppendNote(string note)
    {
        if (string.IsNullOrWhiteSpace(inputReleaseNotes))
        {
            inputReleaseNotes = note;
        }
        else
        {
            inputReleaseNotes = inputReleaseNotes.TrimEnd() + "\n" + note;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;
        if (file == null) return;

        // حداکثر ۱۰۰ مگابایت
        if (file.Size > 100 * 1024 * 1024)
        {
            errorMessage = "حجم فایل APK نمی‌تواند بیش از ۱۰۰ مگابایت باشد.";
            return;
        }

        try
        {
            selectedFileName = file.Name;
            selectedFileSize = file.Size;
            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            selectedFileBytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to read APK file");
            errorMessage = "خطا در خواندن فایل APK: " + ex.Message;
        }
    }

    private async Task HandleSaveRelease()
    {
        statusMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(inputVersionName))
        {
            errorMessage = "نام نسخه را وارد کنید.";
            return;
        }
        if (inputVersionCode <= 0)
        {
            errorMessage = "شماره نسخه باید عددی بزرگتر از صفر باشد.";
            return;
        }
        if (!editingId.HasValue && (selectedFileBytes == null || selectedFileBytes.Length == 0) && string.IsNullOrWhiteSpace(inputExternalUrl))
        {
            errorMessage = "لطفاً فایل نصبی APK را انتخاب کنید یا لینک مستقیم دانلود وارد نمایید.";
            return;
        }

        isSubmitting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (editingId.HasValue)
            {
                var rel = await db.AppReleases.FindAsync(editingId.Value);
                if (rel != null)
                {
                    rel.VersionName = inputVersionName.Trim();
                    rel.VersionCode = inputVersionCode;
                    rel.ReleaseNotes = inputReleaseNotes.Trim();
                    rel.IsForceUpdate = inputIsForceUpdate;
                    rel.IsActive = inputIsActive;
                    rel.BazaarPackageName = string.IsNullOrWhiteSpace(inputBazaarPkg) ? "com.leon.be_nobat" : inputBazaarPkg.Trim();
                    rel.ExternalDownloadUrl = string.IsNullOrWhiteSpace(inputExternalUrl) ? null : inputExternalUrl.Trim();

                    if (selectedFileBytes != null && selectedFileBytes.Length > 0)
                    {
                        rel.ApkData = selectedFileBytes;
                        rel.ApkFileSize = selectedFileBytes.LongLength;
                        rel.ApkFileName = selectedFileName ?? $"benobat-v{rel.VersionName}.apk";
                        rel.ApkContentType = "application/vnd.android.package-archive";
                    }

                    rel.UpdatedAt = DateTimeOffset.UtcNow;
                    await db.SaveChangesAsync();
                    statusMessage = "مشخصات نسخه با موفقیت ویرایش شد.";
                }
            }
            else
            {
                var rel = new AppRelease
                {
                    VersionName = inputVersionName.Trim(),
                    VersionCode = inputVersionCode,
                    ReleaseNotes = inputReleaseNotes.Trim(),
                    IsForceUpdate = inputIsForceUpdate,
                    IsActive = inputIsActive,
                    BazaarPackageName = string.IsNullOrWhiteSpace(inputBazaarPkg) ? "com.leon.be_nobat" : inputBazaarPkg.Trim(),
                    ExternalDownloadUrl = string.IsNullOrWhiteSpace(inputExternalUrl) ? null : inputExternalUrl.Trim(),
                    ApkData = selectedFileBytes,
                    ApkFileSize = selectedFileBytes?.LongLength,
                    ApkFileName = selectedFileName ?? $"benobat-v{inputVersionName.Trim()}.apk",
                    ApkContentType = "application/vnd.android.package-archive",
                    CreatedAt = DateTimeOffset.UtcNow,
                    UpdatedAt = DateTimeOffset.UtcNow
                };

                db.AppReleases.Add(rel);
                await db.SaveChangesAsync();
                statusMessage = "نسخه جدید با موفقیت ثبت و منتشر گردید.";
            }

            ResetForm();
            await LoadReleases();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save release");
            errorMessage = "خطا در ذخیره‌سازی نسخه: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void StartEdit(AppRelease item)
    {
        editingId = item.Id;
        inputVersionName = item.VersionName;
        inputVersionCode = item.VersionCode;
        inputReleaseNotes = item.ReleaseNotes;
        inputIsForceUpdate = item.IsForceUpdate;
        inputIsActive = item.IsActive;
        inputBazaarPkg = item.BazaarPackageName ?? "com.leon.be_nobat";
        inputExternalUrl = item.ExternalDownloadUrl;
        selectedFileName = item.ApkFileName;
        selectedFileSize = item.ApkFileSize ?? 0;
        selectedFileBytes = null;
    }

    private void ResetForm()
    {
        editingId = null;
        inputVersionName = string.Empty;
        inputReleaseNotes = string.Empty;
        inputIsForceUpdate = false;
        inputIsActive = true;
        inputBazaarPkg = "com.leon.be_nobat";
        inputExternalUrl = null;
        selectedFileName = null;
        selectedFileSize = 0;
        selectedFileBytes = null;
        if (releases.Count > 0)
        {
            inputVersionCode = releases.Max(r => r.VersionCode) + 1;
        }
    }

    private async Task ToggleActive(AppRelease item)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var rel = await db.AppReleases.FindAsync(item.Id);
            if (rel != null)
            {
                rel.IsActive = !rel.IsActive;
                rel.UpdatedAt = DateTimeOffset.UtcNow;
                await db.SaveChangesAsync();
                statusMessage = rel.IsActive ? $"نسخه v{rel.VersionName} فعال شد." : $"نسخه v{rel.VersionName} غیرفعال شد.";
                await LoadReleases();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle active status");
            errorMessage = "خطا در تغییر وضعیت نسخه.";
        }
    }

    private async Task DeleteRelease(Guid id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var rel = await db.AppReleases.FindAsync(id);
            if (rel != null)
            {
                db.AppReleases.Remove(rel);
                await db.SaveChangesAsync();
                statusMessage = "نسخه مورد نظر حذف شد.";
                if (editingId == id) ResetForm();
                await LoadReleases();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete release");
            errorMessage = "خطا در حذف نسخه: " + ex.Message;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F2} MB";
    }
}
