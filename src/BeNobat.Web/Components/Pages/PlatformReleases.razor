@page "/platform/releases"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILogger<PlatformReleases> Logger

<PageTitle>مدیریت و انتشار نسخه‌های اپلیکیشن | به‌نوبت</PageTitle>

<div class="releases-page">
    <div class="page-title">
        <div>
            <h1>مدیریت و انتشار نسخه‌های اپلیکیشن</h1>
            <p>بارگذاری فایل نصبی APK، تنظیم نسخه فعال، ثبت لیست تغییرات و مدیریت به‌روزرسانی اجباری</p>
        </div>
        @if (editingId.HasValue)
        {
            <button type="button" class="btn-cancel-edit" @onclick="ResetForm">
                <span>✕</span> انصراف از ویرایش
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>@statusMessage</span>
            <button type="button" class="alert-close" @onclick="() => statusMessage = null">×</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            <span>@errorMessage</span>
            <button type="button" class="alert-close" @onclick="() => errorMessage = null">×</button>
        </div>
    }

    <!-- کارت‌های خلاصه وضعیت -->
    <div class="stat-cards release-stats">
        <article class="stat-card">
            <i class="stat-icon purple">📦</i>
            <div>
                <small>نسخه فعال فعلی</small>
                <strong>@(latestActive != null ? $"v{latestActive.VersionName}" : "نامشخص")</strong>
            </div>
        </article>
        <article class="stat-card">
            <i class="stat-icon blue">🔢</i>
            <div>
                <small>شماره ساخت (Code)</small>
                <strong>@(latestActive != null ? latestActive.VersionCode.ToString() : "-")</strong>
            </div>
        </article>
        <article class="stat-card">
            <i class="stat-icon @(latestActive?.IsForceUpdate == true ? "orange" : "green")">
                @(latestActive?.IsForceUpdate == true ? "⚠️" : "✓")
            </i>
            <div>
                <small>نوع به‌روزرسانی</small>
                <strong class="@(latestActive?.IsForceUpdate == true ? "text-danger" : "text-success")">
                    @(latestActive?.IsForceUpdate == true ? "اجباری" : "اختیاری")
                </strong>
            </div>
        </article>
        <article class="stat-card">
            <i class="stat-icon green">💾</i>
            <div>
                <small>کل نسخه‌ها</small>
                <strong>@releases.Count نسخه</strong>
            </div>
        </article>
    </div>

    <!-- بدنه اصلی دو ستونه -->
    <div class="releases-grid">
        <!-- فرم بارگذاری و انتشار نسخه جدید -->
        <section class="release-card form-section @(editingId.HasValue ? "is-editing" : "")">
            <div class="card-header">
                <div class="header-title">
                    <span class="header-icon">@(editingId.HasValue ? "✏️" : "🚀")</span>
                    <h2>@(editingId.HasValue ? $"ویرایش نسخه v{inputVersionName}" : "ثبت و آپلود نسخه جدید APK")</h2>
                </div>
                <span class="badge-tag">Android APK</span>
            </div>

            <div class="card-body">
                <div class="form-row-2">
                    <div class="form-group">
                        <label class="field-label">
                            <span>نام نسخه (Version Name)</span>
                            <span class="req">*</span>
                        </label>
                        <div class="input-with-prefix">
                            <span class="input-prefix">v</span>
                            <input type="text" class="text-input" @bind="inputVersionName" placeholder="مثلاً 1.2.0" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="field-label">
                            <span>کد نسخه عددی (Version Code)</span>
                            <span class="req">*</span>
                        </label>
                        <input type="number" min="1" class="text-input" @bind="inputVersionCode" placeholder="مثلاً 3" />
                    </div>
                </div>

                <!-- ناحیه انتخاب فایل APK -->
                <div class="form-group">
                    <label class="field-label">
                        <span>فایل نصبی اپلیکیشن (.apk)</span>
                        @if (!editingId.HasValue) { <span class="req">*</span> }
                    </label>
                    <div class="apk-upload-box @(selectedFileSize > 0 ? "has-file" : "")">
                        <div class="upload-icon">📥</div>
                        <div class="upload-text">
                            @if (selectedFileSize > 0)
                            {
                                <div class="file-info-selected">
                                    <span class="file-name">@selectedFileName</span>
                                    <span class="file-size-badge">@FormatBytes(selectedFileSize)</span>
                                </div>
                                <small class="file-change-hint">برای تغییر فایل، کلیک کنید یا فایل دیگری انتخاب نمایید</small>
                            }
                            else if (editingId.HasValue && !string.IsNullOrEmpty(selectedFileName))
                            {
                                <div class="file-info-selected">
                                    <span class="file-name">فایل فعلی: @selectedFileName</span>
                                    @if (selectedFileSize > 0) { <span class="file-size-badge">@FormatBytes(selectedFileSize)</span> }
                                </div>
                                <small class="file-change-hint">برای جایگزینی APK قبلی، روی دکمه زیر کلیک کنید</small>
                            }
                            else
                            {
                                <strong>فایل APK را انتخاب کنید</strong>
                                <small>حداکثر ۱۰۰ مگابایت — فرمت .apk</small>
                            }
                        </div>
                        <InputFile OnChange="HandleFileSelected" accept=".apk" class="apk-file-input" />
                    </div>
                </div>

                <!-- توضیحات و لیست تغییرات -->
                <div class="form-group">
                    <div class="label-with-actions">
                        <label class="field-label">
                            <span>لیست تغییرات نسخه جدید (Release Notes)</span>
                        </label>
                        <div class="quick-notes-chips">
                            <button type="button" class="chip-btn" @onclick='() => AppendNote("• رفع ایرادات گزارش‌شده و بهبود عملکرد کلی")'>+ رفع باگ</button>
                            <button type="button" class="chip-btn" @onclick='() => AppendNote("• اضافه شدن قابلیت‌های جدید و بهینه‌سازی رابط کاربری")'>+ بهینه‌سازی</button>
                            <button type="button" class="chip-btn" @onclick='() => AppendNote("• ارتقای سرعت بارگذاری و پایداری ارتباط با سرور")'>+ افزایش سرعت</button>
                        </div>
                    </div>
                    <textarea class="text-input textarea-input" rows="4" @bind="inputReleaseNotes" placeholder="تغییرات این نسخه را بنویسید (در دیالوگ به‌روزرسانی درون برنامه به کاربر نمایش داده خواهد شد)..."></textarea>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="field-label">شناسه بسته در کافه‌بازار</label>
                        <input type="text" class="text-input ltr-input" @bind="inputBazaarPkg" placeholder="com.leon.be_nobat" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">لینک مستقیم خارجی (اختیاری)</label>
                        <input type="url" class="text-input ltr-input" @bind="inputExternalUrl" placeholder="https://dl.example.com/app.apk" />
                    </div>
                </div>

                <!-- تنظیمات به‌روزرسانی اجباری و وضعیت فعال -->
                <div class="options-container">
                    <label class="setting-check-card @(inputIsActive ? "is-active" : "")">
                        <input type="checkbox" @bind="inputIsActive" class="setting-checkbox" />
                        <div class="setting-info">
                            <strong class="setting-title">نسخه فعال سامانه</strong>
                            <p class="setting-desc">این نسخه به عنوان آخرین نگارش موجود به کلاینت‌ها و اپلیکیشن‌ها گزارش می‌شود.</p>
                        </div>
                    </label>

                    <label class="setting-check-card force-card @(inputIsForceUpdate ? "is-force" : "")">
                        <input type="checkbox" @bind="inputIsForceUpdate" class="setting-checkbox force-checkbox" />
                        <div class="setting-info">
                            <strong class="setting-title force-title">به‌روزرسانی اجباری (Force Update)</strong>
                            <p class="setting-desc">در صورت فعال بودن، کاربر بدون نصب این نسخه امکان استفاده از برنامه را نخواهد داشت (دیالوگ قابل بستن نیست).</p>
                        </div>
                    </label>
                </div>

                <!-- دکمه‌های عملیات -->
                <div class="form-actions">
                    <button type="button" class="btn-submit" disabled="@isSubmitting" @onclick="HandleSaveRelease">
                        @if (isSubmitting)
                        {
                            <span class="spinner"></span>
                            <span>در حال آپلود و ذخیره فایل APK...</span>
                        }
                        else
                        {
                            <span>@(editingId.HasValue ? "💾 ذخیره تغییرات نسخه" : "🚀 آپلود و انتشار نسخه")</span>
                        }
                    </button>
                    @if (editingId.HasValue)
                    {
                        <button type="button" class="btn-secondary" @onclick="ResetForm">انصراف</button>
                    }
                </div>
            </div>
        </section>

        <!-- لیست نسخه‌های منتشر شده -->
        <section class="release-card history-section">
            <div class="card-header">
                <div class="header-title">
                    <span class="header-icon">📋</span>
                    <h2>نسخه‌های ثبت‌شده در سامانه</h2>
                </div>
                <div class="header-actions">
                    <span class="badge-count">@releases.Count نسخه</span>
                    <button type="button" class="btn-refresh" title="تازه‌سازی" @onclick="LoadReleases">↻</button>
                </div>
            </div>

            <div class="card-body">
                @if (isLoading)
                {
                    <div class="empty-state">
                        <div class="spinner-large"></div>
                        <p>در حال بارگذاری لیست نسخه‌ها...</p>
                    </div>
                }
                else if (releases.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon">📦</span>
                        <h3>هنوز نسخه‌ای ثبت نشده است</h3>
                        <p>از فرم روبه‌رو برای آپلود و انتشار اولین نسخه اپلیکیشن استفاده کنید.</p>
                    </div>
                }
                else
                {
                    <div class="releases-list">
                        @foreach (var item in releases)
                        {
                            <article class="release-item @(item.IsActive ? "is-active" : "") @(item.IsForceUpdate ? "is-force" : "")" @key="item.Id">
                                <div class="item-top">
                                    <div class="item-version-info">
                                        <div class="version-name-group">
                                            <strong class="version-badge">@($"v{item.VersionName}")</strong>
                                            <span class="code-badge">کد ساخت: @item.VersionCode</span>
                                        </div>
                                        <div class="status-pills">
                                            @if (item.IsActive)
                                            {
                                                <span class="pill pill-success">● فعال</span>
                                            }
                                            else
                                            {
                                                <span class="pill pill-muted">غیرفعال</span>
                                            }

                                            @if (item.IsForceUpdate)
                                            {
                                                <span class="pill pill-danger">به‌روزرسانی اجباری</span>
                                            }
                                            else
                                            {
                                                <span class="pill pill-info">به‌روزرسانی اختیاری</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="item-actions">
                                        <button class="action-btn edit-btn" title="ویرایش" @onclick="() => StartEdit(item)">
                                            ✏️ ویرایش
                                        </button>
                                        <button class="action-btn toggle-btn" title="@(item.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")" @onclick="() => ToggleActive(item)">
                                            @(item.IsActive ? "غیرفعال" : "فعال‌سازی")
                                        </button>
                                        <button class="action-btn delete-btn" title="حذف نسخه" @onclick="() => DeleteRelease(item.Id)">
                                            🗑️
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.ReleaseNotes))
                                {
                                    <div class="item-notes">
                                        <small class="notes-title">تغییرات نسخه:</small>
                                        <p>@item.ReleaseNotes</p>
                                    </div>
                                }

                                <div class="item-footer">
                                    <div class="download-info">
                                        @if (item.ApkFileSize.HasValue && item.ApkFileSize > 0)
                                        {
                                            <a href="/api/v1/app/releases/@item.Id/download" target="_blank" class="download-btn">
                                                <span>📥 دانلود مستقیم APK</span>
                                                <span class="download-size">(@FormatBytes(item.ApkFileSize.Value))</span>
                                            </a>
                                        }
                                        else if (!string.IsNullOrEmpty(item.ExternalDownloadUrl))
                                        {
                                            <a href="@item.ExternalDownloadUrl" target="_blank" class="download-btn external">
                                                <span>🔗 لینک خارجی دانلود</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="no-file-label">⚠️ بدون فایل نصبی</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.BazaarPackageName))
                                        {
                                            <span class="bazaar-tag" title="شناسه بسته کافه‌بازار">🛍️ @item.BazaarPackageName</span>
                                        }
                                    </div>

                                    <div class="date-info">
                                        <span>ثبت: @item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<style>
.releases-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.5rem 0 3rem;
}

.page-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    gap: 1rem;
}

.page-title h1 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    color: var(--on-surface, #17211F);
}

.page-title p {
    font-size: 0.95rem;
    color: var(--on-surface-variant, #596562);
    margin: 0;
}

.btn-cancel-edit {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #f8fafc;
    border: 1.5px solid var(--outline, #B9C7C3);
    color: var(--on-surface, #17211F);
    border-radius: 10px;
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-cancel-edit:hover {
    background: #edf2f7;
    border-color: #cbd5e0;
}

/* Alerts */
.alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
}

.alert-success {
    background: #e6f6ee;
    color: #1e7046;
    border: 1px solid #b7e4cb;
}

.alert-danger {
    background: #fdf2f2;
    color: #c53030;
    border: 1px solid #fed7d7;
}

.alert-close {
    margin-right: auto;
    background: transparent;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: inherit;
    line-height: 1;
}

/* Stat Cards */
.release-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

@@media (max-width: 900px) {
    .release-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 500px) {
    .release-stats {
        grid-template-columns: 1fr;
    }
}

.stat-card {
    background: var(--surface, #ffffff);
    border: 1px solid var(--outline-soft, #E1EAE8);
    border-radius: 14px;
    padding: 1.1rem 1.3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 3px 12px rgba(14, 59, 52, 0.04);
}

.stat-icon {
    font-style: normal;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.stat-icon.purple { background: #f0f7f6; color: var(--primary, #146B5D); }
.stat-icon.blue { background: #eaf3fa; color: #2b6cb0; }
.stat-icon.green { background: #eaf7f0; color: #2f855a; }
.stat-icon.orange { background: #fef5ea; color: #c05621; }

.stat-card div {
    display: flex;
    flex-direction: column;
}

.stat-card small {
    font-size: 0.82rem;
    color: var(--on-surface-variant, #718096);
    margin-bottom: 0.2rem;
}

.stat-card strong {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--on-surface, #17211F);
}

.text-danger { color: #c53030 !important; }
.text-success { color: #2f855a !important; }

/* Grid layout */
.releases-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.75rem;
    align-items: start;
}

@@media (max-width: 1024px) {
    .releases-grid {
        grid-template-columns: 1fr;
    }
}

/* Card */
.release-card {
    background: var(--surface, #ffffff);
    border: 1px solid var(--outline-soft, #E1EAE8);
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    overflow: hidden;
}

.release-card.is-editing {
    border-color: var(--primary, #146B5D);
    box-shadow: 0 0 0 3px rgba(20, 107, 93, 0.15);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--outline-soft, #E1EAE8);
    background: var(--surface, #ffffff);
}

.header-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.header-icon {
    font-size: 1.3rem;
}

.card-header h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--on-surface, #17211F);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.badge-tag {
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(20, 107, 93, 0.08);
    color: var(--primary, #146B5D);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
}

.badge-count {
    font-size: 0.8rem;
    font-weight: 600;
    background: #edf2f7;
    color: #4a5568;
    padding: 0.25rem 0.65rem;
    border-radius: 20px;
}

.btn-refresh {
    background: transparent;
    border: 1px solid var(--outline, #B9C7C3);
    border-radius: 8px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--on-surface-variant, #596562);
    transition: all 0.2s;
}

.btn-refresh:hover {
    background: #edf2f7;
    color: var(--primary, #146B5D);
}

.card-body {
    padding: 1.5rem;
}

/* Forms */
.form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
}

@@media (max-width: 550px) {
    .form-row-2 {
        grid-template-columns: 1fr;
    }
}

.form-group {
    margin-bottom: 1.25rem;
}

.field-label {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--on-surface, #17211F);
    margin-bottom: 0.45rem;
}

.req {
    color: #e53e3e;
    font-weight: 700;
}

.text-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    border: 1.5px solid var(--outline, #B9C7C3);
    background: var(--surface, #ffffff);
    color: var(--on-surface, #17211F);
    font-family: inherit;
    font-size: 0.92rem;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.text-input:focus {
    outline: none;
    border-color: var(--primary, #146B5D);
    box-shadow: 0 0 0 3px rgba(20, 107, 93, 0.15);
}

.input-with-prefix {
    position: relative;
    display: flex;
    align-items: center;
}

.input-prefix {
    position: absolute;
    right: 12px;
    color: var(--on-surface-variant, #718096);
    font-weight: 700;
    font-size: 0.95rem;
    pointer-events: none;
}

.input-with-prefix .text-input {
    padding-right: 28px;
}

.ltr-input {
    direction: ltr;
    text-align: left;
}

.textarea-input {
    resize: vertical;
    min-height: 100px;
    line-height: 1.6;
}

.label-with-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
}

.quick-notes-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
}

.chip-btn {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
