        public string Address { get; set; } = "";
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public int OpenHour { get; set; } = 8;
        public int CloseHour { get; set; } = 20;
        public List<WeeklyTimeRange> WeeklyHours { get; set; } = WeeklySchedule.Default();
        public string TimeZoneId { get; set; } = "Asia/Tehran";
        public int? DepositPercentage { get; set; }
        public string? DepositCardNumber { get; set; }
        public string? DepositIban { get; set; }
        public string? DepositAccountHolder { get; set; }
    }

    private sealed class ResourceInput
    {
        public string Name { get; set; } = "";
        public string Kind { get; set; } = "staff";
        public Guid? UserId { get; set; }
    }

    private sealed class MemberInput
    {
        public string Email { get; set; } = "";
        public Guid? UserId { get; set; }
        public string Role { get; set; } = AppRoles.Staff;
    }
