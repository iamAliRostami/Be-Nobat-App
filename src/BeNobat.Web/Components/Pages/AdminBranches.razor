@page "/admin/branches"
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject UserManager<AppUser> UserManager
@inject AdminAccessScope Access
@inject NavigationManager Navigation

<PageTitle>شعب و منابع | به‌نوبت</PageTitle>
<div class="page-title">
    <div><h1>شعب و منابع</h1><p>نشانی، ساعات کاری، اعضا و منابع قابل رزرو هر شعبه را مدیریت کنید.</p></div>
    <button type="button" class="action-primary" @onclick="NewBranch">+ افزودن شعبه</button>
</div>

@if (Message is not null) { <div class="success-notice">@Message</div> }
@if (Error is not null && !ShowBranchForm && ResourceBranch is null && MemberBranch is null) { <div class="auth-error" role="alert">@Error</div> }

<article class="admin-panel">
    <div class="toolbar">
        <input aria-label="جست‌وجوی شعب" placeholder="جست‌وجوی شعبه، کسب‌وکار، نشانی یا منبع..." @bind="Query" @bind:event="oninput" />
        <select aria-label="وضعیت شعب" @bind="StatusFilter"><option value="all">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
        <span>@Filtered.Count() شعبه</span>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ClearFilters">پاک کردن فیلترها</button> }
    </div>
    @if (HasEntityFilter) { <p class="filter-summary">شعب مرتبط با مورد انتخاب‌شده</p> }
    @if (!Filtered.Any()) { <p class="empty-state">شعبه‌ای با این فیلترها پیدا نشد.</p> }
    <div class="management-grid">
        @foreach (var branch in Filtered)
        {
            <article class="management-card">
                <div class="panel-head">
                    <div><h2 data-i18n-skip>@branch.Name</h2><p><a class="entity-link" href="@BusinessUrl(branch.BusinessId)" data-i18n-skip>@branch.Business.Name</a> · <span data-i18n-skip>@branch.Address</span></p></div>
                    <em class="status @(branch.DeletedAt is null ? "confirmed" : "cancelled")">@(branch.DeletedAt is null ? "فعال" : "غیرفعال")</em>
                </div>
                <dl>
                    <div><dt>ساعت کاری</dt><dd>@($"{branch.OpenHour}:00 تا {branch.CloseHour}:00")</dd></div>
                    <div><dt>منطقه زمانی</dt><dd>@branch.TimeZoneId</dd></div>
                    <div><dt>منابع</dt><dd>@branch.Resources.Count مورد</dd></div>
                    <div><dt>اعضا</dt><dd>@branch.Memberships.Count نفر</dd></div>
                </dl>
                <div class="card-actions">
                    <button type="button" class="action-secondary" @onclick="() => EditBranch(branch)">ویرایش</button>
                    <button type="button" class="action-primary" @onclick="() => AddResource(branch)">+ منبع</button>
                    <button type="button" class="action-info" @onclick="() => OpenMembers(branch)">اعضا</button>
                    <button type="button" class="@(branch.DeletedAt is null ? "action-danger" : "action-success")" @onclick="() => ToggleBranch(branch)">@(branch.DeletedAt is null ? "غیرفعال" : "فعال")</button>
                </div>
                @if (branch.Resources.Count > 0)
                {
                    <div class="resource-chips">
                        @foreach (var resource in branch.Resources)
                        {
                            <span><a class="entity-link" href="@ResourceUrl(resource)" data-i18n-skip>@resource.Name</a> <small>@KindLabel(resource.Kind)</small><button type="button" class="action-icon action-remove-plain" title="حذف منبع" aria-label="@($"حذف منبع {resource.Name}")" @onclick="() => DeleteResource(resource)">×</button></span>
                        }
                    </div>
                }
            </article>
        }
    </div>
</article>

@if (ShowBranchForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="BranchForm" FormName="admin-branch" OnValidSubmit="SaveBranch" class="form-modal" @onclick:stopPropagation>
            <DataAnnotationsValidator />
            <div><h2>@(EditingBranchId is null ? "شعبه جدید" : "ویرایش شعبه")</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <label>کسب‌وکار<select disabled="@(EditingBranchId is not null)" @bind="BranchForm.BusinessId">@foreach (var b in Businesses) { <option value="@b.Id" data-i18n-skip>@b.Name</option> }</select></label>
            <label>نام شعبه<input required @bind="BranchForm.Name" /></label>
            <label>نشانی<input @bind="BranchForm.Address" /></label>
            <label>منطقه زمانی<select @bind="BranchForm.TimeZoneId">@foreach (var zone in TimeZones) { <option value="@zone.Id">@zone.Label</option> }</select></label>
            <div class="form-columns">
                <label>شروع کار<input type="number" min="0" max="23" @bind="BranchForm.OpenHour" /></label>
                <label>پایان کار<input type="number" min="1" max="24" @bind="BranchForm.CloseHour" /></label>
            </div>
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره</button>
        </EditForm>
    </div>
}

@* [fix] فرم منبع فقط یک فیلد متنی «نام منبع» داشت؛ برای منبع از نوع «عضو تیم»
   هیچ راهی برای انتخاب یک عضو واقعی از لیست وجود نداشت. حالا وقتی نوع روی
   «عضو تیم» باشد، لیست کشویی اعضای تیم نمایش داده می‌شود و منبع به حساب
   کاربری همان عضو وصل می‌شود. *@
@if (ResourceBranch is not null)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="ResourceForm" FormName="admin-resource" OnValidSubmit="SaveResource" class="form-modal" @onclick:stopPropagation>
            <div><h2>منبع جدید برای @ResourceBranch.Name</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <label>نوع
                <select @bind="ResourceForm.Kind" @bind:after="KindChanged">
                    <option value="staff">عضو تیم</option>
                    <option value="room">اتاق</option>
                    <option value="equipment">تجهیزات</option>
                </select>
            </label>
            @if (ResourceForm.Kind == "staff")
            {
                <label>عضو تیم
                    <input class="select-search" placeholder="جست‌وجوی نام، ایمیل یا موبایل..." @bind="TeamMemberQuery" @bind:event="oninput" />
                    <select @bind="ResourceForm.UserId" @bind:after="TeamMemberChanged">
                        <option value="">— انتخاب از لیست اعضای تیم —</option>
                        @foreach (var member in ResourceTeamMembers)
                        {
                            <option value="@member.Id">@MemberLabel(member)</option>
                        }
                    </select>
                </label>
                @if (TeamMembers.Count == 0)
                {
                    <small>هنوز عضو تیمی ثبت نشده است؛ ابتدا از بخش «اعضای تیم» یک عضو اضافه کنید.</small>
                }
            }
            <label>نام نمایشی منبع<input required @bind="ResourceForm.Name" /></label>
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره</button>
        </EditForm>
    </div>
}

@* [feature] «عضویت در کسب‌وکار» اصلاً رابط کاربری نداشت؛ جدول BranchMemberships
   ساخته می‌شد ولی هیچ صفحه‌ای رکوردی در آن ثبت نمی‌کرد. *@
@if (MemberBranch is not null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="form-modal membership-modal" @onclick:stopPropagation>
            <div><h2>اعضای @MemberBranch.Name</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>

            @if (Memberships.Count == 0)
            {
                <p class="empty-state">هنوز عضوی به این شعبه اضافه نشده است.</p>
            }
            else
            {
                <div class="people-list membership-list">
                    @foreach (var membership in Memberships)
                    {
                        <article>
                            <span class="customer-avatar purple" data-i18n-skip>@UserAvatar.Initials(membership.User.DisplayName)</span>
                            <div><b data-i18n-skip>@(string.IsNullOrWhiteSpace(membership.User.DisplayName) ? membership.User.Email : membership.User.DisplayName)</b><small><span data-i18n-skip>@membership.User.Email</span> · @(string.IsNullOrWhiteSpace(membership.User.PhoneNumber) ? "بدون شماره تماس" : membership.User.PhoneNumber)</small></div>
                            <em>@RoleLabel(membership.Role)</em>
                            <div class="inline-actions"><button type="button" class="action-danger" @onclick="() => RemoveMember(membership)">حذف</button></div>
                        </article>
                    }
                </div>
            }

            <EditForm Model="MemberForm" FormName="branch-member" OnValidSubmit="AddMember" class="member-form">
                <label>کاربر
                    <input class="select-search" placeholder="جست‌وجوی نام، ایمیل یا موبایل..." @bind="MemberQuery" @bind:event="oninput" />
                    <select @bind="MemberForm.UserId">
                        <option value="">— انتخاب کاربر —</option>
                        @foreach (var candidate in FilteredMemberCandidates)
                        {
                            <option value="@candidate.Id">@MemberLabel(candidate)</option>
                        }
                    </select>
                </label>
                <label>یا ایمیل حساب موجود<input type="email" autocomplete="off" placeholder="name@example.com" @bind="MemberForm.Email" /></label>
                <label>نقش در شعبه
                    <select @bind="MemberForm.Role">
                        <option value="@AppRoles.Staff">پرسنل</option>
                        <option value="@AppRoles.Manager">مدیر</option>
                        <option value="@AppRoles.Owner">مالک</option>
                    </select>
                </label>
                @if (Error is not null) { <div class="auth-error">@Error</div> }
                <button class="primary-button">افزودن عضو</button>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? FilterQuery { get; set; }
    [SupplyParameterFromQuery(Name = "businessId")] public Guid? FilterBusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "branchId")] public Guid? FilterBranchId { get; set; }
    [SupplyParameterFromQuery(Name = "resourceId")] public Guid? FilterResourceId { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? FilterStatus { get; set; }

    private List<Business> Businesses = [];
    private List<Branch> Branches = [];
    private List<AppUser> TeamMembers = [];
    private List<BranchMembership> Memberships = [];

    private string Query = "";
    private string StatusFilter = "all";
    private bool IsPlatformAdmin;
    private string MemberQuery = "";
    private string TeamMemberQuery = "";
    private bool ShowBranchForm;
    private Guid? EditingBranchId;
    private BranchInput BranchForm = new();
    private Branch? ResourceBranch;
    private ResourceInput ResourceForm = new();
    private Branch? MemberBranch;
    private MemberInput MemberForm = new();
    private string? Error;
    private string? Message;

    private static readonly (string Id, string Label)[] TimeZones =
    [
        ("Asia/Tehran", "تهران (UTC+03:30)"),
        ("Asia/Dubai", "دبی (UTC+04:00)"),
        ("Asia/Baghdad", "بغداد (UTC+03:00)"),
        ("Europe/Istanbul", "استانبول (UTC+03:00)"),
        ("Europe/London", "لندن"),
        ("UTC", "UTC"),
    ];

    private static readonly string[] TeamRoles = [AppRoles.Owner, AppRoles.Manager, AppRoles.Staff];

    private bool HasEntityFilter => FilterBusinessId is not null || FilterBranchId is not null || FilterResourceId is not null;
    private bool HasFilters => HasEntityFilter || Query.Length > 0 || StatusFilter != "all";
    private IEnumerable<Branch> Filtered => Branches
        .Where(x => FilterBusinessId is null || x.BusinessId == FilterBusinessId)
        .Where(x => FilterBranchId is null || x.Id == FilterBranchId)
        .Where(x => FilterResourceId is null || x.Resources.Any(r => r.Id == FilterResourceId))
        .Where(x => StatusFilter == "all" || (x.DeletedAt is null) == (StatusFilter == "active"))
        .Where(x => $"{x.Name} {x.Address} {x.Business.Name} {string.Join(' ', x.Resources.Select(r => r.Name))}".Contains(Query, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<AppUser> MemberCandidates =>
        TeamMembers.Where(u => Memberships.All(m => m.UserId != u.Id));

    private IEnumerable<AppUser> FilteredMemberCandidates => MemberCandidates.Where(u => MatchesUser(u, MemberQuery));
    private IEnumerable<AppUser> FilteredTeamMembers => TeamMembers.Where(u => MatchesUser(u, TeamMemberQuery));
    private IEnumerable<AppUser> ResourceTeamMembers => FilteredTeamMembers.Where(u =>
        ResourceBranch is not null && ResourceBranch.Memberships.Any(m => m.UserId == u.Id));

    private static bool MatchesUser(AppUser user, string query) =>
        $"{user.DisplayName} {user.Email} {user.PhoneNumber}".Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        IsPlatformAdmin = await Access.IsPlatformAdminAsync();
        Businesses = await Access.ManagedBusinessesAsync();
        await LoadTeamMembers();
        await Load();
    }

    protected override void OnParametersSet()
    {
        Query = FilterQuery?.Trim() ?? "";
        StatusFilter = FilterStatus is "active" or "disabled" ? FilterStatus : "all";
    }
    private void ClearFilters()
    {
        Query = "";
        StatusFilter = "all";
        FilterBusinessId = FilterBranchId = FilterResourceId = null;
        Navigation.NavigateTo("/admin/branches");
    }
    private string BusinessUrl(Guid businessId) => $"{(IsPlatformAdmin ? "/platform" : "/businesses")}?businessId={businessId}";
    private static string ResourceUrl(Resource resource) => resource.Kind == "staff"
        ? $"/admin/team?resourceId={resource.Id}"
        : $"/admin/branches?branchId={resource.BranchId}&resourceId={resource.Id}";

    private async Task LoadTeamMembers()
    {
        // A customer's existing account can join a team without creating a duplicate
        // identity. Account lockout prevents offering disabled accounts as providers.
        var query = UserManager.Users.AsNoTracking()
            .Where(u => !u.LockoutEnabled || u.LockoutEnd == null || u.LockoutEnd <= DateTimeOffset.UtcNow);
        if (!await Access.IsPlatformAdminAsync())
        {
            var branches = await Access.ManagedBranchesAsync();
            var appointments = await Access.AppointmentsAsync();
            query = query.Where(u => Db.BranchMemberships.Any(m => m.UserId == u.Id && branches.Any(b => b.Id == m.BranchId)) ||
                appointments.Any(a => a.CustomerId == u.Id));
        }
        TeamMembers = await query.OrderBy(u => u.DisplayName).ToListAsync();
    }

    private async Task Load()
    {
        Businesses = await Access.ManagedBusinessesAsync();
        var query = await Access.ManagedBranchesAsync(includeArchived: true);
        Branches = await query.IgnoreQueryFilters().AsNoTracking()
            .Include(x => x.Business)
            .Include(x => x.Resources.Where(r => r.DeletedAt == null))
            .Include(x => x.Memberships.Where(m => m.DeletedAt == null))
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private void NewBranch()
    {
        EditingBranchId = null;
        BranchForm = new BranchInput { BusinessId = Businesses.FirstOrDefault(b => b.Id == FilterBusinessId)?.Id ?? Businesses.FirstOrDefault()?.Id ?? Guid.Empty };
        Error = Message = null;
        ShowBranchForm = true;
    }

    private void EditBranch(Branch branch)
    {
        EditingBranchId = branch.Id;
        BranchForm = new BranchInput
        {
            BusinessId = branch.BusinessId,
            Name = branch.Name,
            Address = branch.Address,
            OpenHour = branch.OpenHour,
            CloseHour = branch.CloseHour,
            TimeZoneId = branch.TimeZoneId,
        };
        Error = Message = null;
        ShowBranchForm = true;
    }

    private async Task SaveBranch()
    {
        if (BranchForm.BusinessId == Guid.Empty || string.IsNullOrWhiteSpace(BranchForm.Name) || BranchForm.CloseHour <= BranchForm.OpenHour)
        {
            Error = "نام، کسب‌وکار و ساعت کاری معتبر الزامی است.";
            return;
        }

        if (!(await Access.ManagedBusinessesAsync()).Any(x => x.Id == BranchForm.BusinessId)) { Error = "به این کسب‌وکار دسترسی ندارید."; return; }
        if (EditingBranchId is Guid editId && !await Access.CanManageBranchAsync(editId)) { Error = "اجازه‌ی ویرایش این شعبه را ندارید."; return; }
        if (EditingBranchId is null && !await Access.IsBusinessOwnerAsync(BranchForm.BusinessId))
        {
            Error = "افزودن شعبه‌ی جدید فقط برای مالک کسب‌وکار یا مدیر سامانه مجاز است.";
            return;
        }
        if (BranchForm.OpenHour < 0 || BranchForm.CloseHour > 24) { Error = "ساعت کاری باید بین ۰ تا ۲۴ باشد."; return; }

        if (BranchForm.Name.Trim().Length > 200 || BranchForm.Address.Trim().Length > 1000 ||
            !TimeZones.Any(z => z.Id == BranchForm.TimeZoneId)) { Error = "نام، نشانی یا منطقه زمانی معتبر نیست."; return; }
        var branch = EditingBranchId is null
            ? new Branch { Name = BranchForm.Name }
            : await Db.Branches.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.Id == EditingBranchId);
        if (branch is null) { Error = "شعبه پیدا نشد."; return; }
        if (EditingBranchId is not null)
        {
            await Db.Entry(branch).ReloadAsync();
            if (branch.BusinessId != BranchForm.BusinessId) { Error = "کسب‌وکار شعبه را نمی‌توان تغییر داد."; return; }
        }
        branch.TimeZoneId = BranchForm.TimeZoneId;

        branch.BusinessId = BranchForm.BusinessId;
        branch.Name = BranchForm.Name.Trim();
        branch.Address = BranchForm.Address.Trim();
        branch.OpenHour = BranchForm.OpenHour;
        branch.CloseHour = BranchForm.CloseHour;
        branch.UpdatedAt = DateTimeOffset.UtcNow;

        if (EditingBranchId is null)
        {
            Db.Branches.Add(branch);
            // سازنده‌ی شعبه (اگر مدیر سامانه نیست) باید خودش به آن دسترسی داشته باشد.
            if (!await Access.IsPlatformAdminAsync())
            {
                var me = await Access.UserIdAsync();
                Db.BranchMemberships.Add(new BranchMembership { Branch = branch, UserId = me, Role = AppRoles.Owner });
            }
        }
        await Db.SaveChangesAsync();
        Close();
        await Load();
    }

    private async Task ToggleBranch(Branch branch)
    {
        if (!await Access.CanManageBranchAsync(branch.Id)) { Error = "اجازه‌ی این کار را ندارید."; return; }
        var item = await Db.Branches.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.Id == branch.Id);
        if (item is null) return;
        await Db.Entry(item).ReloadAsync();
        var deactivate = branch.DeletedAt is null;
        if (deactivate && item.DeletedAt is null && await Db.Appointments.AnyAsync(a => a.BranchId == branch.Id &&
                (a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed) && a.EndsAt >= DateTimeOffset.UtcNow))
        {
            Message = null; Error = "این شعبه نوبت فعال پیش‌رو دارد؛ ابتدا نوبت‌ها را لغو یا تکمیل کنید.";
            return;
        }
        item.UpdatedAt = DateTimeOffset.UtcNow;
        item.DeletedAt = deactivate ? item.DeletedAt ?? DateTimeOffset.UtcNow : null;
        await Db.SaveChangesAsync();
        await Load();
    }

    private void AddResource(Branch branch)
    {
        ResourceBranch = branch;
        ResourceForm = new ResourceInput();
        TeamMemberQuery = "";
        Error = Message = null;
    }

    private void KindChanged()
    {
        if (ResourceForm.Kind != "staff")
        {
            ResourceForm.UserId = null;
        }
    }

    private void TeamMemberChanged()
    {
        var member = TeamMembers.FirstOrDefault(x => x.Id == ResourceForm.UserId);
        if (member is not null)
        {
            // نام منبع به‌طور پیش‌فرض همان نام عضو است، ولی قابل ویرایش می‌ماند.
            ResourceForm.Name = string.IsNullOrWhiteSpace(member.DisplayName) ? member.Email ?? "" : member.DisplayName;
        }
    }

    private async Task SaveResource()
    {
        var branch = ResourceBranch;
        if (branch is null) return;
        if (!await Access.CanManageBranchAsync(branch.Id)) { Error = "اجازه‌ی مدیریت منابع این شعبه را ندارید."; return; }

        if (!await Db.Branches.AnyAsync(b => b.Id == branch.Id) || ResourceForm.Kind is not ("staff" or "room" or "equipment") || ResourceForm.Name.Trim().Length > 200)
        {
            Error = "شعبه، نوع یا نام منبع معتبر نیست."; return;
        }
        if (ResourceForm.Kind != "staff") ResourceForm.UserId = null;
        if (ResourceForm.Kind == "staff" && ResourceForm.UserId is null)
        {
            Error = "برای منبع از نوع «عضو تیم» باید یک عضو را از لیست انتخاب کنید.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ResourceForm.Name))
        {
            Error = "نام منبع الزامی است.";
            return;
        }

        if (ResourceForm.UserId is Guid userId &&
            await Db.Resources.AnyAsync(x => x.BranchId == branch.Id && x.UserId == userId))
        {
            Error = "این عضو از قبل به‌عنوان منبع این شعبه ثبت شده است.";
            return;
        }

        if (ResourceForm.UserId is Guid memberId &&
            !await Db.BranchMemberships.AnyAsync(x => x.BranchId == branch.Id && x.UserId == memberId &&
                (!x.User.LockoutEnabled || x.User.LockoutEnd == null || x.User.LockoutEnd <= DateTimeOffset.UtcNow)))
        {
            Error = "کارمند باید ابتدا عضو همین شعبه باشد.";
            return;
        }

        Db.Resources.Add(new Resource
        {
            BranchId = branch.Id,
            Name = ResourceForm.Name.Trim(),
            Kind = ResourceForm.Kind,
            UserId = ResourceForm.UserId,
        });

        await Db.SaveChangesAsync();
        Close();
        await Load();
    }

    private async Task DeleteResource(Resource resource)
    {
        var item = await Db.Resources.FirstOrDefaultAsync(r => r.Id == resource.Id);
        if (item is null) return;
        await Db.Entry(item).ReloadAsync();
        if (!await Access.CanManageBranchAsync(item.BranchId)) { Error = "اجازه‌ی حذف این منبع را ندارید."; return; }
        if (await Db.Appointments.AnyAsync(a => a.ResourceId == item.Id &&
                (a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed) && a.EndsAt >= DateTimeOffset.UtcNow))
        {
            Error = "این منبع نوبت فعال پیش‌رو دارد؛ ابتدا نوبت‌هایش را لغو یا تکمیل کنید.";
            return;
        }
        Error = null;

        item.DeletedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        await Load();
    }

    private async Task OpenMembers(Branch branch)
    {
        MemberBranch = branch;
        MemberForm = new MemberInput();
        MemberQuery = "";
        Error = Message = null;
        await LoadMemberships();
    }

    private async Task LoadMemberships()
    {
        var branch = MemberBranch;
        if (branch is null) return;

        if (!await Access.CanManageBranchAsync(branch.Id)) { Memberships = []; Error = "به اعضای این شعبه دسترسی ندارید."; return; }
        Memberships = await Db.BranchMemberships.AsNoTracking()
            .Include(x => x.User)
            .Where(x => x.BranchId == branch.Id)
            .OrderBy(x => x.User.DisplayName)
            .ToListAsync();
    }

    private async Task AddMember()
    {
        var branch = MemberBranch;
        if (branch is null) return;

        // An exact email allows joining an existing account without exposing the
        // global user directory to a business manager.
        var user = MemberForm.UserId is Guid selectedUserId
            ? await UserManager.FindByIdAsync(selectedUserId.ToString())
            : string.IsNullOrWhiteSpace(MemberForm.Email) ? null : await UserManager.FindByEmailAsync(MemberForm.Email.Trim());
        if (user is not null) await Db.Entry(user).ReloadAsync();
        var userId = user?.Id ?? Guid.Empty;
        if (user is null || (user.LockoutEnabled && user.LockoutEnd > DateTimeOffset.UtcNow)) { Error = "کاربر فعال پیدا نشد."; return; }
        if (await Db.BranchMemberships.AnyAsync(x => x.BranchId == branch.Id && x.UserId == userId))
        {
            Error = "این کاربر از قبل عضو این شعبه است.";
            return;
        }
        if (!await Access.CanAssignRoleAsync(MemberForm.Role, branch.Id))
        {
            Error = MemberForm.Role == AppRoles.Owner ? "نقش «مالک» را فقط مالک کسب‌وکار یا مدیر سامانه می‌تواند بدهد." : "اجازه‌ی واگذاری این نقش را ندارید.";
            return;
        }

        await using var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
        var archived = await Db.BranchMemberships.IgnoreQueryFilters().FirstOrDefaultAsync(m => m.BranchId == branch.Id && m.UserId == userId);
        if (archived is null) Db.BranchMemberships.Add(new BranchMembership { BranchId = branch.Id, UserId = userId, Role = MemberForm.Role });
        else { await Db.Entry(archived).ReloadAsync(); archived.DeletedAt = null; archived.Role = MemberForm.Role; archived.UpdatedAt = DateTimeOffset.UtcNow; }

        await Db.SaveChangesAsync();
        await TeamRoleSync.SyncAsync(UserManager, Db, user);
        await transaction.CommitAsync();
        Error = null;
        Message = "عضو جدید به شعبه اضافه شد.";
        MemberForm = new MemberInput();
        await LoadTeamMembers();
        await LoadMemberships();
        await Load();
    }

    private async Task RemoveMember(BranchMembership membership)
    {
        await using var transaction = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
        var current = await Db.BranchMemberships.FirstOrDefaultAsync(m => m.Id == membership.Id);
        if (current is null) return;
        await Db.Entry(current).ReloadAsync();
        membership = current;
        if (!await Access.CanManageBranchAsync(membership.BranchId) ||
            (membership.Role == AppRoles.Owner && !await Access.CanAssignRoleAsync(AppRoles.Owner, membership.BranchId)))
        {
            Error = "اجازه‌ی حذف این عضو را ندارید.";
            return;
        }
        if (membership.Role == AppRoles.Owner &&
            !await Db.BranchMemberships.AnyAsync(m => m.BranchId == membership.BranchId && m.Role == AppRoles.Owner && m.Id != membership.Id))
        {
            Error = "آخرین مالک شعبه را نمی‌توان حذف کرد.";
            return;
        }
        var resources = await Db.Resources.Where(r => r.BranchId == membership.BranchId && r.UserId == membership.UserId).ToListAsync();
        if (await Db.Appointments.AnyAsync(a => a.ResourceId != null && resources.Select(r => r.Id).Contains(a.ResourceId.Value) &&
            (a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed) && a.EndsAt >= DateTimeOffset.UtcNow))
        { Error = "این عضو نوبت فعال پیش‌رو دارد؛ ابتدا نوبت‌ها را لغو یا تکمیل کنید."; return; }
        foreach (var resource in resources) { resource.DeletedAt = DateTimeOffset.UtcNow; resource.UpdatedAt = DateTimeOffset.UtcNow; }
        membership.DeletedAt = DateTimeOffset.UtcNow;
        membership.UpdatedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        var removedUser = await UserManager.FindByIdAsync(membership.UserId.ToString());
        if (removedUser is not null) await TeamRoleSync.SyncAsync(UserManager, Db, removedUser);
        await transaction.CommitAsync();
        Error = null;
        await LoadMemberships();
        await Load();
    }

    private void Close()
    {
        ShowBranchForm = false;
        ResourceBranch = null;
        MemberBranch = null;
        Error = null;
    }

    private static string MemberLabel(AppUser user) =>
        string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? "کاربر" : $"{user.DisplayName} ({user.Email})";

    private static string KindLabel(string kind) => kind switch
    {
        "staff" => "عضو تیم",
        "room" => "اتاق",
        "equipment" => "تجهیزات",
        _ => kind,
    };

    private static string RoleLabel(string role) => role switch
    {
        AppRoles.Owner => "مالک",
        AppRoles.Manager => "مدیر",
        AppRoles.Staff => "پرسنل",
        _ => role,
    };

