@page "/platform/messages"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UiLocale UiLocale
@inject ILogger<PlatformMessages> Logger

<PageTitle>پیام‌های کاربران | مدیریت سامانه</PageTitle>

<div class="admin-page">
    <div class="page-title">
        <div>
            <h1>پیام‌های کاربران (تماس با ما)</h1>
            <p>بررسی، پاسخ‌گویی و پیگیری پیام‌های ارسال‌شده از فرم تماس با ما</p>
        </div>
        <div class="page-actions" style="display: flex; gap: 8px;">
            @if (messages.Any(m => !m.IsRead))
            {
                <button class="action-secondary" @onclick="MarkAllAsReadAsync">
                    <span>خواندن همه</span>
                </button>
            }
            <button class="action-secondary" @onclick="LoadMessagesAsync">
                <span>تازه‌سازی</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    <!-- تب‌های فیلتر -->
    <div class="filter-bar">
        <div class="filter-tabs">
            <button class="filter-tab @(selectedTab == "all" ? "active" : "")" @onclick="@(() => ChangeTab("all"))">
                همه پیام‌ها (@allCount)
            </button>
            <button class="filter-tab @(selectedTab == "unread" ? "active" : "")" @onclick="@(() => ChangeTab("unread"))">
                خوانده‌نشده (@unreadCount)
            </button>
            <button class="filter-tab @(selectedTab == "read" ? "active" : "")" @onclick="@(() => ChangeTab("read"))">
                بررسی‌شده (@readCount)
            </button>
        </div>
        <div class="search-input-box">
            <input type="text" placeholder="جستجو بر اساس نام، شماره، موضوع..." @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">در حال بارگذاری پیام‌ها...</div>
    }
    else if (!FilteredMessages.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">✉</div>
            <h3>هیچ پیامی یافت نشد</h3>
            <p>پیامی با این مشخصات وجود ندارد.</p>
        </div>
    }
    else
    {
        <div class="messages-list">
            @foreach (var msg in FilteredMessages)
            {
                <div class="message-card @(msg.IsRead ? "is-read" : "is-unread")">
                    <div class="card-head">
                        <div class="user-meta">
                            <span class="user-avatar-circle">@(msg.Name.Length > 0 ? msg.Name[0] : '؟')</span>
                            <div>
                                <strong class="user-name">@msg.Name</strong>
                                <span class="user-contact" dir="ltr">@msg.ContactInfo</span>
                            </div>
                        </div>
                        <div class="head-right">
                            <span class="subject-badge">@msg.Subject</span>
                            <span class="date-label">@LocalizedDate.FormatDateTime(msg.CreatedAt, UiLocale.Language)</span>
                            @if (!msg.IsRead)
                            {
                                <span class="badge-unread">جدید</span>
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        <p class="message-text">@msg.Message</p>

                        @if (!string.IsNullOrEmpty(msg.AdminReply))
                        {
                            <div class="reply-box">
                                <strong>پاسخ ثبت شده توسط مدیریت:</strong>
                                <p>@msg.AdminReply</p>
                                <small>تاریخ پاسخ: @msg.RepliedAt?.ToLocalTime().ToString("yyyy/MM/dd - HH:mm")</small>
                            </div>
                        }
                    </div>

                    <div class="card-actions">
                        @if (!msg.IsRead)
                        {
                            <button type="button" class="btn-action primary" @onclick="@(() => MarkAsRead(msg.Id, true))">علامت به عنوان بررسی‌شده</button>
                        }
                        else
                        {
                            <button type="button" class="btn-action ghost" @onclick="@(() => MarkAsRead(msg.Id, false))">علامت به عنوان خوانده‌نشده</button>
                        }

                        <button type="button" class="btn-action outline" @onclick="@(() => OpenReplyModal(msg))">
                            @(string.IsNullOrEmpty(msg.AdminReply) ? "ثبت یادداشت یا پاسخ" : "ویرایش پاسخ")
                        </button>

                        <button type="button" class="btn-action danger" @onclick="@(() => DeleteMessage(msg.Id))">حذف</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (replyingMessage != null)
{
    <div class="modal-backdrop" @onclick="CloseReplyModal">
        <div class="modal-card" @onclick:stopPropagation>
            <h3>ثبت یادداشت یا پاسخ برای پیام @replyingMessage.Name</h3>
            <p class="subtle">موضوع: @replyingMessage.Subject | تماس: @replyingMessage.ContactInfo</p>

            <textarea rows="4" class="reply-textarea" placeholder="متن پاسخ یا یادداشت پیگیری..." @bind="replyText"></textarea>

            <div class="modal-actions">
                <button type="button" class="btn-action ghost" @onclick="CloseReplyModal">انصراف</button>
                <button type="button" class="btn-action primary" @onclick="SaveReplyAsync">ذخیره پاسخ</button>
            </div>
        </div>
    </div>
}

