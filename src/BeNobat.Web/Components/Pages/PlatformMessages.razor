@code {
    private List<ContactMessage> messages = [];
    private bool isLoading = true;
    private string selectedTab = "all";
    private string searchQuery = "";
    private string? statusMessage;

    private int allCount => messages.Count;
    private int unreadCount => messages.Count(m => !m.IsRead);
    private int readCount => messages.Count(m => m.IsRead);

    private ContactMessage? replyingMessage;
    private string replyText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        isLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            messages = await db.ContactMessages
                .AsNoTracking()
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در دریافت پیام‌ها");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<ContactMessage> FilteredMessages =>
        messages.Where(m =>
        {
            if (selectedTab == "unread" && m.IsRead) return false;
            if (selectedTab == "read" && !m.IsRead) return false;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLowerInvariant();
                var matchName = m.Name.ToLowerInvariant().Contains(q);
                var matchContact = m.ContactInfo.ToLowerInvariant().Contains(q);
                var matchSubject = m.Subject.ToLowerInvariant().Contains(q);
                var matchMsg = m.Message.ToLowerInvariant().Contains(q);
                if (!matchName && !matchContact && !matchSubject && !matchMsg) return false;
            }
            return true;
        });

    private void ChangeTab(string tab)
    {
        selectedTab = tab;
    }

    private async Task MarkAsRead(Guid id, bool isRead)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var target = await db.ContactMessages.FindAsync(id);
            if (target != null)
            {
                target.IsRead = isRead;
                target.UpdatedAt = DateTimeOffset.UtcNow;
                await db.SaveChangesAsync();

                var local = messages.FirstOrDefault(m => m.Id == id);
                if (local != null) local.IsRead = isRead;

                statusMessage = isRead ? "پیام به عنوان بررسی‌شده علامت خورد." : "پیام به عنوان خوانده‌نشده تنظیم شد.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در تغییر وضعیت پیام");
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var unread = await db.ContactMessages.Where(m => !m.IsRead).ToListAsync();
            foreach (var m in unread)
            {
                m.IsRead = true;
                m.UpdatedAt = DateTimeOffset.UtcNow;
            }
            if (unread.Count > 0)
            {
                await db.SaveChangesAsync();
                foreach (var local in messages) local.IsRead = true;
                statusMessage = "تمام پیام‌ها به عنوان بررسی‌شده علامت‌گذاری شدند.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در بررسی همه پیام‌ها");
        }
    }

    private void OpenReplyModal(ContactMessage msg)
    {
        replyingMessage = msg;
        replyText = msg.AdminReply ?? "";
    }

    private void CloseReplyModal()
    {
        replyingMessage = null;
        replyText = "";
    }

    private async Task SaveReplyAsync()
    {
        if (replyingMessage == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var target = await db.ContactMessages.FindAsync(replyingMessage.Id);
            if (target != null)
            {
                target.AdminReply = replyText.Trim();
                target.RepliedAt = DateTimeOffset.UtcNow;
                target.IsRead = true; // پیام پاسخ‌داده‌شده خودکار بررسی‌شده می‌شود
                target.UpdatedAt = DateTimeOffset.UtcNow;
                await db.SaveChangesAsync();

                var local = messages.FirstOrDefault(m => m.Id == replyingMessage.Id);
                if (local != null)
                {
                    local.AdminReply = target.AdminReply;
                    local.RepliedAt = target.RepliedAt;
                    local.IsRead = true;
                }

                statusMessage = "پاسخ/یادداشت با موفقیت ثبت شد.";
            }
            CloseReplyModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره پاسخ");
        }
    }

    private async Task DeleteMessage(Guid id)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var target = await db.ContactMessages.FindAsync(id);
            if (target != null)
            {
                db.ContactMessages.Remove(target);
                await db.SaveChangesAsync();
                messages.RemoveAll(m => m.Id == id);
                statusMessage = "پیام با موفقیت حذف شد.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در حذف پیام");
        }
    }
}
