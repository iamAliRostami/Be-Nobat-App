    flex-wrap: wrap;
    gap: 0.5rem;
}
.sender-info {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
}
.btn-read {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #0f766e;
    color: white;
    border: none;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
}
.btn-read:hover {
    background: #115e59;
}
.read-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #10b981;
    font-weight: 600;
}
.empty-state {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    color: var(--text-secondary);
}
.empty-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
}
.empty-state h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
}
.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem;
    color: var(--text-secondary);
    gap: 0.75rem;
}
.spinner {
    width: 24px;
    height: 24px;
    border: 2.5px solid rgba(15, 118, 110, 0.2);
    border-top-color: #0f766e;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}
@@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>

@code {
    private List<MessageItem> messages = [];
    private bool isLoading = true;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid))
        {
            currentUserId = uid;
        }

        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        isLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var rawMessages = await db.AdminBroadcastMessages
                .AsNoTracking()
                .Where(m => m.TargetUserId == null || m.TargetUserId == currentUserId)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync();

            var readIds = (await db.AdminMessageReads
                .AsNoTracking()
                .Where(r => r.UserId == currentUserId)
                .Select(r => r.MessageId)
                .ToListAsync()).ToHashSet();

            messages = rawMessages.Select(m => new MessageItem
            {
                Id = m.Id,
                Title = m.Title,
                Content = m.Content,
                Priority = m.Priority,
                CreatedAt = m.CreatedAt,
                IsRead = readIds.Contains(m.Id)
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در بارگذاری پیام‌های سامانه");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MarkAsRead(Guid messageId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var already = await db.AdminMessageReads
                .AnyAsync(r => r.UserId == currentUserId && r.MessageId == messageId);

            if (!already)
            {
                db.AdminMessageReads.Add(new AdminMessageRead
                {
                    UserId = currentUserId,
                    MessageId = messageId,
                    ReadAt = DateTimeOffset.UtcNow
                });
                await db.SaveChangesAsync();
            }

            var item = messages.FirstOrDefault(m => m.Id == messageId);
            if (item != null)
            {
                item.IsRead = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت خواندن پیام");
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        if (currentUserId == Guid.Empty) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var readIds = (await db.AdminMessageReads
                .Where(r => r.UserId == currentUserId)
                .Select(r => r.MessageId)
                .ToListAsync()).ToHashSet();

            var unread = messages.Where(m => !readIds.Contains(m.Id)).ToList();
            if (unread.Count > 0)
            {
                var now = DateTimeOffset.UtcNow;
                foreach (var m in unread)
                {
                    db.AdminMessageReads.Add(new AdminMessageRead
                    {
                        UserId = currentUserId,
                        MessageId = m.Id,
                        ReadAt = now
                    });
                    m.IsRead = true;
                }
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت خواندن تمام پیام‌ها");
        }
    }

    private static string GetPriorityLabel(string priority) => priority switch
    {
        "Urgent" => "فوری و ضروری",
        "Important" => "مهم",
        _ => "عادی"
    };

    private sealed class MessageItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public string Priority { get; set; } = "Normal";
        public DateTimeOffset CreatedAt { get; set; }
        public bool IsRead { get; set; }
    }
}
