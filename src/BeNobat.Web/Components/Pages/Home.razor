        <a href="#businesses"><i class="cat health">♡</i><strong>پزشکی و سلامت</strong><small>۶۲۰ مرکز</small></a>
        <a href="#businesses"><i class="cat sport">♙</i><strong>ورزش و تندرستی</strong><small>۳۲۰ مرکز</small></a>
