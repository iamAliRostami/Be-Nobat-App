        <a href="#businesses"><i class="cat repair">⌘</i><strong>تعمیر و خدمات</strong><small>۱۸۰ مرکز</small></a>
        <a href="#businesses"><i class="cat education">◇</i><strong>آموزش</strong><small>۱۴۰ آموزشگاه</small></a>
