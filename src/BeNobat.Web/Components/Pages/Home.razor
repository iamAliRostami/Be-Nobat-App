@page "/"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>به‌نوبت | رزرو آنلاین خدمات</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow"><span class="pulse"></span> @(TotalBusinesses > 0 ? $"{TotalBusinesses} مرکز آماده‌ی رزرو آنلاین" : "رزرو آنلاین خدمات")</span>
        <h1>وقتت ارزشمنده؛<br/><em>به‌نوبت</em> رزرو کن.</h1>
        <p>بهترین متخصص‌های اطرافت را پیدا کن، زمان‌های خالی را ببین و در چند ثانیه نوبت بگیر.</p>
        <div class="search-box">
            <label><span>⌕</span><input aria-label="جست‌وجوی خدمت" placeholder="چه خدمتی نیاز داری؟" @bind="SearchTerm" @bind:event="oninput" @onkeyup="OnKeyUp" /></label>
            <i></i>
            <label><span>⌖</span><input aria-label="انتخاب شهر" @bind="City" @bind:event="oninput" /></label>
            <button type="button" class="search-submit" @onclick="Search">جست‌وجو</button>
        </div>
        <div class="quick-tags">
            <span>جست‌وجوهای محبوب:</span>
            @foreach (var tag in QuickTags)
            {
                <a href="javascript:void(0)" @onclick="() => SearchFor(tag)" @onclick:preventDefault>@tag</a>
            }
        </div>
    </div>
    <div class="hero-visual" aria-label="نمونه کارت نوبت‌دهی">
        <div class="hero-blob"></div>
        <div class="salon-card">
            <div class="salon-photo"><span>✦</span><b>استودیو زیبایی</b></div>
            <div class="salon-info"><div><strong>نمونه‌ی کارت مرکز</strong><small>نشانی، امتیاز و رزرو در یک نگاه</small></div><span class="verified">✓</span></div>
        </div>
        <div class="floating-card next-slot"><span>◷</span><div><small>رزرو آنلاین</small><b>زمان‌های خالی را لحظه‌ای ببینید</b></div></div>
        <div class="floating-card rating"><span>★★★★★</span><small>نظر واقعی مراجعه‌کنندگان</small></div>
    </div>
</section>

<section class="section" id="popular">
    <div class="section-heading"><div><span>دسته‌بندی‌ها</span><h2>دنبال چه خدمتی هستی؟</h2></div></div>
    <div class="categories">
        @foreach (var category in Categories)
        {
            <a href="javascript:void(0)" @onclick="() => SearchFor(category.Name)" @onclick:preventDefault>
                <i class="cat @category.CssClass">@category.Icon</i><strong>@category.Name</strong>
            </a>
        }
    </div>
</section>

<section class="section businesses" id="businesses">
    <div class="section-heading">
        <div>
            <span>@(HasSearched ? "نتایج جست‌وجو" : "پیشنهاد به‌نوبت")</span>
            <h2>@(HasSearched ? $"نتایج برای «{SearchTerm}»" : "محبوب‌ترین‌های نزدیک شما")</h2>
        </div>
        @if (HasSearched)
        {
            <a href="javascript:void(0)" @onclick="ClearSearch" @onclick:preventDefault>پاک کردن جست‌وجو ←</a>
        }
    </div>

    @if (CityFilterRelaxed)
    {
        <p class="search-hint">نتیجه‌ای در «@City» پیدا نشد؛ این نتایج از سایر شهرها نمایش داده شده‌اند.</p>
    }

    @if (Results.Count == 0)
    {
        <p class="empty-state">هیچ کسب‌وکاری با این مشخصات پیدا نشد.</p>
    }
    else
    {
        <div class="business-grid">
            @foreach (var business in Results)
            {
                var accent = business.Category.Contains("دندان") ? "blue"
                    : business.Category.Contains("ماساژ") || business.Category.Contains("تندرست") ? "green"
                    : "rose";
                var icon = business.Category.Contains("دندان") ? "✚" : business.Category.Contains("ماساژ") ? "♧" : "✦";
                <BusinessCard Id="@business.Id" Name="@business.Name" Category="@business.Category" City="@business.City"
                              Location="@(business.Branches.FirstOrDefault()?.Address ?? business.City)"
                              Rating="@Rating(business)" ReviewCount="@business.Reviews.Count"
                              Accent="@accent" Icon="@icon" ReturnUrl="@SearchReturnUrl"
                              UserId="@CurrentUserId" IsFavorite="@FavoriteIds.Contains(business.Id)" />
            }
        </div>
    }
</section>

<section class="how-it-works section" id="how">
    <div class="section-heading centered"><div><span>ساده، سریع، مطمئن</span><h2>نوبت گرفتن به همین راحتیه</h2></div></div>
    <div class="steps">
        <article><b>۱</b><i>⌕</i><h3>پیدا کن</h3><p>خدمت یا متخصص موردنظرت را در نزدیکی خودت پیدا کن.</p></article>
        <span>··········</span>
        <article><b>۲</b><i>▦</i><h3>زمان را انتخاب کن</h3><p>زمان‌های خالی را ببین و مناسب‌ترین وقت را بردار.</p></article>
        <span>··········</span>
        <article><b>۳</b><i>✓</i><h3>تمام!</h3><p>تأیید نوبت را بگیر؛ ما به‌موقع یادت می‌اندازیم.</p></article>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? QueryTerm { get; set; }
    [SupplyParameterFromQuery(Name = "city")] private string? QueryCity { get; set; }
    private string SearchTerm { get; set; } = "";
    private string City { get; set; } = "تهران";
    private bool HasSearched { get; set; }
    private bool CityFilterRelaxed;
    private bool ScrollToResultsPending;
    private int TotalBusinesses;
    private Guid? CurrentUserId;
    private HashSet<Guid> FavoriteIds = [];
    private List<Business> Results { get; set; } = [];

    private static readonly string[] QuickTags = ["کوتاهی مو", "دندانپزشکی", "ماساژ"];

    private static readonly (string Name, string Icon, string CssClass)[] Categories =
    [
        ("زیبایی و آرایش", "✦", "beauty"),
        ("دندانپزشکی", "♡", "health"),
        ("ماساژ و تندرستی", "♙", "sport"),
        ("مشاوره", "⌁", "consult"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        CurrentUserId = UserContext.IdOf(user);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            TotalBusinesses = await db.Businesses.CountAsync(b => b.Branches.Any());
            if (CurrentUserId is Guid userId)
            {
                FavoriteIds = (await db.FavoriteBusinesses.AsNoTracking()
                    .Where(x => x.UserId == userId).Select(x => x.BusinessId).ToListAsync()).ToHashSet();
            }
        }

        if (!string.IsNullOrWhiteSpace(QueryTerm))
        {
            SearchTerm = QueryTerm;
            City = QueryCity ?? "";
            await Search(scroll: false);
            return;
        }

        await LoadFeaturedAsync();
    }

    private async Task LoadFeaturedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Results = await db.Businesses.AsNoTracking()
            .Where(b => b.Branches.Any())
            .Include(b => b.Branches)
            .Include(b => b.Reviews.Where(r => r.Status == ReviewStatus.Published))
            .OrderByDescending(b => b.Reviews.Count(r => r.Status == ReviewStatus.Published))
            .ThenByDescending(b => b.CreatedAt)
            .Take(12)
            .ToListAsync();
    }

    private string SearchReturnUrl => HasSearched
        ? $"/?q={Uri.EscapeDataString(SearchTerm.Trim())}&city={Uri.EscapeDataString(City.Trim())}#businesses"
        : "/#businesses";

    private async Task OnKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task SearchFor(string term)
    {
        SearchTerm = term;
        await Search();
    }

    private Task Search() => Search(scroll: true);

    private async Task Search(bool scroll)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var term = TextSearch.Normalize(SearchTerm);
        var city = TextSearch.Normalize(City);
        HasSearched = term.Length > 0;
        CityFilterRelaxed = false;

        // هر دو املای فارسی/عربی («ی/ي»، «ک/ك») جست‌وجو می‌شوند و %/_ ورودی کاربر escape می‌شود.
        var termPatterns = TextSearch.LikePatterns(term);
        var termA = termPatterns.Length > 0 ? termPatterns[0] : "%";
        var termB = termPatterns.Length > 1 ? termPatterns[1] : termA;
        var cityPatterns = TextSearch.LikePatterns(city);
        var cityA = cityPatterns.Length > 0 ? cityPatterns[0] : "%";
        var cityB = cityPatterns.Length > 1 ? cityPatterns[1] : cityA;

        IQueryable<Business> BaseQuery() => db.Businesses.AsNoTracking()
            .Where(b => b.Branches.Any())
            .Include(b => b.Branches)
            .Include(b => b.Reviews.Where(r => r.Status == ReviewStatus.Published));

        IQueryable<Business> ApplyTerm(IQueryable<Business> query) =>
            term.Length == 0
                ? query
                : query.Where(b =>
                    EF.Functions.ILike(b.Name, termA) || EF.Functions.ILike(b.Name, termB) ||
                    EF.Functions.ILike(b.Category, termA) || EF.Functions.ILike(b.Category, termB) ||
                    EF.Functions.ILike(b.Description, termA) || EF.Functions.ILike(b.Description, termB) ||
                    db.Services.Any(s => s.BusinessId == b.Id &&
                        (EF.Functions.ILike(s.Name, termA) || EF.Functions.ILike(s.Name, termB))));

        var withTerm = ApplyTerm(BaseQuery());

        var withCity = city.Length == 0
            ? withTerm
            : withTerm.Where(b => EF.Functions.ILike(b.City, cityA) || EF.Functions.ILike(b.City, cityB));

        Results = await withCity.OrderByDescending(b => b.CreatedAt).Take(24).ToListAsync();

        // شهر را فیلتر «سخت‌گیرانه» در نظر نمی‌گیریم: اگر با محدود کردن به شهر نتیجه‌ای نبود ولی بدون آن
        // هست، همان‌ها را نشان می‌دهیم و به کاربر می‌گوییم به‌جای یک صفحه‌ی خالی.
        if (Results.Count == 0 && city.Length > 0)
        {
            var withoutCity = await withTerm.OrderByDescending(b => b.CreatedAt).Take(24).ToListAsync();
            if (withoutCity.Count > 0)
            {
                Results = withoutCity;
                CityFilterRelaxed = true;
            }
        }

        // اسکرول را به بعد از رندر شدن نتایج موکول می‌کنیم.
        ScrollToResultsPending = scroll;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ScrollToResultsPending) return;
        ScrollToResultsPending = false;

        try
        {
            await JS.InvokeVoidAsync("beNobat.scrollToResults", "#businesses");
        }
        catch (JSDisconnectedException)
        {
            // کاربر صفحه را بسته است؛ چیزی برای اسکرول کردن نمانده.
        }
    }

    private async Task ClearSearch()
    {
        SearchTerm = "";
        HasSearched = false;
        CityFilterRelaxed = false;
        // اگر آدرس شامل ?q= باشد، بدون ناوبری دوباره جست‌وجو می‌شد؛ پس آدرس هم پاک می‌شود.
        if (!string.IsNullOrWhiteSpace(QueryTerm))
        {
            Navigation.NavigateTo("/#businesses");
            return;
        }

        await LoadFeaturedAsync();
    }

    private static string Rating(Business business) => business.Reviews.Count == 0
        ? "—"
        : LocalizedDate.FormatNumber(Math.Round(business.Reviews.Average(x => x.Rating), 1), "fa", "0.0");
}
