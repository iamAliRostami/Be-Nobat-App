@page "/account/profile"
@layout Layout.PublicLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<MyAccount> Logger

<PageTitle>اطلاعات حساب | به‌نوبت</PageTitle>

<div class="account-page">
    <AccountMenu UserId="@User?.Id" DisplayName="@User?.DisplayName" Email="@User?.Email"
                 AvatarContentType="@User?.AvatarContentType" ConcurrencyStamp="@User?.ConcurrencyStamp" />
    <div class="account-content profile-account-content">
<section class="profile-page" aria-labelledby="profile-heading">
    <div class="page-title">
        <div><h1 id="profile-heading">اطلاعات حساب کاربری</h1><p>عکس، مشخصات تماس، ایمیل و نظرهای ثبت‌شده‌ی خود را مدیریت کنید.</p></div>
    </div>

    @if (Message is not null) { <div class="success-notice" role="status">@Message</div> }
    @if (ErrorMessage is not null) { <div class="auth-error" role="alert">@ErrorMessage</div> }

    <div class="profile-grid profile-columns">
        <div class="profile-column profile-personal-column">
        @* [feature] تا پیش از این عکس پروفایل اصلاً وجود نداشت. *@
        <article class="admin-panel profile-form profile-card profile-avatar-card" aria-labelledby="profile-avatar-heading">
            <header class="profile-card-head"><h2 id="profile-avatar-heading">عکس پروفایل</h2></header>
            <div class="avatar-editor">
                @if (User is not null && UserAvatar.Has(User))
                {
                    <img class="avatar-preview" src="@UserAvatar.Url(User)" alt="عکس پروفایل" />
                }
                else
                {
                    <span class="avatar-preview placeholder" data-i18n-skip>@UserAvatar.Initials(User?.DisplayName)</span>
                }
                <div class="profile-avatar-details">
                    <div class="profile-avatar-actions">
                        <label class="file-label">
                            انتخاب عکس
                            <InputFile disabled="@IsSaving" OnChange="UploadAvatar" accept="image/png,image/jpeg,image/webp" />
                        </label>
                        @if (User is not null && UserAvatar.Has(User))
                        {
                            <button type="button" class="action-danger" disabled="@IsSaving" @onclick="RemoveAvatar">حذف عکس</button>
                        }
                    </div>
                    <small class="profile-help">PNG، JPEG یا WebP؛ حداکثر ۲ مگابایت.</small>
                </div>
            </div>
        </article>

        <EditForm Model="Profile" FormName="account-profile" OnValidSubmit="SaveProfile" class="admin-panel profile-form profile-card profile-contact-card" aria-labelledby="profile-contact-heading">
            <header class="profile-card-head"><h2 id="profile-contact-heading">مشخصات من</h2></header>
            <div class="profile-fields">
                <label>نام و نام خانوادگی<input autocomplete="name" required maxlength="100" disabled="@IsSaving" @bind="Profile.DisplayName" /></label>
                <label>شماره تماس<input type="tel" disabled="@IsSaving" inputmode="tel" autocomplete="tel" dir="ltr" maxlength="14" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" @bind="Profile.Phone" /></label>
                @if (string.IsNullOrWhiteSpace(Profile.Phone)) { <small class="appointment-hint">هنوز شماره‌ای در حساب شما ثبت نشده است؛ این شماره هنگام رزرو نوبت هم به‌صورت پیش‌فرض استفاده می‌شود.</small> }
            </div>
            <div class="profile-card-actions"><button type="submit" disabled="@IsSaving" class="primary-button action-primary">ذخیره تغییرات</button></div>
        </EditForm>

        <article class="admin-panel profile-form profile-card profile-review-card" aria-labelledby="profile-review-heading">
            <header class="profile-card-head"><h2 id="profile-review-heading">امتیاز و نظر</h2></header>
            <p>پس از پایان هر نوبت، از صفحه‌ی «نوبت‌های من» می‌توانید امتیاز و نظر خود را ثبت کنید.</p>
            <a class="entity-link profile-review-link" href="/appointments">رفتن به نوبت‌های من <span aria-hidden="true">←</span></a>
            @* [feature] امتیازی که مجموعه‌ها به شما داده‌اند هم نمایش داده می‌شود. *@
            @if (ReceivedRating is not null)
            {
                <div class="profile-rating-summary">
                    <span class="profile-rating-mark" aria-hidden="true">★</span>
                    <div><span>امتیاز شما به‌عنوان مراجعه‌کننده</span><strong>@LocalizedDate.FormatNumber(ReceivedRating.Value, UiLocale.Language, "0.0") از ۵</strong><small>بر اساس @LocalizedDate.FormatNumber(ReceivedCount, UiLocale.Language) ارزیابی مجموعه‌ها</small></div>
                </div>
            }
        </article>
        </div>

        <div class="profile-column profile-security-column">
        @* [feature] ایمیل قبلاً disabled بود و هیچ راهی برای تغییرش نبود.
           این فرم عمداً یک POST معمولی به سرور است (نه فرم تعاملی): تغییر ایمیل
           SecurityStamp را عوض می‌کند و باید همان‌جا با RefreshSignInAsync کوکی
           ورود تازه شود، وگرنه کاربر بعد از چند دقیقه از حساب بیرون می‌افتد. *@
        <form method="post" action="/account/change-email" class="admin-panel profile-form profile-card profile-email-card" aria-labelledby="profile-email-heading">
            <AntiforgeryToken />
            <header class="profile-card-head"><h2 id="profile-email-heading">ایمیل حساب</h2></header>
            <div class="profile-fields"><label>ایمیل<input name="email" type="email" required autocomplete="email" dir="ltr" value="@Profile.Email" /></label></div>
            <small class="profile-help">پس از تغییر، برای ورود باید از ایمیل جدید استفاده کنید.</small>
            <div class="profile-card-actions"><button type="submit" class="primary-button action-primary">تغییر ایمیل</button></div>
        </form>

        <form method="post" action="/account/change-password" class="admin-panel profile-form profile-card profile-password-card" aria-labelledby="profile-password-heading">
            <AntiforgeryToken />
            <header class="profile-card-head"><h2 id="profile-password-heading">تغییر گذرواژه</h2></header>
            <div class="profile-fields">
                <label>گذرواژه‌ی فعلی<input name="currentPassword" type="password" required autocomplete="current-password" dir="ltr" /></label>
                <label>گذرواژه‌ی جدید<input name="newPassword" type="password" required minlength="8" autocomplete="new-password" dir="ltr" /></label>
                <label>تکرار گذرواژه‌ی جدید<input name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" dir="ltr" /></label>
            </div>
            <div class="profile-card-actions"><button type="submit" class="primary-button action-primary">تغییر گذرواژه</button></div>
        </form>
        </div>
    </div>
</section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "emailChanged")] private string? EmailChanged { get; set; }
    [SupplyParameterFromQuery(Name = "emailError")] private string? EmailError { get; set; }
    [SupplyParameterFromQuery(Name = "passwordChanged")] private string? PasswordChanged { get; set; }
    [SupplyParameterFromQuery(Name = "passwordError")] private string? PasswordError { get; set; }

    private AppUser? User;
    private ProfileInput Profile = new();
    private double? ReceivedRating;
    private int ReceivedCount;
    private string? Message;
    private string? ErrorMessage;
    private bool IsSaving;

    protected override async Task OnInitializedAsync()
    {
        // پیام‌های برگشتی از endpoint تغییر ایمیل.
        Message = EmailChanged == "1" ? "ایمیل حساب با موفقیت تغییر کرد."
            : PasswordChanged == "1" ? "گذرواژه با موفقیت تغییر کرد." : null;
        ErrorMessage = PasswordError switch
        {
            "mismatch" => "گذرواژه‌ی جدید و تکرار آن یکسان نیست.",
            "wrong" => "گذرواژه‌ی فعلی درست نیست.",
            "weak" => "گذرواژه‌ی جدید ضعیف است؛ حداقل ۸ حرف با ترکیب حروف و عدد انتخاب کنید.",
            "invalid" => "اطلاعات واردشده معتبر نیست.",
            _ => null,
        } ?? EmailError switch
        {
            "duplicate" => "این ایمیل قبلاً برای حساب دیگری ثبت شده است.",
            "invalid" => "ایمیل واردشده معتبر نیست.",
            _ => null,
        };

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        User = await FreshUserAsync(users);
        if (User is null) return;

        Profile = new ProfileInput
        {
            DisplayName = User.DisplayName,
            Email = User.Email ?? "",
            Phone = User.PhoneNumber ?? "",
        };

        var userId = User.Id;

        await using var db = await DbFactory.CreateDbContextAsync();
        var ratings = await db.CustomerReviews.AsNoTracking().Where(x => x.CustomerId == userId)
            .Select(x => x.Rating).ToListAsync();
        ReceivedCount = ratings.Count;
        ReceivedRating = ratings.Count == 0 ? null : ratings.Average(x => (double)x);
    }

    private async Task<AppUser?> FreshUserAsync(UserManager<AppUser> users)
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var id = UserContext.IdOf(principal);
        var stamp = principal.FindFirst(users.Options.ClaimsIdentity.SecurityStampClaimType)?.Value;
        var user = id is Guid userId ? await users.FindByIdAsync(userId.ToString()) : null;
        if (user is null || (User is not null && User.Id != user.Id) || stamp is null || !string.Equals(stamp, user.SecurityStamp, StringComparison.Ordinal)
            || (user.LockoutEnabled && user.LockoutEnd > DateTimeOffset.UtcNow))
        {
            User = null;
            Profile = new();
            ReceivedRating = null;
            ReceivedCount = 0;
            ErrorMessage = "نشست شما منقضی شده است؛ دوباره وارد حساب شوید.";
            return null;
        }
        return user;
    }

    private async Task SaveProfile()
    {
        if (User is null || IsSaving) return;
        Message = ErrorMessage = null;
        if (!UserInputValidation.TryNormalizeDisplayName(Profile.DisplayName, out var name))
        {
            ErrorMessage = "نام و نام خانوادگی باید بین ۱ تا ۱۰۰ نویسه باشد.";
            return;
        }
        if (!UserInputValidation.TryNormalizeIranianMobile(Profile.Phone, out var phone))
        {
            ErrorMessage = "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
            return;
        }
        IsSaving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var user = await FreshUserAsync(users);
            if (user is null) return;
            user.DisplayName = name;
            if (user.PhoneNumber != phone) user.PhoneNumberConfirmed = false;
            user.PhoneNumber = phone;
            ApplyUpdateResult(await users.UpdateAsync(user), user, "اطلاعات حساب ذخیره شد.");
            if (ErrorMessage is null) { Profile.DisplayName = name; Profile.Phone = phone; }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save account profile");
            Message = null;
            ErrorMessage = "ذخیره اطلاعات حساب انجام نشد؛ دوباره تلاش کنید.";
        }
        finally { IsSaving = false; }
    }

    private async Task UploadAvatar(InputFileChangeEventArgs e)
    {
        if (User is null || IsSaving) return;
        Message = ErrorMessage = null;
        var file = e.File;
        if (!UserAvatar.AllowedContentTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            ErrorMessage = "فقط فایل‌های PNG، JPEG و WebP پذیرفته می‌شوند.";
            return;
        }
        if (file.Size <= 0 || file.Size > UserAvatar.MaxBytes)
        {
            ErrorMessage = "حجم عکس نباید بیشتر از ۲ مگابایت باشد.";
            return;
        }
        IsSaving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var user = await FreshUserAsync(users);
            if (user is null) return;
            using var stream = file.OpenReadStream(UserAvatar.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (!UserAvatar.ValidImage(bytes, file.ContentType))
            {
                ErrorMessage = "فایل انتخاب‌شده یک تصویر معتبر PNG، JPEG یا WebP نیست.";
                return;
            }
            user.AvatarData = bytes;
            user.AvatarContentType = file.ContentType.ToLowerInvariant();
            ApplyUpdateResult(await users.UpdateAsync(user), user, "عکس پروفایل به‌روزرسانی شد.");
        }
        catch (IOException) { ErrorMessage = "خواندن فایل انجام نشد؛ دوباره تلاش کنید."; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save account avatar");
            Message = null;
            ErrorMessage = "ذخیره اطلاعات حساب انجام نشد؛ دوباره تلاش کنید.";
        }
        finally { IsSaving = false; }
    }

    private async Task RemoveAvatar()
    {
        if (User is null || IsSaving) return;
        Message = ErrorMessage = null;
        IsSaving = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var users = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var user = await FreshUserAsync(users);
            if (user is null) return;
            user.AvatarData = null;
            user.AvatarContentType = null;
            ApplyUpdateResult(await users.UpdateAsync(user), user, "عکس پروفایل حذف شد.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove account avatar");
            Message = null;
            ErrorMessage = "ذخیره اطلاعات حساب انجام نشد؛ دوباره تلاش کنید.";
        }
        finally { IsSaving = false; }
    }

    private void ApplyUpdateResult(IdentityResult result, AppUser updatedUser, string successMessage)
    {
        if (result.Succeeded)
        {
            User = updatedUser;
            Message = successMessage;
            ErrorMessage = null;
        }
        else
        {
            Message = null;
            ErrorMessage = result.Errors.Any()
                ? string.Join("، ", result.Errors.Select(x => x.Description).Distinct(StringComparer.Ordinal))
                : "ذخیره اطلاعات حساب انجام نشد؛ دوباره تلاش کنید.";
        }
    }

    private sealed class ProfileInput
    {
        public string DisplayName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }
}
