@page "/businesses"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@inject AppDbContext Db
@inject AdminAccessScope Access
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>خدمات | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>خدمات شعب</h1><p>هر خدمت را به شعبه و کارکنان ارائه‌دهنده متصل کنید.</p></div><button type="button" class="action-primary" @onclick="OpenNew">+ افزودن خدمت</button></div>

@if (Error is not null && !ShowForm) { <div class="auth-error" role="alert">@Error</div> }

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="service-form" OnValidSubmit="Save" class="form-modal service-form-modal" novalidate @onclick:stopPropagation>
            <div><h2>@(EditingId is null ? "خدمت جدید" : "تنظیم خدمت")</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <div class="service-form-row">
                <label>کسب‌وکار<select disabled="@(EditingId is not null)" @bind="Form.BusinessId" @bind:after="BusinessChanged">@foreach (var business in BusinessOptions) { <option value="@business.Id" data-i18n-skip>@business.Name</option> }</select></label>
                <label>شعبه<select @bind="Form.BranchId" @bind:after="BranchChanged">@foreach (var branch in FormBranches) { <option value="@branch.Id" data-i18n-skip>@branch.Name</option> }</select></label>
            </div>
            @if (EditingId is null)
            {
                <div class="service-form-row source-row">
                    <fieldset class="service-source">
                        <legend>روش تعریف خدمت</legend>
                        <InputRadioGroup TValue="string" @bind-Value="Form.Source">
                            <label class="check-label"><InputRadio TValue="string" Value="@CatalogSource" /><span>کاتالوگ سراسری</span></label>
                            <label class="check-label"><InputRadio TValue="string" Value="@CustomSource" /><span>خدمت اختصاصی</span></label>
                        </InputRadioGroup>
                    </fieldset>
                    @if (Form.Source == CatalogSource)
                    {
                        <label>خدمت کاتالوگ<select @bind="Form.CatalogItemId" @bind:after="CatalogChanged"><option value="">— انتخاب کنید —</option>@foreach (var item in CatalogItems) { <option value="@item.Id" data-i18n-skip>@item.Category · @item.Name</option> }</select><small>نام و مشخصات از کاتالوگ تکمیل می‌شود.</small></label>
                    }
                    else
                    {
                        <label>نام خدمت<input @bind="Form.Name" /></label>
                    }
                </div>
            }
            else if (Form.Source == CustomSource)
            {
                <label>نام خدمت<input @bind="Form.Name" /></label>
            }
            <label>توضیحات<textarea @bind="Form.Description"></textarea></label>
            <div class="service-form-row"><label>مدت (دقیقه)<input type="number" @bind="Form.DurationMinutes" /></label><label>قیمت خدمت (تومان)<input type="number" @bind="Form.Price" /></label></div>
            <fieldset class="service-providers"><legend>کارکنان ارائه‌دهنده</legend>
                @if (!FormResources.Any()) { <small>ابتدا در صفحه شعب، منبع «عضو تیم» تعریف کنید.</small> }
                <div class="service-provider-list">@foreach (var resource in FormResources) { <label class="check-label"><input type="checkbox" checked="@SelectedResourceIds.Contains(resource.Id)" @onchange="() => ToggleResource(resource.Id)" /><span data-i18n-skip>@resource.Name</span></label> }</div>
            </fieldset>
            @if (Error is not null) { <div class="auth-error" role="alert" aria-live="polite">@Error</div> }
            <button class="primary-button">ذخیره خدمت و تخصیص‌ها</button>
        </EditForm>
    </div>
}

<article class="admin-panel">
    <div class="toolbar">
        <input aria-label="جست‌وجوی خدمات" placeholder="جست‌وجوی خدمت، کسب‌وکار، شعبه یا ارائه‌دهنده..." @bind="Search" @bind:event="oninput" />
        <select aria-label="وضعیت خدمات" @bind="StatusFilter"><option value="all">همه وضعیت‌ها</option><option value="active">فعال</option><option value="disabled">غیرفعال</option></select>
        <span>@Filtered.Count() خدمت</span>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ClearFilters">پاک کردن فیلترها</button> }
    </div>
    @if (HasEntityFilter) { <p class="filter-summary">فهرست خدمات مرتبط با مورد انتخاب‌شده</p> }
    @if (!Filtered.Any()) { <p class="empty-state">خدمتی با این فیلترها پیدا نشد.</p> }
    <div class="service-table branch-services-table">
        <div class="table-head"><span>خدمت</span><span>نام کسب‌وکار</span><span>شعب</span><span>ارائه‌دهندگان</span><span>وضعیت</span><span></span></div>
        @foreach (var service in Filtered)
        {
            <div>
                <span><i class="rose">✂</i><b><a class="entity-link" href="@($"/businesses?serviceId={service.Id}")" data-i18n-skip>@service.Name</a><small>@($"{LocalizedDate.FormatNumber(service.DurationMinutes, UiLocale.Language)} دقیقه · {LocalizedDate.FormatNumber(service.Price, UiLocale.Language, "N0")} تومان · {(service.CatalogItem is null ? "اختصاصی" : "کاتالوگ")}")</small></b></span>
                <span><a class="entity-link" href="@BusinessUrl(service.BusinessId)" data-i18n-skip>@BusinessName(service.BusinessId)</a></span>
                <span class="entity-links">@foreach (var assignment in service.BranchServices) { <a class="entity-link" href="@($"/admin/branches?branchId={assignment.BranchId}")" data-i18n-skip>@assignment.Branch.Name</a> }</span>
                <span class="entity-links">@foreach (var provider in service.ServiceResources) { <a class="entity-link" href="@ResourceUrl(provider.Resource)" data-i18n-skip>@provider.Resource.Name</a> }</span>
                <span><em class="status @(service.DeletedAt is null ? "confirmed" : "cancelled")">@(service.DeletedAt is null ? "فعال" : "غیرفعال")</em></span>
                <span class="inline-actions"><button type="button" class="action-secondary" @onclick="() => Edit(service)">تنظیم</button><button type="button" class="@(service.DeletedAt is null ? "action-danger" : "action-success")" @onclick="() => ToggleActive(service)">@(service.DeletedAt is null ? "غیرفعال" : "فعال")</button></span>
            </div>
        }
    </div>
</article>

@code {
    private const string CatalogSource = "catalog";
    private const string CustomSource = "custom";

    [SupplyParameterFromQuery(Name = "q")] public string? FilterQuery { get; set; }
    [SupplyParameterFromQuery(Name = "serviceId")] public Guid? FilterServiceId { get; set; }
    [SupplyParameterFromQuery(Name = "businessId")] public Guid? FilterBusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "branchId")] public Guid? FilterBranchId { get; set; }
    [SupplyParameterFromQuery(Name = "resourceId")] public Guid? FilterResourceId { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? FilterStatus { get; set; }

    private List<Business> BusinessOptions = [];
    private List<Branch> Branches = [];
    private List<Service> Services = [];
    private List<Resource> Resources = [];
    private List<ServiceCatalogItem> CatalogItems = [];
    private string Search = "";
    private string StatusFilter = "all";
    private bool IsPlatformAdmin;
    private bool ShowForm;
    private Guid? EditingId;
    private ServiceInput Form = new();
    private HashSet<Guid> SelectedResourceIds = [];
    private string? Error;
    private string Language = "fa";
    private bool HasEntityFilter => FilterServiceId is not null || FilterBusinessId is not null || FilterBranchId is not null || FilterResourceId is not null;
    private bool HasFilters => HasEntityFilter || Search.Length > 0 || StatusFilter != "all";
    private IEnumerable<Service> Filtered => Services
        .Where(x => FilterServiceId is null || x.Id == FilterServiceId)
        .Where(x => FilterBusinessId is null || x.BusinessId == FilterBusinessId)
        .Where(x => FilterBranchId is null || x.BranchServices.Any(b => b.BranchId == FilterBranchId))
        .Where(x => FilterResourceId is null || x.ServiceResources.Any(r => r.ResourceId == FilterResourceId))
        .Where(x => StatusFilter == "all" || (x.DeletedAt is null) == (StatusFilter == "active"))
        .Where(x => $"{x.Name} {BusinessName(x.BusinessId)} {string.Join(' ', x.BranchServices.Select(b => b.Branch.Name))} {string.Join(' ', x.ServiceResources.Select(r => r.Resource.Name))}".Contains(Search, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<Branch> FormBranches => Branches.Where(x => x.BusinessId == Form.BusinessId);
    private IEnumerable<Resource> FormResources => Resources.Where(x => x.BranchId == Form.BranchId && x.Kind == "staff");
    private string BusinessName(Guid businessId) => BusinessOptions.FirstOrDefault(x => x.Id == businessId)?.Name ?? "—";
    private string BusinessUrl(Guid businessId) => $"{(IsPlatformAdmin ? "/platform" : "/businesses")}?businessId={businessId}";
    private static string ResourceUrl(Resource resource) => resource.Kind == "staff"
        ? $"/admin/team?resourceId={resource.Id}"
        : $"/admin/branches?branchId={resource.BranchId}&resourceId={resource.Id}";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Language = await JS.InvokeAsync<string>("beNobat.preferences.getLanguage");
        StateHasChanged();
    }
    protected override void OnParametersSet()
    {
        Search = FilterQuery?.Trim() ?? "";
        StatusFilter = FilterStatus is "active" or "disabled" ? FilterStatus : "all";
    }
    private void ClearFilters()
    {
        Search = "";
        StatusFilter = "all";
        FilterServiceId = FilterBusinessId = FilterBranchId = FilterResourceId = null;
        Navigation.NavigateTo("/businesses");
    }
    private async Task Load()
    {
        IsPlatformAdmin = await Access.IsPlatformAdminAsync();
        Branches = await (await Access.ManagedBranchesAsync()).AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        BusinessOptions = await Access.ManagedBusinessesAsync();
        var ids = BusinessOptions.Select(x => x.Id).ToList();
        var branchIds = Branches.Select(x => x.Id).ToList();
        Resources = await Db.Resources.AsNoTracking().Where(x => branchIds.Contains(x.BranchId)).OrderBy(x => x.Name).ToListAsync();
        CatalogItems = await Db.ServiceCatalogItems.AsNoTracking().Where(x => x.IsPublished).OrderBy(x => x.Category).ThenBy(x => x.Name).ToListAsync();
        Services = await Db.Services.IgnoreQueryFilters().AsNoTracking().Where(x => ids.Contains(x.BusinessId) && x.Business.DeletedAt == null)
            .Include(x => x.CatalogItem)
            .Include(x => x.BranchServices.Where(b => b.DeletedAt == null && b.Branch.DeletedAt == null && branchIds.Contains(b.BranchId))).ThenInclude(x => x.Branch)
            .Include(x => x.ServiceResources.Where(r => r.DeletedAt == null && r.Resource.DeletedAt == null && branchIds.Contains(r.Resource.BranchId))).ThenInclude(x => x.Resource)
            .OrderBy(x => x.Name).ToListAsync();
    }
    private void OpenNew()
    {
        EditingId = null;
        var selectedBranch = Branches.FirstOrDefault(b => b.Id == FilterBranchId);
        var businessId = BusinessOptions.FirstOrDefault(b => b.Id == FilterBusinessId)?.Id ?? selectedBranch?.BusinessId ?? BusinessOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        Form = new() { BusinessId = businessId, BranchId = selectedBranch is not null && selectedBranch.BusinessId == businessId ? selectedBranch.Id : Branches.FirstOrDefault(b => b.BusinessId == businessId)?.Id ?? Guid.Empty };
        SelectedResourceIds = [];
        Error = null;
        ShowForm = true;
    }
    private void Edit(Service service) { EditingId = service.Id; var assignment = service.BranchServices.FirstOrDefault(); Form = new() { BusinessId = service.BusinessId, CatalogItemId = service.CatalogItemId, Source = service.CatalogItemId is null ? "custom" : "catalog", Name = service.Name, Description = service.Description, DurationMinutes = service.DurationMinutes, Price = assignment?.Price ?? service.Price, BranchId = assignment?.BranchId ?? Branches.FirstOrDefault(x => x.BusinessId == service.BusinessId)?.Id ?? Guid.Empty }; SelectedResourceIds = service.ServiceResources.Select(x => x.ResourceId).Where(r => Resources.Any(f => f.Id == r && f.BranchId == Form.BranchId)).ToHashSet(); Error = null; ShowForm = true; }
    private Task BusinessChanged() { Form.BranchId = FormBranches.FirstOrDefault()?.Id ?? Guid.Empty; SelectedResourceIds.Clear(); return Task.CompletedTask; }
    private Task BranchChanged()
    {
        if (EditingId is Guid id && Services.FirstOrDefault(x => x.Id == id) is { } editing)
            SelectedResourceIds = editing.ServiceResources.Select(x => x.ResourceId).Where(r => FormResources.Any(f => f.Id == r)).ToHashSet();
        else
            SelectedResourceIds.RemoveWhere(x => FormResources.All(r => r.Id != x));
        return Task.CompletedTask;
    }
    private Task CatalogChanged() { var item = CatalogItems.FirstOrDefault(x => x.Id == Form.CatalogItemId); if (item is not null) { Form.Name = item.Name; Form.Description = item.Description; Form.DurationMinutes = item.SuggestedDurationMinutes; } return Task.CompletedTask; }
    private void ToggleResource(Guid id) { if (!SelectedResourceIds.Add(id)) SelectedResourceIds.Remove(id); }
    private async Task Save()
    {
        var branch = await Db.Branches.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Form.BranchId && x.BusinessId == Form.BusinessId);
        Error = null;
        if (branch is not null && !await Access.CanManageBranchAsync(branch.Id)) { Error = T("اجازه‌ی مدیریت خدمات این شعبه را ندارید.", "ليس لديك صلاحية إدارة خدمات هذا الفرع.", "You are not allowed to manage services of this branch."); return; }
        if (Form.BusinessId == Guid.Empty) { Error = T("ابتدا یک کسب‌وکار انتخاب کنید.", "اختر نشاطًا تجاريًا أولًا.", "Select a business first."); return; }
        if (EditingId is null && Form.Source == CatalogSource && Form.CatalogItemId is null) { Error = T("یک خدمت را از فهرست کاتالوگ انتخاب کنید.", "اختر خدمة من قائمة الكتالوج.", "Select a service from the catalog list."); return; }
        if (string.IsNullOrWhiteSpace(Form.Name)) { Error = T("نام خدمت را وارد کنید.", "أدخل اسم الخدمة.", "Enter a service name."); return; }
        if (branch is null) { Error = T("یک شعبه معتبر برای این کسب‌وکار انتخاب کنید.", "اختر فرعًا صالحًا لهذا النشاط.", "Select a valid branch for this business."); return; }
        if (Form.DurationMinutes < 5 || Form.DurationMinutes > 1440) { Error = T("مدت خدمت باید بین ۵ تا ۱۴۴۰ دقیقه باشد.", "يجب ألا تقل مدة الخدمة عن ٥ دقائق.", "Service duration must be at least 5 minutes."); return; }
        if (Form.Price < 0 || Form.Price > 9999999999999999.99m || decimal.Round(Form.Price, 2) != Form.Price) { Error = T("قیمت خدمت نمی‌تواند منفی باشد.", "لا يمكن أن يكون سعر الخدمة سالبًا.", "Service price cannot be negative."); return; }
        if (Form.Name.Trim().Length > 200 || Form.Description.Trim().Length > 5000 || Form.Source is not (CatalogSource or CustomSource)) { Error = "نام یا توضیحات خدمت معتبر نیست."; return; }
        if (EditingId is Guid editingId && !await Access.CanManageServiceAsync(editingId)) { Error = "اجازه‌ی تغییر این خدمت و شعب مرتبط با آن را ندارید."; return; }
        if (Form.Source == CatalogSource && !await Db.ServiceCatalogItems.AnyAsync(c => c.Id == Form.CatalogItemId && c.IsPublished) &&
            !await Db.Services.IgnoreQueryFilters().AnyAsync(s => s.Id == EditingId && s.CatalogItemId == Form.CatalogItemId)) { Error = "خدمت کاتالوگ انتخاب‌شده فعال نیست."; return; }
        if (SelectedResourceIds.Count == 0) { Error = T("حداقل یک کارمند ارائه‌دهنده را انتخاب کنید.", "اختر موظفًا واحدًا على الأقل لتقديم الخدمة.", "Select at least one service provider."); return; }
        if (Form.Source == CatalogSource && Form.CatalogItemId is Guid catalogId && await Db.Services.IgnoreQueryFilters().AnyAsync(x => x.BusinessId == Form.BusinessId && x.CatalogItemId == catalogId && x.Id != EditingId)) { Error = T("این خدمت کاتالوگ قبلاً برای این کسب‌وکار ثبت شده است؛ خدمت موجود را ویرایش کنید.", "تمت إضافة خدمة الكتالوج هذه مسبقًا لهذا النشاط؛ عدّل الخدمة الحالية.", "This catalog service already exists for this business; edit the existing service instead."); return; }
        var validResourceIds = await Db.Resources.Where(r => r.BranchId == branch.Id && r.Kind == "staff" && SelectedResourceIds.Contains(r.Id)).Select(r => r.Id).ToListAsync();
        if (SelectedResourceIds.Any(id => !validResourceIds.Contains(id))) { Error = T("یک یا چند کارمند انتخاب‌شده متعلق به این شعبه نیستند؛ کارکنان را دوباره انتخاب کنید.", "موظف واحد أو أكثر لا ينتمي إلى هذا الفرع؛ أعد اختيار الموظفين.", "One or more selected providers do not belong to this branch; select the providers again."); return; }
        var service = EditingId is null ? new Service { Name = Form.Name } : await Db.Services.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.Id == EditingId);
        if (service is null) { Error = "خدمت پیدا نشد."; return; }
        if (EditingId is not null)
        {
            await Db.Entry(service).ReloadAsync();
            if (service.BusinessId != Form.BusinessId) { Error = "کسب‌وکار خدمت را نمی‌توان تغییر داد."; return; }
        }
        if (EditingId is not null && service.Price != Form.Price)
        {
            // قیمت پایه عوض می‌شود؛ شعبه‌های دیگر که قیمت اختصاصی ندارند نباید ناخواسته تغییر کنند.
            foreach (var other in await Db.BranchServices.Where(x => x.ServiceId == service.Id && x.BranchId != branch.Id && x.Price == null).ToListAsync())
                other.Price = service.Price;
        }
        service.BusinessId = Form.BusinessId; service.CatalogItemId = Form.Source == "catalog" ? Form.CatalogItemId : null; service.Name = Form.Name.Trim(); service.Description = Form.Description.Trim(); service.DurationMinutes = Form.DurationMinutes; service.Price = Form.Price;
        if (EditingId is null) Db.Services.Add(service);
        service.UpdatedAt = DateTimeOffset.UtcNow;
        // فقط اتصال‌های همین شعبه تغییر می‌کند؛ اتصال خدمت به شعبه‌های دیگر دست‌نخورده می‌ماند.
        var assignment = await Db.BranchServices.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.ServiceId == service.Id && x.BranchId == branch.Id);
        if (assignment is null) Db.BranchServices.Add(new BranchService { BranchId = branch.Id, ServiceId = service.Id, Price = null });
        else { assignment.DeletedAt = null; assignment.Price = Form.Price; assignment.UpdatedAt = DateTimeOffset.UtcNow; }
        var branchResourceIds = (await Db.Resources.IgnoreQueryFilters().Where(r => r.BranchId == branch.Id).Select(r => r.Id).ToListAsync()).ToHashSet();
        var currentLinks = await Db.ServiceResources.IgnoreQueryFilters().Where(x => x.ServiceId == service.Id && branchResourceIds.Contains(x.ResourceId)).ToListAsync();
        Db.ServiceResources.RemoveRange(currentLinks.Where(x => !SelectedResourceIds.Contains(x.ResourceId)));
        foreach (var link in currentLinks.Where(x => SelectedResourceIds.Contains(x.ResourceId))) { link.DeletedAt = null; link.UpdatedAt = DateTimeOffset.UtcNow; }
        var linked = currentLinks.Select(x => x.ResourceId).ToHashSet();
        Db.ServiceResources.AddRange(SelectedResourceIds.Where(id => !linked.Contains(id)).Select(id => new ServiceResource { ServiceId = service.Id, ResourceId = id }));
        await Db.SaveChangesAsync(); Close(); await Load();
    }
    private async Task ToggleActive(Service service)
    {
        if (!await Access.CanManageServiceAsync(service.Id)) { Error = "اجازه‌ی تغییر وضعیت این خدمت را ندارید."; return; }
        var item = await Db.Services.IgnoreQueryFilters().FirstOrDefaultAsync(x => x.Id == service.Id);
        if (item is null) return;
        await Db.Entry(item).ReloadAsync();
        item.DeletedAt = service.DeletedAt is null ? item.DeletedAt ?? DateTimeOffset.UtcNow : null;
        item.UpdatedAt = DateTimeOffset.UtcNow;
        await Db.SaveChangesAsync();
        await Load();
    }
    private void Close() { ShowForm = false; Error = null; }
    private string T(string fa, string ar, string en) => LocalizedDate.Choose(Language, fa, ar, en);
    private sealed class ServiceInput { public Guid BusinessId { get; set; } public Guid BranchId { get; set; } public Guid? CatalogItemId { get; set; } public string Source { get; set; } = "catalog"; public string Name { get; set; } = ""; public string Description { get; set; } = ""; public int DurationMinutes { get; set; } = 30; public decimal Price { get; set; } }
}
