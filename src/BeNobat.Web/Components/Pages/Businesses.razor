@page "/businesses"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ManageBusiness)]
@inject AppDbContext Db
@inject AdminAccessScope Access

<PageTitle>خدمات | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>خدمات شعب</h1><p>هر خدمت را به شعبه و کارکنان ارائه‌دهنده متصل کنید.</p></div><button type="button" @onclick="OpenNew">+ افزودن خدمت</button></div>

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="service-form" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation>
            <div><h2>@(EditingId is null ? "خدمت جدید" : "تنظیم خدمت")</h2><button type="button" @onclick="Close">×</button></div>
            <label>کسب‌وکار<select @bind="Form.BusinessId" @bind:after="BusinessChanged">@foreach (var business in BusinessOptions) { <option value="@business.Id">@business.Name</option> }</select></label>
            <label>نام خدمت<input required @bind="Form.Name" /></label>
            <div class="form-columns"><label>مدت (دقیقه)<input type="number" min="5" @bind="Form.DurationMinutes" /></label><label>قیمت پایه (تومان)<input type="number" min="0" @bind="Form.Price" /></label></div>
            <label>شعبه<select @bind="Form.BranchId" @bind:after="BranchChanged">@foreach (var branch in FormBranches) { <option value="@branch.Id">@branch.Name</option> }</select></label>
            <label>قیمت در این شعبه (اختیاری)<input type="number" min="0" @bind="Form.BranchPrice" /></label>
            <fieldset><legend>کارکنان ارائه‌دهنده</legend>
                @if (!FormResources.Any()) { <small>ابتدا در صفحه شعب، منبع «عضو تیم» تعریف کنید.</small> }
                @foreach (var resource in FormResources) { <label class="check-label"><input type="checkbox" checked="@SelectedResourceIds.Contains(resource.Id)" @onchange="() => ToggleResource(resource.Id)" /><span>@resource.Name</span></label> }
            </fieldset>
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره خدمت و تخصیص‌ها</button>
        </EditForm>
    </div>
}

<article class="admin-panel">
    <div class="toolbar"><input placeholder="جست‌وجو بین خدمات..." @bind="Search" @bind:event="oninput" /><span>@Filtered.Count() خدمت</span></div>
    <div class="service-table">
        <div class="table-head"><span>خدمت</span><span>شعب</span><span>ارائه‌دهندگان</span><span>وضعیت</span><span></span></div>
        @foreach (var service in Filtered)
        {
            <div><span><i class="rose">✂</i><b>@service.Name<small>@service.Business.Name · @service.DurationMinutes دقیقه · @service.Price.ToString("N0") تومان</small></b></span><span>@BranchNames(service)</span><span>@ProviderNames(service)</span><span><em class="status @(service.DeletedAt is null ? "confirmed" : "cancelled")">@(service.DeletedAt is null ? "فعال" : "غیرفعال")</em></span><span class="inline-actions"><button @onclick="() => Edit(service)">تنظیم</button><button @onclick="() => ToggleActive(service)">@(service.DeletedAt is null ? "غیرفعال" : "فعال")</button></span></div>
        }
    </div>
</article>

@code {
    private List<Business> BusinessOptions = [];
    private List<Branch> Branches = [];
    private List<Service> Services = [];
    private List<Resource> Resources = [];
    private string Search = "";
    private bool ShowForm;
    private Guid? EditingId;
    private ServiceInput Form = new();
    private HashSet<Guid> SelectedResourceIds = [];
    private string? Error;
    private IEnumerable<Service> Filtered => Services.Where(x => x.Name.Contains(Search, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<Branch> FormBranches => Branches.Where(x => x.BusinessId == Form.BusinessId);
    private IEnumerable<Resource> FormResources => Resources.Where(x => x.BranchId == Form.BranchId && x.Kind == "staff");

    protected override async Task OnInitializedAsync()
    {
        var query = await Access.BranchesAsync();
        Branches = await query.OrderBy(x => x.Name).ToListAsync();
        var ids = Branches.Select(x => x.BusinessId).Distinct().ToList();
        BusinessOptions = await Db.Businesses.Where(x => ids.Contains(x.Id)).OrderBy(x => x.Name).ToListAsync();
        Resources = await Db.Resources.Where(x => Branches.Select(b => b.Id).Contains(x.BranchId)).OrderBy(x => x.Name).ToListAsync();
        await Load();
    }
    private async Task Load() { var ids = BusinessOptions.Select(x => x.Id).ToList(); Services = await Db.Services.IgnoreQueryFilters().Where(x => ids.Contains(x.BusinessId)).Include(x => x.Business).Include(x => x.BranchServices).ThenInclude(x => x.Branch).Include(x => x.ServiceResources).ThenInclude(x => x.Resource).OrderBy(x => x.Business.Name).ThenBy(x => x.Name).ToListAsync(); }
    private static string BranchNames(Service service) { var names = service.BranchServices.Select(x => x.Branch.Name).Distinct().ToList(); return names.Count == 0 ? "بدون شعبه" : string.Join("، ", names); }
    private static string ProviderNames(Service service) { var names = service.ServiceResources.Select(x => x.Resource.Name).Distinct().ToList(); return names.Count == 0 ? "بدون ارائه‌دهنده" : string.Join("، ", names); }
    private void OpenNew() { EditingId = null; var businessId = BusinessOptions.FirstOrDefault()?.Id ?? Guid.Empty; Form = new() { BusinessId = businessId, BranchId = Branches.FirstOrDefault(x => x.BusinessId == businessId)?.Id ?? Guid.Empty }; SelectedResourceIds = []; Error = null; ShowForm = true; }
    private void Edit(Service service) { EditingId = service.Id; var assignment = service.BranchServices.FirstOrDefault(); Form = new() { BusinessId = service.BusinessId, Name = service.Name, DurationMinutes = service.DurationMinutes, Price = service.Price, BranchId = assignment?.BranchId ?? Branches.FirstOrDefault(x => x.BusinessId == service.BusinessId)?.Id ?? Guid.Empty, BranchPrice = assignment?.Price }; SelectedResourceIds = service.ServiceResources.Select(x => x.ResourceId).ToHashSet(); Error = null; ShowForm = true; }
    private Task BusinessChanged() { Form.BranchId = FormBranches.FirstOrDefault()?.Id ?? Guid.Empty; SelectedResourceIds.Clear(); return Task.CompletedTask; }
    private Task BranchChanged() { SelectedResourceIds.RemoveWhere(x => FormResources.All(r => r.Id != x)); return Task.CompletedTask; }
    private void ToggleResource(Guid id) { if (!SelectedResourceIds.Add(id)) SelectedResourceIds.Remove(id); }
    private async Task Save()
    {
        var branch = Branches.FirstOrDefault(x => x.Id == Form.BranchId && x.BusinessId == Form.BusinessId);
        if (branch is null || string.IsNullOrWhiteSpace(Form.Name) || Form.DurationMinutes <= 0 || SelectedResourceIds.Count == 0) { Error = "نام، شعبه، مدت معتبر و حداقل یک کارمند ارائه‌دهنده الزامی است."; return; }
        if (SelectedResourceIds.Any(id => Resources.All(x => x.Id != id || x.BranchId != branch.Id))) { Error = "کارمند باید متعلق به همان شعبه باشد."; return; }
        var service = EditingId is null ? new Service { Name = Form.Name } : await Db.Services.IgnoreQueryFilters().FirstAsync(x => x.Id == EditingId);
        service.BusinessId = Form.BusinessId; service.Name = Form.Name.Trim(); service.DurationMinutes = Form.DurationMinutes; service.Price = Form.Price;
        if (EditingId is null) Db.Services.Add(service);
        await Db.SaveChangesAsync();
        var oldBranch = await Db.BranchServices.Where(x => x.ServiceId == service.Id).ToListAsync(); Db.BranchServices.RemoveRange(oldBranch);
        Db.BranchServices.Add(new BranchService { BranchId = branch.Id, ServiceId = service.Id, Price = Form.BranchPrice });
        var oldResources = await Db.ServiceResources.Where(x => x.ServiceId == service.Id).ToListAsync(); Db.ServiceResources.RemoveRange(oldResources);
        Db.ServiceResources.AddRange(SelectedResourceIds.Select(id => new ServiceResource { ServiceId = service.Id, ResourceId = id }));
        await Db.SaveChangesAsync(); Close(); await Load();
    }
    private async Task ToggleActive(Service service) { var item = await Db.Services.IgnoreQueryFilters().FirstAsync(x => x.Id == service.Id); item.DeletedAt = item.DeletedAt is null ? DateTimeOffset.UtcNow : null; await Db.SaveChangesAsync(); await Load(); }
    private void Close() { ShowForm = false; Error = null; }
    private sealed class ServiceInput { public Guid BusinessId { get; set; } public Guid BranchId { get; set; } public string Name { get; set; } = ""; public int DurationMinutes { get; set; } = 30; public decimal Price { get; set; } public decimal? BranchPrice { get; set; } }
}
