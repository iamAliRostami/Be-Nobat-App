@page "/book/{Business}"
@layout Layout.PublicLayout
@rendermode InteractiveServer

<PageTitle>رزرو نوبت | به‌نوبت</PageTitle>

<div class="booking-page">
    <a class="back-link" href="/">→ بازگشت به نتایج</a>
    <div class="booking-head">
        <div class="booking-logo">✦</div><div><h1>@Business</h1><p><span>★ ۴.۹</span> (۲۳۸ نظر) · ونک، تهران</p></div>
    </div>
    <div class="booking-progress">
        <div class="done"><b>✓</b><span>انتخاب خدمت</span></div><i></i>
        <div class="@(Step >= 2 ? "done" : "active")"><b>@(Step > 1 ? "✓" : "۲")</b><span>انتخاب زمان</span></div><i></i>
        <div class="@(Step >= 3 ? "active" : "")"><b>۳</b><span>تأیید نهایی</span></div>
    </div>

    @if (Step == 1)
    {
        <div class="booking-layout">
            <section class="booking-panel"><div class="booking-title"><span>۱</span><div><h2>خدمت موردنظر را انتخاب کنید</h2><p>می‌توانید یک خدمت را برای این نوبت انتخاب کنید.</p></div></div>
                <div class="service-list">
                    @foreach (var service in Services)
                    {
                        <button class="service-option @(SelectedService == service.Name ? "selected" : "")" @onclick="() => SelectedService = service.Name">
                            <i>@service.Icon</i><span><strong>@service.Name</strong><small>@service.Description</small><em>◷ @service.Duration دقیقه</em></span><b>@service.Price هزار تومان</b><u>✓</u>
                        </button>
                    }
                </div>
            </section>
            <BookingSummary OnContinue="Next" Service="SelectedService" />
        </div>
    }
    else if (Step == 2)
    {
        <div class="booking-layout">
            <section class="booking-panel"><div class="booking-title"><span>۲</span><div><h2>روز و ساعت را انتخاب کنید</h2><p>همه ساعت‌ها بر اساس منطقه زمانی تهران است.</p></div></div>
                <div class="date-strip">@foreach (var day in Days){<button class="@(SelectedDay == day.Day ? "selected" : "")" @onclick="() => SelectedDay = day.Day"><small>@day.Weekday</small><b>@day.Day</b><span>شهریور</span></button>}</div>
                <h3 class="time-title">زمان‌های خالی <small>۱۲ زمان موجود</small></h3>
                <div class="time-grid">@foreach(var time in Times){<button class="@(SelectedTime == time ? "selected" : "")" @onclick="() => SelectedTime = time">@time</button>}</div>
            </section>
            <BookingSummary OnContinue="Next" Service="SelectedService" Time="@(SelectedTime is null ? null : $"{SelectedDay} شهریور، ساعت {SelectedTime}")" />
        </div>
    }
    else
    {
        <section class="success-card"><div class="success-icon">✓</div><span>نوبت شما ثبت شد</span><h1>منتظرت هستیم!</h1><p>جزئیات نوبت برای شماره همراه شما پیامک شد.</p><div class="success-details"><div><small>خدمت</small><b>@SelectedService</b></div><div><small>زمان</small><b>@SelectedDay شهریور، ساعت @SelectedTime</b></div><div><small>محل</small><b>ونک، خیابان ملاصدرا</b></div></div><a href="/appointments">مشاهده نوبت‌های من</a><a class="secondary-link" href="/">بازگشت به صفحه اصلی</a></section>
    }
</div>

@code {
    [Parameter] public string Business { get; set; } = "مرکز خدماتی";
    private int Step { get; set; } = 1;
    private string SelectedService { get; set; } = "کوتاهی و استایل مو";
    private int SelectedDay { get; set; } = 19;
    private string? SelectedTime { get; set; }
    private readonly (string Name, string Description, int Duration, int Price, string Icon)[] Services = [
        ("کوتاهی و استایل مو", "شستشو، کوتاهی و براشینگ", 60, 480, "✂"),
        ("رنگ و لایت", "مشاوره رنگ، رنگ و مراقبت", 120, 950, "✦"),
        ("اصلاح و ابرو", "اصلاح صورت و طراحی ابرو", 30, 280, "♧")];
    private readonly (string Weekday, int Day)[] Days = [("امروز",19), ("شنبه",20), ("یکشنبه",21), ("دوشنبه",22), ("سه‌شنبه",23)];
    private readonly string[] Times = ["۱۰:۰۰", "۱۰:۳۰", "۱۱:۳۰", "۱۲:۰۰", "۱۴:۳۰", "۱۵:۰۰", "۱۶:۳۰", "۱۷:۰۰", "۱۸:۳۰"];
    private void Next() { if (Step == 1 || SelectedTime is not null) Step++; }
}

