@page "/book/{BusinessId:guid}"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@using System.Globalization
@using BeNobat.Web.Application
@inject AppointmentBookingService BookingService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<Booking> Logger

<PageTitle>رزرو نوبت | به‌نوبت</PageTitle>

@if (IsLoading)
{
    <div class="booking-page"><p class="empty-state">در حال دریافت اطلاعات…</p></div>
}
else if (Business is null)
{
    <div class="booking-page"><p class="empty-state">این کسب‌وکار پیدا نشد یا دیگر فعال نیست.</p><p class="auth-switch"><a href="/">بازگشت به صفحه‌ی اصلی</a></p></div>
}
else if (Branches.Count == 0)
{
    <div class="booking-page"><p class="empty-state">برای «@Business.Name» هنوز شعبه‌ی قابل رزروی تعریف نشده است.</p><p class="auth-switch"><a href="@SafeReturnUrl">بازگشت</a></p></div>
}
else
{
    <div class="booking-page">
        @if (Step == 3) { <button type="button" class="booking-back-button" disabled="@IsBooking" @onclick="BackToStep2">→ بازگشت به انتخاب زمان</button> }
        else if (Step == 2) { <button type="button" class="booking-back-button" disabled="@IsBooking" @onclick="BackToStep1">→ بازگشت به انتخاب خدمات</button> }
        else if (Step == 1) { <a class="booking-back-button" href="@SafeReturnUrl">→ بازگشت</a> }
        <div class="booking-head"><div class="booking-logo">✦</div><div><h1 data-i18n-skip>@Business.Name</h1><p data-i18n-skip>@(SelectedBranch?.Address ?? Business.City)</p></div></div>
        <div class="booking-progress">
            <div class="@(Step > 1 ? "done" : "active")"><b>@(Step > 1 ? "✓" : "۱")</b><span>خدمات</span></div><i></i>
            <div class="@(Step > 2 ? "done" : Step == 2 ? "active" : "")"><b>@(Step > 2 ? "✓" : "۲")</b><span>کارمند و زمان</span></div><i></i>
            <div class="@(Step > 3 ? "done" : Step == 3 ? "active" : "")"><b>@(Step > 3 ? "✓" : "۳")</b><span>تأیید نهایی</span></div>
        </div>
        @if (ErrorMessage is not null) { <div class="auth-error" role="alert">@ErrorMessage</div> }

        @if (Step == 1)
        {
            <div class="booking-layout">
                <section class="booking-panel">
                    <div class="booking-title"><span>۱</span><div><h2>خدمات موردنظر را انتخاب کنید</h2><p>یک یا چند خدمت را می‌توانید در یک نوبت رزرو کنید.</p></div></div>
                    @if (Branches.Count > 1)
                    {
                        <div class="booking-filters"><label>شعبه<select @bind="SelectedBranchId" @bind:after="BranchChanged">@foreach (var branch in Branches) { <option value="@branch.Id" data-i18n-skip>@branch.Name</option> }</select></label></div>
                    }
                    @if (Services.Count == 0) { <p class="empty-state">در این شعبه هنوز خدمتی برای رزرو آنلاین فعال نشده است.@(Branches.Count > 1 ? " شعبه‌ی دیگری را انتخاب کنید." : "")</p> }
                    <div class="service-list">
                        @foreach (var service in Services)
                        {
                            <button type="button" aria-pressed="@(SelectedServiceIds.Contains(service.Id) ? "true" : "false")" class="service-option @(SelectedServiceIds.Contains(service.Id) ? "selected" : "")" @onclick="() => ToggleService(service.Id)">
                                <i>✂</i><span><strong data-i18n-skip>@service.Name</strong><small data-i18n-skip>@service.Description</small><em>◷ @service.DurationMinutes دقیقه</em></span><b>@ServicePrice(service).ToString("N0") تومان</b><u>✓</u>
                            </button>
                        }
                    </div>
                </section>
                <BookingSummary OnContinue="NextFromStep1" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Language="@Language" />
            </div>
        }
        else if (Step == 2)
        {
            <div class="booking-layout">
                <section class="booking-panel">
                    <div class="booking-title"><span>۲</span><div><h2>کارمند، روز و ساعت را انتخاب کنید</h2><p>فقط کارکنانی نمایش داده می‌شوند که همه خدمات انتخابی را ارائه می‌کنند.</p></div></div>
                    <div class="booking-filters provider-filter">
                        <label>ارائه‌دهنده خدمت<select @bind="ProviderChoice" @bind:after="ResourceChanged"><option value="">— انتخاب کارمند —</option>@if (EligibleResources.Count > 1) { <option value="any">هر کارمندی که زودتر آزاد است</option> }@foreach (var resource in EligibleResources) { <option value="@resource.Id" data-i18n-skip>@resource.Name</option> }</select></label>
                    </div>
                    @if (EligibleResources.Count == 0) { <p class="empty-state">برای ترکیب خدمات انتخابی، کارمند فعالی در این شعبه تعریف نشده است. خدمات را کمتر کنید یا شعبه‌ی دیگری را انتخاب کنید.</p> }
                    <details class="booking-calendar" open>
                        <summary>@LocalizedDate.Choose(Language, "انتخاب تاریخ", "اختيار التاريخ", "Choose a date")<i>⌄</i></summary>
                        <div class="booking-date-navigation">
                            <div class="booking-date-goto">
                                <span class="booking-date-label">@LocalizedDate.Choose(Language, "رفتن به تاریخ", "الانتقال إلى تاريخ", "Go to date")</span>
                                <CalendarPicker Value="SelectedDate" Min="Today" Today="Today" Language="@Language" ValueChanged="SelectDate" />
                            </div>
                        </div>
                        <div class="date-strip-wrap">
                            <button type="button" class="cal-nav prev" disabled="@(!CanGoPrev)" aria-label="@LocalizedDate.Choose(Language, "هفته قبل", "الأسبوع السابق", "Previous week")" @onclick="() => ShiftWindow(-1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
                            <div class="date-strip">@foreach (var day in Days) { <button type="button" disabled="@(IsLoadingSlots || day.Date > MaxDate)" class="@(SelectedDate == day.Date ? "selected" : "")" @onclick="() => SelectDate(day.Date)"><small>@day.Weekday</small><b>@day.DayNumber</b><span>@day.Month</span></button> }</div>
                            <button type="button" class="cal-nav next" disabled="@(!CanGoNext)" aria-label="@LocalizedDate.Choose(Language, "هفته بعد", "الأسبوع التالي", "Next week")" @onclick="() => ShiftWindow(1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
                        </div>
                    </details>
                    <h3 class="time-title">زمان‌های خالی <small>@Slots.Count زمان موجود</small></h3>
                    @if (ProviderChoice.Length == 0) { <p class="empty-state">ابتدا کارمند ارائه‌دهنده را انتخاب کنید.</p> }
                    else if (IsLoadingSlots) { <p class="empty-state">در حال بررسی زمان‌های خالی…</p> }
                    else if (Slots.Count == 0) { <p class="empty-state">برای این روز زمان خالی وجود ندارد. روز دیگری را انتخاب کنید@(NextAvailableDate is DateOnly next ? $" — نزدیک‌ترین روز خالی: {LocalizedDate.Format(next, Language)}" : "").@if (NextAvailableDate is DateOnly jump) { <button type="button" class="link-button" @onclick="() => SelectDate(jump)">برو به آن روز</button> }</p> }
                    else
                    {
                        <div class="time-grid">@foreach (var slot in Slots) { <button type="button" class="@(SelectedSlot == slot ? "selected" : "") @(IsFlexibleSlot(slot) ? "flex-slot" : "")" aria-pressed="@(SelectedSlot == slot ? "true" : "false")" title="@(IsFlexibleSlot(slot) ? "نیازمند هماهنگی با شعبه" : "")" @onclick="() => PickSlot(slot)">@BranchClock.FormatTime(slot, SelectedBranch?.TimeZoneId, Language)@(IsFlexibleSlot(slot) ? " ◔" : "")</button> }</div>
                        @if (Slots.Any(IsFlexibleSlot))
                        {
                            <p class="booking-login-hint">زمان‌های دارای «◔» کمی کوتاه‌تر از مدت خدمت شما هستند (حداکثر @BookingPolicy.OverrunToleranceMinutes دقیقه). با انتخاب آن‌ها درخواست شما به شعبه می‌رسد و شعبه زمان نهایی را تأیید می‌کند.</p>
                        }
                    }
                </section>
                <BookingSummary OnContinue="NextFromStep2" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Time="@(SelectedSlot is null ? null : FormatSelectedTime())" Language="@Language" />
            </div>
        }
        else if (Step == 3)
        {
            <div class="booking-layout">
                <section class="booking-panel booking-confirmation">
                    <div class="booking-title"><span>۳</span><div><h2>بررسی و تأیید نهایی</h2><p>پیش از ثبت نوبت، مشخصات و قوانین رزرو را بررسی کنید.</p></div></div>
                    <div class="confirmation-business"><i>✦</i><div><h3 data-i18n-skip>@Business.Name</h3><b data-i18n-skip>@SelectedBranch?.Name</b><small data-i18n-skip>@SelectedBranch?.Address</small></div></div>
                    <div class="confirmation-details">
                        <article class="confirmation-primary"><small>خدمت انتخابی</small><strong data-i18n-skip>@SelectedServicesLabel</strong><span>@SelectedDuration دقیقه</span></article>
                        <article><small>متخصص شما</small><strong data-i18n-skip>@(ResourceForSelectedSlot?.Name ?? "—")</strong></article>
                        <article><small>زمان مراجعه</small><strong>@FormatSelectedTime()</strong></article>
                        <article class="confirmation-price"><small>مبلغ قابل پرداخت</small><strong>@SelectedPrice?.ToString("N0") <span>تومان</span></strong></article>
                    </div>
                    @if (IsAuthenticated)
                    {
                        <label class="booking-note">شماره موبایل شما (برای هماهنگی مجموعه)
                            <input class="booking-field" type="tel" disabled="@IsBooking" inputmode="tel" autocomplete="tel-national" dir="ltr" maxlength="14" required placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" @bind:get="PhoneInput" @bind:set="UpdatePhoneInput" @bind:event="oninput" />
                        </label>
                        <small class="appointment-hint">@(string.IsNullOrWhiteSpace(ExistingPhone) ? "شماره‌ای در حساب شما ثبت نشده است؛ با ثبت نوبت در حسابتان ذخیره می‌شود." : "شماره‌ی ثبت‌شده در حساب شما به‌صورت پیش‌فرض آمده است؛ در صورت نیاز می‌توانید آن را تغییر دهید.")</small>
                    }
                    <label class="booking-note">توضیح برای مجموعه (اختیاری)
                        <textarea class="booking-field" rows="3" disabled="@IsBooking" maxlength="500" placeholder="هر نکته‌ای که مجموعه باید بداند…" @bind="CustomerNote" @bind:event="oninput"></textarea>
                    </label>
                    @if (SelectedSlot is DateTimeOffset chosenSlot && IsFlexibleSlot(chosenSlot))
                    {
                        <p class="booking-login-hint">این زمان کمی کوتاه‌تر از مدت خدمت شماست؛ شعبه درخواست را بررسی می‌کند و در صورت نیاز چند دقیقه زمان را جابه‌جا می‌کند. نتیجه در «نوبت‌های من» نمایش داده می‌شود.</p>
                    }
                    else
                    {
                    <p class="booking-login-hint">@(Business.RequiresApproval ? "نوبت شما پس از تأیید مجموعه قطعی می‌شود و نتیجه در «نوبت‌های من» نمایش داده می‌شود." : "نوبت شما بلافاصله پس از ثبت قطعی می‌شود.")</p>
                    }
                    @if (!IsAuthenticated)
                    {
                        <p class="booking-login-hint">برای ثبت نوبت باید وارد حساب خود شوید یا ثبت‌نام کنید؛ انتخاب‌های شما حفظ می‌شود و بعد از ورود به همین مرحله برمی‌گردید.</p>
                    }
                </section>
                <BookingSummary OnContinue="ConfirmBookingAsync" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Time="@FormatSelectedTime()" Language="@Language" RequireTerms="true" TermsAccepted="@TermsAccepted" OnShowTerms="OpenTerms" Disabled="@(!TermsAccepted || IsBooking)" DisabledReason="برای ثبت نوبت، قوانین رزرو را مطالعه و تأیید کنید." />
            </div>
        }
        else
        {
            <section class="success-card"><div class="success-icon">✓</div><span>@(CreatedStatus == AppointmentStatus.Confirmed ? "نوبت شما ثبت و تأیید شد" : "درخواست نوبت شما ثبت شد")</span><h1>@(CreatedStatus == AppointmentStatus.Confirmed ? "منتظرت هستیم!" : "منتظر تأیید مجموعه باشید")</h1><p>@(CreatedStatus == AppointmentStatus.Confirmed ? "جزئیات نوبت در «نوبت‌های من» قابل مشاهده است." : CreatedOverrun > 0 ? "این زمان کمی کوتاه‌تر از مدت خدمت شماست؛ شعبه زمان نهایی را تأیید می‌کند و ممکن است چند دقیقه آن را جابه‌جا کند. نتیجه در «نوبت‌های من» نمایش داده می‌شود." : "به‌محض تأیید مجموعه، وضعیت نوبت در «نوبت‌های من» به «تأیید شده» تغییر می‌کند.")</p><div class="success-details"><div><small>شماره پیگیری</small><b>@TrackingCode</b></div><div><small>خدمات</small><b data-i18n-skip>@SelectedServicesLabel</b></div><div><small>متخصص</small><b data-i18n-skip>@(ResourceForSelectedSlot?.Name ?? "—")</b></div><div><small>زمان</small><b>@FormatSelectedTime()</b></div></div><a href="/appointments">مشاهده نوبت‌های من</a></section>
        }
    </div>
}

@if (ShowTerms)
{
    <div class="modal-backdrop" @onclick="CloseTerms">
        <section class="form-modal booking-rules-modal" @onclick:stopPropagation>
            <div><h2>قوانین رزرو نوبت</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="CloseTerms">×</button></div>
            <ol>
                <li>برای حضور به‌موقع، حداقل ۱۰ دقیقه پیش از شروع نوبت در شعبه حاضر باشید.</li>
                <li>لغو اینترنتی فقط تا دو ساعت پیش از شروع نوبت امکان‌پذیر است.</li>
                <li>در صورت تأخیر، مدت خدمت ممکن است کوتاه شود یا نوبت با هماهنگی شعبه جابه‌جا شود.</li>
                <li>مبلغ نمایش‌داده‌شده بر اساس خدمات انتخابی است و خدمات اضافه با تأیید شما محاسبه می‌شود.</li>
            </ol>
            <button type="button" class="primary-button" @onclick="AcceptTerms">قوانین را خواندم و تأیید می‌کنم</button>
        </section>
    </div>
}

@code {
    [Parameter] public Guid BusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    // پیش‌انتخاب از صفحه‌های خدمت/شعبه/ارائه‌دهنده و بازگشت بعد از ورود:
    [SupplyParameterFromQuery(Name = "branch")] public Guid? QueryBranch { get; set; }
    [SupplyParameterFromQuery(Name = "service")] public Guid? QueryService { get; set; }
    [SupplyParameterFromQuery(Name = "services")] public string? QueryServices { get; set; }
    [SupplyParameterFromQuery(Name = "provider")] public string? QueryProvider { get; set; }
    [SupplyParameterFromQuery(Name = "slot")] public long? QuerySlot { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool IsLoading = true;
    private bool IsAuthenticated;
    private Guid? CurrentUserId;
    private string? CurrentSecurityStamp;
    private string? ExistingPhone;
    private string PhoneInput = "";
    private bool PhoneInputEdited;
    private string CustomerNote = "";

    private Business? Business;
    private List<Branch> Branches = [];
    private Guid SelectedBranchId;
    private Branch? SelectedBranch => Branches.FirstOrDefault(x => x.Id == SelectedBranchId);
    private List<Service> Services = [];
    private List<BranchService> BranchServices = [];
    private HashSet<Guid> SelectedServiceIds = [];
    private List<Resource> EligibleResources = [];

    // "" = انتخاب نشده، "any" = اولین کارمند آزاد، در غیر این صورت شناسه‌ی کارمند.
    private string ProviderChoice = "";
    private bool HasPendingProviderQuery = true;
    private Guid? SelectedResourceId => Guid.TryParse(ProviderChoice, out var id) ? id : null;
    private bool AnyProvider => ProviderChoice == "any";

    private int Step = 1;
    private DateOnly SelectedDate;
    private DateTimeOffset? SelectedSlot;
    private Dictionary<Guid, List<DateTimeOffset>> SlotsByResource = new();
    // زمان‌هایی که فقط با «تحمل زمانی» جا می‌شوند (کارمند ← زمان ← دقیقه‌ی اضافه).
    private Dictionary<Guid, Dictionary<DateTimeOffset, int>> FlexibleByResource = new();
    private List<DateTimeOffset> Slots = [];
    private DateOnly? NextAvailableDate;
    private string? ErrorMessage;
    private bool IsLoadingSlots;
    private int SlotsLoadVersion;
    private bool IsBooking;
    private bool ShowTerms;
    private bool TermsAccepted;
    private string? TrackingCode;
    private AppointmentStatus CreatedStatus = AppointmentStatus.Pending;
    private int CreatedOverrun;
    private Resource? BookedResource;
    private sealed record DayOption(DateOnly Date, string Weekday, string DayNumber, string Month);
    private const int WindowDays = 7;
    private string Language = "fa";
    private DateOnly WindowStart;
    private List<DayOption> Days = [];

    private string? ZoneId => SelectedBranch?.TimeZoneId;
    private DateOnly Today => BranchClock.Today(ZoneId);
    private DateOnly MaxDate => Today.AddDays(BookingPolicy.MaxAdvanceDays);
    private bool CanGoPrev => WindowStart > Today;
    private bool CanGoNext => WindowStart.AddDays(WindowDays) <= MaxDate;

    private IEnumerable<Service> SelectedServices => Services.Where(x => SelectedServiceIds.Contains(x.Id));
    private string SelectedServicesLabel => string.Join("، ", SelectedServices.Select(x => x.Name));
    private int? SelectedDuration => SelectedServiceIds.Count == 0 ? null : BookingPolicy.TotalDuration(SelectedServices);
    private decimal? SelectedPrice => SelectedServiceIds.Count == 0 ? null : SelectedServices.Sum(ServicePrice);
    private string SafeReturnUrl => SafeRedirect.Local(ReturnUrl, "/#businesses");

    // کارمندی که برای زمان انتخاب‌شده نمایش داده می‌شود (در حالت «هر کارمند» اولین کارمند آزاد).
    private Resource? ResourceForSelectedSlot
    {
        get
        {
            if (BookedResource is not null) return BookedResource;
            if (SelectedSlot is null) return null;
            return PickResource(SlotsByResource, SelectedSlot.Value);
        }
    }

    private string? LoadedParameters;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            CurrentUserId = UserContext.IdOf(user);
            CurrentSecurityStamp = user.FindFirst("AspNet.Identity.SecurityStamp")?.Value;
            IsAuthenticated = CurrentUserId is not null;
        }

        var parameters = $"{BusinessId}|{QueryBranch}|{QueryService}|{QueryServices}|{QueryProvider}|{QuerySlot}|{ReturnUrl}";
        if (LoadedParameters == parameters) return;
        LoadedParameters = parameters;
        IsLoading = true;
        SlotsLoadVersion++; IsLoadingSlots = false;
        Step = 1; SelectedSlot = null; BookedResource = null; TrackingCode = null;
        SelectedServiceIds = []; EligibleResources = []; ProviderChoice = ""; HasPendingProviderQuery = true;
        Slots = []; SlotsByResource = new(); FlexibleByResource = new(); ErrorMessage = null; TermsAccepted = false;
        PhoneInputEdited = false; PhoneInput = ""; ExistingPhone = null; CustomerNote = "";

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            Business = await db.Businesses.AsNoTracking().Include(x => x.Branches).FirstOrDefaultAsync(x => x.Id == BusinessId);
        }

        if (Business is null) { IsLoading = false; return; }
        Branches = Business.Branches.OrderBy(x => x.Name).ToList();
        SelectedBranchId = QueryBranch is Guid q && Branches.Any(x => x.Id == q) ? q : Branches.FirstOrDefault()?.Id ?? Guid.Empty;
        if (Branches.Count > 0)
        {
            SelectedDate = Today;
            WindowStart = SelectedDate;
            BuildDays();
            await LoadBranchServicesAsync();
            await TryRestoreSelectionAsync();
        }

        // شماره‌ی حساب از همان ابتدا خوانده می‌شود تا فیلد مرحله‌ی آخر (و بازگشت بعد از ورود) پر باشد.
        if (IsAuthenticated)
        {
            try { await RefreshContactPhoneAsync(); }
            catch (Exception exception) { Logger.LogWarning(exception, "Could not load the account phone number"); }
        }

        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Language = await JS.InvokeAsync<string>("beNobat.preferences.getLanguage");
            if (QuerySlot is not null && SelectedServiceIds.Count > 0)
            {
                var savedNote = await JS.InvokeAsync<string?>("sessionStorage.getItem", BookingNoteKey());
                if (savedNote is not null)
                {
                    CustomerNote = savedNote.Length > 500 ? savedNote[..500] : savedNote;
                    await JS.InvokeVoidAsync("sessionStorage.removeItem", BookingNoteKey());
                }
            }
        }
        catch (JSDisconnectedException) { return; }
        catch (JSException) { /* Browser storage is optional; booking remains available when it is disabled. */ }
        BuildDays();
        StateHasChanged();
    }

    private decimal ServicePrice(Service service) => BranchServices.FirstOrDefault(x => x.ServiceId == service.Id)?.Price ?? service.Price;

    private async Task LoadBranchServicesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        BranchServices = await db.BranchServices.AsNoTracking().Where(x => x.BranchId == SelectedBranchId).ToListAsync();
        var serviceIds = BranchServices.Select(x => x.ServiceId).ToList();
        // خدمت فقط بعد از تخصیص صریح به شعبه قابل رزرو است (خدمات غیرفعال با فیلتر سراسری حذف می‌شوند).
        Services = await db.Services.AsNoTracking().Where(x => x.BusinessId == BusinessId && serviceIds.Contains(x.Id)).OrderBy(x => x.Name).ToListAsync();
        SelectedServiceIds.RemoveWhere(id => Services.All(x => x.Id != id));
        await LoadEligibleResourcesAsync(db);
    }

    private async Task LoadEligibleResourcesAsync(AppDbContext? existing = null)
    {
        await using var owned = existing is null ? await DbFactory.CreateDbContextAsync() : null;
        var db = existing ?? owned!;
        if (SelectedServiceIds.Count == 0) { EligibleResources = []; ProviderChoice = ""; return; }
        var staff = await db.Resources.AsNoTracking().Where(x => x.BranchId == SelectedBranchId && x.Kind == "staff").OrderBy(x => x.Name).ToListAsync();
        var ids = SelectedServiceIds.ToList();
        var assignments = await db.ServiceResources.AsNoTracking().Where(x => ids.Contains(x.ServiceId)).ToListAsync();
        // عضویت در شعبه به‌تنهایی کارمند را صلاحیت‌دار نمی‌کند؛ باید برای همه‌ی خدمات انتخابی تخصیص داشته باشد.
        EligibleResources = staff.Where(r => ids.All(s => assignments.Any(a => a.ServiceId == s && a.ResourceId == r.Id))).ToList();
        ApplyEligibleProviderSelection();
    }

    private void ApplyEligibleProviderSelection()
    {
        if (SelectedResourceId is Guid chosen && EligibleResources.All(r => r.Id != chosen)) ProviderChoice = "";
        if (AnyProvider && EligibleResources.Count < 2) ProviderChoice = "";
        // لینک صفحه‌ی کارمند ممکن است هنوز خدمتی نداشته باشد؛ پیش‌انتخاب را تا مشخص شدن
        // صلاحیت کارکنان نگه می‌داریم و سپس فقط یک‌بار اعمال می‌کنیم.
        if (HasPendingProviderQuery)
        {
            HasPendingProviderQuery = false;
            if (QueryProvider == "any" && EligibleResources.Count > 1) ProviderChoice = "any";
            else if (Guid.TryParse(QueryProvider, out var provider) && EligibleResources.Any(r => r.Id == provider)) ProviderChoice = provider.ToString();
        }
        if (EligibleResources.Count == 1 && ProviderChoice.Length == 0) ProviderChoice = EligibleResources[0].Id.ToString();
    }

    // پیش‌انتخاب خدمت/ارائه‌دهنده از صفحه‌های عمومی و بازگرداندن مرحله‌ی تأیید بعد از ورود.
    private async Task TryRestoreSelectionAsync()
    {
        var ids = new HashSet<Guid>();
        if (QueryService is Guid single) ids.Add(single);
        foreach (var part in (QueryServices ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (Guid.TryParse(part, out var parsed)) ids.Add(parsed);
        }

        ids.IntersectWith(Services.Select(x => x.Id));
        if (ids.Count == 0) return;
        SelectedServiceIds = ids;
        await LoadEligibleResourcesAsync();

        if (QuerySlot is not long unix || ProviderChoice.Length == 0) return;
        DateTimeOffset slot;
        try { slot = DateTimeOffset.FromUnixTimeSeconds(unix); }
        catch (ArgumentOutOfRangeException) { return; }

        var date = BranchClock.LocalDate(slot, ZoneId);
        if (date < Today || date > MaxDate) return;
        SelectedDate = date;
        WindowStart = date;
        BuildDays();
        await LoadSlotsAsync();
        if (Slots.Contains(slot)) { await RefreshContactPhoneAsync(); SelectedSlot = slot; Step = 3; }
        else { Step = 2; ErrorMessage = "زمانی که انتخاب کرده بودید دیگر خالی نیست؛ لطفاً زمان دیگری را انتخاب کنید."; }
    }

    private async Task BranchChanged()
    {
        SlotsLoadVersion++; IsLoadingSlots = false;
        SelectedSlot = null; ProviderChoice = ""; HasPendingProviderQuery = false; TermsAccepted = false; EnsureDateNotPast();
        await LoadBranchServicesAsync();
    }

    private void ToggleService(Guid id)
    {
        if (!SelectedServiceIds.Add(id)) SelectedServiceIds.Remove(id);
        SelectedSlot = null; TermsAccepted = false; ErrorMessage = null;
    }

    private async Task NextFromStep1()
    {
        if (SelectedServiceIds.Count == 0) { ErrorMessage = "حداقل یک خدمت را انتخاب کنید."; return; }
        await LoadEligibleResourcesAsync();
        ErrorMessage = null; EnsureDateNotPast(); Step = 2;
        await LoadSlotsAsync();
    }

    private void BackToStep1() { SlotsLoadVersion++; IsLoadingSlots = false; ErrorMessage = null; SelectedSlot = null; Step = 1; }

    private async Task ResourceChanged() { HasPendingProviderQuery = false; SelectedSlot = null; TermsAccepted = false; ErrorMessage = null; await LoadSlotsAsync(); }

    private void PickSlot(DateTimeOffset slot) { SelectedSlot = slot; ErrorMessage = null; TermsAccepted = false; }

    private async Task SelectDate(DateOnly date)
    {
        if (IsLoadingSlots) return;
        if (date < Today) return;
        if (date > MaxDate) { ErrorMessage = $"رزرو فقط تا {BookingPolicy.MaxAdvanceDays} روز آینده امکان‌پذیر است."; return; }
        ErrorMessage = null;
        SelectedDate = date; SelectedSlot = null; TermsAccepted = false;
        // فقط وقتی تاریخ انتخاب‌شده (از تقویم کشویی) بیرون از هفته‌ی نمایش‌داده‌شده است، نوار روزها جابه‌جا می‌شود.
        if (date < WindowStart || date >= WindowStart.AddDays(WindowDays)) { WindowStart = date; BuildDays(); }
        await LoadSlotsAsync();
    }

    // دکمه‌های فلش: هر بار یک هفته، نه قبل از امروز و نه بعد از سقف رزرو.
    private void ShiftWindow(int direction)
    {
        var next = WindowStart.AddDays(direction * WindowDays);
        if (next < Today) next = Today;
        if (next > MaxDate) return;
        WindowStart = next;
        BuildDays();
    }

    private void EnsureDateNotPast()
    {
        var today = Today;
        if (SelectedDate < today) SelectedDate = today;
        if (SelectedDate > MaxDate) SelectedDate = MaxDate;
        if (WindowStart < today) WindowStart = today;
        if (WindowStart > MaxDate) WindowStart = MaxDate;
        BuildDays();
    }

    private void BuildDays()
    {
        var today = Today;
        Days = Enumerable.Range(0, WindowDays).Select(offset =>
        {
            var date = WindowStart.AddDays(offset);
            var parts = LocalizedDate.DayAndMonth(date, Language);
            return new DayOption(date, LocalizedDate.Weekday(date, Language, date == today), parts.Day, parts.Month);
        }).Where(x => x.Date <= MaxDate).ToList();
    }

    private async Task LoadSlotsAsync()
    {
        var version = ++SlotsLoadVersion;
        Slots = [];
        SlotsByResource = new();
        FlexibleByResource = new();
        NextAvailableDate = null;
        if (SelectedBranch is null || ProviderChoice.Length == 0 || SelectedDuration is null) return;
        var businessId = BusinessId;
        var branchId = SelectedBranchId;
        var serviceIds = SelectedServiceIds.ToArray();
        var resourceId = AnyProvider ? null : SelectedResourceId;
        var date = SelectedDate;
        IsLoadingSlots = true;
        ErrorMessage = null;
        try
        {
            var availability = await BookingService.GetAvailabilityAsync(businessId, branchId, serviceIds, resourceId, date);
            if (version != SlotsLoadVersion) return;
            if (!availability.Success)
            {
                ErrorMessage = BookingFailureMessage(availability.Failure!.Value);
                return;
            }
            foreach (var service in availability.Services)
            {
                var index = Services.FindIndex(x => x.Id == service.Id);
                if (index >= 0) Services[index] = service;
            }
            foreach (var assignment in availability.BranchServices)
            {
                BranchServices.RemoveAll(x => x.ServiceId == assignment.ServiceId);
                BranchServices.Add(assignment);
            }
            if (AnyProvider) EligibleResources = availability.Resources.ToList();
            SlotsByResource = availability.SlotsByResource.ToDictionary(x => x.Key, x => x.Value);
            FlexibleByResource = availability.FlexibleByResource.ToDictionary(x => x.Key, x => x.Value);
            Slots = SlotsByResource.Values.SelectMany(x => x)
                .Concat(FlexibleByResource.Values.SelectMany(x => x.Keys))
                .Distinct().OrderBy(x => x).ToList();
            if (SelectedSlot is DateTimeOffset kept && !Slots.Contains(kept)) SelectedSlot = null;
            if (Slots.Count == 0)
            {
                var next = await FindNextAvailableDateAsync(businessId, branchId, serviceIds, resourceId, date, version);
                if (version == SlotsLoadVersion) NextAvailableDate = next;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load booking slots for business {BusinessId}, branch {BranchId}, provider {Provider}, date {Date}",
                businessId, branchId, resourceId, date);
            if (version == SlotsLoadVersion)
                ErrorMessage = "دریافت زمان‌های خالی ممکن نشد. لطفاً تاریخ دیگری را انتخاب کنید یا به مرحله قبل بازگردید.";
        }
        finally { if (version == SlotsLoadVersion) IsLoadingSlots = false; }
    }

    // اگر روز انتخابی خالی بود، تا ۱۴ روز بعد را می‌گردد تا کاربر دست‌خالی نماند.
    private async Task<DateOnly?> FindNextAvailableDateAsync(Guid businessId, Guid branchId, Guid[] serviceIds,
        Guid? resourceId, DateOnly selectedDate, int version)
    {
        for (var offset = 1; offset <= 14; offset++)
        {
            if (version != SlotsLoadVersion) return null;
            var date = selectedDate.AddDays(offset);
            if (date > MaxDate) break;
            var availability = await BookingService.GetAvailabilityAsync(businessId, branchId, serviceIds, resourceId, date);
            if (!availability.Success) break;
            if (availability.SlotsByResource.Values.Any(x => x.Count > 0) || availability.FlexibleByResource.Values.Any(x => x.Count > 0)) return date;
        }
        return null;
    }

    // زمانی که فقط با تحمل زمانی جا می‌شود (هیچ کارمندی آن را کاملاً جا نمی‌دهد).
    private bool IsFlexibleSlot(DateTimeOffset slot) =>
        !SlotsByResource.Values.Any(list => list.Contains(slot)) && FlexibleByResource.Values.Any(map => map.ContainsKey(slot));

    // اولین کارمند (به ترتیب فهرست) که در آن زمان آزاد است؛ کارمندی که کاملاً جا دارد بر تحمل‌زمانی مقدم است.
    private Resource? PickResource(Dictionary<Guid, List<DateTimeOffset>> map, DateTimeOffset slot)
    {
        if (SelectedResourceId is Guid fixedId)
        {
            var fits = map.TryGetValue(fixedId, out var fixedSlots) && fixedSlots.Contains(slot)
                || FlexibleByResource.TryGetValue(fixedId, out var fixedFlex) && fixedFlex.ContainsKey(slot);
            return fits ? EligibleResources.FirstOrDefault(r => r.Id == fixedId) : null;
        }

        return EligibleResources.FirstOrDefault(r => map.TryGetValue(r.Id, out var list) && list.Contains(slot))
            ?? EligibleResources.FirstOrDefault(r => FlexibleByResource.TryGetValue(r.Id, out var flex) && flex.ContainsKey(slot));
    }

    private async Task NextFromStep2()
    {
        if (ProviderChoice.Length == 0) { ErrorMessage = "کارمند ارائه‌دهنده را انتخاب کنید."; return; }
        if (SelectedSlot is null) { ErrorMessage = "یک زمان را انتخاب کنید."; return; }
        await RefreshContactPhoneAsync();
        ErrorMessage = null; TermsAccepted = false; Step = 3;
    }

    private async Task RefreshContactPhoneAsync()
    {
        if (CurrentUserId is not Guid userId) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var savedPhone = await db.Users.AsNoTracking().Where(u => u.Id == userId).Select(u => u.PhoneNumber).FirstOrDefaultAsync();
        ApplyProfilePhone(savedPhone);
    }

    private void ApplyProfilePhone(string? savedPhone)
    {
        ExistingPhone = savedPhone;
        // شماره‌ی حساب ممکن است در تب دیگری تغییر کرده باشد؛ فقط تا پیش از ویرایش
        // این فیلد، تازه‌ترین مقدار حساب را به‌عنوان پیش‌فرض نمایش می‌دهیم.
        if (!PhoneInputEdited) PhoneInput = savedPhone ?? "";
    }

    private void UpdatePhoneInput(string? value)
    {
        PhoneInput = value ?? "";
        PhoneInputEdited = true;
    }

    private void BackToStep2() { ErrorMessage = null; TermsAccepted = false; Step = 2; }
    private void OpenTerms() => ShowTerms = true;
    private void CloseTerms() => ShowTerms = false;
    private void AcceptTerms() { TermsAccepted = true; ShowTerms = false; }

    // آدرس بازگشت بعد از ورود: همین رزرو با همه‌ی انتخاب‌ها.
    private string BookingRestoreUrl()
    {
        var url = $"/book/{BusinessId}?branch={SelectedBranchId}&services={string.Join(',', SelectedServiceIds)}&provider={ProviderChoice}";
        if (SelectedSlot is DateTimeOffset slot) url += $"&slot={slot.ToUnixTimeSeconds()}";
        return url + $"&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
    }

    private string BookingNoteKey() => $"beNobat.bookingNote:{BusinessId}:{SelectedBranchId}:{SelectedSlot?.ToUnixTimeSeconds() ?? QuerySlot}:{string.Join(',', SelectedServiceIds.OrderBy(x => x))}";

    private async Task ConfirmBookingAsync()
    {
        if (IsBooking) return;
        IsBooking = true;
        try
        {
            await ConfirmBookingCoreAsync();
        }
        catch (DbUpdateException ex) when (ex.InnerException is Npgsql.PostgresException { SqlState: "23P01" })
        {
            // قید دیتابیس: هم‌زمان کس دیگری همین زمان را گرفته است.
            ErrorMessage = "همین لحظه کس دیگری این زمان را رزرو کرد؛ لطفاً زمان دیگری را انتخاب کنید.";
            SelectedSlot = null; Step = 2;
            await LoadSlotsAsync();
        }
        catch (Exception ex)
        {
            var code = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
            Logger.LogError(ex, "Booking confirmation failed. Reference {BookingFailureCode}; business {BusinessId}; branch {BranchId}; provider {Provider}; slot {SelectedSlot}",
                code, BusinessId, SelectedBranchId, ProviderChoice, SelectedSlot);
            ErrorMessage = $"ثبت نوبت انجام نشد. دوباره تلاش کنید؛ در صورت تکرار، کد خطا {code} را به پشتیبانی اعلام کنید.";
        }
        finally
        {
            IsBooking = false;
        }
    }

    private async Task ConfirmBookingCoreAsync()
    {
        if (!TermsAccepted) { ErrorMessage = "برای ثبت نوبت ابتدا قوانین رزرو را مطالعه و تأیید کنید."; return; }
        if (SelectedSlot is null || SelectedBranch is null || SelectedDuration is null || Business is null) return;

        if (CurrentUserId is not Guid userId)
        {
            // مهمان: انتخاب‌ها در آدرس بازگشت حفظ می‌شود.
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", BookingNoteKey(), CustomerNote.Trim()); }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // A private note stays in this tab and is never placed in the login URL.
            }
            NavigationManager.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(BookingRestoreUrl())}", forceLoad: true);
            return;
        }

        if (!UserInputValidation.TryNormalizeIranianMobile(PhoneInput, out var normalized))
        {
            ErrorMessage = "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
            return;
        }
        if (ProviderChoice.Length == 0) { ErrorMessage = "کارمند ارائه‌دهنده را انتخاب کنید."; Step = 2; return; }
        if (CurrentSecurityStamp is null) { ErrorMessage = "نشست شما منقضی شده است؛ دوباره وارد حساب شوید."; return; }

        var note = CustomerNote.Trim();
        if (note.Length > 500) note = note[..500];
        var result = await BookingService.BookAsync(userId, new AppointmentBookingRequest(
            BusinessId, SelectedBranchId, SelectedServiceIds.ToArray(), AnyProvider ? null : SelectedResourceId,
            SelectedSlot.Value, normalized, note, TermsAccepted, SelectedPrice, SelectedDuration, CurrentSecurityStamp));
        if (!result.Success)
        {
            var failure = result.Failure!.Value;
            var message = BookingFailureMessage(failure);
            if (failure is BookingFailure.TermsChanged or BookingFailure.ServiceUnavailable or BookingFailure.NoEligibleProvider
                or BookingFailure.BusinessUnavailable or BookingFailure.BranchUnavailable)
            {
                TermsAccepted = false;
                SelectedSlot = null;
                Step = 1;
                await LoadBranchServicesAsync();
            }
            else if (failure is BookingFailure.SlotUnavailable or BookingFailure.TooSoon or BookingFailure.OutsideHorizon)
            {
                SelectedSlot = null; Step = 2;
                await LoadSlotsAsync();
            }
            ErrorMessage = message;
            return;
        }

        var appointment = result.Appointment!;
        ExistingPhone = normalized;
        PhoneInput = normalized;
        TrackingCode = appointment.TrackingCode;
        CreatedStatus = appointment.Status;
        CreatedOverrun = appointment.OverrunMinutes;
        BookedResource = result.Resource;
        ErrorMessage = null;
        Step = 4;
    }

    private static string BookingFailureMessage(BookingFailure failure) => failure switch
    {
        BookingFailure.TermsNotAccepted => "برای ثبت نوبت ابتدا قوانین رزرو را مطالعه و تأیید کنید.",
        BookingFailure.InvalidPhone => "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.",
        BookingFailure.CustomerNotFound => "نشست شما منقضی شده است؛ دوباره وارد حساب شوید.",
        BookingFailure.BusinessUnavailable => "این کسب‌وکار دیگر قابل رزرو نیست.",
        BookingFailure.BranchUnavailable => "این شعبه دیگر قابل رزرو نیست؛ شعبه دیگری را انتخاب کنید.",
        BookingFailure.ServiceUnavailable => "یکی از خدمات انتخاب‌شده دیگر در این شعبه فعال نیست؛ خدمات را دوباره انتخاب کنید.",
        BookingFailure.NoEligibleProvider => "کارمند واجد شرایطی برای همه خدمات انتخاب‌شده وجود ندارد؛ خدمات یا شعبه را تغییر دهید.",
        BookingFailure.OutsideHorizon => $"رزرو فقط از امروز تا {BookingPolicy.MaxAdvanceDays} روز آینده امکان‌پذیر است.",
        BookingFailure.TooSoon => "رزرو باید حداقل ۳۰ دقیقه پیش از شروع نوبت انجام شود.",
        BookingFailure.TermsChanged => "قیمت یا مدت خدمات تغییر کرده است؛ اطلاعات به‌روز را بررسی و زمان را دوباره انتخاب کنید.",
        BookingFailure.SlotUnavailable => "این زمان دیگر قابل رزرو نیست؛ لطفاً یکی از زمان‌های به‌روز را انتخاب کنید.",
        BookingFailure.CustomerOverlap => "شما در همین بازه‌ی زمانی نوبت فعال دیگری دارید؛ زمان دیگری را انتخاب کنید.",
        BookingFailure.ActiveLimitReached => $"حداکثر {BookingPolicy.MaxActiveAppointmentsPerCustomer} نوبت فعال می‌توانید داشته باشید؛ ابتدا یکی از نوبت‌ها را لغو کنید یا منتظر برگزاری آن‌ها بمانید.",
        _ => "ثبت نوبت انجام نشد؛ اطلاعات را بررسی و دوباره تلاش کنید.",
    };

    // از خودِ لحظه ساخته می‌شود (نه از هفته‌ی نمایش‌داده‌شده) و همیشه با منطقه‌ی زمانی شعبه و تقویم زبان فعال.
    private string FormatSelectedTime() =>
        SelectedSlot is null ? "" : BranchClock.FormatDateTime(SelectedSlot.Value, ZoneId, Language);
}
