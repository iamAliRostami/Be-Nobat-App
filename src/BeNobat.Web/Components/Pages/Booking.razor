@page "/book/{BusinessId:guid}"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.ViewOwnAppointments)]
@using System.Globalization
@using System.Security.Claims
@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<Booking> Logger

<PageTitle>رزرو نوبت | به‌نوبت</PageTitle>

@if (Business is null)
{
    <div class="booking-page"><p class="empty-state">این کسب‌وکار پیدا نشد.</p></div>
}
else
{
    <div class="booking-page">
        @if (Step == 3) { <button type="button" class="booking-back-button" @onclick="BackToStep2">→ بازگشت به انتخاب زمان</button> }
        else if (Step == 2) { <button type="button" class="booking-back-button" @onclick="BackToStep1">→ بازگشت به انتخاب خدمات</button> }
        else if (Step == 1) { <a class="booking-back-button" href="@SafeReturnUrl">→ بازگشت به نتایج</a> }
        <div class="booking-head"><div class="booking-logo">✦</div><div><h1>@Business.Name</h1><p>@(SelectedBranch?.Address ?? Business.City)</p></div></div>
        <div class="booking-progress">
            <div class="@(Step > 1 ? "done" : "active")"><b>@(Step > 1 ? "✓" : "۱")</b><span>خدمات</span></div><i></i>
            <div class="@(Step > 2 ? "done" : Step == 2 ? "active" : "")"><b>@(Step > 2 ? "✓" : "۲")</b><span>کارمند و زمان</span></div><i></i>
            <div class="@(Step > 3 ? "done" : Step == 3 ? "active" : "")"><b>@(Step > 3 ? "✓" : "۳")</b><span>تأیید نهایی</span></div>
        </div>
        @if (ErrorMessage is not null) { <div class="auth-error">@ErrorMessage</div> }

        @if (Step == 1)
        {
            <div class="booking-layout">
                <section class="booking-panel">
                    <div class="booking-title"><span>۱</span><div><h2>خدمات موردنظر را انتخاب کنید</h2><p>یک یا چند خدمت را می‌توانید در یک نوبت رزرو کنید.</p></div></div>
                    @if (Branches.Count > 1)
                    {
                        <div class="booking-filters"><label>شعبه<select @bind="SelectedBranchId" @bind:after="BranchChanged">@foreach (var branch in Branches) { <option value="@branch.Id">@branch.Name</option> }</select></label></div>
                    }
                    <div class="service-list">
                        @foreach (var service in Services)
                        {
                            <button type="button" class="service-option @(SelectedServiceIds.Contains(service.Id) ? "selected" : "")" @onclick="() => ToggleService(service.Id)">
                                <i>✂</i><span><strong>@service.Name</strong><small>@service.Description</small><em>◷ @service.DurationMinutes دقیقه</em></span><b>@ServicePrice(service).ToString("N0") تومان</b><u>✓</u>
                            </button>
                        }
                    </div>
                </section>
                <BookingSummary OnContinue="NextFromStep1" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Language="@Language" />
            </div>
        }
        else if (Step == 2)
        {
            <div class="booking-layout">
                <section class="booking-panel">
                    <div class="booking-title"><span>۲</span><div><h2>کارمند، روز و ساعت را انتخاب کنید</h2><p>فقط کارکنانی نمایش داده می‌شوند که همه خدمات انتخابی را ارائه می‌کنند.</p></div></div>
                    <div class="booking-filters provider-filter">
                        <label>ارائه‌دهنده خدمت<select @bind="SelectedResourceId" @bind:after="ResourceChanged"><option value="">— انتخاب کارمند —</option>@foreach (var resource in EligibleResources) { <option value="@resource.Id">@resource.Name</option> }</select></label>
                    </div>
                    @if (EligibleResources.Count == 0) { <p class="empty-state">برای ترکیب خدمات انتخابی، کارمند فعالی در این شعبه تعریف نشده است.</p> }
                    <details class="booking-calendar" open>
                        <summary>@LocalizedDate.Choose(Language, "انتخاب تاریخ", "اختيار التاريخ", "Choose a date")<i>⌄</i></summary>
                        <div class="booking-date-navigation">
                            <div class="booking-date-goto">
                                <span class="booking-date-label">@LocalizedDate.Choose(Language, "رفتن به تاریخ", "الانتقال إلى تاريخ", "Go to date")</span>
                                <CalendarPicker Value="SelectedDate" Min="Today" Today="Today" Language="@Language" ValueChanged="SelectDate" />
                            </div>
                        </div>
                        <div class="date-strip-wrap">
                            <button type="button" class="cal-nav prev" disabled="@(!CanGoPrev)" aria-label="@LocalizedDate.Choose(Language, "هفته قبل", "الأسبوع السابق", "Previous week")" @onclick="() => ShiftWindow(-1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
                            <div class="date-strip">@foreach (var day in Days) { <button type="button" disabled="@IsLoadingSlots" class="@(SelectedDate == day.Date ? "selected" : "")" @onclick="() => SelectDate(day.Date)"><small>@day.Weekday</small><b>@day.DayNumber</b><span>@day.Month</span></button> }</div>
                            <button type="button" class="cal-nav next" aria-label="@LocalizedDate.Choose(Language, "هفته بعد", "الأسبوع التالي", "Next week")" @onclick="() => ShiftWindow(1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
                        </div>
                    </details>
                    <h3 class="time-title">زمان‌های خالی <small>@Slots.Count زمان موجود</small></h3>
                    @if (SelectedResourceId is null) { <p class="empty-state">ابتدا کارمند ارائه‌دهنده را انتخاب کنید.</p> }
                    else if (Slots.Count == 0) { <p class="empty-state">برای این روز زمان خالی وجود ندارد.</p> }
                    else { <div class="time-grid">@foreach (var slot in Slots) { <button type="button" disabled="@(!BookingPolicy.IsBookable(slot, DateTimeOffset.UtcNow))" class="@(SelectedSlot == slot ? "selected" : "")" @onclick="() => SelectedSlot = slot">@LocalizedDate.FormatTime(slot, Language)</button> }</div> }
                </section>
                <BookingSummary OnContinue="NextFromStep2" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Time="@(SelectedSlot is null ? null : FormatSelectedTime())" Language="@Language" />
            </div>
        }
        else if (Step == 3)
        {
            <div class="booking-layout">
                <section class="booking-panel booking-confirmation">
                    <div class="booking-title"><span>۳</span><div><h2>بررسی و تأیید نهایی</h2><p>پیش از ثبت نوبت، مشخصات و قوانین رزرو را بررسی کنید.</p></div></div>
                    <div class="confirmation-business"><i>✦</i><div><h3>@Business.Name</h3><b>@SelectedBranch?.Name</b><small>@SelectedBranch?.Address</small></div></div>
                    <div class="confirmation-details">
                        <article class="confirmation-primary"><small>خدمت انتخابی</small><strong>@SelectedServicesLabel</strong><span>@SelectedDuration دقیقه</span></article>
                        <article><small>متخصص شما</small><strong>@SelectedResource?.Name</strong></article>
                        <article><small>زمان مراجعه</small><strong>@FormatSelectedTime()</strong></article>
                        <article class="confirmation-price"><small>مبلغ قابل پرداخت</small><strong>@SelectedPrice?.ToString("N0") <span>تومان</span></strong></article>
                    </div>
                </section>
                <BookingSummary OnContinue="ConfirmBookingAsync" ServiceName="@SelectedServicesLabel" Price="@SelectedPrice" DurationMinutes="@SelectedDuration" BranchName="@(SelectedBranch?.Name ?? "")" BusinessName="@Business.Name" Time="@FormatSelectedTime()" Language="@Language" RequireTerms="true" TermsAccepted="@TermsAccepted" OnShowTerms="OpenTerms" Disabled="@(!TermsAccepted)" DisabledReason="برای ثبت نوبت، قوانین رزرو را مطالعه و تأیید کنید." />
            </div>
        }
        else
        {
            <section class="success-card"><div class="success-icon">✓</div><span>نوبت شما ثبت شد</span><h1>منتظرت هستیم!</h1><p>جزئیات نوبت در «نوبت‌های من» قابل مشاهده است.</p><div class="success-details"><div><small>شماره پیگیری</small><b>@TrackingCode</b></div><div><small>خدمات</small><b>@SelectedServicesLabel</b></div><div><small>متخصص</small><b>@SelectedResource?.Name</b></div><div><small>زمان</small><b>@FormatSelectedTime()</b></div></div><a href="/appointments">مشاهده نوبت‌های من</a></section>
        }
    </div>
}

@if (ShowTerms)
{
    <div class="modal-backdrop" @onclick="CloseTerms">
        <section class="form-modal booking-rules-modal" @onclick:stopPropagation>
            <div><h2>قوانین رزرو نوبت</h2><button type="button" @onclick="CloseTerms">×</button></div>
            <ol>
                <li>برای حضور به‌موقع، حداقل ۱۰ دقیقه پیش از شروع نوبت در شعبه حاضر باشید.</li>
                <li>لغو اینترنتی فقط تا دو ساعت پیش از شروع نوبت امکان‌پذیر است.</li>
                <li>در صورت تأخیر، مدت خدمت ممکن است کوتاه شود یا نوبت با هماهنگی شعبه جابه‌جا شود.</li>
                <li>مبلغ نمایش‌داده‌شده بر اساس خدمات انتخابی است و خدمات اضافه با تأیید شما محاسبه می‌شود.</li>
            </ol>
            <button type="button" class="primary-button" @onclick="AcceptTerms">قوانین را خواندم و تأیید می‌کنم</button>
        </section>
    </div>
}

@code {
    [Parameter] public Guid BusinessId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private Business? Business;
    private List<Branch> Branches = [];
    private Guid SelectedBranchId;
    private Branch? SelectedBranch => Branches.FirstOrDefault(x => x.Id == SelectedBranchId);
    private List<Service> Services = [];
    private List<BranchService> BranchServices = [];
    private HashSet<Guid> SelectedServiceIds = [];
    private List<Resource> EligibleResources = [];
    private Guid? SelectedResourceId;
    private Resource? SelectedResource => EligibleResources.FirstOrDefault(x => x.Id == SelectedResourceId);
    private int Step = 1;
    private DateOnly SelectedDate;
    private DateTimeOffset? SelectedSlot;
    private List<DateTimeOffset> Slots = [];
    private string? ErrorMessage;
    private bool IsLoadingSlots;
    private bool ShowTerms;
    private bool TermsAccepted;
    private string? TrackingCode;
    private sealed record DayOption(DateOnly Date, string Weekday, string DayNumber, string Month);
    private const int WindowDays = 7;
    private string Language = "fa";
    // First day shown in the strip. Only the arrow buttons (or jumping to a date outside the
    // visible week) move it; picking a day inside the strip never re-anchors the strip.
    private DateOnly WindowStart;
    private bool CanGoPrev => WindowStart > Today;
    private List<DayOption> Days = [];
    private IEnumerable<Service> SelectedServices => Services.Where(x => SelectedServiceIds.Contains(x.Id));
    private string SelectedServicesLabel => string.Join("، ", SelectedServices.Select(x => x.Name));
    private int? SelectedDuration => SelectedServiceIds.Count == 0 ? null : BookingPolicy.TotalDuration(SelectedServices);
    private decimal? SelectedPrice => SelectedServiceIds.Count == 0 ? null : SelectedServices.Sum(ServicePrice);
    // "Today" is the calendar day in the branch's own time zone (UTC would be a day behind for
    // Tehran between 00:00 and 03:30, making yesterday selectable).
    private TimeZoneInfo BranchZone
    {
        get
        {
            if (SelectedBranch is null) return TimeZoneInfo.Utc;
            try { return TimeZoneInfo.FindSystemTimeZoneById(SelectedBranch.TimeZoneId); }
            catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException) { return TimeZoneInfo.Utc; }
        }
    }
    private DateOnly Today => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, BranchZone).DateTime);
    private string SafeReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/#businesses";

    protected override async Task OnInitializedAsync()
    {
        Business = await Db.Businesses.Include(x => x.Branches).FirstOrDefaultAsync(x => x.Id == BusinessId);
        if (Business is null) return;
        Branches = Business.Branches.OrderBy(x => x.Name).ToList();
        SelectedBranchId = Branches.FirstOrDefault()?.Id ?? Guid.Empty;
        SelectedDate = Today;
        WindowStart = SelectedDate;
        BuildDays();
        await LoadBranchServicesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { Language = await JS.InvokeAsync<string>("beNobat.preferences.getLanguage"); }
        catch (JSDisconnectedException) { return; }
        BuildDays();
        StateHasChanged();
    }

    private decimal ServicePrice(Service service) => BranchServices.FirstOrDefault(x => x.ServiceId == service.Id)?.Price ?? service.Price;
    private async Task LoadBranchServicesAsync()
    {
        BranchServices = await Db.BranchServices.Where(x => x.BranchId == SelectedBranchId).ToListAsync();
        var all = await Db.Services.Where(x => x.BusinessId == BusinessId).OrderBy(x => x.Name).ToListAsync();
        // A business service is bookable in a branch only after an explicit branch assignment.
        Services = all.Where(x => BranchServices.Any(y => y.ServiceId == x.Id)).ToList();
        SelectedServiceIds.RemoveWhere(id => Services.All(x => x.Id != id));
        await LoadEligibleResourcesAsync();
    }
    private async Task BranchChanged() { SelectedSlot = null; SelectedResourceId = null; EnsureDateNotPast(); await LoadBranchServicesAsync(); }
    private void ToggleService(Guid id) { if (!SelectedServiceIds.Add(id)) SelectedServiceIds.Remove(id); SelectedResourceId = null; SelectedSlot = null; TermsAccepted = false; }
    private async Task LoadEligibleResourcesAsync()
    {
        var staff = await Db.Resources.Where(x => x.BranchId == SelectedBranchId && x.Kind == "staff").OrderBy(x => x.Name).ToListAsync();
        if (SelectedServiceIds.Count == 0) { EligibleResources = []; return; }
        var assignments = await Db.ServiceResources.Where(x => SelectedServiceIds.Contains(x.ServiceId)).ToListAsync();
        // Branch membership alone doesn't qualify a staff member to provide a service.
        EligibleResources = staff.Where(r => SelectedServiceIds.All(s =>
            assignments.Any(a => a.ServiceId == s && a.ResourceId == r.Id))).ToList();
    }
    private async Task NextFromStep1() { if (SelectedServiceIds.Count == 0) { ErrorMessage = "حداقل یک خدمت را انتخاب کنید."; return; } await LoadEligibleResourcesAsync(); ErrorMessage = null; EnsureDateNotPast(); Step = 2; await LoadSlotsAsync(); }
    private void BackToStep1() { ErrorMessage = null; SelectedSlot = null; Step = 1; }
    private async Task ResourceChanged() { SelectedSlot = null; TermsAccepted = false; await LoadSlotsAsync(); }
    private async Task SelectDate(DateOnly date)
    {
        if (date < Today || IsLoadingSlots) return;
        SelectedDate = date; SelectedSlot = null; TermsAccepted = false;
        // Only move the strip when the chosen date (from the calendar popup) is outside it.
        if (date < WindowStart || date >= WindowStart.AddDays(WindowDays)) { WindowStart = date; BuildDays(); }
        await LoadSlotsAsync();
    }
    // Arrow buttons: one week per click, never before today.
    private void ShiftWindow(int direction)
    {
        var next = WindowStart.AddDays(direction * WindowDays);
        WindowStart = next < Today ? Today : next;
        BuildDays();
    }
    private void EnsureDateNotPast()
    {
        var today = Today;
        if (SelectedDate < today) SelectedDate = today;
        if (WindowStart < today) WindowStart = today;
        BuildDays();
    }
    private void BuildDays()
    {
        var today = Today;
        Days = Enumerable.Range(0, WindowDays).Select(offset =>
        {
            var date = WindowStart.AddDays(offset);
            var parts = LocalizedDate.DayAndMonth(date, Language);
            return new DayOption(date, LocalizedDate.Weekday(date, Language, date == today), parts.Day, parts.Month);
        }).ToList();
    }

    private async Task LoadSlotsAsync()
    {
        if (SelectedBranch is null || SelectedResourceId is null || SelectedDuration is null) { Slots = []; return; }
        IsLoadingSlots = true;
        ErrorMessage = null;
        try
        {
        var branch = SelectedBranch;
        var duration = TimeSpan.FromMinutes(SelectedDuration.Value);
        var zone = TimeZoneInfo.FindSystemTimeZoneById(branch.TimeZoneId);
        // PostgreSQL timestamptz parameters must be UTC. Passing Tehran's +03:30 offset
        // makes Npgsql throw before the availability query can return any slots.
        var (dayStart, dayEnd) = BookingPolicy.UtcDayWindow(SelectedDate, zone);
        var rules = await Db.AvailabilityRules.Where(x => x.BusinessId == BusinessId && (x.EffectiveDate == SelectedDate || (x.EffectiveDate == null && x.DayOfWeek == SelectedDate.DayOfWeek)) && (x.ResourceId == SelectedResourceId || (x.ResourceId == null && (x.BranchId == branch.Id || x.BranchId == null)))).OrderBy(x => x.StartsAt).ToListAsync();
        var scoped = rules.Any(x => x.ResourceId == SelectedResourceId) ? rules.Where(x => x.ResourceId == SelectedResourceId).ToList() : rules.Any(x => x.BranchId == branch.Id) ? rules.Where(x => x.ResourceId == null && x.BranchId == branch.Id).ToList() : rules.Where(x => x.ResourceId == null && x.BranchId == null).ToList();
        var intervals = scoped.Where(x => x.IsAvailable).ToList();
        if (scoped.Count == 0) intervals.Add(new AvailabilityRule { StartsAt = new(branch.OpenHour, 0), EndsAt = new(branch.CloseHour, 0) });
        var appointments = await Db.Appointments.Where(a => a.ResourceId == SelectedResourceId && a.Status != AppointmentStatus.Cancelled && a.StartsAt < dayEnd && a.EndsAt > dayStart).Select(a => new { a.StartsAt, a.EndsAt }).ToListAsync();
        var now = DateTimeOffset.UtcNow;
        var slots = new List<DateTimeOffset>();
        foreach (var interval in intervals)
        {
            var startLocal = SelectedDate.ToDateTime(interval.StartsAt, DateTimeKind.Unspecified);
            var endLocal = SelectedDate.ToDateTime(interval.EndsAt, DateTimeKind.Unspecified);
            var from = new DateTimeOffset(startLocal, zone.GetUtcOffset(startLocal)); var to = new DateTimeOffset(endLocal, zone.GetUtcOffset(endLocal));
            for (var start = from; start + duration <= to; start = start.AddMinutes(30))
            {
                var end = start + duration;
                var blocked = scoped.Any(x => !x.IsAvailable && start.TimeOfDay < x.EndsAt.ToTimeSpan() && x.StartsAt.ToTimeSpan() < end.TimeOfDay);
                if (BookingPolicy.IsBookable(start, now) && !blocked && appointments.All(a => !BookingPolicy.Overlaps(start, end, a.StartsAt, a.EndsAt))) slots.Add(start);
            }
        }
        Slots = slots.Distinct().OrderBy(x => x).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load booking slots for business {BusinessId}, branch {BranchId}, resource {ResourceId}, date {Date}",
                BusinessId, SelectedBranchId, SelectedResourceId, SelectedDate);
            Slots = [];
            ErrorMessage = "دریافت زمان‌های خالی ممکن نشد. لطفاً تاریخ دیگری را انتخاب کنید یا به مرحله قبل بازگردید.";
        }
        finally { IsLoadingSlots = false; }
    }

    private Task NextFromStep2()
    {
        if (SelectedResourceId is null) { ErrorMessage = "کارمند ارائه‌دهنده را انتخاب کنید."; return Task.CompletedTask; }
        if (SelectedSlot is null) { ErrorMessage = "یک زمان را انتخاب کنید."; return Task.CompletedTask; }
        ErrorMessage = null; TermsAccepted = false; Step = 3; return Task.CompletedTask;
    }
    private void BackToStep2() { ErrorMessage = null; TermsAccepted = false; Step = 2; }
    private void OpenTerms() => ShowTerms = true;
    private void CloseTerms() => ShowTerms = false;
    private void AcceptTerms() { TermsAccepted = true; ShowTerms = false; }
    private async Task ConfirmBookingAsync()
    {
        try
        {
            await ConfirmBookingCoreAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to confirm booking for business {BusinessId}, branch {BranchId}, resource {ResourceId}", BusinessId, SelectedBranchId, SelectedResourceId);
            Db.ChangeTracker.Clear();
            ErrorMessage = "ثبت نوبت انجام نشد. لطفاً دوباره تلاش کنید؛ در صورت تکرار، زمان دیگری را انتخاب کنید.";
        }
    }

    private async Task ConfirmBookingCoreAsync()
    {
        if (!TermsAccepted) { ErrorMessage = "برای ثبت نوبت ابتدا قوانین رزرو را مطالعه و تأیید کنید."; return; }
        if (SelectedSlot is null || SelectedBranch is null || SelectedResourceId is null || AuthStateTask is null || SelectedDuration is null) return;
        var userText = (await AuthStateTask).User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userText, out var userId)) { NavigationManager.NavigateTo($"/account/login?ReturnUrl=/book/{BusinessId}", true); return; }
        var start = SelectedSlot.Value; var end = start.AddMinutes(SelectedDuration.Value);
        if (!BookingPolicy.IsBookable(start, DateTimeOffset.UtcNow)) { ErrorMessage = "رزرو باید حداقل ۳۰ دقیقه پیش از شروع نوبت انجام شود."; await LoadSlotsAsync(); return; }
        await using var transaction = await Db.Database.BeginTransactionAsync();
        // An advisory transaction lock is stable across application instances and closes the
        // race between the last conflict check and INSERT for this provider.
        var resourceLockKey = BitConverter.ToInt64(SelectedResourceId.Value.ToByteArray(), 0);
        var lockAcquired = await Db.Database.SqlQuery<bool>($"SELECT pg_try_advisory_xact_lock({resourceLockKey}) AS \"Value\"").SingleAsync();
        if (!lockAcquired)
        {
            await transaction.RollbackAsync();
            ErrorMessage = "در حال حاضر رزرو دیگری برای این ارائه‌دهنده در حال ثبت است؛ چند لحظه بعد دوباره تلاش کنید.";
            return;
        }
        await LoadSlotsAsync();
        if (!Slots.Contains(start))
        {
            await transaction.RollbackAsync();
            ErrorMessage = "این زمان دیگر قابل رزرو نیست؛ لطفاً یکی از زمان‌های به‌روز را انتخاب کنید.";
            SelectedSlot = null;
            return;
        }
        var selectedServiceIds = SelectedServiceIds.ToList();
        var isEligibleProvider = await Db.Resources.AnyAsync(r => r.Id == SelectedResourceId && r.BranchId == SelectedBranch.Id && r.Kind == "staff") &&
            await Db.ServiceResources.Where(x => x.ResourceId == SelectedResourceId && selectedServiceIds.Contains(x.ServiceId))
                .Select(x => x.ServiceId).Distinct().CountAsync() == selectedServiceIds.Count;
        if (!isEligibleProvider) { await transaction.RollbackAsync(); ErrorMessage = "این کارمند برای همه خدمات انتخاب‌شده به‌عنوان ارائه‌دهنده تعریف نشده است."; SelectedResourceId = null; SelectedSlot = null; await LoadEligibleResourcesAsync(); return; }
        var conflict = await Db.Appointments.AnyAsync(a => a.ResourceId == SelectedResourceId && a.Status != AppointmentStatus.Cancelled && a.StartsAt < end && a.EndsAt > start);
        if (conflict) { await transaction.RollbackAsync(); ErrorMessage = "این زمان رزرو شده است؛ زمان دیگری انتخاب کنید."; SelectedSlot = null; await LoadSlotsAsync(); return; }
        var selected = SelectedServices.ToList();
        var first = selected[0];
        var appointment = new Appointment { BranchId = SelectedBranch.Id, ServiceId = first.Id, ResourceId = SelectedResourceId, CustomerId = userId, StartsAt = start, EndsAt = end, FinalPrice = SelectedPrice!.Value };
        foreach (var service in selected) appointment.Services.Add(new AppointmentService { ServiceId = service.Id, DurationMinutes = service.DurationMinutes, Price = ServicePrice(service) });
        Db.Appointments.Add(appointment); await Db.SaveChangesAsync(); await transaction.CommitAsync();
        TrackingCode = appointment.Id.ToString("N")[..10].ToUpperInvariant(); ErrorMessage = null; Step = 4;
    }
    // Built from the slot itself (not from the visible week) so it stays correct after the strip moves,
    // and always uses the calendar of the active language.
    private string FormatSelectedTime()
    {
        if (SelectedSlot is null) return "";
        var slot = SelectedSlot.Value;
        var date = DateOnly.FromDateTime(slot.DateTime);
        var parts = LocalizedDate.DayAndMonth(date, Language);
        var year = LocalizedDate.FormatNumber(LocalizedDate.GetParts(date, Language).Year, Language);
        var time = LocalizedDate.FormatTime(slot, Language);
        return Language switch
        {
            "en" => $"{parts.Day} {parts.Month} {year} at {time}",
            "ar" => $"{parts.Day} {parts.Month} {year} هـ، الساعة {time}",
            _ => $"{parts.Day} {parts.Month} {year}، ساعت {time}",
        };
    }
}
