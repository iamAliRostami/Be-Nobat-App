@page "/platform/services"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>کاتالوگ خدمات | به‌نوبت</PageTitle>
<div class="page-title"><div><h1>کاتالوگ خدمات</h1><p>تعریف‌های استانداردی که کسب‌وکارها می‌توانند انتخاب و شخصی‌سازی کنند.</p></div><button type="button" @onclick="NewItem">+ خدمت جدید</button></div>

<div class="stat-cards platform-stats">
    <a class="stat-card-link" href="/platform/services"><article><i class="purple">✦</i><div><small>کل خدمات</small><strong>@Items.Count</strong></div></article></a>
    <a class="stat-card-link" href="/platform/services?status=published"><article><i class="green">✓</i><div><small>منتشرشده</small><strong>@Items.Count(x => x.IsPublished)</strong></div></article></a>
    <a class="stat-card-link" href="/platform/categories?kind=Service"><article><i class="blue">▦</i><div><small>دسته‌بندی‌ها</small><strong>@Items.Select(x => x.Category).Distinct().Count()</strong></div></article></a>
    <a class="stat-card-link" href="/platform/services?usage=used"><article><i class="orange">◇</i><div><small>استفاده کسب‌وکارها</small><strong>@Items.Sum(UsageCount)</strong></div></article></a>
</div>

@if (ShowForm)
{
    <div class="modal-backdrop" @onclick="Close">
        <EditForm Model="Form" FormName="catalog-service" OnValidSubmit="Save" class="form-modal" @onclick:stopPropagation>
            <div><h2>@(EditingId is null ? "خدمت کاتالوگ جدید" : "ویرایش خدمت کاتالوگ")</h2><button type="button" aria-label="بستن پنجره" title="بستن" @onclick="Close">×</button></div>
            <label>نام استاندارد<input required @bind="Form.Name" /></label>
            <label>شناسه URL<input required dir="ltr" pattern="[a-z0-9-]+" @bind="Form.Slug" /></label>
            <label>دسته‌بندی<select @bind="Form.Category">@if (!Categories.Contains(Form.Category)) { <option value="@Form.Category">@Form.Category (قدیمی)</option> }@foreach (var category in Categories) { <option value="@category">@category</option> }</select></label>
            <label>مدت پیشنهادی (دقیقه)<input type="number" min="5" @bind="Form.Duration" /></label>
            <label>توضیحات<textarea @bind="Form.Description"></textarea></label>
            <label class="check-label"><input type="checkbox" @bind="Form.IsPublished" /><span>در دسترس کسب‌وکارها باشد</span></label>
            @if (Error is not null) { <div class="auth-error">@Error</div> }
            <button class="primary-button">ذخیره در کاتالوگ</button>
        </EditForm>
    </div>
}

<article class="admin-panel">
    <div class="toolbar filter-toolbar">
        <input aria-label="جست‌وجوی کاتالوگ خدمات" placeholder="جست‌وجوی نام، دسته یا شناسه..." @bind="Search" @bind:event="oninput" />
        <select aria-label="فیلتر دسته‌بندی خدمت" @bind="SelectedCategory"><option value="">همه دسته‌بندی‌ها</option>@foreach (var category in FilterCategories) { <option value="@category">@category</option> }</select>
        <select aria-label="فیلتر وضعیت انتشار" @bind="StatusFilter"><option value="">همه وضعیت‌ها</option><option value="published">منتشرشده</option><option value="hidden">پنهان</option></select>
        <select aria-label="فیلتر استفاده کسب‌وکارها" @bind="UsageFilter"><option value="">همه خدمات</option><option value="used">استفاده‌شده</option><option value="unused">بدون استفاده</option></select>
        @if (HasFilters) { <button type="button" class="action-secondary" @onclick="ResetFilters">پاک‌کردن فیلترها</button> }
        <span>@Filtered.Count() خدمت</span>
    </div>
    @if (!Filtered.Any()) { <p class="empty-state">خدمتی با این فیلترها پیدا نشد.</p> }
    <div class="service-table platform-table catalog-table">
        <div class="table-head"><span>خدمت</span><span>دسته‌بندی</span><span>مدت</span><span>وضعیت</span><span></span></div>
        @foreach (var item in Filtered)
        {
            <div @key="item.Id">
                <span><i class="purple">✦</i><b><a class="entity-link" href="@($"/platform/services?serviceId={item.Id}")">@item.Name</a><small>/@item.Slug · @UsageCount(item) کسب‌وکار</small></b></span>
                <span><a class="entity-link" href="@($"/platform/services?category={Uri.EscapeDataString(item.Category)}")">@item.Category</a></span>
                <span>@item.SuggestedDurationMinutes دقیقه</span>
                <span><em class="status @(item.IsPublished ? "confirmed" : "cancelled")">@(item.IsPublished ? "منتشرشده" : "پنهان")</em></span>
                <span class="inline-actions"><button type="button" class="action-secondary" @onclick="() => Edit(item)">ویرایش</button><button type="button" class="@(item.IsPublished ? "action-danger" : "action-success")" @onclick="() => Toggle(item)">@(item.IsPublished ? "پنهان‌کردن" : "انتشار")</button></span>
            </div>
        }
    </div>
</article>

@code {
    private List<ServiceCatalogItem> Items = [];
    private List<string> Categories = [];
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "serviceId")] public Guid? ServiceIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryParam { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "usage")] public string? UsageParam { get; set; }
    private string Search = "";
    private Guid? SelectedServiceId;
    private string SelectedCategory = "";
    private string StatusFilter = "";
    private string UsageFilter = "";
    private string? Error;
    private bool ShowForm;
    private Guid? EditingId;
    private CatalogInput Form = new();
    private IEnumerable<string> FilterCategories => Categories.Concat(Items.Select(x => x.Category)).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();
    private static int UsageCount(ServiceCatalogItem item) => item.BusinessServices.Where(x => x.DeletedAt is null).Select(x => x.BusinessId).Distinct().Count();
    private bool HasFilters => !string.IsNullOrWhiteSpace(Search) || SelectedServiceId is not null || SelectedCategory != "" || StatusFilter != "" || UsageFilter != "";
    private IEnumerable<ServiceCatalogItem> Filtered => Items.Where(x =>
        (SelectedServiceId is null || x.Id == SelectedServiceId) &&
        (StatusFilter != "published" || x.IsPublished) &&
        (StatusFilter != "hidden" || !x.IsPublished) &&
        (UsageFilter != "used" || UsageCount(x) > 0) &&
        (UsageFilter != "unused" || UsageCount(x) == 0) &&
        (SelectedCategory == "" || x.Category == SelectedCategory) &&
        $"{x.Name} {x.Category} {x.Slug}".Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase));
    protected override Task OnInitializedAsync() => Load();
    protected override void OnParametersSet()
    {
        Search = QueryParam?.Trim() ?? "";
        SelectedServiceId = ServiceIdParam;
        SelectedCategory = CategoryParam ?? "";
        StatusFilter = StatusParam is "published" or "hidden" ? StatusParam : "";
        UsageFilter = UsageParam is "used" or "unused" ? UsageParam : "";
    }
    private void ResetFilters()
    {
        Search = SelectedCategory = StatusFilter = UsageFilter = "";
        SelectedServiceId = null;
        Navigation.NavigateTo("/platform/services");
    }
    private async Task Load() { await using var db = await DbFactory.CreateDbContextAsync(); Items = await db.ServiceCatalogItems.IgnoreQueryFilters().Include(x => x.BusinessServices).OrderBy(x => x.Category).ThenBy(x => x.Name).ToListAsync(); Categories = await db.CategoryDefinitions.Where(x => x.Kind == CategoryKind.Service && x.IsActive).OrderBy(x => x.SortOrder).Select(x => x.Name).ToListAsync(); }
    private void NewItem() { EditingId = null; Form = new(); Error = null; ShowForm = true; }
    private void Edit(ServiceCatalogItem item) { EditingId = item.Id; Form = new() { Name = item.Name, Slug = item.Slug, Category = item.Category, Description = item.Description, Duration = item.SuggestedDurationMinutes, IsPublished = item.IsPublished }; Error = null; ShowForm = true; }
    private async Task Save()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var slug = Form.Slug.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(Form.Name) || string.IsNullOrWhiteSpace(slug) || Form.Duration < 5) { Error = "نام، شناسه و مدت معتبر الزامی است."; return; }
        if (await db.ServiceCatalogItems.IgnoreQueryFilters().AnyAsync(x => x.Slug == slug && x.Id != EditingId)) { Error = "این شناسه قبلاً استفاده شده است."; return; }
        var item = EditingId is Guid id ? await db.ServiceCatalogItems.IgnoreQueryFilters().FirstAsync(x => x.Id == id) : new ServiceCatalogItem { Name = Form.Name };
        item.Name = Form.Name.Trim(); item.Slug = slug; item.Category = Form.Category.Trim(); item.Description = Form.Description.Trim(); item.SuggestedDurationMinutes = Form.Duration; item.IsPublished = Form.IsPublished;
        if (EditingId is null) db.ServiceCatalogItems.Add(item);
        await db.SaveChangesAsync(); Close(); await Load();
    }
    private async Task Toggle(ServiceCatalogItem item) { await using var db = await DbFactory.CreateDbContextAsync(); var entity = await db.ServiceCatalogItems.FirstAsync(x => x.Id == item.Id); entity.IsPublished = !entity.IsPublished; await db.SaveChangesAsync(); await Load(); }
    private void Close() { ShowForm = false; Error = null; }
    private sealed class CatalogInput { public string Name { get; set; } = ""; public string Slug { get; set; } = ""; public string Category { get; set; } = "عمومی"; public string Description { get; set; } = ""; public int Duration { get; set; } = 30; public bool IsPublished { get; set; } = true; }
}
