<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <div class="account-auth-page">
                        <div class="auth-card">
                            <h1>دسترسی غیرمجاز</h1>
                            <p class="auth-subtitle">شما اجازه‌ی دسترسی به این صفحه را ندارید.</p>
                            <a class="primary-button auth-submit" href="/">بازگشت به صفحه اصلی</a>
                        </div>
                    </div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.PublicLayout)">
            <div class="account-auth-page">
                <div class="auth-card">
                    <h1>صفحه پیدا نشد</h1>
                    <p class="auth-subtitle">آدرس موردنظر وجود ندارد.</p>
                    <a class="primary-button auth-submit" href="/">بازگشت به صفحه اصلی</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
