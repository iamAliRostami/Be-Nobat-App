@inject AppDbContext Db

@if (UserAvatar.Has(Account))
{
    <img class="@CssClass" src="@UserAvatar.Url(Account!)" alt="عکس پروفایل @DisplayName" />
}
else
{
    <span class="@CssClass purple">@UserAvatar.Initials(DisplayName)</span>
}

@code {
    [Parameter, EditorRequired] public System.Security.Claims.ClaimsPrincipal User { get; set; } = null!;
    [Parameter] public string CssClass { get; set; } = "customer-avatar";

    private AppUser? Account;
    private string DisplayName => Account?.DisplayName
        ?? User.FindFirst("DisplayName")?.Value
        ?? User.Identity?.Name
        ?? "کاربر";

    protected override async Task OnParametersSetAsync()
    {
        var value = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        Account = Guid.TryParse(value, out var id)
            ? await Db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id)
            : null;
    }
}
