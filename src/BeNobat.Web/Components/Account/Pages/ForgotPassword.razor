@page "/account/forgot-password"
@layout Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@using BeNobat.Web.Security
@inject UserManager<AppUser> UserManager
@inject IServiceScopeFactory ScopeFactory

<PageTitle>بازیابی رمز عبور | به‌نوبت</PageTitle>

<div class="account-auth-page">
    <div class="auth-card">
        <h1>بازیابی رمز عبور</h1>
        <p class="auth-subtitle">ایمیل یا شماره موبایل حساب کاربری خود را وارد کنید.</p>

        @if (Submitted)
        {
            <div class="success-notice" style="margin-bottom:16px; font-size:13px; line-height:1.6;">
                درخواست بازیابی رمز عبور شما با موفقیت ثبت شد. مدیریت سامانه پس از بررسی، رمز جدید را صادر و با شما هماهنگ خواهد کرد.
            </div>
            <p class="auth-switch"><a href="/account/login">بازگشت به صفحه ورود</a></p>
        }
        else
        {
            <EditForm Model="Input!" FormName="forgot-password" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="auth-error" role="alert">@ErrorMessage</div>
                }

                <label>ایمیل یا شماره موبایل
                    <InputText @bind-Value="Input!.Identifier" autocomplete="username" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷ یا ایمیل" dir="ltr" />
                </label>
                <ValidationMessage For="() => Input!.Identifier" />

                <button type="submit" class="primary-button auth-submit" disabled="@Loading">
                    @(Loading ? "در حال ثبت..." : "ارسال درخواست بازیابی رمز")
                </button>
                <p class="auth-switch">رمز عبور خود را به خاطر دارید؟ <a href="/account/login">وارد شوید</a></p>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private string? ErrorMessage;
    private bool Submitted;
    private bool Loading;

    protected override void OnInitialized() => Input ??= new();

    private async Task HandleSubmit()
    {
        ErrorMessage = null;
        var identifier = (Input?.Identifier ?? "").Trim();
        if (string.IsNullOrWhiteSpace(identifier))
        {
            ErrorMessage = "لطفاً ایمیل یا شماره موبایل خود را وارد کنید.";
            return;
        }

        Loading = true;
        try
        {
            AppUser? user = null;
            if (UserInputValidation.TryNormalizeIranianMobile(identifier, out var phone))
            {
                user = await UserManager.Users.FirstOrDefaultAsync(u => u.PhoneNumber == phone || u.UserName == phone);
            }
            else if (new EmailAddressAttribute().IsValid(identifier))
            {
                user = await UserManager.FindByEmailAsync(identifier)
                    ?? await UserManager.Users.FirstOrDefaultAsync(u => u.UserName == identifier);
            }
            else
            {
                user = await UserManager.FindByNameAsync(identifier);
            }

            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var request = new PasswordResetRequest
            {
                UserId = user?.Id,
                Identifier = identifier,
                ContactInfo = user?.PhoneNumber ?? user?.Email ?? identifier,
                Status = PasswordResetRequestStatus.Pending,
                CreatedAt = DateTimeOffset.UtcNow
            };

            db.PasswordResetRequests.Add(request);
            await db.SaveChangesAsync();

            Submitted = true;
        }
        catch (Exception)
        {
            ErrorMessage = "خطایی در ثبت درخواست رخ داد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            Loading = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "ایمیل یا شماره موبایل الزامی است.")]
        public string Identifier { get; set; } = "";
    }
}
