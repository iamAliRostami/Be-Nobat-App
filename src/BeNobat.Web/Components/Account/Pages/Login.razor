@page "/account/login"
@layout Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BeNobat.Web.Domain
@using BeNobat.Web.Security
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<Login> Logger

<PageTitle>ورود | به‌نوبت</PageTitle>

<div class="account-auth-page">
    <EditForm Model="Input!" FormName="login" OnValidSubmit="LoginUser" class="auth-card">
        <DataAnnotationsValidator />
        <h1>ورود به حساب کاربری</h1>
        <p class="auth-subtitle">برای رزرو و مشاهده نوبت‌هایتان وارد شوید.</p>
        @* تب‌ها لینک ساده‌اند (نه NavLink) تا returnUrl حفظ شود. *@
        <div class="auth-tabs">
            <a class="active" aria-current="page" href="@LoginHref">ورود</a>
            <a href="@RegisterHref">ثبت‌نام</a>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="auth-error" role="alert">@ErrorMessage</div>
        }

        <label>ایمیل یا شماره موبایل
            <InputText @bind-Value="Input!.Identifier" autocomplete="username" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷ یا ایمیل" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input!.Identifier" />

        <label for="loginPassword">رمز عبور
            <div class="password-input-wrap">
                <InputText @bind-Value="Input!.Password" id="loginPassword" type="password" autocomplete="current-password" dir="ltr" />
                <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('loginPassword', this)" title="نمایش رمز عبور" aria-label="نمایش یا پنهان‌سازی رمز عبور">
                    <svg class="eye-icon eye-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-icon eye-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </label>
        <ValidationMessage For="() => Input!.Password" />

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
            <label class="auth-remember" style="margin-top:0;"><InputCheckbox @bind-Value="Input!.RememberMe" /> مرا به خاطر بسپار</label>
            <a href="/account/forgot-password" style="font-size:12px; color:var(--primary); text-decoration:none;">فراموشی رمز عبور؟</a>
        </div>

        <button type="submit" class="primary-button auth-submit">ورود</button>
        <p class="auth-switch">حساب کاربری ندارید؟ <a href="@RegisterHref">ثبت‌نام کنید</a></p>
    </EditForm>
</div>

@code {
    private string? ErrorMessage;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl => SafeRedirect.Local(ReturnUrl, "");

    private string LoginHref => SafeReturnUrl.Length == 0
        ? "/account/login"
        : $"/account/login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private string RegisterHref => SafeReturnUrl.Length == 0
        ? "/account/register"
        : $"/account/register?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private async Task LoginUser()
    {
        ErrorMessage = null;
        var identifier = (Input!.Identifier ?? "").Trim();
        if (string.IsNullOrWhiteSpace(identifier))
        {
            ErrorMessage = "ایمیل یا شماره موبایل الزامی است.";
            return;
        }

        AppUser? user = null;
        if (UserInputValidation.TryNormalizeIranianMobile(identifier, out var phone))
        {
            user = await UserManager.Users.FirstOrDefaultAsync(u => u.PhoneNumber == phone || u.UserName == phone);
        }
        else if (new EmailAddressAttribute().IsValid(identifier))
        {
            user = await UserManager.FindByEmailAsync(identifier)
                ?? await UserManager.Users.FirstOrDefaultAsync(u => u.UserName == identifier);
        }
        else
        {
            user = await UserManager.FindByNameAsync(identifier);
        }

        if (user is null)
        {
            ErrorMessage = "ایمیل، شماره موبایل یا رمز عبور اشتباه است.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user.UserName!,
            Input!.Password,
            Input!.RememberMe,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("کاربر {User} با موفقیت وارد شد.", user.UserName);
            var target = SafeReturnUrl;
            if (target.Length == 0)
            {
                var roles = await UserManager.GetRolesAsync(user);
                target = roles.Any(role => AppRoles.AppointmentManagers.Contains(role)) ? "/admin" : "/";
            }

            NavigationManager.NavigateTo(target, forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            // حساب غیرفعال‌شده توسط مدیر تا ابد قفل است؛ قفل ناشی از تلاش ناموفق چند دقیقه‌ای است.
            ErrorMessage = user.LockoutEnd > DateTimeOffset.UtcNow.AddYears(1)
                ? "این حساب توسط مدیر غیرفعال شده است. برای فعال‌سازی با پشتیبانی تماس بگیرید."
                : "حساب شما موقتاً به دلیل تلاش‌های ناموفق متعدد قفل شده است؛ چند دقیقه بعد دوباره تلاش کنید.";
            return;
        }

        ErrorMessage = "ایمیل، شماره موبایل یا رمز عبور اشتباه است.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "ایمیل یا شماره موبایل الزامی است.")]
        public string Identifier { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
