@page "/account/register"
@layout Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@using BeNobat.Web.Security
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager NavigationManager
@inject AppDbContext Db

<PageTitle>ثبت‌نام | به‌نوبت</PageTitle>

<div class="account-auth-page">
    <EditForm Model="Input!" FormName="register" OnValidSubmit="RegisterUser" class="auth-card">
        <DataAnnotationsValidator />
        <h1>ساخت حساب کاربری</h1>
        <p class="auth-subtitle">برای رزرو نوبت، یک حساب کاربری بسازید.</p>
        <div class="auth-tabs">
            <a href="@LoginHref">ورود</a>
            <a class="active" aria-current="page" href="@RegisterHref">ثبت‌نام</a>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="auth-error" role="alert">
                @ErrorMessage
                @if (EmailTaken)
                {
                    <a href="@LoginHref">وارد شوید</a>
                }
            </div>
        }

        <label>نام و نام خانوادگی
            <InputText @bind-Value="Input!.DisplayName" autocomplete="name" />
        </label>
        <ValidationMessage For="() => Input!.DisplayName" />

        <label>ایمیل (اختیاری)
            <InputText @bind-Value="Input!.Email" type="email" autocomplete="username" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input!.Email" />

        <label>شماره موبایل
            <InputText @bind-Value="Input!.Phone" type="tel" inputmode="tel" maxlength="14" autocomplete="tel" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input!.Phone" />

        <label for="registerPassword">رمز عبور
            <div class="password-input-wrap">
                <InputText @bind-Value="Input!.Password" id="registerPassword" type="password" autocomplete="new-password" dir="ltr" />
                <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('registerPassword', this)" title="نمایش رمز عبور" aria-label="نمایش یا پنهان‌سازی رمز عبور">
                    <svg class="eye-icon eye-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-icon eye-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </label>
        <ValidationMessage For="() => Input!.Password" />

        <label for="registerConfirmPassword">تکرار رمز عبور
            <div class="password-input-wrap">
                <InputText @bind-Value="Input!.ConfirmPassword" id="registerConfirmPassword" type="password" autocomplete="new-password" dir="ltr" />
                <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('registerConfirmPassword', this)" title="نمایش رمز عبور" aria-label="نمایش یا پنهان‌سازی رمز عبور">
                    <svg class="eye-icon eye-show" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-icon eye-hide" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </label>
        <ValidationMessage For="() => Input!.ConfirmPassword" />

        <label>کد دعوت شعبه (اختیاری)
            <InputText @bind-Value="Input!.InviteCode" placeholder="مثلاً BN-XXXXXX" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input!.InviteCode" />

        <button type="submit" class="primary-button auth-submit">ثبت‌نام</button>
        <p class="auth-switch">قبلاً ثبت‌نام کرده‌اید؟ <a href="@LoginHref">وارد شوید</a></p>
    </EditForm>
</div>

@code {
    private string? ErrorMessage;
    private bool EmailTaken;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl => SafeRedirect.Local(ReturnUrl, "");

    private string LoginHref => SafeReturnUrl.Length == 0
        ? "/account/login"
        : $"/account/login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private string RegisterHref => SafeReturnUrl.Length == 0
        ? "/account/register"
        : $"/account/register?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private async Task RegisterUser()
    {
        ErrorMessage = null;
        EmailTaken = false;

        Branch? invitedBranch = null;
        if (!string.IsNullOrWhiteSpace(Input!.InviteCode))
        {
            var cleanCode = Input!.InviteCode.Trim().ToUpperInvariant();
            invitedBranch = await Db.Branches.FirstOrDefaultAsync(b => b.InviteCode == cleanCode && b.DeletedAt == null && b.IsApproved);
            if (invitedBranch is null)
            {
                ErrorMessage = "کد دعوت شعبه وارد شده معتبر نیست.";
                return;
            }
        }

        if (Input!.Password != Input!.ConfirmPassword)
        {
            ErrorMessage = "رمز عبور و تکرار آن یکسان نیستند.";
            return;
        }

        if (!UserInputValidation.TryNormalizeIranianMobile(Input!.Phone, out var phone))
        {
            ErrorMessage = "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
            return;
        }

        if (await UserManager.Users.AnyAsync(u => u.PhoneNumber == phone || u.UserName == phone))
        {
            ErrorMessage = "این شماره موبایل قبلاً ثبت شده است.";
            return;
        }

        var rawEmail = (Input!.Email ?? "").Trim();
        string? email = null;
        if (!string.IsNullOrWhiteSpace(rawEmail))
        {
            if (!new EmailAddressAttribute().IsValid(rawEmail) || rawEmail.Length > 256)
            {
                ErrorMessage = "ایمیل وارد شده معتبر نیست.";
                return;
            }

            if (await UserManager.FindByEmailAsync(rawEmail) is not null)
            {
                EmailTaken = true;
                ErrorMessage = "این ایمیل قبلاً ثبت شده است.";
                return;
            }
            email = rawEmail;
        }

        var user = new AppUser
        {
            UserName = phone,
            Email = email,
            DisplayName = Input!.DisplayName.Trim(),
            PhoneNumber = phone,
        };

        var result = await UserManager.CreateAsync(user, Input!.Password);

        if (!result.Succeeded)
        {
            EmailTaken = result.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.DuplicateEmail));

            ErrorMessage = string.Join(" ", result.Errors
                .Select(e => e.Description)
                .Distinct(StringComparer.Ordinal));
            return;
        }

        await UserManager.AddToRoleAsync(user, DbSeeder.CustomerRole);

        if (invitedBranch is not null)
        {
            Db.BranchMemberships.Add(new BranchMembership
            {
                BranchId = invitedBranch.Id,
                UserId = user.Id,
                Role = AppRoles.Staff
            });
            await Db.SaveChangesAsync();
            await TeamRoleSync.SyncAsync(UserManager, Db, user);
        }

        await SignInManager.SignInAsync(user, isPersistent: true);

        // کاربری که برای رزرو یا با کد دعوت به ثبت‌نام آمده بود
        var target = SafeReturnUrl.Length == 0 ? (invitedBranch != null ? "/admin" : "/") : SafeReturnUrl;
        NavigationManager.NavigateTo(target, forceLoad: true);
    }

    private sealed class InputModel
    {
        [StringLength(20, ErrorMessage = "کد دعوت نباید بیشتر از ۲۰ کاراکتر باشد.")]
        public string? InviteCode { get; set; }

        [Required(ErrorMessage = "نام الزامی است.")]
        [StringLength(80, ErrorMessage = "نام نباید بیشتر از ۸۰ کاراکتر باشد.")]
        public string DisplayName { get; set; } = "";

        private string? _email;

        [OptionalEmailAddress(ErrorMessage = "ایمیل معتبر نیست.")]
        [StringLength(256, ErrorMessage = "ایمیل نباید بیشتر از ۲۵۶ کاراکتر باشد.")]
        public string? Email
        {
            get => _email;
            set => _email = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        }

        [Required(ErrorMessage = "شماره موبایل الزامی است.")]
        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است.")]
        [MinLength(6, ErrorMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "تکرار رمز عبور الزامی است.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
