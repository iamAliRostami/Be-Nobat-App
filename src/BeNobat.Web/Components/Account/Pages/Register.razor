@page "/account/register"
@layout Layout.PublicLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BeNobat.Web.Domain
@using BeNobat.Web.Infrastructure
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager NavigationManager

<PageTitle>ثبت‌نام | به‌نوبت</PageTitle>

<div class="account-auth-page">
    <EditForm Model="Input" FormName="register" OnValidSubmit="RegisterUser" class="auth-card">
        <DataAnnotationsValidator />
        <h1>ساخت حساب کاربری</h1>
        <p class="auth-subtitle">برای رزرو نوبت، یک حساب کاربری بسازید.</p>
        <div class="auth-tabs">
            <a href="@LoginHref">ورود</a>
            <a class="active" aria-current="page" href="@RegisterHref">ثبت‌نام</a>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="auth-error" role="alert">
                @ErrorMessage
                @if (EmailTaken)
                {
                    <a href="@LoginHref">وارد شوید</a>
                }
            </div>
        }

        <label>نام و نام خانوادگی
            <InputText @bind-Value="Input.DisplayName" autocomplete="name" />
        </label>
        <ValidationMessage For="() => Input.DisplayName" />

        <label>ایمیل
            <InputText @bind-Value="Input.Email" type="email" autocomplete="username" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input.Email" />

        @* شماره موبایل برای هماهنگی مجموعه با مراجعه‌کننده لازم است؛ قبلاً در ثبت‌نام گرفته نمی‌شد. *@
        <label>شماره موبایل
            <InputText @bind-Value="Input.Phone" type="tel" inputmode="tel" maxlength="14" autocomplete="tel" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input.Phone" />

        <label>رمز عبور
            <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input.Password" />

        <label>تکرار رمز عبور
            <InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" dir="ltr" />
        </label>
        <ValidationMessage For="() => Input.ConfirmPassword" />

        <button type="submit" class="primary-button auth-submit">ثبت‌نام</button>
        <p class="auth-switch">قبلاً ثبت‌نام کرده‌اید؟ <a href="@LoginHref">وارد شوید</a></p>
    </EditForm>
</div>

@code {
    private string? ErrorMessage;
    private bool EmailTaken;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl => SafeRedirect.Local(ReturnUrl, "");

    private string LoginHref => SafeReturnUrl.Length == 0
        ? "/account/login"
        : $"/account/login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private string RegisterHref => SafeReturnUrl.Length == 0
        ? "/account/register"
        : $"/account/register?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private async Task RegisterUser()
    {
        ErrorMessage = null;
        EmailTaken = false;

        if (Input.Password != Input.ConfirmPassword)
        {
            ErrorMessage = "رمز عبور و تکرار آن یکسان نیستند.";
            return;
        }

        if (!UserInputValidation.TryNormalizeIranianMobile(Input.Phone, out var phone))
        {
            ErrorMessage = "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
            return;
        }

        // ایمیل را قبل از ساخت حساب نرمال می‌کنیم؛ «Ali@Example.com » و «ali@example.com» نباید دو حساب شوند.
        var email = Input.Email.Trim();

        if (await UserManager.FindByEmailAsync(email) is not null)
        {
            EmailTaken = true;
            ErrorMessage = "این ایمیل قبلاً ثبت شده است.";
            return;
        }

        var user = new AppUser
        {
            UserName = email,
            Email = email,
            DisplayName = Input.DisplayName.Trim(),
            PhoneNumber = phone,
        };

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            EmailTaken = result.Errors.Any(e =>
                e.Code is nameof(IdentityErrorDescriber.DuplicateUserName) or nameof(IdentityErrorDescriber.DuplicateEmail));

            ErrorMessage = string.Join(" ", result.Errors
                .Select(e => e.Description)
                .Distinct(StringComparer.Ordinal));
            return;
        }

        await UserManager.AddToRoleAsync(user, DbSeeder.CustomerRole);
        await SignInManager.SignInAsync(user, isPersistent: true);

        // کاربری که برای رزرو به ثبت‌نام آمده بود به همان رزرو برمی‌گردد (قبلاً همیشه به صفحه‌ی اصلی می‌رفت).
        var target = SafeReturnUrl.Length == 0 ? "/" : SafeReturnUrl;
        NavigationManager.NavigateTo(target, forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "نام الزامی است.")]
        [StringLength(80, ErrorMessage = "نام نباید بیشتر از ۸۰ کاراکتر باشد.")]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "ایمیل الزامی است.")]
        [EmailAddress(ErrorMessage = "ایمیل معتبر نیست.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "شماره موبایل الزامی است.")]
        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است.")]
        [MinLength(6, ErrorMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "تکرار رمز عبور الزامی است.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
