@inherits LayoutComponentBase

<div class="shell">
    <input class="sidebar-toggle-state" id="sidebar-toggle-state" type="checkbox" aria-label="بستن یا باز کردن نوار کناری" />
    <aside class="sidebar">
        <div class="brand sidebar-identity">
            <a class="sidebar-home" href="/admin" aria-label="داشبورد به‌نوبت">ب</a>
            <div>
                <a href="/admin"><strong>به‌نوبت</strong></a>
                <a class="sidebar-business-name" href="/platform?q=استودیو زیبایی آوان">استودیو زیبایی آوان</a>
            </div>
        </div>
        <nav>
            <details class="sidebar-group" open>
                <summary>مدیریت</summary>
                <div><NavLink href="/admin" Match="NavLinkMatch.All"><i>⌂</i> داشبورد</NavLink>
                <NavLink href="/admin/calendar"><i>▦</i> تقویم نوبت‌ها</NavLink></div>
            </details>
            <AuthorizeView Policy="@Policies.ManageBusiness" Context="teamContext">
                <Authorized>
                    <details class="sidebar-group" open>
                    <summary>مدیریت کسب‌وکار</summary>
                    <div><NavLink href="/businesses"><i>◇</i> خدمات</NavLink>
                    <NavLink href="/admin/branches"><i>⌖</i> شعب و منابع</NavLink>
                    @* [fix] این دو صفحه وجود داشتند ولی هیچ لینکی به آن‌ها نبود:
                       «زمان‌های خالی» و «امتیازها و نظرات» عملاً فعال نشده بودند. *@
                    <NavLink href="/admin/availability"><i>◷</i> زمان‌های خالی</NavLink>
                    <NavLink href="/admin/reviews"><i>★</i> امتیازها و نظرات</NavLink>
                    <NavLink href="/admin/customers" Match="NavLinkMatch.All"><i>◈</i> مشتریان</NavLink>
                    <NavLink href="/admin/team" Match="NavLinkMatch.All"><i>◎</i> اعضای تیم</NavLink></div>
                    </details>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@AppRoles.PlatformAdmin" Context="platformContext">
                <Authorized>
                    <details class="sidebar-group" open>
                    <summary>مدیریت سامانه</summary>
                    <div><NavLink href="/platform" Match="NavLinkMatch.All"><i>▤</i> کسب‌وکارها</NavLink>
                    <NavLink href="/platform/categories" Match="NavLinkMatch.All"><i>▦</i> دسته‌بندی‌ها</NavLink>
                    <NavLink href="/platform/services" Match="NavLinkMatch.All"><i>✦</i> کاتالوگ خدمات</NavLink>
                    <NavLink href="/platform/access" Match="NavLinkMatch.All"><i>♙</i> کاربران و دسترسی‌ها</NavLink></div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <UserAvatarBadge User="context.User" />
                    <div><a class="sidebar-profile-name" href="/account/profile"><b>@(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</b></a><small>@RoleLabel(context.User)</small></div>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>
    <main>
        <header>
            <label class="sidebar-toggle" for="sidebar-toggle-state" title="بستن یا باز کردن منو">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path class="collapse-arrow" d="m15 9-3 3 3 3"/></svg>
            </label>
            <div class="mobile-brand">به‌نوبت</div>
            <div class="admin-header-actions">
                <UiPreferences />
                <AuthorizeView>
                    <Authorized>
                        <details class="public-user-menu">
                            <summary aria-label="باز کردن منوی حساب کاربری" title="حساب کاربری"><UserAvatarBadge User="context.User" CssClass="header-avatar" /></summary>
                            <div>
                                <NavLink href="/account/profile" Match="NavLinkMatch.Prefix">حساب من</NavLink>
                                <NavLink href="/appointments" Match="NavLinkMatch.Prefix">نوبت‌های من</NavLink>
                                <a href="/" target="_top">صفحه عمومی</a>
                                <form method="post" action="/account/logout">
                                    <AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit">خروج</button>
                                </form>
                            </div>
                        </details>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <section class="content">@Body</section>
    </main>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(AppRoles.PlatformAdmin) ? "مدیر کل سامانه" :
        user.IsInRole(AppRoles.Owner) ? "مدیر کسب‌وکار" :
        user.IsInRole(AppRoles.Manager) ? "مدیر شعبه" :
        user.IsInRole(AppRoles.Staff) ? "کارمند" : "کاربر";
}
