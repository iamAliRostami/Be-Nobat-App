@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/admin"><span>ب</span><div><strong>به‌نوبت</strong><small>پنل کسب‌وکار</small></div></a>
        <div class="branch-switcher"><span class="branch-logo">✦</span><div><small>مجموعه فعال</small><b>استودیو زیبایی آوان</b></div><span>⌄</span></div>
        <nav>
            <small>مدیریت</small><NavLink href="/admin" Match="NavLinkMatch.All"><i>⌂</i> داشبورد</NavLink>
            <NavLink href="/admin/calendar"><i>▦</i> تقویم نوبت‌ها</NavLink>
            <AuthorizeView Policy="@Policies.ManageBusiness" Context="teamContext">
                <Authorized>
                    <small>مدیریت کسب‌وکار</small>
                    <NavLink href="/businesses"><i>◇</i> خدمات</NavLink>
                    <NavLink href="/admin/branches"><i>⌖</i> شعب و منابع</NavLink>
                    @* [fix] این دو صفحه وجود داشتند ولی هیچ لینکی به آن‌ها نبود:
                       «زمان‌های خالی» و «امتیازها و نظرات» عملاً فعال نشده بودند. *@
                    <NavLink href="/admin/availability"><i>◷</i> زمان‌های خالی</NavLink>
                    <NavLink href="/admin/reviews"><i>★</i> امتیازها و نظرات</NavLink>
                    <NavLink href="/admin/customers" Match="NavLinkMatch.All"><i>◈</i> مشتریان</NavLink>
                    <NavLink href="/admin/team" Match="NavLinkMatch.All"><i>◎</i> اعضای تیم</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@AppRoles.PlatformAdmin" Context="platformContext">
                <Authorized>
                    <small>مدیریت سامانه</small>
                    <NavLink href="/platform" Match="NavLinkMatch.All"><i>▤</i> کسب‌وکارها</NavLink>
                    <NavLink href="/platform/access" Match="NavLinkMatch.All"><i>♙</i> کاربران و دسترسی‌ها</NavLink>
                </Authorized>
            </AuthorizeView>
            <small>حساب</small><a href="/" target="_top"><i>⌖</i> مشاهده صفحه عمومی</a>
        </nav>
        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <span class="customer-avatar purple">@Initials(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</span>
                    <div><b>@(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</b><small>@RoleLabel(context.User)</small></div>
                    <form method="post" action="/account/logout" class="logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="logout-icon-button" title="خروج">⋮</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>
    <main>
        <header><div class="mobile-brand">به‌نوبت</div><div class="admin-header-actions"><UiPreferences /><a href="/" target="_top">مشاهده صفحه عمومی</a></div></header>
        <section class="content">@Body</section>
    </main>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(AppRoles.PlatformAdmin) ? "مدیر کل سامانه" :
        user.IsInRole(AppRoles.Owner) ? "مدیر کسب‌وکار" :
        user.IsInRole(AppRoles.Manager) ? "مدیر شعبه" :
        user.IsInRole(AppRoles.Staff) ? "کارمند" : "کاربر";
}
