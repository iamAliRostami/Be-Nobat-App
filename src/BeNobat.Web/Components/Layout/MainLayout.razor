@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar" id="admin-sidebar" aria-label="منوی مدیریت">
        <div class="brand sidebar-identity">
            <a class="sidebar-home" href="/admin" aria-label="داشبورد به‌نوبت">ب</a>
            <div>
                <a href="/admin"><strong>به‌نوبت</strong></a>
                <a class="sidebar-business-name" href="/">مشاهده صفحه عمومی</a>
            </div>
        </div>
        <nav>
            <details class="sidebar-group" open>
                <summary>مدیریت</summary>
                <div><NavLink href="/admin" Match="NavLinkMatch.All" title="داشبورد" aria-label="داشبورد"><i>⌂</i> <span class="sidebar-label">داشبورد</span></NavLink>
                <NavLink href="/admin/calendar" title="تقویم نوبت‌ها" aria-label="تقویم نوبت‌ها"><i>▦</i> <span class="sidebar-label">تقویم نوبت‌ها</span></NavLink></div>
            </details>
            <AuthorizeView Policy="@Policies.ManageBusiness" Context="teamContext">
                <Authorized>
                    <details class="sidebar-group" open>
                    <summary>مدیریت کسب‌وکار</summary>
                    <div><NavLink href="/businesses" title="خدمات" aria-label="خدمات"><i>◇</i> <span class="sidebar-label">خدمات</span></NavLink>
                    <NavLink href="/admin/branches" title="شعب و منابع" aria-label="شعب و منابع"><i>⌖</i> <span class="sidebar-label">شعب و منابع</span></NavLink>
                    @* [fix] این دو صفحه وجود داشتند ولی هیچ لینکی به آن‌ها نبود:
                       «زمان‌های خالی» و «امتیازها و نظرات» عملاً فعال نشده بودند. *@
                    <NavLink href="/admin/availability" title="زمان‌های خالی" aria-label="زمان‌های خالی"><i>◷</i> <span class="sidebar-label">زمان‌های خالی</span></NavLink>
                    <NavLink href="/admin/reviews" title="امتیازها و نظرات" aria-label="امتیازها و نظرات"><i>★</i> <span class="sidebar-label">امتیازها و نظرات</span></NavLink>
                    <NavLink href="/admin/customers" Match="NavLinkMatch.All" title="مشتریان" aria-label="مشتریان"><i>◈</i> <span class="sidebar-label">مشتریان</span></NavLink>
                    <NavLink href="/admin/team" Match="NavLinkMatch.All" title="اعضای تیم" aria-label="اعضای تیم"><i>◎</i> <span class="sidebar-label">اعضای تیم</span></NavLink></div>
                    </details>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@AppRoles.PlatformAdmin" Context="platformContext">
                <Authorized>
                    <details class="sidebar-group" open>
                    <summary>مدیریت سامانه</summary>
                    <div><NavLink href="/platform" Match="NavLinkMatch.All" title="کسب‌وکارها" aria-label="کسب‌وکارها"><i>▤</i> <span class="sidebar-label">کسب‌وکارها</span></NavLink>
                    <NavLink href="/platform/services" Match="NavLinkMatch.All" title="کاتالوگ خدمات" aria-label="کاتالوگ خدمات"><i>✦</i> <span class="sidebar-label">کاتالوگ خدمات</span></NavLink>
                    <NavLink href="/platform/categories" Match="NavLinkMatch.All" title="دسته‌بندی‌ها" aria-label="دسته‌بندی‌ها"><i>▧</i> <span class="sidebar-label">دسته‌بندی‌ها</span></NavLink>
                    <NavLink href="/platform/access" Match="NavLinkMatch.All" title="کاربران و دسترسی‌ها" aria-label="کاربران و دسترسی‌ها"><i>♙</i> <span class="sidebar-label">کاربران و دسترسی‌ها</span></NavLink></div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <UserAvatarBadge User="context.User" />
                    <div><a class="sidebar-profile-name" href="/account/profile"><b data-i18n-skip>@(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</b></a><small>@RoleLabel(context.User)</small></div>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>
    <main>
        <header>
            <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="true" aria-label="باز و بسته کردن منوی مدیریت" title="باز و بسته کردن منوی مدیریت"><span aria-hidden="true">☰</span></button>
            <div class="mobile-brand">به‌نوبت</div>
            <div class="admin-header-actions">
                <UiPreferences />
                <AuthorizeView>
                    <Authorized>
                        <details class="public-user-menu">
                            <summary aria-label="باز کردن منوی حساب کاربری" title="حساب کاربری"><UserAvatarBadge User="context.User" CssClass="header-avatar" /></summary>
                            <div>
                                <NavLink href="/account/profile" Match="NavLinkMatch.Prefix">حساب من</NavLink>
                                <NavLink href="/appointments" Match="NavLinkMatch.Prefix">نوبت‌های من</NavLink>
                                <a href="/" target="_top">صفحه عمومی</a>
                                <form method="post" action="/account/logout">
                                    <AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit">خروج</button>
                                </form>
                            </div>
                        </details>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <section class="content">@Body</section>
    </main>
    <button type="button" class="sidebar-overlay" data-sidebar-close aria-label="بستن منوی مدیریت" tabindex="-1"></button>
</div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}‌{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(AppRoles.PlatformAdmin) ? "مدیر کل سامانه" :
        user.IsInRole(AppRoles.Owner) ? "مدیر کسب‌وکار" :
        user.IsInRole(AppRoles.Manager) ? "مدیر شعبه" :
        user.IsInRole(AppRoles.Staff) ? "کارمند" : "کاربر";
}
