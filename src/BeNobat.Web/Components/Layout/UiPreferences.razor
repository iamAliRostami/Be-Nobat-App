@inject IJSRuntime JS
@rendermode InteractiveServer
<div class="ui-preferences" aria-label="تنظیمات نمایش">
    <details class="language-menu">
        <summary title="انتخاب زبان" aria-label="انتخاب زبان">@LanguageLabel</summary>
        <div>
            <button type="button" lang="fa" @onclick='() => ChangeLanguage("fa")'>فارسی</button>
            <button type="button" lang="ar" @onclick='() => ChangeLanguage("ar")'>العربیة</button>
            <button type="button" lang="en" @onclick='() => ChangeLanguage("en")'>English</button>
        </div>
    </details>
    <button class="theme-toggle" type="button" title="تغییر حالت روشن و تیره" aria-label="تغییر حالت روشن و تیره" @onclick="ToggleTheme"><span aria-hidden="true"></span></button>
</div>
@code {
    private string Language = "fa";
    private string LanguageLabel => Language switch { "en" => "EN", "ar" => "عر", _ => "فا" };
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; Language = await JS.InvokeAsync<string>("beNobat.preferences.initialize"); StateHasChanged(); }
    private async Task ChangeLanguage(string language) { Language = language; await JS.InvokeVoidAsync("beNobat.preferences.setLanguage", Language); await JS.InvokeVoidAsync("beNobat.preferences.reload"); }
    private Task ToggleTheme() => JS.InvokeVoidAsync("beNobat.preferences.toggleTheme").AsTask();
}
