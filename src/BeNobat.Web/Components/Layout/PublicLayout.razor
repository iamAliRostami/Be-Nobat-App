@inherits LayoutComponentBase

<div class="public-shell">
    <header class="public-header">
        <a class="public-brand" href="/"><span>ب</span><strong>به‌نوبت</strong></a>
        <nav><a href="/#popular">خدمات</a><a href="/#businesses">مراکز برتر</a><a href="/#how">چطور کار می‌کند؟</a><NavLink href="/contact" Match="NavLinkMatch.All">ارتباط با ما</NavLink></nav>
        <div class="public-actions">
            <UiPreferences />
            <AuthorizeView>
                <Authorized>
                    <details class="public-user-menu">
                        <summary aria-label="حساب کاربری"><UserAvatarBadge User="context.User" CssClass="header-avatar" /></summary>
                        <div class="public-user-menu-backdrop" aria-hidden="true"></div>
                        <div>
                            <NavLink href="/account/profile" Match="NavLinkMatch.Prefix">حساب من</NavLink>
                            <NavLink href="/appointments" Match="NavLinkMatch.Prefix">نوبت‌های من</NavLink>
                            <NavLink href="/favorites" Match="NavLinkMatch.Prefix">علاقه‌مندی‌ها</NavLink>
                            <AuthorizeView Policy="@Policies.ManageAppointments" Context="adminContext"><Authorized><NavLink href="/admin">پنل مدیریت</NavLink></Authorized></AuthorizeView>
                            <form method="post" action="/account/logout">
                                <AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" />
                                <button type="submit">خروج</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    @* [fix] قبلاً هر دو دکمه به /account/login می‌رفتند و هیچ‌کدام حالت فعال
                       نداشتند؛ با سوییچ بین ورود و ثبت‌نام ظاهر هدر تغییر نمی‌کرد. *@
                    <NavLink class="nav-pill" href="/account/login" Match="NavLinkMatch.All">ورود</NavLink>
                    <NavLink class="nav-pill" href="/account/register" Match="NavLinkMatch.All">ثبت‌نام</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="public-main">@Body</main>
    <footer class="public-footer"><div class="public-brand"><span>ب</span><strong>به‌نوبت</strong></div><p>راه ساده‌تر برای پیدا کردن و رزرو بهترین خدمات.</p><div style="margin:0.5rem 0;display:flex;gap:1.5rem;justify-content:center;"><a href="/contact" style="color:var(--text-secondary);font-size:0.875rem;text-decoration:none;">ارتباط با ما و پشتیبانی</a></div><small>© ۱۴۰۵ به‌نوبت؛ همه حقوق محفوظ است.</small></footer>
</div>
