@inherits LayoutComponentBase

<div class="public-shell">
    <header class="public-header">
        <a class="public-brand" href="/"><span>ب</span><strong>به‌نوبت</strong></a>
        <nav><a href="/#popular">خدمات</a><a href="/#businesses">مراکز برتر</a><a href="/#how">چطور کار می‌کند؟</a></nav>
        <div class="public-actions">
            <UiPreferences />
            <AuthorizeView>
                <Authorized>
                    <UserAvatarBadge User="context.User" CssClass="header-avatar" />
                    <AuthorizeView Policy="@Policies.ManageAppointments" Context="adminContext">
                        <Authorized>
                            <NavLink class="nav-pill" href="/admin">پنل مدیریت</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    @* [fix] «نوبت‌های من» قبلاً یک <a> با کلاس ثابت user-login بود و همیشه -
                       حتی در صفحه‌ی اصلی - روشن/پررنگ دیده می‌شد. حالا NavLink است و فقط
                       وقتی واقعاً روی /appointments هستیم حالت فعال می‌گیرد. *@
                    <NavLink class="nav-pill" href="/appointments" Match="NavLinkMatch.Prefix">نوبت‌های من</NavLink>
                    <NavLink class="nav-pill" href="/account/profile" Match="NavLinkMatch.Prefix">حساب من</NavLink>
                    <form method="post" action="/account/logout" class="logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="logout-button">خروج</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    @* [fix] قبلاً هر دو دکمه به /account/login می‌رفتند و هیچ‌کدام حالت فعال
                       نداشتند؛ با سوییچ بین ورود و ثبت‌نام ظاهر هدر تغییر نمی‌کرد. *@
                    <NavLink class="nav-pill" href="/account/login" Match="NavLinkMatch.All">ورود</NavLink>
                    <NavLink class="nav-pill" href="/account/register" Match="NavLinkMatch.All">ثبت‌نام</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="public-main">@Body</main>
    <footer class="public-footer"><div class="public-brand"><span>ب</span><strong>به‌نوبت</strong></div><p>راه ساده‌تر برای پیدا کردن و رزرو بهترین خدمات.</p><small>© ۱۴۰۵ به‌نوبت؛ همه حقوق محفوظ است.</small></footer>
</div>
