<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.BeNobat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:supportsRtl">true</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>
    <style name="Widget.BeNobat.Button.Secondary" parent="Widget.BeNobat.Button.Tonal" />
    <style name="TextAppearance.BeNobat.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.BeNobat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="Widget.BeNobat.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:supportsRtl">true</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="iconTint">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="Widget.BeNobat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="Widget.BeNobat.Button.Icon" parent="Widget.Material3.Button.TextButton">
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.BeNobat.Button.Icon.Header" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="Widget.BeNobat.Button.Icon.Header.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.BeNobat.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BeNobat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/til_border_selector</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="endIconTint">?attr/colorPrimary</item>
        <item name="passwordToggleTint">?attr/colorPrimary</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.BeNobat.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/til_border_selector</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="endIconTint">?attr/colorPrimary</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.BeNobat.TextInputLayout.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/til_border_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">?attr/colorPrimary</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="TextAppearance.BeNobat.StepTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="TextAppearance.BeNobat.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.BeNobat.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.BeNobat.Body.Muted" parent="TextAppearance.BeNobat.Body">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.BeNobat.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.BeNobat.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.BeNobat.NavDrawer.Item" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nav_item_text_color</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BeNobat.NavDrawer.Subheader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BeNobat.Brand" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.BeNobat.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.BeNobat.BottomNav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.BeNobat.BottomNav.Active</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="TextAppearance.BeNobat.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="TextAppearance.BeNobat.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="TextAppearance.BeNobat.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
