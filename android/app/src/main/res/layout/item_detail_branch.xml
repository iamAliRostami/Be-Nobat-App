<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBranchItem"
    style="@style/Widget.BeNobat.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_branch"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvBranchName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/vazir_bold"
                android:textAppearance="@style/TextAppearance.BeNobat.Headline"
                android:textSize="14.5sp"
                android:textColor="?attr/colorOnSurface"
                tools:text="شعبه سعادت‌آباد" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBranchSelectedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp"
                    android:textColor="?attr/colorPrimary"
                    android:text="✓ انتخاب‌شده"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مشاهده شعبه"
                    android:textSize="11.5sp"
                    android:textColor="?attr/colorPrimary"
                    android:fontFamily="@font/app_font" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBranchAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="28dp"
            android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
            android:textSize="12.5sp"
            tools:text="بلوار سرو، خیابان پنجم" />

        <LinearLayout
            android:id="@+id/layoutBranchHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvBranchHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
                android:textSize="11.5sp"
                tools:text="ساعت کاری: ۰۹:۰۰ الی ۱۸:۰۰" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBranchPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvBranchPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
                android:textSize="11.5sp"
                tools:text="تلفن تماس: ۰۲۱۲۲۳۳۴۴۵۵" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
