<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <!-- Header: Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="تأیید نوبت و تعیین زمان"
            android:textAppearance="@style/TextAppearance.BeNobat.Headline"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDialog"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:icon="@drawable/ic_close"
            app:iconSize="20dp"
            android:contentDescription="@string/action_close" />
    </RelativeLayout>

    <!-- Appointment Info Line -->
    <TextView
        android:id="@+id/tvAppointmentMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        tools:text="الهام کریمی · مشاوره تغذیه · حسین کریمی" />

    <!-- Requested Time Notice -->
    <TextView
        android:id="@+id/tvRequestedTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="زمان درخواستی مشتری: ۲۳ آبان ۱۴۰۵، ساعت ۱۰:۰۰" />

    <!-- Day Switch Bar (Matching Image 4) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayPrev"
            style="@style/Widget.BeNobat.Button.Icon.Header.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            app:icon="@drawable/ic_back"
            app:iconSize="18dp"
            android:contentDescription="روز قبل" />

        <TextView
            android:id="@+id/tvSelectedDateDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            tools:text="شنبه، ۱۴۰۵/۰۸/۲۳" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayNext"
            style="@style/Widget.BeNobat.Button.Icon.Header.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:rotation="180"
            app:icon="@drawable/ic_back"
            app:iconSize="18dp"
            android:contentDescription="روز بعد" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSlots"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptySlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        android:text="برای این روز زمان خالی وجود ندارد؛ روز دیگری را ببینید یا در همان زمان درخواستی تأیید کنید." />

    <!-- Slots Grid (Matching Image 1 & 4) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRescheduleSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        tools:itemCount="12"
        tools:listitem="@layout/item_booking_slot" />

    <!-- Return to requested time button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearReschedule"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="بازگشت به زمان درخواستی"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Confirm button (Matching Image 4) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAction"
        style="@style/Widget.BeNobat.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="تأیید در زمان درخواستی"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="پس از تأیید، زمان جدید در «نوبت‌های من» برای مشتری نمایش داده می‌شود." />
</LinearLayout>
