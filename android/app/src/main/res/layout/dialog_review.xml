<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- Star Rating Row -->
    <LinearLayout
        android:id="@+id/starContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="1"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="2"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="3"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="4"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="5"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRatingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
        android:textSize="13sp" />

    <!-- Comment Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReviewComment"
        style="@style/Widget.BeNobat.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/review_comment_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="6" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
