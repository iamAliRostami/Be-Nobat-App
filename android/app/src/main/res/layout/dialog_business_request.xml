<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvReqTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/business_request_dialog_title"
        android:textAppearance="@style/TextAppearance.BeNobat.Brand"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/business_upgrade_card_desc"
        android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
        android:textSize="13sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqBusinessName"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/business_request_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/business_request_category"
                android:textAppearance="@style/TextAppearance.BeNobat.Caption" />

            <Spinner
                android:id="@+id/spReqCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_day_tab_unselected"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqCity"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/business_request_city">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تهران"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqContactPhone"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/business_request_phone"
                app:startIconDrawable="@drawable/ic_mobile">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqFirstBranchName"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/business_request_first_branch">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqFirstBranchName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شعبه مرکزی"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqFirstBranchAddress"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/business_request_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqFirstBranchAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReqDescription"
                style="@style/Widget.BeNobat.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/business_request_description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReqDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="top"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReq"
            style="@style/Widget.BeNobat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReq"
            style="@style/Widget.BeNobat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/business_request_submit_btn" />
    </LinearLayout>
</LinearLayout>
