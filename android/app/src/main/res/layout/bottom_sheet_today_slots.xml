<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sheet_drag_handle" />

    <!-- Header: Title, Subtitle, Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnCloseTodaySlots"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTodaySlotsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_slots_title"
                android:textAppearance="@style/TextAppearance.BeNobat.Headline"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTodaySlotsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.BeNobat.Caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="امروز · دوشنبه ۵ آبان" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseTodaySlots"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />
    </RelativeLayout>

    <!-- Tab Toggle: Today / Tomorrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabToday"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/today_slots_tab_today"
            android:textSize="12sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabTomorrow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/today_slots_tab_tomorrow"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Status / Count -->
    <TextView
        android:id="@+id/tvSlotsCountBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:textAppearance="@style/TextAppearance.BeNobat.Caption"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="۸ نوبت خالی در دسترس است"
        tools:visibility="visible" />

    <!-- Progress Loader -->
    <ProgressBar
        android:id="@+id/progressTodaySlots"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:visibility="visible" />

    <!-- Error State -->
    <TextView
        android:id="@+id/tvTodaySlotsError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:textColor="@color/error_red"
        android:visibility="gone"
        tools:text="خطا در دریافت نوبت‌ها" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyTodaySlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvEmptySlotsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/today_slots_empty"
            android:textAppearance="@style/TextAppearance.BeNobat.Title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEmptySlotsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="می‌توانید نوبت‌های فردا را بررسی کنید یا مراکز فعال با رزرو سریع را ببینید."
            android:textAppearance="@style/TextAppearance.BeNobat.Body.Muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTomorrowSlots"
            style="@style/Widget.BeNobat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/today_slots_view_tomorrow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewInstantCenters"
            style="@style/Widget.BeNobat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/today_slots_view_instant_businesses" />
    </LinearLayout>

    <!-- RecyclerView of Available Slots -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodaySlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        tools:itemCount="3"
        tools:listitem="@layout/item_today_slot" />
</LinearLayout>
