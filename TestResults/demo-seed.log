              WHERE b0."DeletedAt" IS NULL
          ) AS b1 ON s."BusinessId" = b1."Id"
          WHERE s."DeletedAt" IS NULL AND b1."DeletedAt" IS NULL
      ) AS s2 ON b."Id" = s2."BusinessId"
      LEFT JOIN (
          SELECT b2."Id", b2."Address", b2."BusinessId", b2."CloseHour", b2."CreatedAt", b2."DeletedAt", b2."Name", b2."OpenHour", b2."TimeZoneId", b2."UpdatedAt", b4."Id" AS "Id0", s3."Id" AS "Id1", s3."BranchId", s3."CreatedAt" AS "CreatedAt0", s3."DeletedAt" AS "DeletedAt0", s3."Kind", s3."Name" AS "Name0", s3."UpdatedAt" AS "UpdatedAt0", s3."UserId", s3."Id0" AS "Id00", s3."Id00" AS "Id000", s3."Id1" AS "Id10"
          FROM benobat."Branches" AS b2
          INNER JOIN (
