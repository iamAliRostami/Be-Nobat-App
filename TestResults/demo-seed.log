      FROM benobat."Businesses" AS b
      LEFT JOIN (
          SELECT s."Id", s."BusinessId", s."CatalogItemId", s."CreatedAt", s."Currency", s."DeletedAt", s."Description", s."DurationMinutes", s."Name", s."Price", s."UpdatedAt", b1."Id" AS "Id0"
          FROM benobat."Services" AS s
          INNER JOIN (
              SELECT b0."Id", b0."DeletedAt"
